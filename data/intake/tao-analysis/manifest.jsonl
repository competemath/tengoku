{"name": "EReal.tsum_le_coe_tsum_of_forall_le", "statement": "lemma EReal.tsum_le_coe_tsum_of_forall_le {f : ℕ → EReal} {g : ℕ → ℝ}\n    (hf_nn : ∀ n, 0 ≤ f n) (hg_nn : ∀ n, 0 ≤ g n) (hg_sum : Summable g)\n    (h_le : ∀ n, f n ≤ (g n : EReal)) :\n    ∑' n, f n ≤ (∑' n, g n : EReal)", "module": "Tengoku.TaoAnalysis.Analysis.Misc.«Real-EReal-ENNReal»", "source_path": "Analysis/Misc/Real-EReal-ENNReal.lean", "library": "tao-analysis", "source_url": "https://github.com/teorth/analysis/blob/245b2e16e2501170cd3d2c234edf74d298dbdc60/Analysis/Misc/Real-EReal-ENNReal.lean", "toolchain": "leanprover/lean4:v4.34.0-rc2", "via": "equal"}
{"name": "EReal.tsum_le_of_sum_range_le_of_nonneg", "statement": "lemma EReal.tsum_le_of_sum_range_le_of_nonneg {f : ℕ → EReal} {M : EReal}\n    (h_nn : ∀ n, 0 ≤ f n) (h : ∀ N : ℕ, ∑ n ∈ Finset.range N, f n ≤ M) :\n    ∑' n, f n ≤ M", "module": "Tengoku.TaoAnalysis.Analysis.Misc.«Real-EReal-ENNReal»", "source_path": "Analysis/Misc/Real-EReal-ENNReal.lean", "library": "tao-analysis", "source_url": "https://github.com/teorth/analysis/blob/245b2e16e2501170cd3d2c234edf74d298dbdc60/Analysis/Misc/Real-EReal-ENNReal.lean", "toolchain": "leanprover/lean4:v4.34.0-rc2", "via": "equal"}
