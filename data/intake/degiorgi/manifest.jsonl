{"name": "DeGiorgi.le_mul_rpow_of_inv_rpow_mul_le", "statement": "lemma le_mul_rpow_of_inv_rpow_mul_le\n    {a C r α : ℝ} (hr : 0 < r)\n    (h : r⁻¹ ^ α * a ≤ C) :\n    a ≤ C * r ^ α", "module": "Tengoku.Degiorgi.DeGiorgi.Oscillation.Campanato", "source_path": "DeGiorgi/Oscillation/Campanato.lean", "library": "degiorgi", "source_url": "https://github.com/scottnarmstrong/DeGiorgi/blob/4c1b3077d3782b24065184df4ba59501b2e56fc7/DeGiorgi/Oscillation/Campanato.lean", "toolchain": "leanprover/lean4:v4.34.0-rc2", "via": "equal"}
{"name": "DeGiorgi.weighted_power_mean_setIntegral", "statement": "theorem weighted_power_mean_setIntegral\n    {α : Type*} [MeasurableSpace α] {μ : Measure α}\n    {s : Set α} (hs : MeasurableSet s)\n    {p : ℝ} (hp : 1 < p)\n    {f w : α → ℝ} (hf : ∀ x, 0 ≤ f x) (hw : ∀ x, 0 ≤ w x)\n    (hf_meas : AEMeasurable f (μ.restrict s))\n    (hwi : IntegrableOn w s μ)\n    (hfpwi : IntegrableOn (fun x => (f x) ^ p * w x) s μ) :\n    (∫ x in s, f x * w x ∂μ) ^ p ≤\n      (∫ x in s, w x ∂μ) ^ (p - 1) * ∫ x in s, (f x) ^ p * w x ∂μ", "module": "Tengoku.Degiorgi.DeGiorgi.Poincare", "source_path": "DeGiorgi/Poincare.lean", "library": "degiorgi", "source_url": "https://github.com/scottnarmstrong/DeGiorgi/blob/4c1b3077d3782b24065184df4ba59501b2e56fc7/DeGiorgi/Poincare.lean", "toolchain": "leanprover/lean4:v4.34.0-rc2", "via": "equal"}
