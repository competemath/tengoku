{"name": "IsCompanion.extend_coe", "statement": "lemma IsCompanion.extend_coe (h : IsCompanion e a b) (x : A) :\n    (h.extend ⟨x, le_closure_insert x.2⟩ : β) = e x", "module": "Tengoku.Foundation.Foundation.Vorspiel.Order.BooleanAlgebra.Extension", "source_path": "Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "library": "foundation", "source_url": "https://github.com/FormalizedFormalLogic/Foundation/blob/81810b9f22c49fbb32bd89c1e9737059d83a37e6/Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "toolchain": "leanprover/lean4:v4.34.0-rc2", "via": "equal"}
{"name": "IsCompanion.extend_self", "statement": "lemma IsCompanion.extend_self (h : IsCompanion e a b) :\n    (h.extend ⟨a, self_mem_closure_insert⟩ : β) = b", "module": "Tengoku.Foundation.Foundation.Vorspiel.Order.BooleanAlgebra.Extension", "source_path": "Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "library": "foundation", "source_url": "https://github.com/FormalizedFormalLogic/Foundation/blob/81810b9f22c49fbb32bd89c1e9737059d83a37e6/Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "toolchain": "leanprover/lean4:v4.34.0-rc2", "via": "equal"}
{"name": "IsCompanion.extend_spec", "statement": "lemma IsCompanion.extend_spec (h : IsCompanion e a b)\n    (x : (closure (insert a (A : Set α)) : BooleanSubalgebra α)) :\n    ∃ y z : A, (x : α) = ((y : α) ⊓ a) ⊔ ((z : α) ⊓ aᶜ) ∧\n      (h.extend x : β) = ((e y : β) ⊓ b) ⊔ ((e z : β) ⊓ bᶜ)", "module": "Tengoku.Foundation.Foundation.Vorspiel.Order.BooleanAlgebra.Extension", "source_path": "Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "library": "foundation", "source_url": "https://github.com/FormalizedFormalLogic/Foundation/blob/81810b9f22c49fbb32bd89c1e9737059d83a37e6/Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "toolchain": "leanprover/lean4:v4.34.0-rc2", "via": "equal"}
{"name": "IsCompanion.mapRep_eq", "statement": "lemma IsCompanion.mapRep_eq (h : IsCompanion e a b) {y z : A}\n    (hu : (u : α) = ((y : α) ⊓ a) ⊔ ((z : α) ⊓ aᶜ)) :\n    (h.mapRep u : β) = ((e y : β) ⊓ b) ⊔ ((e z : β) ⊓ bᶜ)", "module": "Tengoku.Foundation.Foundation.Vorspiel.Order.BooleanAlgebra.Extension", "source_path": "Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "library": "foundation", "source_url": "https://github.com/FormalizedFormalLogic/Foundation/blob/81810b9f22c49fbb32bd89c1e9737059d83a37e6/Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "toolchain": "leanprover/lean4:v4.34.0-rc2", "via": "equal"}
{"name": "IsCompanion.mapRep_mapRep", "statement": "lemma IsCompanion.mapRep_mapRep (h : IsCompanion e a b) : h.symm.mapRep (h.mapRep u) = u", "module": "Tengoku.Foundation.Foundation.Vorspiel.Order.BooleanAlgebra.Extension", "source_path": "Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "library": "foundation", "source_url": "https://github.com/FormalizedFormalLogic/Foundation/blob/81810b9f22c49fbb32bd89c1e9737059d83a37e6/Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "toolchain": "leanprover/lean4:v4.34.0-rc2", "via": "equal"}
{"name": "IsCompanion.mapRep_mono", "statement": "lemma IsCompanion.mapRep_mono (h : IsCompanion e a b) (hu : u₁ ≤ u₂) :\n    h.mapRep u₁ ≤ h.mapRep u₂", "module": "Tengoku.Foundation.Foundation.Vorspiel.Order.BooleanAlgebra.Extension", "source_path": "Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "library": "foundation", "source_url": "https://github.com/FormalizedFormalLogic/Foundation/blob/81810b9f22c49fbb32bd89c1e9737059d83a37e6/Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "toolchain": "leanprover/lean4:v4.34.0-rc2", "via": "equal"}
{"name": "IsCompanion.map_le_map", "statement": "lemma IsCompanion.map_le_map (h : IsCompanion e a b) {y₁ z₁ y₂ z₂ : A}\n    (hle : ((y₁ : α) ⊓ a) ⊔ ((z₁ : α) ⊓ aᶜ) ≤ ((y₂ : α) ⊓ a) ⊔ ((z₂ : α) ⊓ aᶜ)) :\n    ((e y₁ : β) ⊓ b) ⊔ ((e z₁ : β) ⊓ bᶜ) ≤ ((e y₂ : β) ⊓ b) ⊔ ((e z₂ : β) ⊓ bᶜ)", "module": "Tengoku.Foundation.Foundation.Vorspiel.Order.BooleanAlgebra.Extension", "source_path": "Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "library": "foundation", "source_url": "https://github.com/FormalizedFormalLogic/Foundation/blob/81810b9f22c49fbb32bd89c1e9737059d83a37e6/Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "toolchain": "leanprover/lean4:v4.34.0-rc2", "via": "equal"}
