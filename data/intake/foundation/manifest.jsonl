{"name": "IsCompanion.val_mapRep", "statement": "@[simp] lemma IsCompanion.val_mapRep (h : IsCompanion e a b) : (h.mapRep u : β) =\n    ((e (insertRepPair u).1 : β) ⊓ b) ⊔ ((e (insertRepPair u).2 : β) ⊓ bᶜ)", "module": "Tengoku.Foundation.Foundation.Vorspiel.Order.BooleanAlgebra.Extension", "source_path": "Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "library": "foundation", "source_url": "https://github.com/FormalizedFormalLogic/Foundation/blob/81810b9f22c49fbb32bd89c1e9737059d83a37e6/Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "toolchain": "leanprover/lean4:v4.34.0-rc2", "via": "equal"}
{"name": "exists_companionPiece", "statement": "lemma exists_companionPiece [DenselyOrdered β] (e : A ≃o B) (a : α) (p : A) :\n    ∃ c : β, c ≤ (e p : β) ∧ (c = ⊥ ↔ (p : α) ⊓ a = ⊥) ∧ (c = (e p : β) ↔ (p : α) ≤ a)", "module": "Tengoku.Foundation.Foundation.Vorspiel.Order.BooleanAlgebra.Extension", "source_path": "Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "library": "foundation", "source_url": "https://github.com/FormalizedFormalLogic/Foundation/blob/81810b9f22c49fbb32bd89c1e9737059d83a37e6/Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "toolchain": "leanprover/lean4:v4.34.0-rc2", "via": "equal"}
{"name": "exists_isCompanion", "statement": "theorem exists_isCompanion [Nontrivial β] [DenselyOrdered β]\n    (hA : (A : Set α).Finite) (e : A ≃o B) (a : α) :\n    ∃ b : β, IsCompanion e a b", "module": "Tengoku.Foundation.Foundation.Vorspiel.Order.BooleanAlgebra.Extension", "source_path": "Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "library": "foundation", "source_url": "https://github.com/FormalizedFormalLogic/Foundation/blob/81810b9f22c49fbb32bd89c1e9737059d83a37e6/Foundation/Vorspiel/Order/BooleanAlgebra/Extension.lean", "toolchain": "leanprover/lean4:v4.34.0-rc2", "via": "equal"}
