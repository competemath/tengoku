{"name": "iso_of_countable_atomless", "statement": "theorem iso_of_countable_atomless\n    [Countable α] [Nontrivial α] [DenselyOrdered α]\n    [Countable β] [Nontrivial β] [DenselyOrdered β] :\n    Nonempty (α ≃o β)", "module": "Tengoku.Foundation.Foundation.Vorspiel.Order.BooleanAlgebra.Iso", "source_path": "Foundation/Vorspiel/Order/BooleanAlgebra/Iso.lean", "library": "foundation", "source_url": "https://github.com/FormalizedFormalLogic/Foundation/blob/81810b9f22c49fbb32bd89c1e9737059d83a37e6/Foundation/Vorspiel/Order/BooleanAlgebra/Iso.lean", "toolchain": "leanprover/lean4:v4.34.0-rc2", "via": "equal"}
{"name": "small_preimage_of_injective", "statement": "theorem small_preimage_of_injective (f : α → β) (h : Function.Injective f) (s : Set β) [Small.{u} s] :\n    Small.{u} (f ⁻¹' s)", "module": "Tengoku.Foundation.Foundation.Vorspiel.Small", "source_path": "Foundation/Vorspiel/Small.lean", "library": "foundation", "source_url": "https://github.com/FormalizedFormalLogic/Foundation/blob/81810b9f22c49fbb32bd89c1e9737059d83a37e6/Foundation/Vorspiel/Small.lean", "toolchain": "leanprover/lean4:v4.34.0-rc2", "via": "equal"}
