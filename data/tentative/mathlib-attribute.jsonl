{"name": "mul_inv_iff_mul_inv", "statement": "@[to_additive (dont_translate := \u03b2 \u03b3) add_neg_iff_mul_inv]\nlemma mul_inv_iff_mul_inv {\u03b1 \u03b2 \u03b3 : Type} [Group \u03b1] [MyRing \u03b2] [MyRing \u03b3] (a : \u03b1) (b : \u03b2) (c : \u03b3) :\n    a * a\u207b\u00b9 = 1 \u2194 b * b\u207b\u00b9 = 1 \u2228 c * c\u207b\u00b9 = 1", "proof": ":= by\n  simp", "status": "tentative", "library": "mathlib", "source_url": "https://github.com/leanprover-community/mathlib4/blob/217ba069a556ad9de837366b35c2ec1bec1de384/MathlibTest/Attribute/ToAdditive/Basic.lean#L790", "toolchain": "leanprover/lean4:v4.34.0-rc2"}
{"name": "simplePowZero_x'", "statement": "@[to_additive]\nlemma simplePowZero_x' {\u03b2} : (simplePowZero Nat \u03b2).x = 0", "proof": ":= by\n  rw [simplePowZero_x]", "status": "tentative", "library": "mathlib", "source_url": "https://github.com/leanprover-community/mathlib4/blob/217ba069a556ad9de837366b35c2ec1bec1de384/MathlibTest/Attribute/ToAdditive/Basic.lean#L837", "toolchain": "leanprover/lean4:v4.34.0-rc2"}
