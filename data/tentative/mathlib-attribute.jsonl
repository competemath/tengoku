{"name": "npowRec_zero", "statement": "@[to_additive]\nlemma npowRec_zero [One M] [Mul M] (x : M) : npowRec 0 x = 1", "proof": ":= by\n  rw [npowRec]", "status": "tentative", "library": "mathlib", "source_url": "https://github.com/leanprover-community/mathlib4/blob/217ba069a556ad9de837366b35c2ec1bec1de384/MathlibTest/Attribute/ToAdditive/Basic.lean#L348", "toolchain": "leanprover/lean4:v4.34.0-rc2"}
{"name": "optiontest", "statement": "@[to_additive addoptiontest]\nlemma optiontest (x : Option \u03b1) : x.elim none some = x", "proof": ":= by\n  cases x <;> rw [Option.elim]", "status": "tentative", "library": "mathlib", "source_url": "https://github.com/leanprover-community/mathlib4/blob/217ba069a556ad9de837366b35c2ec1bec1de384/MathlibTest/Attribute/ToAdditive/Basic.lean#L354", "toolchain": "leanprover/lean4:v4.34.0-rc2"}
{"name": "isUnit_iff_exists_inv", "statement": "@[to_additive]\ntheorem isUnit_iff_exists_inv [Mul M] {a : M} : IsUnit a \u2194 \u2203 _ : \u03b1, a \u2260 a", "proof": ":=\n  \u27e8fun h => absurd rfl h, fun \u27e8_, hab\u27e9 => hab\u27e9", "status": "tentative", "library": "mathlib", "source_url": "https://github.com/leanprover-community/mathlib4/blob/217ba069a556ad9de837366b35c2ec1bec1de384/MathlibTest/Attribute/ToAdditive/Basic.lean#L361", "toolchain": "leanprover/lean4:v4.34.0-rc2"}
{"name": "mulMatchThm", "statement": "@[to_additive (dont_translate := R)]\ntheorem mulMatchThm {R A} (r : R) (a : A) [Mul A] : True", "proof": ":= by\n  have \u27e8_, _\u27e9 : mulMatchAux r a = mulMatchAux r a \u2227 True := \u27e8rfl, trivial\u27e9\n  exact trivial", "status": "tentative", "library": "mathlib", "source_url": "https://github.com/leanprover-community/mathlib4/blob/217ba069a556ad9de837366b35c2ec1bec1de384/MathlibTest/Attribute/ToAdditive/Basic.lean#L368", "toolchain": "leanprover/lean4:v4.34.0-rc2"}
{"name": "isUnit'_iff_exists_inv", "statement": "@[to_additive]\ntheorem isUnit'_iff_exists_inv [CommMonoid M] {a : M} : IsUnit' a \u2194 \u2203 b, a * b = 1", "proof": ":= Iff.rfl", "status": "tentative", "library": "mathlib", "source_url": "https://github.com/leanprover-community/mathlib4/blob/217ba069a556ad9de837366b35c2ec1bec1de384/MathlibTest/Attribute/ToAdditive/Basic.lean#L378", "toolchain": "leanprover/lean4:v4.34.0-rc2"}
{"name": "isUnit'_iff_exists_inv'", "statement": "@[to_additive]\ntheorem isUnit'_iff_exists_inv' [CommMonoid M] {a : M} : IsUnit' a \u2194 \u2203 b, b * a = 1", "proof": ":= by\n  simp [isUnit'_iff_exists_inv, mul_comm]", "status": "tentative", "library": "mathlib", "source_url": "https://github.com/leanprover-community/mathlib4/blob/217ba069a556ad9de837366b35c2ec1bec1de384/MathlibTest/Attribute/ToAdditive/Basic.lean#L381", "toolchain": "leanprover/lean4:v4.34.0-rc2"}
{"name": "monoidEnd_lemma", "statement": "@[to_additive]\nlemma monoidEnd_lemma (x y z : MonoidEnd) : x * (y * z) = (x * y) * z", "proof": ":= mul_assoc .. |>.symm", "status": "tentative", "library": "mathlib", "source_url": "https://github.com/leanprover-community/mathlib4/blob/217ba069a556ad9de837366b35c2ec1bec1de384/MathlibTest/Attribute/ToAdditive/Basic.lean#L478", "toolchain": "leanprover/lean4:v4.34.0-rc2"}
{"name": "one_eq_one", "statement": "@[simp, reduce_mod_char, to_additive]\nlemma one_eq_one {\u03b1 : Type*} [One \u03b1] : (1 : \u03b1) = 1", "proof": ":= rfl", "status": "tentative", "library": "mathlib", "source_url": "https://github.com/leanprover-community/mathlib4/blob/217ba069a556ad9de837366b35c2ec1bec1de384/MathlibTest/Attribute/ToAdditive/Basic.lean#L559", "toolchain": "leanprover/lean4:v4.34.0-rc2"}
