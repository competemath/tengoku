{"name": "triple.hab'", "statement": "@[simp]\nlemma triple.hab' (l : List (Fin 2019)) (users : SimpleGraph (Fin 2019)) (h : IsTriple l users) :\n  l[1]! = l[2]! \u2194 False", "proof": ":= by\n  constructor\n  \u00b7 exact (h.2.2.2.2 \u00b7)\n  \u00b7 tauto", "status": "tentative", "library": "combibench", "source_url": "https://github.com/MoonshotAI/CombiBench/blob/c67e4213597b1477351d9ef5ca37fb622084cc78/lean/CombiBench/imo_2019_p3.lean#L8", "toolchain": "leanprover/lean4:v4.24.0"}
{"name": "toRelSeries_injective", "statement": "lemma toRelSeries_injective : Injective (toRelSeries : sq.UphillPath \u2192 RelSeries _)", "proof": ":=\n  fun p q \u21a6 by cases p; congr!", "status": "tentative", "library": "combibench", "source_url": "https://github.com/MoonshotAI/CombiBench/blob/c67e4213597b1477351d9ef5ca37fb622084cc78/lean/CombiBench/imo_2022_p6.lean#L24", "toolchain": "leanprover/lean4:v4.24.0"}
{"name": "strictMono", "statement": "lemma strictMono (p : sq.UphillPath) : StrictMono fun x \u21a6 sq (p x)", "proof": ":=\n  Fin.strictMono_iff_lt_succ.2 fun i \u21a6 (p.toRelSeries.step i).2", "status": "tentative", "library": "combibench", "source_url": "https://github.com/MoonshotAI/CombiBench/blob/c67e4213597b1477351d9ef5ca37fb622084cc78/lean/CombiBench/imo_2022_p6.lean#L33", "toolchain": "leanprover/lean4:v4.24.0"}
{"name": "length_lt", "statement": "lemma length_lt (p : sq.UphillPath) : p.length < n ^ 2", "proof": ":= by\n  simpa using Fintype.card_le_of_injective _ p.strictMono.injective", "status": "tentative", "library": "combibench", "source_url": "https://github.com/MoonshotAI/CombiBench/blob/c67e4213597b1477351d9ef5ca37fb622084cc78/lean/CombiBench/imo_2022_p6.lean#L36", "toolchain": "leanprover/lean4:v4.24.0"}
