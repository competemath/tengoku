module

public import Tengoku.AisafetyAtlas.AISafetyAtlas.Compositional.Hyperproperties

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# The observation topology on systems

`AISafetyAtlas.Compositional.Hyperproperties` proves a decomposition theorem for
an *arbitrary* topology on systems, and deliberately declines to read it as
hypersafety and hyperliveness.  This module supplies the topology that makes
that reading correct.

## Why the topology is a `def`, not an `instance`

Everything here depends on the observation relation `prefixOf`, and on the
prefix type.  A global `TopologicalSpace (TraceSystem Trace)` instance cannot
mention either, so registering one would silently forget the observation
semantics and let an unrelated topology be substituted under the same theorem
names.  `prefixTopology` is therefore a plain definition, installed locally with
`letI` at each use.

## What is proved

* `isOpen_cone`: the cones `{S | S realizes M}` are open, and they are the local
  basis by construction.
* `isClosed_iff_hyperSafety`: closed sets are exactly the operationally
  hypersafety hyperproperties of Clarkson and Schneider, those whose every
  violation has a finite bad observation.
* `dense_iff_hyperLiveness`: dense sets are exactly the operationally
  hyperliveness ones, those meeting every realizable finite observation.
* `hyperSafety_of_isKSafety`: every `k`-safety hyperproperty is hypersafety, the
  inclusion that joins this module to the `k`-safety reduction.
* `hyperSafety_hyperLiveness_decomposition`: the generic decomposition,
  specialized through this topology, so the operational reading is now earned
  rather than asserted.

Sources: Clarkson and Schneider, *Hyperproperties*, JCS 18(6), 2010; Alpern and
Schneider, *Defining liveness*, IPL 21(4), 1985, for the trace-level pattern.
-/

namespace AISafetyAtlas.Compositional.Hyperproperties

variable {Prefix Trace : Type*}

/-- The set of systems realizing a finite observation.-/
@[expose] public def Cone (prefixOf : Prefix → Trace → Prop)
    (M : Observation Prefix) : Set (TraceSystem Trace) :=
  {S | Realizes prefixOf M S}

/-- Realizing a union of observations is realizing both.-/
public theorem cone_union (prefixOf : Prefix → Trace → Prop)
    [DecidableEq Prefix] (M N : Observation Prefix) :
    Cone prefixOf (M ∪ N) = Cone prefixOf M ∩ Cone prefixOf N := by
  ext S
  constructor
  · intro h
    exact ⟨fun p hp => h p (Finset.mem_union_left _ hp),
      fun p hp => h p (Finset.mem_union_right _ hp)⟩
  · rintro ⟨h₁, h₂⟩ p hp
    rcases Finset.mem_union.mp hp with hp' | hp'
    · exact h₁ p hp'
    · exact h₂ p hp'

/--
The observation topology on systems, parameterized by the observation relation.

A set of systems is open when every member is separated from the outside by a
finite observation it realizes.  This is the local-basis presentation of the
topology generated by the cones; stating it directly avoids any dependence on
basis machinery.-/
@[expose, reducible] public def prefixTopology [DecidableEq Prefix]
    (prefixOf : Prefix → Trace → Prop) : TopologicalSpace (TraceSystem Trace) where
  IsOpen U := ∀ S ∈ U, ∃ M : Observation Prefix,
    Realizes prefixOf M S ∧ Cone prefixOf M ⊆ U
  isOpen_univ := by
    intro S _
    exact ⟨∅, by simp [Realizes], by simp⟩
  isOpen_inter := by
    rintro U V hU hV S ⟨hSU, hSV⟩
    obtain ⟨M, hM, hMU⟩ := hU S hSU
    obtain ⟨N, hN, hNV⟩ := hV S hSV
    refine ⟨M ∪ N, ?_, ?_⟩
    · intro p hp
      rcases Finset.mem_union.mp hp with hp' | hp'
      · exact hM p hp'
      · exact hN p hp'
    · rw [cone_union]
      exact Set.inter_subset_inter hMU hNV
  isOpen_sUnion := by
    intro 𝒮 h S hS
    obtain ⟨U, hU𝒮, hSU⟩ := hS
    obtain ⟨M, hM, hMU⟩ := h U hU𝒮 S hSU
    exact ⟨M, hM, hMU.trans (Set.subset_sUnion_of_mem hU𝒮)⟩

section

variable [DecidableEq Prefix] (prefixOf : Prefix → Trace → Prop)

/-!
### Operational hypersafety and hyperliveness

These are the Clarkson-Schneider definitions, stated without reference to any
topology, so that the theorems below are genuine characterizations rather than
renamings.
-/

/-- **Operational hypersafety.**  Every violation is witnessed by a finite bad
observation that the violating system realizes.-/
@[expose] public def IsHyperSafetyOp (H : Hyperproperty Trace) : Prop :=
  ∀ S, S ∉ H → ∃ M : Observation Prefix,
    Realizes prefixOf M S ∧ IsBadObservation prefixOf H M

/-- **Operational hyperliveness.**  Every finite observation that some system
realizes is also realized by a system satisfying `H`.-/
@[expose] public def IsHyperLivenessOp (H : Hyperproperty Trace) : Prop :=
  ∀ M : Observation Prefix, (∃ S, Realizes prefixOf M S) →
    ∃ S ∈ H, Realizes prefixOf M S

end

end AISafetyAtlas.Compositional.Hyperproperties
