module

public import Tengoku.ChoppedPlanePointIdeals.ChoppedPlane.EasyRange
public import Tengoku.Seed.RingTheory.MvPolynomial.Ideal

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

@[expose] public section

/-!
# Empty configurations and the degree-zero chop

For the empty configuration the actual point ideal is the unit ideal and its
degree chop is the corresponding power of the ideal of the variables. For a
nonempty configuration, degree zero has no nonzero equations, so its chop is
the zero ideal. These edge statements use the actual ideals and quotient maps.
-/
noncomputable section
namespace ChoppedPlane
open MvPolynomial Module
variable {K : Type*} [Field K]

/-- The ideal of the empty chart configuration is the unit ideal.
@isnad1 id=eq.0h2v.s7.540965f6ab7f from=translated src=- shape=906163d9 vocab=0e4681cd
-/
theorem pointIdeal_empty (a : PointCoordinates K 0) : pointIdeal K a = ⊤ := by
  simp [pointIdeal]

/-- Every form is an equation of the empty configuration.
@isnad1 id=eq.0h3v.s10.b94d82ef6592 from=translated src=- shape=5674872a vocab=197416c7
-/
theorem pointDegreePiece_empty (a : PointCoordinates K 0) (d : ℕ) :
    pointDegreePiece K a d = ⊤ := by
  ext f
  simp [mem_pointDegreePiece]

/-- Its degree equation space is exactly the entire homogeneous form space.
@isnad1 id=eq.0h3v.s6.b3c61d26df1a from=translated src=- shape=8f18ee90 vocab=e098e93a
-/
theorem pointDegreeSpace_empty (a : PointCoordinates K 0) (d : ℕ) :
    pointDegreeSpace K a d = Forms K 3 d := by
  rw [pointDegreeSpace, pointDegreePiece_empty, Submodule.map_top, Submodule.range_subtype]

/-- The ideal generated by all forms of degree `d` is exactly the `d`th power
of the ideal of the variables.
@isnad1 id=eq.0h3v.s8.a0ca739a8463 from=translated src=- shape=10403866 vocab=e501930d
-/
theorem idealSpan_forms_eq_idealOfVars_pow (n d : ℕ) :
    Ideal.span (Forms K n d : Set (Poly K n)) = idealOfVars (Fin n) K ^ d := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    intro f hf
    change f ∈ idealOfVars (Fin n) K ^ d
    rw [MvPolynomial.mem_pow_idealOfVars_iff]
    intro x hx
    have hdeg : x.degree = d := by
      have h := hf (MvPolynomial.mem_support_iff.mp hx)
      simpa only [Finsupp.degree_eq_weight_one, Pi.one_def] using h
    exact hdeg.ge
  · rw [MvPolynomial.pow_idealOfVars_eq_span]
    apply Ideal.span_le.mpr
    rintro f ⟨x, hx, rfl⟩
    apply Ideal.subset_span
    have hdeg : x.degree = d := hx
    exact MvPolynomial.isHomogeneous_monomial 1 hdeg

/-- The actual empty-configuration chop is the stated maximal-ideal power.
@isnad1 id=eq.0h3v.s8.9351906a74ee from=translated src=- shape=56615d6e vocab=0eba8c56
-/
theorem choppedIdeal_empty (a : PointCoordinates K 0) (d : ℕ) :
    choppedIdeal K a d = idealOfVars (Fin 3) K ^ d := by
  rw [choppedIdeal, pointDegreeSpace_empty, idealSpan_forms_eq_idealOfVars_pow]

/-- The empty point quotient has zero Hilbert function in every degree.
@isnad1 id=eq.0h3v.s5.cbbaa1043d1f from=translated src=- shape=8fe0d43c vocab=d18a20d9
-/
theorem pointHilbertFunction_empty (a : PointCoordinates K 0) (t : ℕ) :
    pointHilbertFunction K a t = 0 := by
  rw [pointHilbertFunction, Submodule.finrank_quotient, pointDegreePiece_empty]
  simp

/-- Every form of degree at least `d` belongs to the actual empty chop.
@isnad1 id=mem.1h5v.s9.c6e0c5cd70cf from=translated src=- shape=cb045b43 vocab=747de2de
-/
theorem form_mem_choppedIdeal_empty (a : PointCoordinates K 0)
    (d t : ℕ) (ht : d ≤ t) (f : Forms K 3 t) :
    f.val ∈ choppedIdeal K a d := by
  rw [choppedIdeal_empty, MvPolynomial.mem_pow_idealOfVars_iff]
  intro x hx
  have hdeg : x.degree = t := by
    have h := f.property (MvPolynomial.mem_support_iff.mp hx)
    simpa only [Finsupp.degree_eq_weight_one, Pi.one_def] using h
  omega

/-- The genuine empty-chop quotient vanishes in degrees at least `d`.
@isnad1 id=eq.1h4v.s5.9e21a988bffd from=translated src=- shape=9181121e vocab=8bb507f2
-/
theorem choppedHilbertFunction_empty_above (a : PointCoordinates K 0)
    (d t : ℕ) (ht : d ≤ t) : choppedHilbertFunction a d t = 0 := by
  have hz : formToRingQuotient t (pointDegreeSpace K a d) = 0 := by
    ext f
    change Ideal.Quotient.mk (choppedIdeal K a d) f.val = 0
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    exact form_mem_choppedIdeal_empty a d t ht f
  simp [choppedHilbertFunction, generatedHilbertFunction, hz]

/-- The complete actual Hilbert function of the empty-configuration chop.
@isnad1 id=eq.0h4v.s5.c55cde2cd37c from=translated src=- shape=21bd5860 vocab=b3f4f4b1
-/
theorem choppedHilbertFunction_empty (a : PointCoordinates K 0) (d t : ℕ) :
    choppedHilbertFunction a d t = if t < d then N t else 0 := by
  by_cases ht : t < d
  · simpa [ht, N] using choppedHilbertFunction_below_degree a ht
  · simpa [ht] using choppedHilbertFunction_empty_above a d t (by omega)

/-- The empty configuration satisfies the full positive-degree conclusion.
@isnad1 id=mainconc.1h3v.s5.763b4bde41b0 from=translated src=- shape=a71861c1 vocab=54f2e818
-/
theorem mainConclusion_empty (a : PointCoordinates K 0) (d : ℕ) (hd : 1 ≤ d) :
    MainConclusion K a d := by
  apply mainConclusion_of_small_point_count a hd (Nat.zero_le _)
  · intro i
    exact Fin.elim0 i
  · intro t
    simp only [pointHilbertFunction_empty, min_eq_right (Nat.zero_le _)]

/-- A constant principal open supplies the complete empty-configuration
conclusion in every positive chop degree.
@isnad1 id=genericc.1h2v.s4.169d46a45a25 from=translated src=- shape=e01d4933 vocab=9a90d212
-/
theorem genericChoppedConclusion_empty (d : ℕ) (hd : 1 ≤ d) :
    GenericChoppedConclusion K d 0 := by
  let a : PointCoordinates K 0 := fun i => Fin.elim0 i.1
  refine ⟨1, ⟨a, by simp⟩, ?_⟩
  intro b _
  exact mainConclusion_empty b d hd

/-- Evaluation on a nonempty configuration is injective on constants.
@isnad1 id=injectiv.1h3v.s11.27de8be5c340 from=translated src=- shape=7fe24f93 vocab=4c98f06d
-/
theorem pointEvaluation_zero_injective {p : ℕ} (a : PointCoordinates K p)
    (hp : 1 ≤ p) : Function.Injective (pointEvaluation K a 0) := by
  apply LinearMap.ker_eq_bot.mp
  apply le_antisymm
  · intro f hf
    change f = 0
    have hC : f.val = C (f.val.coeff 0) :=
      MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp
        (Nat.eq_zero_of_le_zero f.property.totalDegree_le)
    have hi : (0 : ℕ) < p := by omega
    have heval : eval (chartPoint K a ⟨0, hi⟩) f.val = 0 := by
      change f ∈ pointDegreePiece K a 0 at hf
      exact (mem_pointDegreePiece a f).mp hf ⟨0, hi⟩
    have hcoeff : f.val.coeff 0 = 0 := by
      rw [hC, MvPolynomial.eval_C] at heval
      exact heval
    apply Subtype.ext
    change f.val = 0
    rw [hC, hcoeff, map_zero]
  · exact bot_le

/-- A nonempty configuration has no nonzero degree-zero equation.
@isnad1 id=eq.1h3v.s7.54a37fd659bd from=translated src=- shape=26a75c95 vocab=4c583435
-/
theorem pointDegreeSpace_zero {p : ℕ} (a : PointCoordinates K p) (hp : 1 ≤ p) :
    pointDegreeSpace K a 0 = ⊥ := by
  simp [pointDegreeSpace, pointDegreePiece,
    LinearMap.ker_eq_bot.mpr (pointEvaluation_zero_injective a hp)]

/-- Its actual degree-zero chop is the zero ideal.
@isnad1 id=eq.1h3v.s7.a13046fdeebd from=translated src=- shape=cff6c9b8 vocab=dd2e5bdf
-/
theorem choppedIdeal_zero {p : ℕ} (a : PointCoordinates K p) (hp : 1 ≤ p) :
    choppedIdeal K a 0 = ⊥ :=
  choppedIdeal_eq_bot_of_injective a (pointEvaluation_zero_injective a hp)

/-- Its actual degree-zero chop quotient is the full polynomial ring in every degree.
@isnad1 id=eq.1h4v.s5.2541d404d341 from=translated src=- shape=5a594b4d vocab=b48e81cc
-/
theorem choppedHilbertFunction_zero {p : ℕ} (a : PointCoordinates K p)
    (hp : 1 ≤ p) (t : ℕ) : choppedHilbertFunction a 0 t = N t :=
  choppedHilbertFunction_of_injective a (pointEvaluation_zero_injective a hp) t

/-- The degree-zero edge has one genuine generic open for the usual point
Hilbert function and its actual zero chop, without using the positive-degree
main specification.
@isnad1 id=ex.1h2v.s9.25330b071597 from=translated src=- shape=160d165a vocab=c2b79395
-/
theorem generic_degree_zero_chop [CharZero K] (p : ℕ) (hp : 1 ≤ p) :
    ∃ D : MvPolynomial (Fin p × Fin 2) K,
      (∃ a, eval a D ≠ 0) ∧ ∀ a, eval a D ≠ 0 →
        DistinctPoints K a ∧
        (∀ t, pointHilbertFunction K a t = min (N t) p) ∧
        choppedIdeal K a 0 = ⊥ ∧
        (∀ t, choppedHilbertFunction a 0 t = N t) := by
  obtain ⟨D, hD, hgood⟩ := generic_pointHilbertFunction (K := K) p
  refine ⟨D, hD, ?_⟩
  intro a ha
  obtain ⟨hdist, hpoint⟩ := hgood a ha
  exact ⟨hdist, by simpa only [N] using hpoint,
    choppedIdeal_zero a hp, choppedHilbertFunction_zero a hp⟩

end ChoppedPlane
