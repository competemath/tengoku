module

public import Tengoku.ChoppedPlanePointIdeals.ChoppedPlane.GradedPresentation
public import Tengoku.ChoppedPlanePointIdeals.ChoppedPlane.Saturation
public import Tengoku.ChoppedPlanePointIdeals.ChoppedPlane.ColumnGradedPresentation
public import Tengoku.Seed.RingTheory.GradedAlgebra.Homogeneous.Ideal

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

@[expose] public section

/-! The determinantal ideals used in both Hilbert--Burch constructions are
homogeneous ideals of the actual polynomial ring. -/
noncomputable section
namespace ChoppedPlane
open MvPolynomial
attribute [local instance] MvPolynomial.gradedAlgebra
variable {K : Type*} [Field K] {n c : ℕ}

/-- An ideal generated by forms of possibly different degrees is homogeneous.-/
theorem ideal_span_homogeneous {ι : Type*} (f : ι → Poly K n) (δ : ι → ℕ)
    (hf : ∀ i, (f i).IsHomogeneous (δ i)) :
    (Ideal.span (Set.range f)).IsHomogeneous (homogeneousSubmodule (Fin n) K) := by
  apply Ideal.homogeneous_span
  rintro _ ⟨i, rfl⟩
  exact ⟨δ i, hf i⟩

/-- Row-homogeneous maximal minors generate a homogeneous ideal.-/
theorem cofactorIdeal_homogeneous_rows
    (B : Matrix (Fin (c + 1)) (Fin c) (Poly K n)) (δ : Fin (c + 1) → ℕ)
    (hB : ∀ i j, (B i j).IsHomogeneous (δ i)) :
    (cofactorIdeal B).IsHomogeneous (homogeneousSubmodule (Fin n) K) := by
  exact ideal_span_homogeneous (signedMaximalMinor B) (fun i => (∑ j, δ j) - δ i)
    (signedMaximalMinor_homogeneous_total B δ hB)

/-- Column-homogeneous maximal minors generate a homogeneous ideal.-/
theorem cofactorIdeal_homogeneous_columns
    (B : Matrix (Fin (c + 1)) (Fin c) (Poly K n)) (ε : Fin c → ℕ)
    (hB : ∀ i j, (B i j).IsHomogeneous (ε j)) :
    (cofactorIdeal B).IsHomogeneous (homogeneousSubmodule (Fin n) K) := by
  exact ideal_span_homogeneous (signedMaximalMinor B) (fun _ => ∑ j, ε j)
    (signedMaximalMinor_homogeneous_columns B ε hB)

end ChoppedPlane
