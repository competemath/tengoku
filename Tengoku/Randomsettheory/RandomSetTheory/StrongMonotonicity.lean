import Tengoku.Randomsettheory.RandomSetTheory.ZeroSetStability

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Strong monotonicity and set-valued zero-set stability

This file formalizes the deterministic argument behind the strong-monotonicity
proposition in Section 5 of the report.  In the just-identified case, every
admissible model `p` has a moment map from the same parameter space to the
ambient real Hilbert space.  Uniform strong monotonicity gives:

* uniqueness of the root attached to each model;
* exact identification of the zero set of the range-valued moment map;
* the uniform metric error bound with the same monotonicity constant.

The parameter space is represented by a subtype `Theta : Set E`.  Thus all
statements, including boundary-restricted parameter spaces, are intrinsic to
the actual domain of the estimating equations.
-/

open Set Metric
open scoped InnerProductSpace

noncomputable section

namespace RandomSetTheory

variable {P E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The set-valued population moment map obtained by ranging over all
admissible models.-/
def momentCorrespondence (Theta : Set E) (g : P → Theta → E) : Theta → Set E :=
  fun theta ↦ Set.range fun p ↦ g p theta

/-- The set of roots generated by the admissible models.-/
def designatedRootSet (Theta : Set E) (root : P → Theta) : Set Theta :=
  Set.range root

/-- Uniform strong monotonicity of a family of just-identified moment maps on
the common parameter domain `Theta`.-/
def UniformStrongMonotonicity (Theta : Set E) (kappa : ℝ)
    (g : P → Theta → E) : Prop :=
  ∀ (p : P) (theta theta' : Theta),
    kappa * ‖(theta : E) - (theta' : E)‖ ^ 2 ≤
      ⟪g p theta - g p theta', (theta : E) - (theta' : E)⟫_ℝ

/-- Strong monotonicity and a zero at `root p` force the norm of the moment
to dominate the distance to that root.-/
theorem norm_moment_ge_of_uniformStrongMonotonicity
    (Theta : Set E) {kappa : ℝ} (g : P → Theta → E) (root : P → Theta)
    (hmono : UniformStrongMonotonicity Theta kappa g)
    (hroot : ∀ p, g p (root p) = 0) (p : P) (theta : Theta) :
    kappa * ‖(theta : E) - (root p : E)‖ ≤ ‖g p theta‖ := by
  by_cases hzero : ‖(theta : E) - (root p : E)‖ = 0
  · simp [hzero]
  · have hdist : 0 < ‖(theta : E) - (root p : E)‖ :=
      lt_of_le_of_ne (norm_nonneg _) (Ne.symm hzero)
    have hmon := hmono p theta (root p)
    rw [hroot p, sub_zero] at hmon
    have hcauchy :
        ⟪g p theta, (theta : E) - (root p : E)⟫_ℝ ≤
          ‖g p theta‖ * ‖(theta : E) - (root p : E)‖ :=
      real_inner_le_norm _ _
    nlinarith

/-- For each admissible model, a root of a uniformly strongly monotone moment
map is unique on the parameter domain.-/
theorem root_unique_of_uniformStrongMonotonicity
    (Theta : Set E) {kappa : ℝ} (g : P → Theta → E) (root : P → Theta)
    (hkappa : 0 < kappa)
    (hmono : UniformStrongMonotonicity Theta kappa g)
    (hroot : ∀ p, g p (root p) = 0) {p : P} {theta : Theta}
    (htheta : g p theta = 0) :
    theta = root p := by
  have hbound := norm_moment_ge_of_uniformStrongMonotonicity
    Theta g root hmono hroot p theta
  rw [htheta, norm_zero] at hbound
  have hnorm : ‖(theta : E) - (root p : E)‖ = 0 := by
    nlinarith [norm_nonneg ((theta : E) - (root p : E))]
  apply Subtype.ext
  exact sub_eq_zero.mp (norm_eq_zero.mp hnorm)

/-- The exact zero set of the range-valued moment correspondence is precisely
the set of designated roots.-/
theorem setValuedZeroSet_momentCorrespondence_eq_designatedRootSet
    (Theta : Set E) {kappa : ℝ} (g : P → Theta → E) (root : P → Theta)
    (hkappa : 0 < kappa)
    (hmono : UniformStrongMonotonicity Theta kappa g)
    (hroot : ∀ p, g p (root p) = 0) :
    setValuedZeroSet (momentCorrespondence Theta g) =
      designatedRootSet Theta root := by
  ext theta
  constructor
  · rintro ⟨p, hp⟩
    exact ⟨p, root_unique_of_uniformStrongMonotonicity
      Theta g root hkappa hmono hroot hp |>.symm⟩
  · rintro ⟨p, rfl⟩
    exact ⟨p, hroot p⟩

/-- Uniform strong monotonicity yields the metric error bound relative to the
set of roots, with no loss in the constant.-/
theorem infDist_momentCorrespondence_ge_designatedRootSet
    (Theta : Set E) [Nonempty P] {kappa : ℝ}
    (g : P → Theta → E) (root : P → Theta)
    (hkappa : 0 < kappa)
    (hmono : UniformStrongMonotonicity Theta kappa g)
    (hroot : ∀ p, g p (root p) = 0) (theta : Theta) :
    kappa * infDist theta (designatedRootSet Theta root) ≤
      infDist 0 (momentCorrespondence Theta g theta) := by
  apply (Metric.le_infDist (Set.range_nonempty fun p ↦ g p theta)).2
  intro y hy
  obtain ⟨p, rfl⟩ := hy
  have hrootDist :
      infDist theta (designatedRootSet Theta root) ≤ dist theta (root p) :=
    infDist_le_dist_of_mem ⟨p, rfl⟩
  have hscaled :
      kappa * infDist theta (designatedRootSet Theta root) ≤
        kappa * dist theta (root p) :=
    mul_le_mul_of_nonneg_left hrootDist hkappa.le
  calc
    kappa * infDist theta (designatedRootSet Theta root)
        ≤ kappa * dist theta (root p) := hscaled
    _ = kappa * ‖(theta : E) - (root p : E)‖ := by
      simp only [Subtype.dist_eq, dist_eq_norm]
    _ ≤ ‖g p theta‖ :=
      norm_moment_ge_of_uniformStrongMonotonicity
        Theta g root hmono hroot p theta
    _ = dist 0 (g p theta) := by simp

/-- Form of the previous theorem stated directly with the exact zero set of
the set-valued moment map.  This is the hypothesis consumed by the oracle
enlarged-zero-set theorem in `ZeroSetStability`.-/
theorem uniformStrongMonotonicity_zeroSet_errorBound
    (Theta : Set E) [Nonempty P] {kappa : ℝ}
    (g : P → Theta → E) (root : P → Theta)
    (hkappa : 0 < kappa)
    (hmono : UniformStrongMonotonicity Theta kappa g)
    (hroot : ∀ p, g p (root p) = 0) (theta : Theta) :
    kappa * infDist theta
        (setValuedZeroSet (momentCorrespondence Theta g)) ≤
      infDist 0 (momentCorrespondence Theta g theta) := by
  rw [setValuedZeroSet_momentCorrespondence_eq_designatedRootSet
    Theta g root hkappa hmono hroot]
  exact infDist_momentCorrespondence_ge_designatedRootSet
    Theta g root hkappa hmono hroot theta

/-- Direct combination of uniform strong monotonicity with the oracle
enlarged-zero-set theorem.  This is the deterministic conclusion of the two
successive results in Section 5, with the same identification constant.-/
theorem hausdorffDist_enlarged_momentCorrespondence_le_of_uniformStrongMonotonicity
    (Theta : Set E) [Nonempty P] {kappa Delta : ℝ}
    (g : P → Theta → E) (root : P → Theta)
    (hkappa : 0 < kappa) (hDelta : 0 ≤ Delta)
    (hmono : UniformStrongMonotonicity Theta kappa g)
    (hroot : ∀ p, g p (root p) = 0)
    (Ghat : Theta → Set E)
    (hfin : ∀ theta,
      hausdorffEDist (Ghat theta) (momentCorrespondence Theta g theta) ≠ ⊤)
    (hhaus : ∀ theta,
      hausdorffDist (Ghat theta) (momentCorrespondence Theta g theta) ≤ Delta) :
    hausdorffDist (enlargedSetValuedZeroSet Ghat Delta)
        (designatedRootSet Theta root) ≤ 2 * Delta / kappa := by
  rw [← setValuedZeroSet_momentCorrespondence_eq_designatedRootSet
    Theta g root hkappa hmono hroot]
  exact hausdorffDist_enlargedSetValuedZeroSet_le Ghat
    (momentCorrespondence Theta g) hDelta hkappa hfin hhaus
    (uniformStrongMonotonicity_zeroSet_errorBound
      Theta g root hkappa hmono hroot)

end RandomSetTheory
