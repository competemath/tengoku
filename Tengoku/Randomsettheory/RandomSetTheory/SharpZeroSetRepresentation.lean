import Tengoku.Randomsettheory.RandomSetTheory.JointLawRepresentation
import Tengoku.Randomsettheory.RandomSetTheory.ZeroSetStability

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Sharp representations of parameterized zero sets

The sharp Aumann theorem identifies the moment attainable at each fixed
parameter.  This file records its parameterized zero-set consequence.

The observational target used here is the union of the roots generated by
all admissible kernels or compatible joint-law couplings.  No uniqueness of
the root of an individual law is imposed.  This is the exact formulation
which is equivalent to membership of zero in the Aumann moment set; a target
defined using only laws having a unique root requires a separate global
uniqueness assumption.
-/
namespace Tengoku.Randomsettheory end Tengoku.Randomsettheory open Tengoku.Randomsettheory
open MeasureTheory Set

noncomputable section

namespace RandomSetTheory

variable {O X H Theta : Type*} [MeasurableSpace O] [MeasurableSpace X]
  [NormedAddCommGroup H] [NormedSpace ℝ H]

/-- Parameters at which zero is attainable by an admissible conditional
kernel.  Equivalently, this is the union of the roots of the kernel-indexed
moment functions.-/
def kernelAttainableZeroSet (mu : Measure O) (S : O → Set X)
    (phi : Theta → O × X → H) : Set Theta :=
  {theta | 0 ∈ kernelAttainableMoments mu S (phi theta)}

/-- Parameters at which zero is attainable by a compatible joint-law
coupling on `O × X`.-/
def jointLawAttainableZeroSet (mu : Measure O) (S : O → Set X)
    (phi : Theta → O × X → H) : Set Theta :=
  {theta | 0 ∈ jointLawAttainableMoments mu S (phi theta)}

/-- The parameterized Aumann moment correspondence associated with a score
map and a feasible completion correspondence.-/
def aumannMomentMap (mu : Measure O) (S : O → Set X)
    (phi : Theta → O × X → H) (theta : Theta) : Set H :=
  aumannExpectation mu
    (fun o ↦ (fun x ↦ phi theta (o, x)) '' S o)

@[simp]
theorem mem_kernelAttainableZeroSet_iff
    {mu : Measure O} {S : O → Set X} {phi : Theta → O × X → H}
    {theta : Theta} :
    theta ∈ kernelAttainableZeroSet mu S phi ↔
      0 ∈ kernelAttainableMoments mu S (phi theta) :=
  Iff.rfl

@[simp]
theorem mem_jointLawAttainableZeroSet_iff
    {mu : Measure O} {S : O → Set X} {phi : Theta → O × X → H}
    {theta : Theta} :
    theta ∈ jointLawAttainableZeroSet mu S phi ↔
      0 ∈ jointLawAttainableMoments mu S (phi theta) :=
  Iff.rfl

/-- Disintegration identifies the zero sets generated by compatible joint
laws and supported conditional kernels, before any atomlessness assumption.-/
theorem jointLawAttainableZeroSet_eq_kernelAttainableZeroSet
    [StandardBorelSpace X] [Nonempty X]
    {mu : Measure O} [IsProbabilityMeasure mu]
    {S : O → Set X}
    (hgraph : MeasurableSet {p : O × X | p.2 ∈ S p.1})
    (hSmeas : ∀ o, MeasurableSet (S o))
    (phi : Theta → O × X → H) :
    jointLawAttainableZeroSet mu S phi =
      kernelAttainableZeroSet mu S phi := by
  ext theta
  change 0 ∈ jointLawAttainableMoments mu S (phi theta) ↔
    0 ∈ kernelAttainableMoments mu S (phi theta)
  rw [jointLawAttainableMoments_eq_kernelAttainableMoments hgraph hSmeas]

/-- **Sharp kernel zero-set representation on an atomless base.**

The union of all roots attainable by supported kernels is exactly the zero
set of the parameterized Aumann moment correspondence.  The assumptions are
uniformly quantified over the parameter, but the envelope itself may depend
on the parameter.-/
theorem kernelAttainableZeroSet_eq_setValuedZeroSet_aumann_of_atomless
    [MetricSpace X] [CompleteSpace X] [BorelSpace X]
    [SecondCountableTopology X] [Nonempty X]
    [CompleteSpace H] [MeasurableSpace H] [BorelSpace H]
    [SecondCountableTopology H] [FiniteDimensional ℝ H]
    {mu : Measure O} [IsFiniteMeasure mu]
    (hmu : IsAtomlessMeasure mu)
    {S : O → Set X} (hS : RandomSet.IsEffrosMeasurable S)
    (hSmeas : ∀ o, MeasurableSet (S o))
    (hcompact : ∀ o, IsCompact (S o)) (hne : ∀ o, (S o).Nonempty)
    (phi : Theta → O × X → H)
    (hphiMeas : ∀ theta, Measurable (phi theta))
    (hphiCont : ∀ theta o, Continuous fun x ↦ phi theta (o, x))
    (g : Theta → O → ℝ) (hg : ∀ theta, Integrable (g theta) mu)
    (hdom : ∀ theta o, ∀ x ∈ S o, ‖phi theta (o, x)‖ ≤ g theta o) :
    kernelAttainableZeroSet mu S phi =
      setValuedZeroSet (aumannMomentMap mu S phi) := by
  ext theta
  change 0 ∈ kernelAttainableMoments mu S (phi theta) ↔
    0 ∈ aumannExpectation mu
      (fun o ↦ (fun x ↦ phi theta (o, x)) '' S o)
  rw [kernelAttainableMoments_eq_aumannExpectation_of_atomless
    hmu hS hSmeas hcompact hne (hphiMeas theta)
      (hphiCont theta) (hg theta) (hdom theta)]

/-- **Sharp joint-law zero-set representation on an atomless observed law.**

Compatible couplings, supported conditional kernels, and the Aumann moment
correspondence all generate the same union of parameter roots.-/
theorem jointLawAttainableZeroSet_eq_setValuedZeroSet_aumann_of_atomless
    [MetricSpace X] [CompleteSpace X] [BorelSpace X]
    [SecondCountableTopology X] [Nonempty X]
    [CompleteSpace H] [MeasurableSpace H] [BorelSpace H]
    [SecondCountableTopology H] [FiniteDimensional ℝ H]
    {mu : Measure O} [IsProbabilityMeasure mu]
    (hmu : IsAtomlessMeasure mu)
    {S : O → Set X} (hS : RandomSet.IsEffrosMeasurable S)
    (hgraph : MeasurableSet {p : O × X | p.2 ∈ S p.1})
    (hSmeas : ∀ o, MeasurableSet (S o))
    (hcompact : ∀ o, IsCompact (S o)) (hne : ∀ o, (S o).Nonempty)
    (phi : Theta → O × X → H)
    (hphiMeas : ∀ theta, Measurable (phi theta))
    (hphiCont : ∀ theta o, Continuous fun x ↦ phi theta (o, x))
    (g : Theta → O → ℝ) (hg : ∀ theta, Integrable (g theta) mu)
    (hdom : ∀ theta o, ∀ x ∈ S o, ‖phi theta (o, x)‖ ≤ g theta o) :
    jointLawAttainableZeroSet mu S phi =
      setValuedZeroSet (aumannMomentMap mu S phi) := by
  rw [jointLawAttainableZeroSet_eq_kernelAttainableZeroSet
    hgraph hSmeas phi]
  exact kernelAttainableZeroSet_eq_setValuedZeroSet_aumann_of_atomless
    hmu hS hSmeas hcompact hne phi hphiMeas hphiCont g hg hdom

end RandomSetTheory
