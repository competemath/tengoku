import Tengoku.Randomsettheory.RandomSetTheory.AtomlessDivisibility

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Vector simple functions on exactly divisible spaces

Exact scalar divisibility can be applied independently on the finitely many
fibres of a vector-valued simple function.  Their union gives a single
measurable set carrying any prescribed proportion of the vector integral.

This is the simple-function core of finite-dimensional Lyapunov convexity on
an abstract base space.  It does not assert the additional compactness and
closure argument needed to pass from simple functions to every integrable
vector-valued function.
-/

open MeasureTheory Set
open scoped BigOperators

noncomputable section

namespace RandomSetTheory

namespace SimpleFunc

/-- A vector-valued simple function on an exactly divisible finite measure
space can be split exactly in any prescribed proportion.
@isnad1 id=ex.3h5v.s7.2c7243426b01 from=translated src=- shape=42e87a3c vocab=07615a6a
-/
theorem exists_setIntegral_eq_smul_of_exactDivisibility
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu) (f : SimpleFunc Omega E)
    {a : ℝ} (ha0 : 0 ≤ a) (ha1 : a ≤ 1) :
    ∃ A : Set Omega, MeasurableSet A ∧
      (∫ x in A, f x ∂mu) = a • ∫ x, f x ∂mu := by
  classical
  have hfiber : ∀ y : E, MeasurableSet (f ⁻¹' {y}) := fun y ↦
    f.measurableSet_fiber y
  have hexists : ∀ y : E, ∃ A : Set Omega,
      A ⊆ f ⁻¹' {y} ∧ MeasurableSet A ∧
        mu.real A = a * mu.real (f ⁻¹' {y}) := fun y ↦
    hmu (f ⁻¹' {y}) (hfiber y) ha0 ha1
  choose As hAs hAsmeas hAsmeasure using hexists
  let A : Set Omega := ⋃ y ∈ f.range, As y
  have hA : MeasurableSet A := by
    exact Finset.measurableSet_biUnion f.range fun y _ ↦ hAsmeas y
  have hinter : ∀ y ∈ f.range, f ⁻¹' {y} ∩ A = As y := by
    intro y hy
    apply Set.Subset.antisymm
    · intro x hx
      rcases Set.mem_iUnion.mp hx.2 with ⟨z, hxz⟩
      rcases Set.mem_iUnion.mp hxz with ⟨hz, hxAs⟩
      have hfxz : f x = z := hAs z hxAs
      have hfxy : f x = y := hx.1
      have hzy : z = y := hfxz.symm.trans hfxy
      simpa [hzy] using hxAs
    · intro x hx
      refine ⟨hAs y hx, ?_⟩
      exact Set.mem_iUnion_of_mem y (Set.mem_iUnion_of_mem hy hx)
  refine ⟨A, hA, ?_⟩
  rw [f.integral_eq_sum f.integrable_of_isFiniteMeasure.integrableOn,
    f.integral_eq_sum f.integrable_of_isFiniteMeasure]
  simp_rw [measureReal_restrict_apply (hfiber _)]
  have hsum :
      ∑ y ∈ f.range, mu.real (f ⁻¹' {y} ∩ A) • y =
        ∑ y ∈ f.range, (a * mu.real (f ⁻¹' {y})) • y := by
    apply Finset.sum_congr rfl
    intro y hy
    rw [hinter y hy, hAsmeasure y]
  rw [hsum, Finset.smul_sum]
  apply Finset.sum_congr rfl
  intro y hy
  rw [smul_smul]

/-- Lyapunov convexity for the vector measure generated by one simple
function.  This is stronger than proportional splitting alone: the range of
all its measurable set integrals is convex.
@isnad1 id=convex.1h4v.s7.f35a8244a4ab from=translated src=- shape=f39a2714 vocab=c0f4795c
-/
theorem convex_measurableSetIntegralRange_of_exactDivisibility
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu) (f : SimpleFunc Omega E) :
    Convex ℝ (measurableSetIntegralRange mu fun omega ↦ f omega) := by
  intro x hx y hy a b ha hb hab
  rcases hx with ⟨A, hA, rfl⟩
  rcases hy with ⟨B, hB, rfl⟩
  let p : SimpleFunc Omega E := f.piecewise A hA 0
  let q : SimpleFunc Omega E := f.piecewise B hB 0
  have hp : Integrable (fun omega ↦ p omega) mu :=
    p.integrable_of_isFiniteMeasure
  have hq : Integrable (fun omega ↦ q omega) mu :=
    q.integrable_of_isFiniteMeasure
  have hpq : Integrable (fun omega ↦ p omega - q omega) mu := hp.sub hq
  obtain ⟨D, hD, hsplitD⟩ :=
    exists_setIntegral_eq_smul_of_exactDivisibility mu hmu (p - q)
      ha (by linarith)
  let C : Set Omega := (D ∩ A) ∪ (Dᶜ ∩ B)
  have hC : MeasurableSet C := (hD.inter hA).union (hD.compl.inter hB)
  have hp_apply : ∀ omega, p omega = A.indicator (fun z ↦ f z) omega := by
    intro omega
    by_cases homega : omega ∈ A <;> simp [p, homega]
  have hq_apply : ∀ omega, q omega = B.indicator (fun z ↦ f z) omega := by
    intro omega
    by_cases homega : omega ∈ B <;> simp [q, homega]
  have hind : C.indicator (fun omega ↦ f omega) =
      fun omega ↦ q omega +
        D.indicator (fun z ↦ p z - q z) omega := by
    funext omega
    by_cases homegaD : omega ∈ D <;>
      by_cases homegaA : omega ∈ A <;>
      by_cases homegaB : omega ∈ B <;>
      simp [C, hp_apply, hq_apply, homegaD, homegaA, homegaB]
  have hpint : (∫ omega, p omega ∂mu) = ∫ omega in A, f omega ∂mu := by
    rw [← integral_indicator hA]
    apply integral_congr_ae
    exact Filter.Eventually.of_forall fun omega ↦ hp_apply omega
  have hqint : (∫ omega, q omega ∂mu) = ∫ omega in B, f omega ∂mu := by
    rw [← integral_indicator hB]
    apply integral_congr_ae
    exact Filter.Eventually.of_forall fun omega ↦ hq_apply omega
  have hsplitD' : (∫ omega in D, (p omega - q omega) ∂mu) =
      a • ∫ omega, (p omega - q omega) ∂mu := by
    simpa using hsplitD
  refine ⟨C, hC, ?_⟩
  calc
    (∫ omega in C, f omega ∂mu) =
        ∫ omega, C.indicator (fun z ↦ f z) omega ∂mu := by
      rw [integral_indicator hC]
    _ = (∫ omega, q omega ∂mu) +
        ∫ omega in D, (p omega - q omega) ∂mu := by
      rw [hind, integral_add hq
        (hpq.integrableOn.integrable_indicator hD), integral_indicator hD]
    _ = (∫ omega, q omega ∂mu) +
        a • ∫ omega, (p omega - q omega) ∂mu := by rw [hsplitD']
    _ = (∫ omega, q omega ∂mu) +
        a • ((∫ omega, p omega ∂mu) - ∫ omega, q omega ∂mu) := by
      rw [integral_sub hp hq]
    _ = a • (∫ omega, p omega ∂mu) +
        b • ∫ omega, q omega ∂mu := by
      have hb' : b = 1 - a := by linarith
      rw [hb']
      module
    _ = a • (∫ omega in A, f omega ∂mu) +
        b • ∫ omega in B, f omega ∂mu := by rw [hpint, hqint]

/-- Exact proportional splitting of a vector-valued simple function on every
finite atomless measurable space.
@isnad1 id=ex.3h5v.s7.c01a2ca6cd2c from=translated src=- shape=42e87a3c vocab=8e820327
-/
theorem exists_setIntegral_eq_smul_of_atomless
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : IsAtomlessMeasure mu)
    (f : SimpleFunc Omega E) {a : ℝ} (ha0 : 0 ≤ a) (ha1 : a ≤ 1) :
    ∃ A : Set Omega, MeasurableSet A ∧
      (∫ x in A, f x ∂mu) = a • ∫ x, f x ∂mu := by
  exact exists_setIntegral_eq_smul_of_exactDivisibility mu
    (hasExactDivisibility_of_atomless hmu) f ha0 ha1

/-- The raw vector-measure range of a simple function is convex on every
finite atomless measurable space.
@isnad1 id=convex.1h4v.s7.65ac1694a5e2 from=translated src=- shape=f39a2714 vocab=616b7d32
-/
theorem convex_measurableSetIntegralRange_of_atomless
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : IsAtomlessMeasure mu) (f : SimpleFunc Omega E) :
    Convex ℝ (measurableSetIntegralRange mu fun omega ↦ f omega) := by
  exact convex_measurableSetIntegralRange_of_exactDivisibility
    mu (hasExactDivisibility_of_atomless hmu) f

/-- Compatibility specialization on a base measurably equivalent to the
real Borel line.
@isnad1 id=ex.3h6v.s7.f523b387dbdf from=translated src=- shape=2a37d784 vocab=4def79c8
-/
theorem exists_setIntegral_eq_smul_of_atomless_measurableEquiv_real
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : IsAtomlessMeasure mu) (_e : Omega ≃ᵐ ℝ)
    (f : SimpleFunc Omega E) {a : ℝ} (ha0 : 0 ≤ a) (ha1 : a ≤ 1) :
    ∃ A : Set Omega, MeasurableSet A ∧
      (∫ x in A, f x ∂mu) = a • ∫ x, f x ∂mu := by
  exact exists_setIntegral_eq_smul_of_atomless mu hmu f ha0 ha1

end SimpleFunc

/-! ## The closure step for general integrable functions -/

/-- For a measurable integrable Banach-valued function, exact divisibility
produces measurable sets whose integrals converge to any prescribed
proportion of the total integral.  Simple-function approximation is in
`L¹`, and the error bound is uniform over the chosen measurable sets.

This proves membership in the *closure* of the vector-measure range.  Turning
the limit into one exact measurable set additionally requires closedness (or
compactness) of that range, the remaining hard step in full Lyapunov
convexity.
@isnad1 id=ex.5h5v.s8.9c8e7cae7794 from=translated src=- shape=6d124a20 vocab=6630620e
-/
theorem exists_measurableSet_setIntegral_tendsto_smul_of_exactDivisibility
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu) {f : Omega → E}
    (hf : Integrable f mu) (hfm : Measurable f)
    {a : ℝ} (ha0 : 0 ≤ a) (ha1 : a ≤ 1) :
    ∃ A : ℕ → Set Omega, (∀ n, MeasurableSet (A n)) ∧
      Filter.Tendsto (fun n ↦ ∫ omega in A n, f omega ∂mu)
        Filter.atTop (nhds (a • ∫ omega, f omega ∂mu)) := by
  classical
  let F : ℕ → SimpleFunc Omega E := fun n ↦
    SimpleFunc.approxOn f hfm (Set.range f ∪ {0}) 0 (by simp) n
  have hFint : ∀ n, Integrable (fun omega ↦ F n omega) mu := fun n ↦
    SimpleFunc.integrable_approxOn_range hfm hf n
  have hexists : ∀ n, ∃ A : Set Omega, MeasurableSet A ∧
      (∫ omega in A, F n omega ∂mu) =
        a • ∫ omega, F n omega ∂mu := fun n ↦
    SimpleFunc.exists_setIntegral_eq_smul_of_exactDivisibility
      mu hmu (F n) ha0 ha1
  choose A hA hsplit using hexists
  let err : ℕ → ℝ := fun n ↦ ∫ omega, ‖F n omega - f omega‖ ∂mu
  have herr : Filter.Tendsto err Filter.atTop (nhds 0) := by
    simpa only [err, F] using
      (MeasureTheory.tendsto_integral_norm_approxOn_sub hfm hf)
  have hfirst : ∀ n,
      ‖(∫ omega in A n, f omega ∂mu) -
          ∫ omega in A n, F n omega ∂mu‖ ≤ err n := by
    intro n
    calc
      ‖(∫ omega in A n, f omega ∂mu) -
          ∫ omega in A n, F n omega ∂mu‖ =
          ‖∫ omega in A n, (f omega - F n omega) ∂mu‖ := by
        rw [integral_sub hf.restrict (hFint n).restrict]
      _ ≤ ∫ omega in A n, ‖f omega - F n omega‖ ∂mu :=
        norm_integral_le_integral_norm _
      _ ≤ ∫ omega, ‖f omega - F n omega‖ ∂mu := by
        exact setIntegral_le_integral
          (hf.sub (hFint n)).norm
          (Filter.Eventually.of_forall fun omega ↦ norm_nonneg _)
      _ = err n := by
        apply integral_congr_ae
        exact Filter.Eventually.of_forall fun omega ↦ by
          simpa only using (norm_sub_rev (f omega) (F n omega))
  have hsecond : ∀ n,
      ‖(∫ omega, F n omega ∂mu) - ∫ omega, f omega ∂mu‖ ≤ err n := by
    intro n
    calc
      ‖(∫ omega, F n omega ∂mu) - ∫ omega, f omega ∂mu‖ =
          ‖∫ omega, (F n omega - f omega) ∂mu‖ := by
        rw [integral_sub (hFint n) hf]
      _ ≤ ∫ omega, ‖F n omega - f omega‖ ∂mu :=
        norm_integral_le_integral_norm _
      _ = err n := rfl
  have hbound : ∀ n,
      ‖(∫ omega in A n, f omega ∂mu) -
          a • ∫ omega, f omega ∂mu‖ ≤
        (1 + |a|) * err n := by
    intro n
    have hid :
        (∫ omega in A n, f omega ∂mu) -
            a • ∫ omega, f omega ∂mu =
          ((∫ omega in A n, f omega ∂mu) -
              ∫ omega in A n, F n omega ∂mu) +
            a • ((∫ omega, F n omega ∂mu) -
              ∫ omega, f omega ∂mu) := by
      rw [hsplit n]
      module
    rw [hid]
    calc
      ‖((∫ omega in A n, f omega ∂mu) -
            ∫ omega in A n, F n omega ∂mu) +
          a • ((∫ omega, F n omega ∂mu) -
            ∫ omega, f omega ∂mu)‖ ≤
          ‖(∫ omega in A n, f omega ∂mu) -
            ∫ omega in A n, F n omega ∂mu‖ +
          ‖a • ((∫ omega, F n omega ∂mu) -
            ∫ omega, f omega ∂mu)‖ := norm_add_le _ _
      _ = ‖(∫ omega in A n, f omega ∂mu) -
            ∫ omega in A n, F n omega ∂mu‖ +
          |a| * ‖(∫ omega, F n omega ∂mu) -
            ∫ omega, f omega ∂mu‖ := by
        rw [norm_smul, Real.norm_eq_abs]
      _ ≤ err n + |a| * err n :=
        add_le_add (hfirst n)
          (mul_le_mul_of_nonneg_left (hsecond n) (abs_nonneg a))
      _ = (1 + |a|) * err n := by ring
  have hupper : Filter.Tendsto (fun n ↦ (1 + |a|) * err n)
      Filter.atTop (nhds 0) := by
    simpa using (tendsto_const_nhds.mul herr :
      Filter.Tendsto (fun n ↦ (1 + |a|) * err n) Filter.atTop
        (nhds ((1 + |a|) * 0)))
  refine ⟨A, hA, tendsto_iff_norm_sub_tendsto_zero.mpr ?_⟩
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le
    tendsto_const_nhds hupper
    (fun n ↦ norm_nonneg _)
    hbound

/-- Version for an arbitrary integrable representative.  An a.e.-equal
measurable representative is used internally; all total and restricted
integrals are unchanged.
@isnad1 id=ex.4h5v.s8.60ba435ea1b7 from=translated src=- shape=2c353a9d vocab=3040da25
-/
theorem exists_measurableSet_setIntegral_tendsto_smul_of_exactDivisibility'
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu) {f : Omega → E}
    (hf : Integrable f mu) {a : ℝ} (ha0 : 0 ≤ a) (ha1 : a ≤ 1) :
    ∃ A : ℕ → Set Omega, (∀ n, MeasurableSet (A n)) ∧
      Filter.Tendsto (fun n ↦ ∫ omega in A n, f omega ∂mu)
        Filter.atTop (nhds (a • ∫ omega, f omega ∂mu)) := by
  let g : Omega → E := hf.aestronglyMeasurable.mk f
  have hfg : f =ᵐ[mu] g := hf.aestronglyMeasurable.ae_eq_mk
  have hg : Integrable g mu := hf.congr hfg
  have hgm : Measurable g := hf.aestronglyMeasurable.measurable_mk
  obtain ⟨A, hA, hlim⟩ :=
    exists_measurableSet_setIntegral_tendsto_smul_of_exactDivisibility
      mu hmu hg hgm ha0 ha1
  refine ⟨A, hA, ?_⟩
  have htotal : (∫ omega, f omega ∂mu) = ∫ omega, g omega ∂mu :=
    integral_congr_ae hfg
  rw [htotal]
  apply hlim.congr'
  exact Filter.Eventually.of_forall fun n ↦
    integral_congr_ae (ae_restrict_of_ae hfg.symm)

/-- Every proportional point of an integrable vector measure belongs to the
closure of its measurable set-integral range.
@isnad1 id=mem.4h5v.s7.0686e135177a from=translated src=- shape=a9adfe4b vocab=d1d5e9e4
-/
theorem smul_integral_mem_closure_measurableSetIntegralRange_of_exactDivisibility
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu) {f : Omega → E}
    (hf : Integrable f mu) {a : ℝ} (ha0 : 0 ≤ a) (ha1 : a ≤ 1) :
    a • ∫ omega, f omega ∂mu ∈
      closure (measurableSetIntegralRange mu f) := by
  obtain ⟨A, hA, hlim⟩ :=
    exists_measurableSet_setIntegral_tendsto_smul_of_exactDivisibility'
      mu hmu hf ha0 ha1
  exact mem_closure_of_tendsto hlim <|
    Filter.Eventually.of_forall fun n ↦ ⟨A n, hA n, rfl⟩

/-- **Approximate Lyapunov convexity.** Every convex combination of two
points in the measurable set-integral range belongs to the closure of that
range.  This is the full algebraic and approximation part of Lyapunov's
theorem, with no closedness hypothesis hidden in the statement.
@isnad1 id=mem.7h8v.s8.727faa420efe from=translated src=- shape=0e633a46 vocab=d486f8f7
-/
theorem combo_mem_closure_measurableSetIntegralRange_of_exactDivisibility
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu) {f : Omega → E}
    (hf : Integrable f mu) {x y : E}
    (hx : x ∈ measurableSetIntegralRange mu f)
    (hy : y ∈ measurableSetIntegralRange mu f)
    {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b = 1) :
    a • x + b • y ∈ closure (measurableSetIntegralRange mu f) := by
  rcases hx with ⟨A, hA, rfl⟩
  rcases hy with ⟨B, hB, rfl⟩
  let p : Omega → E := A.indicator f
  let q : Omega → E := B.indicator f
  let g : Omega → E := fun omega ↦ p omega - q omega
  have hp : Integrable p mu := hf.integrableOn.integrable_indicator hA
  have hq : Integrable q mu := hf.integrableOn.integrable_indicator hB
  have hg : Integrable g mu := hp.sub hq
  obtain ⟨D, hD, hlim⟩ :=
    exists_measurableSet_setIntegral_tendsto_smul_of_exactDivisibility'
      mu hmu hg ha (by linarith)
  let C : ℕ → Set Omega := fun n ↦ (D n ∩ A) ∪ ((D n)ᶜ ∩ B)
  have hC : ∀ n, MeasurableSet (C n) := fun n ↦
    ((hD n).inter hA).union ((hD n).compl.inter hB)
  have hind : ∀ n, (C n).indicator f =
      fun omega ↦ q omega + (D n).indicator g omega := by
    intro n
    funext omega
    by_cases homegaD : omega ∈ D n <;>
      by_cases homegaA : omega ∈ A <;>
      by_cases homegaB : omega ∈ B <;>
      simp [C, p, q, g, homegaD, homegaA, homegaB]
  have heq : ∀ n, (∫ omega in C n, f omega ∂mu) =
      (∫ omega, q omega ∂mu) + ∫ omega in D n, g omega ∂mu := by
    intro n
    calc
      (∫ omega in C n, f omega ∂mu) =
          ∫ omega, (C n).indicator f omega ∂mu := by
        rw [integral_indicator (hC n)]
      _ = (∫ omega, q omega ∂mu) +
          ∫ omega, (D n).indicator g omega ∂mu := by
        rw [hind n, integral_add hq
          (hg.integrableOn.integrable_indicator (hD n))]
      _ = (∫ omega, q omega ∂mu) +
          ∫ omega in D n, g omega ∂mu := by
        rw [integral_indicator (hD n)]
  have hseq : Filter.Tendsto (fun n ↦ ∫ omega in C n, f omega ∂mu)
      Filter.atTop
      (nhds ((∫ omega, q omega ∂mu) +
        a • ∫ omega, g omega ∂mu)) := by
    apply (tendsto_const_nhds.add hlim).congr'
    exact Filter.Eventually.of_forall fun n ↦ (heq n).symm
  have htarget : (∫ omega, q omega ∂mu) +
      a • ∫ omega, g omega ∂mu =
      a • (∫ omega in A, f omega ∂mu) +
        b • ∫ omega in B, f omega ∂mu := by
    calc
      (∫ omega, q omega ∂mu) +
          a • ∫ omega, g omega ∂mu =
          (∫ omega, q omega ∂mu) +
            a • ((∫ omega, p omega ∂mu) -
              ∫ omega, q omega ∂mu) := by
        rw [show (∫ omega, g omega ∂mu) =
          (∫ omega, p omega ∂mu) - ∫ omega, q omega ∂mu by
            exact integral_sub hp hq]
      _ = a • (∫ omega, p omega ∂mu) +
          b • ∫ omega, q omega ∂mu := by
        have hb' : b = 1 - a := by linarith
        rw [hb']
        module
      _ = a • (∫ omega in A, f omega ∂mu) +
          b • ∫ omega in B, f omega ∂mu := by
        rw [show (∫ omega, p omega ∂mu) =
            ∫ omega in A, f omega ∂mu by
              exact integral_indicator hA,
          show (∫ omega, q omega ∂mu) =
            ∫ omega in B, f omega ∂mu by
              exact integral_indicator hB]
  rw [htarget] at hseq
  exact mem_closure_of_tendsto hseq <|
    Filter.Eventually.of_forall fun n ↦ ⟨C n, hC n, rfl⟩

/-- Once the measurable set-integral range is known to be closed, exact
divisibility upgrades approximate Lyapunov convexity to genuine convexity.
@isnad1 id=convex.3h4v.s7.51b262c1ad75 from=translated src=- shape=b8e6f401 vocab=9087a0a3
-/
theorem convex_measurableSetIntegralRange_of_exactDivisibility_of_isClosed
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu) {f : Omega → E}
    (hf : Integrable f mu)
    (hclosed : IsClosed (measurableSetIntegralRange mu f)) :
    Convex ℝ (measurableSetIntegralRange mu f) := by
  intro x hx y hy a b ha hb hab
  have hcombo :=
    combo_mem_closure_measurableSetIntegralRange_of_exactDivisibility
      mu hmu hf hx hy ha hb hab
  rwa [hclosed.closure_eq] at hcombo

/-- Abstract full Lyapunov bridge: on an exactly divisible finite base,
closedness of all vector-measure ranges is the only additional input needed
for `HasLyapunovConvexity`.
@isnad1 id=haslyapu.2h3v.s6.7ee0d50f9834 from=translated src=- shape=ad8ca384 vocab=e2f5c06d
-/
theorem hasLyapunovConvexity_of_exactDivisibility_of_isClosedRange
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu)
    (hclosed : ∀ f : Omega → E, Integrable f mu →
      IsClosed (measurableSetIntegralRange mu f)) :
    HasLyapunovConvexity mu E := by
  intro f hf
  exact convex_measurableSetIntegralRange_of_exactDivisibility_of_isClosed
    mu hmu hf (hclosed f hf)

