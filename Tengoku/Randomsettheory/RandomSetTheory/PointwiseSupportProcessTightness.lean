import Tengoku.Randomsettheory.RandomSetTheory.FiniteDirectionalCLT
import Tengoku.Seed.MeasureTheory.Measure.LevyConvergence
import Tengoku.Seed.Topology.ContinuousMap.SecondCountableSpace

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Tightness plus finite-dimensional convergence for continuous processes

This file isolates the probability-theoretic bridge needed by the pointwise
random-set CLT.  On a compact metric index space, a law on `C(T, ℝ)` is
determined by the characteristic functions of finite linear combinations of
point evaluations.  Consequently, tightness of a family of process laws and
convergence of all those finite-dimensional characteristic functions imply
weak convergence in `C(T, ℝ)`.

The theorem does not assert tightness.  Establishing it for empirical support
processes from an `L²` envelope is the remaining analytic step (truncation,
Bernstein bounds, chaining, and Arzelà--Ascoli).  Keeping that premise explicit
pinpoints the part not currently supplied by Mathlib while avoiding the much
stronger premise that the whole process already converges.
-/

open Filter MeasureTheory ProbabilityTheory Real Set
open scoped Topology ProbabilityTheory

noncomputable section

namespace RandomSetTheory

variable (T : Type*) [MetricSpace T] [CompactSpace T]

/-- Continuous linear functionals on `C(T, ℝ)` generated by finitely many
point evaluations.  Elements of this space are precisely the linear
projections needed for finite-dimensional distributions.-/
def FiniteEvaluationDual : Submodule ℝ (StrongDual ℝ C(T, ℝ)) :=
  Submodule.span ℝ (Set.range fun t : T ↦ ContinuousMap.evalCLM ℝ t)

/-- The canonical pairing between a continuous path and a finite linear
combination of point evaluations.-/
def finiteEvaluationPairing :
    C(T, ℝ) →ₗ[ℝ] FiniteEvaluationDual T →ₗ[ℝ] ℝ where
  toFun f :=
    { toFun := fun w ↦ (w.1 : StrongDual ℝ C(T, ℝ)) f
      map_add' := fun _ _ ↦ by simp
      map_smul' := fun _ _ ↦ by simp }
  map_add' := fun _ _ ↦ by ext; simp
  map_smul' := fun _ _ ↦ by ext; simp

omit [CompactSpace T] in
@[simp]
theorem finiteEvaluationPairing_apply
    (f : C(T, ℝ)) (w : FiniteEvaluationDual T) :
    finiteEvaluationPairing T f w = (w.1 : StrongDual ℝ C(T, ℝ)) f := rfl

/-- Evaluation of a continuous path against a finite evaluation functional is
jointly continuous.-/
theorem continuous_finiteEvaluationPairing :
    Continuous fun p : C(T, ℝ) × FiniteEvaluationDual T ↦
      finiteEvaluationPairing T p.1 p.2 := by
  have hsub : Continuous fun p : C(T, ℝ) × FiniteEvaluationDual T ↦
      (p.2.1 : StrongDual ℝ C(T, ℝ)) :=
    continuous_subtype_val.comp continuous_snd
  have hp : Continuous fun p : C(T, ℝ) × FiniteEvaluationDual T ↦
      (p.1, (p.2.1 : StrongDual ℝ C(T, ℝ))) :=
    continuous_fst.prodMk hsub
  exact (isBoundedBilinearMap_apply (E := C(T, ℝ)) (F := ℝ)).symm.continuous.comp hp

omit [CompactSpace T] in
/-- Finite combinations of point evaluations separate continuous paths.-/
theorem finiteEvaluationPairing_ne_zero
    {f : C(T, ℝ)} (hf : f ≠ 0) : finiteEvaluationPairing T f ≠ 0 := by
  have hfun : (f : T → ℝ) ≠ 0 := by
    intro h
    apply hf
    ext t
    simpa using congrFun h t
  obtain ⟨t, ht⟩ := Function.ne_iff.mp hfun
  apply DFunLike.ne_iff.mpr
  let w : FiniteEvaluationDual T :=
    ⟨ContinuousMap.evalCLM ℝ t,
      Submodule.subset_span (Set.mem_range_self t)⟩
  exact ⟨w, by simpa [w] using ht⟩

section ProbabilityMeasures

variable [SecondCountableTopology T]
variable [MeasurableSpace C(T, ℝ)] [BorelSpace C(T, ℝ)]
variable {ι : Type*} {l : Filter ι}

section RandomProcesses

variable {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']
variable {μ : Measure Ω} {μ' : Measure Ω'}
variable [IsProbabilityMeasure μ] [IsProbabilityMeasure μ']

end RandomProcesses

end ProbabilityMeasures

end RandomSetTheory
