import Tengoku.Randomsettheory.RandomSetTheory.FiniteSupremumEfronStein
import Tengoku.Randomsettheory.RandomSetTheory.MartingaleFukNagaev

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Fuk--Nagaev concentration for finite process suprema

This file connects the canonical Doob differences of a finite process
supremum to the variance-sensitive martingale Fuk--Nagaev theorem.

The finite-class measurability, all `L^q` and `L^2` conditions, adaptation,
martingale centring and the final telescoping identity are discharged here
from a common envelope.  The only remaining probabilistic interfaces are:

* deterministic conditional second-moment bounds for the Doob differences;
* deterministic conditional `q`-moment bounds used for truncation bias;
* terminal measurability at the last filtration time.

`FiniteSupremumEfronStein` proves the coordinatewise ghost estimate which
supplies the second-moment bounds once a concrete product filtration is
identified with its revealed-past/current-coordinate representation.  That
global identification is deliberately not postulated here: it depends on the
chosen encoding of the product sample and filtration.
-/

open Real Set Finset MeasureTheory
open scoped BigOperators ProbabilityTheory ENNReal NNReal

noncomputable section

namespace ProbabilityTheory

variable {Omega T : Type*} {mOmega : MeasurableSpace Omega}
  {mu : Measure Omega}

/-- A common `L^p` envelope puts a measurable finite supremum in `L^p`.-/
theorem memLp_finiteProcessSupremum
    (s : Finset T) (hs : s.Nonempty) (X : T → Omega → ℝ)
    (A : Omega → ℝ) {p : ℝ≥0∞} (hA : MemLp A p mu)
    (hX : ∀ t ∈ s, Measurable (X t))
    (hdom : ∀ omega t, t ∈ s → |X t omega| ≤ |A omega|) :
    MemLp (finiteProcessSupremum s hs X) p mu := by
  apply hA.norm.mono'
    (measurable_finiteProcessSupremum s hs X hX).aestronglyMeasurable
  filter_upwards [] with omega
  simpa only [Real.norm_eq_abs, abs_abs] using
    abs_finiteProcessSupremum_le s hs X A hdom omega

variable (filtration : Filtration ℕ mOmega)

/-- Doob differences preserve every `L^p`, `1 ≤ p`, of the terminal
variable.-/
theorem memLp_doobCenteredDifference
    [IsFiniteMeasure mu] {p : ℝ≥0∞} (hp : 1 ≤ p)
    {F : Omega → ℝ} (hF : MemLp F p mu) (k : ℕ) :
    MemLp (doobCenteredDifference filtration mu F k) p mu := by
  cases k with
  | zero =>
      change MemLp
        (mu[F | filtration 0] - fun _ ↦ ∫ z, F z ∂mu) p mu
      exact (hF.condExp hp).sub (memLp_const _)
  | succ k =>
      change MemLp
        (mu[F | filtration (k + 1)] - mu[F | filtration k]) p mu
      exact (hF.condExp hp).sub (hF.condExp hp)

/-- A concrete revealed-past/current-coordinate representation of one Doob
difference transports the ghost Efron--Stein estimate to the corresponding
conditional second moment.

This lemma isolates the exact equality which a product-space encoding must
prove: the filtration at time `k` is generated by `P`, and the next Doob
difference agrees almost everywhere with the centred free-coordinate
supremum.  Once these equalities are supplied, the `L²` premise and the
conditional variance estimate are automatic.-/
theorem condExp_sq_doobCenteredDifference_succ_le_of_finiteReplaceOne
    {Z Beta : Type*} [MeasurableSpace Z] [MeasurableSpace Beta]
    [StandardBorelSpace Omega] [StandardBorelSpace Z] [Nonempty Z]
    [IsProbabilityMeasure mu]
    (F : Omega → ℝ) (hF2 : MemLp F 2 mu) (k : ℕ)
    (P : Omega → Beta) (Y : Omega → Z)
    (hPY : IndepFun P Y mu) (hP : Measurable P) (hY : Measurable Y)
    (hfiltration : filtration k = MeasurableSpace.comap P inferInstance)
    (s : Finset T) (hs : s.Nonempty)
    (r : Beta → T → ℝ) (X : Z → T → ℝ) (A : Z → ℝ)
    (hr : ∀ t, t ∈ s → Measurable (fun b ↦ r b t))
    (hX : ∀ t, t ∈ s → Measurable (fun z ↦ X z t))
    (hA : ∀ z, 0 ≤ A z)
    (hdom : ∀ z t, t ∈ s → |X z t| ≤ A z)
    (hA2 : MemLp A 2 (mu.map Y))
    (hrepresentation :
      doobCenteredDifference filtration mu F (k + 1) =ᵐ[mu]
        fun omega ↦
          finiteReplaceOneCenteredSupremum (mu.map Y) s hs r X
            (P omega, Y omega)) :
    ∀ᵐ omega ∂mu,
      mu[fun z ↦
        doobCenteredDifference filtration mu F (k + 1) z ^ 2 |
          filtration k] omega ≤
        2 * ∫ z, A z ^ 2 ∂(mu.map Y) := by
  let R : Omega → ℝ := fun omega ↦
    finiteReplaceOneCenteredSupremum (mu.map Y) s hs r X
      (P omega, Y omega)
  have hDoob2 : MemLp
      (doobCenteredDifference filtration mu F (k + 1)) 2 mu :=
    memLp_doobCenteredDifference filtration (by norm_num) hF2 (k + 1)
  have hR2 : MemLp R 2 mu :=
    (memLp_congr_ae hrepresentation).1 hDoob2
  have hghost := condExp_sq_finiteReplaceOneCenteredSupremum_le
    P Y hPY hP hY s hs r X A hr hX hA hdom hA2 hR2
  have hsquare :
      (fun z ↦ doobCenteredDifference filtration mu F (k + 1) z ^ 2)
        =ᵐ[mu] fun z ↦ R z ^ 2 := by
    filter_upwards [hrepresentation] with omega homega
    rw [homega]
  have hcondCongr := condExp_congr_ae (m := filtration k) hsquare
  rw [hfiltration] at hcondCongr ⊢
  filter_upwards [hcondCongr, hghost] with omega hcongrOmega hghostOmega
  exact hcongrOmega.trans_le hghostOmega

end ProbabilityTheory
