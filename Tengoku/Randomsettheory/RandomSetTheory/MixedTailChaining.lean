import Tengoku.Randomsettheory.RandomSetTheory.FiniteChaining
import Tengoku.Randomsettheory.RandomSetTheory.BernsteinConcentration

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Finite chaining with mixed Bernstein tails

This file combines the deterministic telescoping and finite union bound from
`FiniteChaining` with the scalar mixed-tail inequality furnished by
`HasBernsteinMGF`.  Every adjacent-net pair may have its own variance and
scale proxies.  A second theorem bounds those pairwise proxies by levelwise
envelopes and obtains the familiar threshold

`sqrt (2 * V k * x k) + 2 * B k * x k`.

The final metric form uses two increment controls `d2` and `d1`, corresponding
respectively to the square-root and linear parts of a Bernstein tail.  All
results are finite: the probability cost is the explicit union bound over the
coarsest net and all adjacent pairs of finite nets.  No infinite chaining,
entropy integral, separability argument, or Dirksen/Dudley theorem is claimed.
-/

open Real Set Finset MeasureTheory
open scoped BigOperators ProbabilityTheory ENNReal NNReal

noncomputable section

namespace ProbabilityTheory

variable {Omega T : Type*} [MeasurableSpace Omega] {mu : Measure Omega}

/-- The square-root plus linear threshold associated with a Bernstein MGF
bound.  It is defined over the reals so that it can also be used with
deterministic upper envelopes of the nonnegative MGF proxies.-/
def bernsteinMixedThreshold (v b x : ℝ) : ℝ :=
  Real.sqrt (2 * v * x) + 2 * b * x

/--
@isnad1 id=eq.0h2v.s4.2305af77f9b6 from=translated src=- shape=9bf57cd7 vocab=9e81c491
-/
@[simp] theorem bernsteinMixedThreshold_zero_confidence (v b : ℝ) :
    bernsteinMixedThreshold v b 0 = 0 := by
  simp [bernsteinMixedThreshold]

/-- A Bernstein mixed-tail threshold is nonnegative for nonnegative
parameters.
@isnad1 id=le.2h3v.s5.3515c4fb51a8 from=translated src=- shape=f22e4838 vocab=d7a10d85
-/
theorem bernsteinMixedThreshold_nonneg {v b x : ℝ}
    (hb : 0 ≤ b) (hx : 0 ≤ x) :
    0 ≤ bernsteinMixedThreshold v b x := by
  unfold bernsteinMixedThreshold
  positivity

/-- Monotonicity of the mixed-tail threshold in both MGF proxies.
@isnad1 id=le.3h5v.s5.35797a19fcf5 from=translated src=- shape=e3ef708f vocab=d7a10d85
-/
theorem bernsteinMixedThreshold_mono {v v' b b' x : ℝ}
    (hv : v ≤ v') (hb : b ≤ b') (hx : 0 ≤ x) :
    bernsteinMixedThreshold v b x ≤
      bernsteinMixedThreshold v' b' x := by
  unfold bernsteinMixedThreshold
  have hvar : 2 * v * x ≤ 2 * v' * x := by
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hv (by norm_num)) hx
  have hsqrt : Real.sqrt (2 * v * x) ≤ Real.sqrt (2 * v' * x) :=
    Real.sqrt_le_sqrt hvar
  have hscale : 2 * b * x ≤ 2 * b' * x := by
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hb (by norm_num)) hx
  exact add_le_add hsqrt hscale

/-- Strict-event version of the confidence-parameter Bernstein inequality.
It is useful for the open upper-tail events in `FiniteChaining`.
@isnad1 id=le.3h6v.s6.446ae75d1951 from=translated src=- shape=3c110178 vocab=dc78d2ae
-/
theorem HasBernsteinMGF.measureReal_abs_gt_mixedThreshold_le
    [IsProbabilityMeasure mu]
    {X : Omega → ℝ} {v b : ℝ≥0}
    (hX : HasBernsteinMGF X v b mu)
    {x : ℝ} (hx : 0 ≤ x) (hv : 0 < (v : ℝ)) :
    mu.real {omega |
        bernsteinMixedThreshold (v : ℝ) (b : ℝ) x < |X omega|} ≤
      2 * exp (-x) := by
  refine (measureReal_mono ?_).trans
    (hX.measure_abs_ge_sqrt_add_le hx hv)
  intro omega homega
  change bernsteinMixedThreshold (v : ℝ) (b : ℝ) x < |X omega| at homega
  change Real.sqrt (2 * (v : ℝ) * x) + 2 * (b : ℝ) * x ≤ |X omega|
  exact homega.le

/-- The bad-increment event associated with a finite graph of admissible
edges at every chaining level.  Restricting the union to actual chaining
edges, rather than the full product of adjacent nets, is what preserves the
small scale of the increments.-/
def finiteChainingEdgeEvent (Z : Omega → T → ℝ)
    (edges : ℕ → Finset (T × T)) (threshold : ℕ → ℝ) (m : ℕ) : Set Omega :=
  ⋃ k ∈ Finset.range m, ⋃ e ∈ edges k,
    {omega | threshold k < |Z omega e.1 - Z omega e.2|}

/-- The local edge graph generated by assigning every point of the finer net
`N (k+1)` a parent in the preceding level.-/
def finiteChainingParentEdges (N : ℕ → Finset T)
    (parent : ℕ → T → T) (k : ℕ) : Finset (T × T) := by
  classical
  exact (N (k + 1)).image fun u ↦ (u, parent k u)

/-- Every fine-net point is joined to its assigned parent.
@isnad1 id=mem.1h5v.s6.efb29d9898b0 from=translated src=- shape=550d86fa vocab=2d1a811c
-/
theorem pair_mem_finiteChainingParentEdges
    (N : ℕ → Finset T) (parent : ℕ → T → T)
    {k : ℕ} {u : T} (hu : u ∈ N (k + 1)) :
    (u, parent k u) ∈ finiteChainingParentEdges N parent k := by
  classical
  exact Finset.mem_image.2 ⟨u, hu, rfl⟩

/-- A parent graph has no more edges than fine-net points.
@isnad1 id=le.0h4v.s5.20eccf9376e5 from=translated src=- shape=1e873903 vocab=9b734c6c
-/
theorem card_finiteChainingParentEdges_le
    (N : ℕ → Finset T) (parent : ℕ → T → T) (k : ℕ) :
    (finiteChainingParentEdges N parent k).card ≤ (N (k + 1)).card := by
  classical
  exact Finset.card_image_le

/-- Coherent projections traverse the graph generated by their parent map.
@isnad1 id=mem.3h7v.s7.e7683745357e from=translated src=- shape=f85eac03 vocab=587884ca
-/
theorem finiteChainingParentEdges_contains_projection
    (N : ℕ → Finset T) (parent proj : ℕ → T → T) (m : ℕ)
    (hfine : ∀ k ∈ Finset.range m, ∀ t, proj (k + 1) t ∈ N (k + 1))
    (hcoherent : ∀ k ∈ Finset.range m, ∀ t,
      parent k (proj (k + 1) t) = proj k t) :
    ∀ k ∈ Finset.range m, ∀ t,
      (proj (k + 1) t, proj k t) ∈
        finiteChainingParentEdges N parent k := by
  intro k hk t
  rw [← hcoherent k hk t]
  exact pair_mem_finiteChainingParentEdges N parent (hfine k hk t)

omit [MeasurableSpace Omega] in
/-- Deterministic chaining inclusion for a prescribed finite edge graph.
Every adjacent pair selected by `proj` must occur in the graph of its level.
Unlike the full-product formulation in `FiniteChaining`, this permits local
increment bounds that decay with the resolution.
@isnad1 id=le.3h10v.s7.9c0bf1a89b51 from=translated src=- shape=e9ee3bbd vocab=8c982f7d
-/
theorem finiteChaining_largeDeviation_subset_edges
    (Z : Omega → T → ℝ) (N0 : Finset T)
    (edges : ℕ → Finset (T × T)) (proj : ℕ → T → T)
    (threshold : ℕ → ℝ) (baseThreshold remainder : ℝ) (m : ℕ)
    (hbase : ∀ t, proj 0 t ∈ N0)
    (hedge : ∀ k ∈ Finset.range m, ∀ t,
      (proj (k + 1) t, proj k t) ∈ edges k)
    (hrem : ∀ omega t,
      |Z omega t - Z omega (proj m t)| ≤ remainder) :
    {omega | ∃ t,
        baseThreshold + (∑ k ∈ Finset.range m, threshold k) + remainder <
          |Z omega t|} ⊆
      finiteChainingBaseEvent Z N0 baseThreshold ∪
        finiteChainingEdgeEvent Z edges threshold m := by
  classical
  intro omega homega
  obtain ⟨t, ht⟩ := homega
  by_cases hbaseBad : omega ∈ finiteChainingBaseEvent Z N0 baseThreshold
  · exact Or.inl hbaseBad
  right
  by_contra hedgeBad
  have hbase_le : |Z omega (proj 0 t)| ≤ baseThreshold := by
    by_contra hbad
    apply hbaseBad
    refine Set.mem_iUnion.2 ⟨proj 0 t, Set.mem_iUnion.2 ⟨hbase t, ?_⟩⟩
    exact lt_of_not_ge hbad
  have hedge_le : ∀ k ∈ Finset.range m,
      |Z omega (proj (k + 1) t) - Z omega (proj k t)| ≤ threshold k := by
    intro k hk
    by_contra hbad
    apply hedgeBad
    refine Set.mem_iUnion.2 ⟨k, Set.mem_iUnion.2 ⟨hk,
      Set.mem_iUnion.2 ⟨(proj (k + 1) t, proj k t),
        Set.mem_iUnion.2 ⟨hedge k hk t, ?_⟩⟩⟩⟩
    exact lt_of_not_ge hbad
  have hchain := abs_process_le_finiteChainingSum Z proj m omega t
  have hsum :
      (∑ k ∈ Finset.range m,
        |Z omega (proj (k + 1) t) - Z omega (proj k t)|) ≤
      ∑ k ∈ Finset.range m, threshold k :=
    Finset.sum_le_sum hedge_le
  have htotal : |Z omega t| ≤
      baseThreshold + (∑ k ∈ Finset.range m, threshold k) + remainder :=
    hchain.trans (add_le_add (add_le_add hbase_le hsum) (hrem omega t))
  exact (not_lt_of_ge htotal) ht

/-- Finite chaining over an explicit edge graph with arbitrary scalar tail
bounds.  The entropy cost at level `k` is exactly `card (edges k)`, not the
cardinality of the full product of adjacent nets.
@isnad1 id=le.5h13v.s8.40d8d94edb5c from=translated src=- shape=0b3c8939 vocab=edbc963c
-/
theorem measureReal_finiteChaining_edges_largeDeviation_le
    [IsFiniteMeasure mu]
    (Z : Omega → T → ℝ) (N0 : Finset T)
    (edges : ℕ → Finset (T × T)) (proj : ℕ → T → T)
    (threshold delta : ℕ → ℝ)
    (baseThreshold remainder delta0 : ℝ) (m : ℕ)
    (hbase : ∀ t, proj 0 t ∈ N0)
    (hedge : ∀ k ∈ Finset.range m, ∀ t,
      (proj (k + 1) t, proj k t) ∈ edges k)
    (hrem : ∀ omega t,
      |Z omega t - Z omega (proj m t)| ≤ remainder)
    (hbaseTail : ∀ u ∈ N0,
      mu.real {omega | baseThreshold < |Z omega u|} ≤ delta0)
    (hedgeTail : ∀ k ∈ Finset.range m, ∀ e ∈ edges k,
      mu.real {omega | threshold k < |Z omega e.1 - Z omega e.2|} ≤
        delta k) :
    mu.real {omega | ∃ t,
        baseThreshold + (∑ k ∈ Finset.range m, threshold k) + remainder <
          |Z omega t|} ≤
      N0.card * delta0 +
        ∑ k ∈ Finset.range m, (edges k).card * delta k := by
  classical
  let Base : Set Omega := finiteChainingBaseEvent Z N0 baseThreshold
  let Incr : Set Omega := finiteChainingEdgeEvent Z edges threshold m
  have hsubset :
      {omega | ∃ t,
          baseThreshold + (∑ k ∈ Finset.range m, threshold k) + remainder <
            |Z omega t|} ⊆ Base ∪ Incr := by
    simpa only [Base, Incr] using
      finiteChaining_largeDeviation_subset_edges Z N0 edges proj threshold
        baseThreshold remainder m hbase hedge hrem
  have hBase : mu.real Base ≤ N0.card * delta0 := by
    calc
      mu.real Base ≤
          ∑ u ∈ N0, mu.real {omega | baseThreshold < |Z omega u|} := by
        simpa only [Base, finiteChainingBaseEvent] using
          (measureReal_biUnion_finset_le (μ := mu) N0
            (fun u ↦ {omega | baseThreshold < |Z omega u|}))
      _ ≤ ∑ _u ∈ N0, delta0 := Finset.sum_le_sum hbaseTail
      _ = N0.card * delta0 := by
        simp only [Finset.sum_const, nsmul_eq_mul]
  have hLevel : ∀ k ∈ Finset.range m,
      mu.real (⋃ e ∈ edges k,
          {omega | threshold k < |Z omega e.1 - Z omega e.2|}) ≤
        (edges k).card * delta k := by
    intro k hk
    calc
      mu.real (⋃ e ∈ edges k,
          {omega | threshold k < |Z omega e.1 - Z omega e.2|}) ≤
          ∑ e ∈ edges k,
            mu.real {omega | threshold k < |Z omega e.1 - Z omega e.2|} :=
        measureReal_biUnion_finset_le (edges k) _
      _ ≤ ∑ _e ∈ edges k, delta k :=
        Finset.sum_le_sum fun e he ↦ hedgeTail k hk e he
      _ = (edges k).card * delta k := by
        simp only [Finset.sum_const, nsmul_eq_mul]
  have hIncr : mu.real Incr ≤
      ∑ k ∈ Finset.range m, (edges k).card * delta k := by
    calc
      mu.real Incr ≤
          ∑ k ∈ Finset.range m,
            mu.real (⋃ e ∈ edges k,
              {omega | threshold k < |Z omega e.1 - Z omega e.2|}) := by
        simpa only [Incr, finiteChainingEdgeEvent] using
          (measureReal_biUnion_finset_le (μ := mu) (Finset.range m)
            (fun k ↦ ⋃ e ∈ edges k,
              {omega | threshold k < |Z omega e.1 - Z omega e.2|}))
      _ ≤ ∑ k ∈ Finset.range m, (edges k).card * delta k :=
        Finset.sum_le_sum hLevel
  calc
    mu.real {omega | ∃ t,
        baseThreshold + (∑ k ∈ Finset.range m, threshold k) + remainder <
          |Z omega t|} ≤ mu.real (Base ∪ Incr) := measureReal_mono hsubset
    _ ≤ mu.real Base + mu.real Incr := measureReal_union_le Base Incr
    _ ≤ N0.card * delta0 +
        ∑ k ∈ Finset.range m, (edges k).card * delta k :=
      add_le_add hBase hIncr

/-- Finite mixed-tail chaining with genuinely pair-dependent Bernstein
proxies.  The deterministic thresholds `baseThreshold` and `edgeThreshold k`
only need to dominate the canonical Bernstein threshold of every base point
or adjacent-net pair.  Thus the MGF proxies may vary with both endpoints,
while the confidence budget `x k` is allocated level by level.

No independence between different net-point increments is required: the
proof only uses their individual Bernstein certificates and a finite union
bound.
@isnad1 id=le.10h16v.s9.393f3f2ee576 from=translated src=- shape=141e768f vocab=0a119aa1
-/
theorem measureReal_finiteChaining_largeDeviation_le_of_bernstein_pairwise
    [IsProbabilityMeasure mu]
    (Z : Omega → T → ℝ) (N : ℕ → Finset T)
    (proj : ℕ → T → T) (edgeThreshold : ℕ → ℝ)
    (baseVariance baseScale : T → ℝ≥0)
    (edgeVariance edgeScale : ℕ → T → T → ℝ≥0)
    (x : ℕ → ℝ) (baseThreshold remainder x0 : ℝ) (m : ℕ)
    (hproj : ∀ k, k ≤ m → ∀ t, proj k t ∈ N k)
    (hrem : ∀ omega t,
      |Z omega t - Z omega (proj m t)| ≤ remainder)
    (hx0 : 0 ≤ x0) (hx : ∀ k ∈ Finset.range m, 0 ≤ x k)
    (hbaseVariance : ∀ u ∈ N 0, 0 < (baseVariance u : ℝ))
    (hedgeVariance : ∀ k ∈ Finset.range m, ∀ u ∈ N (k + 1),
      ∀ v ∈ N k, 0 < (edgeVariance k u v : ℝ))
    (hbaseThreshold : ∀ u ∈ N 0,
      bernsteinMixedThreshold (baseVariance u : ℝ)
          (baseScale u : ℝ) x0 ≤ baseThreshold)
    (hedgeThreshold : ∀ k ∈ Finset.range m, ∀ u ∈ N (k + 1),
      ∀ v ∈ N k,
        bernsteinMixedThreshold (edgeVariance k u v : ℝ)
            (edgeScale k u v : ℝ) (x k) ≤ edgeThreshold k)
    (hbaseBernstein : ∀ u ∈ N 0,
      HasBernsteinMGF (fun omega ↦ Z omega u)
        (baseVariance u) (baseScale u) mu)
    (hedgeBernstein : ∀ k ∈ Finset.range m, ∀ u ∈ N (k + 1),
      ∀ v ∈ N k,
        HasBernsteinMGF (fun omega ↦ Z omega u - Z omega v)
          (edgeVariance k u v) (edgeScale k u v) mu) :
    mu.real {omega | ∃ t,
        baseThreshold +
            (∑ k ∈ Finset.range m, edgeThreshold k) + remainder <
          |Z omega t|} ≤
      (N 0).card * (2 * exp (-x0)) +
        ∑ k ∈ Finset.range m,
          ((N (k + 1)).card * (N k).card : ℕ) *
            (2 * exp (-x k)) := by
  apply measureReal_finiteChaining_largeDeviation_le
    Z N proj edgeThreshold (fun k ↦ 2 * exp (-x k))
      baseThreshold remainder (2 * exp (-x0)) m hproj hrem
  · intro u hu
    have htail := (hbaseBernstein u hu).measureReal_abs_gt_mixedThreshold_le
      hx0 (hbaseVariance u hu)
    exact (measureReal_mono (by
      intro omega homega
      exact lt_of_le_of_lt (hbaseThreshold u hu) homega)).trans htail
  · intro k hk u hu v hv
    have htail :=
      (hedgeBernstein k hk u hu v hv).measureReal_abs_gt_mixedThreshold_le
        (hx k hk) (hedgeVariance k hk u hu v hv)
    exact (measureReal_mono (by
      intro omega homega
      exact lt_of_le_of_lt (hedgeThreshold k hk u hu v hv) homega)).trans htail

/-- Levelwise-envelope form of finite Bernstein chaining.  Although the
displayed threshold only contains `V k` and `B k`, the hypotheses retain
pair-dependent MGF proxies and merely ask that they be bounded by those
levelwise envelopes.
@isnad1 id=le.12h18v.s9.e81aa76ce16c from=translated src=- shape=5bf302d1 vocab=0a119aa1
-/
theorem measureReal_finiteChaining_largeDeviation_le_of_bernstein
    [IsProbabilityMeasure mu]
    (Z : Omega → T → ℝ) (N : ℕ → Finset T)
    (proj : ℕ → T → T)
    (baseVariance baseScale : T → ℝ≥0)
    (edgeVariance edgeScale : ℕ → T → T → ℝ≥0)
    (V B : ℕ → ℝ≥0) (V0 B0 : ℝ≥0)
    (x : ℕ → ℝ) (x0 remainder : ℝ) (m : ℕ)
    (hproj : ∀ k, k ≤ m → ∀ t, proj k t ∈ N k)
    (hrem : ∀ omega t,
      |Z omega t - Z omega (proj m t)| ≤ remainder)
    (hx0 : 0 ≤ x0) (hx : ∀ k ∈ Finset.range m, 0 ≤ x k)
    (hbaseVariance : ∀ u ∈ N 0, 0 < (baseVariance u : ℝ))
    (hedgeVariance : ∀ k ∈ Finset.range m, ∀ u ∈ N (k + 1),
      ∀ v ∈ N k, 0 < (edgeVariance k u v : ℝ))
    (hbaseVariance_le : ∀ u ∈ N 0, baseVariance u ≤ V0)
    (hbaseScale_le : ∀ u ∈ N 0, baseScale u ≤ B0)
    (hedgeVariance_le : ∀ k ∈ Finset.range m, ∀ u ∈ N (k + 1),
      ∀ v ∈ N k, edgeVariance k u v ≤ V k)
    (hedgeScale_le : ∀ k ∈ Finset.range m, ∀ u ∈ N (k + 1),
      ∀ v ∈ N k, edgeScale k u v ≤ B k)
    (hbaseBernstein : ∀ u ∈ N 0,
      HasBernsteinMGF (fun omega ↦ Z omega u)
        (baseVariance u) (baseScale u) mu)
    (hedgeBernstein : ∀ k ∈ Finset.range m, ∀ u ∈ N (k + 1),
      ∀ v ∈ N k,
        HasBernsteinMGF (fun omega ↦ Z omega u - Z omega v)
          (edgeVariance k u v) (edgeScale k u v) mu) :
    mu.real {omega | ∃ t,
        bernsteinMixedThreshold (V0 : ℝ) (B0 : ℝ) x0 +
            (∑ k ∈ Finset.range m,
              bernsteinMixedThreshold (V k : ℝ) (B k : ℝ) (x k)) +
            remainder < |Z omega t|} ≤
      (N 0).card * (2 * exp (-x0)) +
        ∑ k ∈ Finset.range m,
          ((N (k + 1)).card * (N k).card : ℕ) *
            (2 * exp (-x k)) := by
  apply measureReal_finiteChaining_largeDeviation_le_of_bernstein_pairwise
    Z N proj
      (fun k ↦ bernsteinMixedThreshold (V k : ℝ) (B k : ℝ) (x k))
      baseVariance baseScale edgeVariance edgeScale x
      (bernsteinMixedThreshold (V0 : ℝ) (B0 : ℝ) x0)
      remainder x0 m hproj hrem hx0 hx hbaseVariance hedgeVariance
  · intro u hu
    apply bernsteinMixedThreshold_mono
    · exact_mod_cast hbaseVariance_le u hu
    · exact_mod_cast hbaseScale_le u hu
    · exact hx0
  · intro k hk u hu v hv
    apply bernsteinMixedThreshold_mono
    · exact_mod_cast hedgeVariance_le k hk u hu v hv
    · exact_mod_cast hedgeScale_le k hk u hu v hv
    · exact hx k hk
  · exact hbaseBernstein
  · exact hedgeBernstein

/-- Edge-graph version of levelwise-envelope Bernstein chaining.  This is the
genuine finite multiscale result: only the edges actually traversed by the
chosen projections are charged, and the MGF proxies may depend on both
endpoints of each edge.
@isnad1 id=le.13h19v.s9.7a38ad95e5b4 from=translated src=- shape=0a4b8828 vocab=1e0557a5
-/
theorem measureReal_finiteChaining_edges_largeDeviation_le_of_bernstein
    [IsProbabilityMeasure mu]
    (Z : Omega → T → ℝ) (N0 : Finset T)
    (edges : ℕ → Finset (T × T)) (proj : ℕ → T → T)
    (baseVariance baseScale : T → ℝ≥0)
    (edgeVariance edgeScale : ℕ → T → T → ℝ≥0)
    (V B : ℕ → ℝ≥0) (V0 B0 : ℝ≥0)
    (x : ℕ → ℝ) (x0 remainder : ℝ) (m : ℕ)
    (hbase : ∀ t, proj 0 t ∈ N0)
    (hedge : ∀ k ∈ Finset.range m, ∀ t,
      (proj (k + 1) t, proj k t) ∈ edges k)
    (hrem : ∀ omega t,
      |Z omega t - Z omega (proj m t)| ≤ remainder)
    (hx0 : 0 ≤ x0) (hx : ∀ k ∈ Finset.range m, 0 ≤ x k)
    (hbaseVariance : ∀ u ∈ N0, 0 < (baseVariance u : ℝ))
    (hedgeVariance : ∀ k ∈ Finset.range m, ∀ e ∈ edges k,
      0 < (edgeVariance k e.1 e.2 : ℝ))
    (hbaseVariance_le : ∀ u ∈ N0, baseVariance u ≤ V0)
    (hbaseScale_le : ∀ u ∈ N0, baseScale u ≤ B0)
    (hedgeVariance_le : ∀ k ∈ Finset.range m, ∀ e ∈ edges k,
      edgeVariance k e.1 e.2 ≤ V k)
    (hedgeScale_le : ∀ k ∈ Finset.range m, ∀ e ∈ edges k,
      edgeScale k e.1 e.2 ≤ B k)
    (hbaseBernstein : ∀ u ∈ N0,
      HasBernsteinMGF (fun omega ↦ Z omega u)
        (baseVariance u) (baseScale u) mu)
    (hedgeBernstein : ∀ k ∈ Finset.range m, ∀ e ∈ edges k,
      HasBernsteinMGF (fun omega ↦ Z omega e.1 - Z omega e.2)
        (edgeVariance k e.1 e.2) (edgeScale k e.1 e.2) mu) :
    mu.real {omega | ∃ t,
        bernsteinMixedThreshold (V0 : ℝ) (B0 : ℝ) x0 +
            (∑ k ∈ Finset.range m,
              bernsteinMixedThreshold (V k : ℝ) (B k : ℝ) (x k)) +
            remainder < |Z omega t|} ≤
      N0.card * (2 * exp (-x0)) +
        ∑ k ∈ Finset.range m, (edges k).card * (2 * exp (-x k)) := by
  apply measureReal_finiteChaining_edges_largeDeviation_le
    Z N0 edges proj
      (fun k ↦ bernsteinMixedThreshold (V k : ℝ) (B k : ℝ) (x k))
      (fun k ↦ 2 * exp (-x k))
      (bernsteinMixedThreshold (V0 : ℝ) (B0 : ℝ) x0)
      remainder (2 * exp (-x0)) m hbase hedge hrem
  · intro u hu
    have hthreshold :
        bernsteinMixedThreshold (baseVariance u : ℝ)
            (baseScale u : ℝ) x0 ≤
