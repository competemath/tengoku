import Tengoku.Randomsettheory.RandomSetTheory.ExactDivisibilitySimpleFunc
import Tengoku.Randomsettheory.RandomSetTheory.SupportFunction

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Compactness and closure criteria for Lyapunov ranges

For an integrable function `f`, its measurable set-integral range is

`{ ∫ x in A, f x ∂μ | A is measurable }`.

This file separates three topological levels which must not be conflated.

* For a vector-valued simple function on an exactly divisible finite measure
  space, the raw range is exactly a finite Minkowski sum of compact segments.
  It is therefore compact (in any Banach target) and convex.
* For an arbitrary integrable function with finite-dimensional target, the
  raw range is bounded, so its closure is compact.  Exact divisibility and
  the approximation theorem make this compact closure convex.
* Passing from that compact convex closure back to the raw range is exactly
  a sequential-attainment statement for limits of set integrals.  We package
  this criterion and show that it supplies full Lyapunov convexity, without
  pretending that Mathlib currently proves the missing attainment theorem.

Thus all compactness and approximation arguments are unconditional under
their stated hypotheses; only the final equality between the raw range and
its closure remains conditional for a general integrable vector function.
-/

open MeasureTheory Set Metric Filter Topology
open scoped Pointwise BigOperators

noncomputable section

namespace RandomSetTheory

/-! ## Exact scalar masses inside a measurable set -/

/-- Exact divisibility realizes every real mass between zero and the mass of
a measurable set.-/
theorem HasExactDivisibility.exists_measurable_subset_measureReal_eq
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu) {s : Set Omega}
    (hs : MeasurableSet s) {t : ℝ}
    (ht : t ∈ Set.Icc 0 (mu.real s)) :
    ∃ A : Set Omega, A ⊆ s ∧ MeasurableSet A ∧ mu.real A = t := by
  by_cases hmass : mu.real s = 0
  · have ht0 : t = 0 := le_antisymm (by simpa [hmass] using ht.2) ht.1
    exact ⟨∅, empty_subset s, MeasurableSet.empty, by simp [ht0]⟩
  · have hmassPos : 0 < mu.real s :=
      lt_of_le_of_ne measureReal_nonneg
        (Ne.symm hmass)
    have ha0 : 0 ≤ t / mu.real s := div_nonneg ht.1 hmassPos.le
    have ha1 : t / mu.real s ≤ 1 := (div_le_one hmassPos).mpr ht.2
    obtain ⟨A, hAs, hA, hAmeasure⟩ :=
      hmu s hs ha0 ha1
    refine ⟨A, hAs, hA, ?_⟩
    rw [hAmeasure]
    exact div_mul_cancel₀ t hmass

/-! ## The exact zonotope for simple functions -/

namespace SimpleFunc

/-- The zonotope generated by the fibres of a vector-valued simple function.
The summand associated with `y` is the segment
`{t • y | 0 ≤ t ≤ μ(f⁻¹{y})}`.-/
def setIntegralZonotope
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (mu : Measure Omega) (f : SimpleFunc Omega E) : Set E :=
  ∑ y ∈ f.range,
    (fun t : ℝ => t • y) '' Set.Icc 0 (mu.real (f ⁻¹' {y}))

/-- On an exactly divisible finite measure space, the measurable set-integral
range of a simple function is exactly its fibre zonotope.-/
theorem measurableSetIntegralRange_eq_setIntegralZonotope
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu) (f : SimpleFunc Omega E) :
    measurableSetIntegralRange mu (fun omega => f omega) =
      setIntegralZonotope mu f := by
  classical
  ext z
  constructor
  · rintro ⟨A, hA, rfl⟩
    rw [f.integral_eq_sum f.integrable_of_isFiniteMeasure.integrableOn]
    simp_rw [measureReal_restrict_apply (f.measurableSet_fiber _)]
    apply Set.finsetSum_mem_finsetSum f.range
    intro y hy
    refine ⟨mu.real (f ⁻¹' {y} ∩ A), ?_, rfl⟩
    refine ⟨measureReal_nonneg, ?_⟩
    exact measureReal_mono inter_subset_left (measure_ne_top mu _)
  · intro hz
    rw [setIntegralZonotope, Set.mem_finsetSum] at hz
    obtain ⟨g, hg, hgsum⟩ := hz
    let I := ↑f.range
    have hcoeff : ∀ i : I, ∃ t : ℝ,
        t ∈ Set.Icc 0 (mu.real (f ⁻¹' {(i : E)})) ∧
          t • (i : E) = g i := by
      intro i
      rcases hg i.property with ⟨t, ht, htEq⟩
      exact ⟨t, ht, htEq⟩
    choose t htIcc htEq using hcoeff
    have hsets : ∀ i : I, ∃ A : Set Omega,
        A ⊆ f ⁻¹' {(i : E)} ∧ MeasurableSet A ∧ mu.real A = t i := by
      intro i
      exact hmu.exists_measurable_subset_measureReal_eq
        (f.measurableSet_fiber (i : E)) (htIcc i)
    choose As hAs hAsMeas hAsMeasure using hsets
    let A : Set Omega := ⋃ i : I, As i
    have hA : MeasurableSet A :=
      MeasurableSet.iUnion fun i => hAsMeas i
    have hinter (y : E) (hy : y ∈ f.range) :
        f ⁻¹' {y} ∩ A = As (⟨y, hy⟩ : I) := by
      apply Set.Subset.antisymm
      · intro omega homega
        rcases Set.mem_iUnion.mp homega.2 with ⟨i, homegaAs⟩
        have hfyi : f omega = (i : E) := hAs i homegaAs
        have hfyy : f omega = y := homega.1
        have hieq : i = ⟨y, hy⟩ := Subtype.ext (hfyi.symm.trans hfyy)
        simpa [hieq] using homegaAs
      · intro omega homega
        refine ⟨hAs ⟨y, hy⟩ homega, ?_⟩
        exact Set.mem_iUnion_of_mem ⟨y, hy⟩ homega
    refine ⟨A, hA, ?_⟩
    rw [f.integral_eq_sum f.integrable_of_isFiniteMeasure.integrableOn]
    simp_rw [measureReal_restrict_apply (f.measurableSet_fiber _)]
    calc
      ∑ y ∈ f.range, mu.real (f ⁻¹' {y} ∩ A) • y =
          ∑ y ∈ f.range, g y := by
        apply Finset.sum_congr rfl
        intro y hy
        rw [hinter y hy, hAsMeasure ⟨y, hy⟩, htEq ⟨y, hy⟩]
      _ = z := hgsum

/-- Every fibre summand in the zonotope is compact.-/
theorem isCompact_setIntegralZonotope_summand
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (mu : Measure Omega) (f : SimpleFunc Omega E) (y : E) :
    IsCompact
      ((fun t : ℝ => t • y) '' Set.Icc 0 (mu.real (f ⁻¹' {y}))) := by
  exact isCompact_Icc.image (by fun_prop)

/-- The simple-function zonotope is compact in any normed target; no finite
dimensionality assumption is needed because it is a finite sum of compact
segments.-/
theorem isCompact_setIntegralZonotope
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (mu : Measure Omega) (f : SimpleFunc Omega E) :
    IsCompact (setIntegralZonotope mu f) := by
  exact isCompact_finset_sum f.range _ fun y _ =>
    isCompact_setIntegralZonotope_summand mu f y

/-- Consequently, the raw set-integral range of a simple function is compact
under exact divisibility.-/
theorem isCompact_measurableSetIntegralRange_of_exactDivisibility
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu) (f : SimpleFunc Omega E) :
    IsCompact (measurableSetIntegralRange mu fun omega => f omega) := by
  rw [measurableSetIntegralRange_eq_setIntegralZonotope mu hmu f]
  exact isCompact_setIntegralZonotope mu f

/-- The same raw range is closed.-/
theorem isClosed_measurableSetIntegralRange_of_exactDivisibility
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu) (f : SimpleFunc Omega E) :
    IsClosed (measurableSetIntegralRange mu fun omega => f omega) :=
  (isCompact_measurableSetIntegralRange_of_exactDivisibility
    mu hmu f).isClosed

/-- On every finite atomless measurable space, the raw set-integral range of
a vector-valued simple function is compact.-/
theorem isCompact_measurableSetIntegralRange_of_atomless
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : IsAtomlessMeasure mu) (f : SimpleFunc Omega E) :
    IsCompact (measurableSetIntegralRange mu fun omega => f omega) :=
  isCompact_measurableSetIntegralRange_of_exactDivisibility
    mu (hasExactDivisibility_of_atomless hmu) f

/-- On every finite atomless measurable space, the raw set-integral range of
a vector-valued simple function is closed.-/
theorem isClosed_measurableSetIntegralRange_of_atomless
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : IsAtomlessMeasure mu) (f : SimpleFunc Omega E) :
    IsClosed (measurableSetIntegralRange mu fun omega => f omega) :=
  (isCompact_measurableSetIntegralRange_of_atomless mu hmu f).isClosed

end SimpleFunc

/-! ## Boundedness and compact closure for arbitrary integrable functions -/

/-- Every set integral is bounded by the integral of the pointwise norm,
uniformly over the measurable set.-/
theorem measurableSetIntegralRange_subset_closedBall
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {mu : Measure Omega} {f : Omega → E} (hf : Integrable f mu) :
    measurableSetIntegralRange mu f ⊆
      Metric.closedBall 0 (∫ omega, ‖f omega‖ ∂mu) := by
  rintro _ ⟨A, _hA, rfl⟩
  rw [Metric.mem_closedBall, dist_zero_right]
  calc
    ‖∫ omega in A, f omega ∂mu‖ ≤
        ∫ omega in A, ‖f omega‖ ∂mu := norm_integral_le_integral_norm _
    _ ≤ ∫ omega, ‖f omega‖ ∂mu := by
      exact setIntegral_le_integral hf.norm
        (Filter.Eventually.of_forall fun omega => norm_nonneg (f omega))

/-- The measurable set-integral range of every integrable function is
bounded.-/
theorem measurableSetIntegralRange_isBounded
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {mu : Measure Omega} {f : Omega → E} (hf : Integrable f mu) :
    Bornology.IsBounded (measurableSetIntegralRange mu f) :=
  Metric.isBounded_closedBall.subset
    (measurableSetIntegralRange_subset_closedBall hf)

/-- In finite dimension, the closure of every integrable vector-measure
range is compact.  This statement does not claim that the raw range is
closed.-/
theorem isCompact_closure_measurableSetIntegralRange
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    {mu : Measure Omega} {f : Omega → E} (hf : Integrable f mu) :
    IsCompact (closure (measurableSetIntegralRange mu f)) :=
  (measurableSetIntegralRange_isBounded hf).isCompact_closure

/-- In finite dimension the raw range is compact if and only if it is
closed: boundedness is automatic from integrability.-/
theorem isCompact_measurableSetIntegralRange_iff_isClosed
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    {mu : Measure Omega} {f : Omega → E} (hf : Integrable f mu) :
    IsCompact (measurableSetIntegralRange mu f) ↔
      IsClosed (measurableSetIntegralRange mu f) := by
  constructor
  · exact fun h => h.isClosed
  · intro hclosed
    rw [← hclosed.closure_eq]
    exact isCompact_closure_measurableSetIntegralRange hf

/-- Every sequence of measurable set integrals has a subsequence converging
to a point of the compact closure in finite dimension.  The conclusion does
not assert that this limit is itself represented by a measurable set.-/
theorem exists_setIntegral_subsequence_tendsto_mem_closure
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    {mu : Measure Omega} {f : Omega → E} (hf : Integrable f mu)
    (A : ℕ → Set Omega) (hA : ∀ n, MeasurableSet (A n)) :
    ∃ z ∈ closure (measurableSetIntegralRange mu f),
      ∃ phi : ℕ → ℕ, StrictMono phi ∧
        Filter.Tendsto
          (fun n => ∫ omega in A (phi n), f omega ∂mu)
          Filter.atTop (nhds z) := by
  have hmem : ∀ n, (∫ omega in A n, f omega ∂mu) ∈
      closure (measurableSetIntegralRange mu f) := fun n =>
    subset_closure ⟨A n, hA n, rfl⟩
  obtain ⟨z, hz, phi, hphi, hlim⟩ :=
    (isCompact_closure_measurableSetIntegralRange hf).isSeqCompact hmem
  exact ⟨z, hz, phi, hphi, hlim⟩

/-! ## Convex compact closure under exact divisibility -/

/-- Exact divisibility makes the closure of the general vector-measure range
convex.  The proof extends approximate convexity from raw range points to
closure points by sequential approximation and continuity of affine
combinations.-/
theorem convex_closure_measurableSetIntegralRange_of_exactDivisibility
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu) {f : Omega → E}
    (hf : Integrable f mu) :
    Convex ℝ (closure (measurableSetIntegralRange mu f)) := by
  intro x hx y hy a b ha hb hab
  obtain ⟨u, hu, hux⟩ := mem_closure_iff_seq_limit.mp hx
  obtain ⟨v, hv, hvy⟩ := mem_closure_iff_seq_limit.mp hy
  have huv : ∀ n, a • u n + b • v n ∈
      closure (measurableSetIntegralRange mu f) := fun n =>
    combo_mem_closure_measurableSetIntegralRange_of_exactDivisibility
      mu hmu hf (hu n) (hv n) ha hb hab
  have hlim : Filter.Tendsto (fun n => a • u n + b • v n)
      Filter.atTop (nhds (a • x + b • y)) :=
    (hux.const_smul a).add (hvy.const_smul b)
  exact isClosed_closure.mem_of_tendsto hlim
    (Filter.Eventually.of_forall huv)

/-- Under exact divisibility, closing the measurable set-integral range is
the same as taking its closed convex hull.-/
theorem closure_measurableSetIntegralRange_eq_closedConvexHull
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu) {f : Omega → E}
    (hf : Integrable f mu) :
    closure (measurableSetIntegralRange mu f) =
      closedConvexHull ℝ (measurableSetIntegralRange mu f) := by
  apply Set.Subset.antisymm
  · exact closure_subset_closedConvexHull
  · exact closedConvexHull_min subset_closure
      (convex_closure_measurableSetIntegralRange_of_exactDivisibility
        mu hmu hf) isClosed_closure

/-- Finite-dimensional exact divisibility therefore gives a canonical
compact convex relaxation of the vector-measure range.-/
theorem isCompact_convex_closure_measurableSetIntegralRange_of_exactDivisibility
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu) {f : Omega → E}
    (hf : Integrable f mu) :
    IsCompact (closure (measurableSetIntegralRange mu f)) ∧
      Convex ℝ (closure (measurableSetIntegralRange mu f)) :=
  ⟨isCompact_closure_measurableSetIntegralRange hf,
    convex_closure_measurableSetIntegralRange_of_exactDivisibility
      mu hmu hf⟩

/-- **Unconditional finite-dimensional atomless closure theorem.** For an
integrable vector function on any finite atomless measurable space, the
closure of the set-integral range is compact and convex.

This deliberately concerns the closure: atomlessness supplies exact scalar
divisibility, but a separate sequential-attainment argument is still needed
to identify the raw range with its closure.-/
theorem isCompact_convex_closure_measurableSetIntegralRange_of_atomless
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : IsAtomlessMeasure mu) {f : Omega → E}
    (hf : Integrable f mu) :
    IsCompact (closure (measurableSetIntegralRange mu f)) ∧
      Convex ℝ (closure (measurableSetIntegralRange mu f)) :=
  isCompact_convex_closure_measurableSetIntegralRange_of_exactDivisibility
    mu (hasExactDivisibility_of_atomless hmu) hf

/-- Under finite atomlessness, closing a set-integral range agrees with its
closed convex hull.  This does not claim that the raw range is closed.-/
theorem closure_measurableSetIntegralRange_eq_closedConvexHull_of_atomless
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : IsAtomlessMeasure mu) {f : Omega → E}
    (hf : Integrable f mu) :
    closure (measurableSetIntegralRange mu f) =
      closedConvexHull ℝ (measurableSetIntegralRange mu f) :=
  closure_measurableSetIntegralRange_eq_closedConvexHull
    mu (hasExactDivisibility_of_atomless hmu) hf

/-- Explicit Euclidean specialization of the compact-convex closure theorem.-/
theorem isCompact_convex_closure_measurableSetIntegralRange_euclidean
    {Omega ι : Type*} [MeasurableSpace Omega] [Fintype ι]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu)
    {f : Omega → EuclideanSpace ℝ ι} (hf : Integrable f mu) :
    IsCompact (closure (measurableSetIntegralRange mu f)) ∧
      Convex ℝ (closure (measurableSetIntegralRange mu f)) :=
  isCompact_convex_closure_measurableSetIntegralRange_of_exactDivisibility
    mu hmu hf

/-! ## The exact sequential-attainment gap -/

/-- Explicit sequential formulation of closedness of one set-integral
range.  Every convergent sequence of integrals over measurable sets must
have its limit represented by one measurable set.-/
theorem isSeqClosed_measurableSetIntegralRange_iff
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (mu : Measure Omega) (f : Omega → E) :
    IsSeqClosed (measurableSetIntegralRange mu f) ↔
      ∀ (A : ℕ → Set Omega) (z : E),
        (∀ n, MeasurableSet (A n)) →
        Filter.Tendsto (fun n => ∫ omega in A n, f omega ∂mu)
          Filter.atTop (nhds z) →
        ∃ B : Set Omega, MeasurableSet B ∧
          (∫ omega in B, f omega ∂mu) = z := by
  classical
  constructor
  · intro hclosed A z hA hlim
    exact hclosed
      (fun n => ⟨A n, hA n, rfl⟩) hlim
  · intro hattain x z hx hlim
    have hexists : ∀ n, ∃ A : Set Omega, MeasurableSet A ∧
        (∫ omega in A, f omega ∂mu) = x n := hx
    choose A hA hxA using hexists
    have hlimA : Filter.Tendsto
        (fun n => ∫ omega in A n, f omega ∂mu)
        Filter.atTop (nhds z) := by
      apply hlim.congr'
      exact Filter.Eventually.of_forall fun n => (hxA n).symm
    obtain ⟨B, hB, hBint⟩ := hattain A z hA hlimA
    exact ⟨B, hB, hBint⟩

/-- Global sequential-attainment property for all integrable functions with
values in `E`.  This is the precise missing topological input in the current
general finite-dimensional Lyapunov development.-/
def HasSequentialSetIntegralAttainment
    {Omega : Type*} [MeasurableSpace Omega]
    (mu : Measure Omega) (E : Type*)
    [NormedAddCommGroup E] [NormedSpace ℝ E] : Prop :=
  ∀ (f : Omega → E), Integrable f mu →
    ∀ (A : ℕ → Set Omega) (z : E),
      (∀ n, MeasurableSet (A n)) →
      Filter.Tendsto (fun n => ∫ omega in A n, f omega ∂mu)
        Filter.atTop (nhds z) →
      ∃ B : Set Omega, MeasurableSet B ∧
        (∫ omega in B, f omega ∂mu) = z

/-- Sequential attainment is exactly closedness of every integrable
set-integral range; it is not a disguised stronger compactness hypothesis.-/
theorem hasSequentialSetIntegralAttainment_iff_isClosedRange
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (mu : Measure Omega) :
    HasSequentialSetIntegralAttainment mu E ↔
      ∀ (f : Omega → E), Integrable f mu →
        IsClosed (measurableSetIntegralRange mu f) := by
  constructor
  · intro hattain f hf
    apply IsSeqClosed.isClosed
    rw [isSeqClosed_measurableSetIntegralRange_iff mu f]
    exact hattain f hf
  · intro hclosed f hf A z hA hlim
    have hseq : IsSeqClosed (measurableSetIntegralRange mu f) :=
      (hclosed f hf).isSeqClosed
    exact (isSeqClosed_measurableSetIntegralRange_iff mu f).mp hseq
      A z hA hlim

/-- Sequential attainment makes every integrable set-integral range closed.-/
theorem isClosed_measurableSetIntegralRange_of_sequentialAttainment
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {mu : Measure Omega}
    (hattain : HasSequentialSetIntegralAttainment mu E)
    {f : Omega → E} (hf : Integrable f mu) :
    IsClosed (measurableSetIntegralRange mu f) := by
  apply IsSeqClosed.isClosed
  rw [isSeqClosed_measurableSetIntegralRange_iff mu f]
  exact hattain f hf

/-- In finite dimension, sequential attainment upgrades the compact closure
to compactness of the raw range.-/
theorem isCompact_measurableSetIntegralRange_of_sequentialAttainment
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E]
    {mu : Measure Omega}
    (hattain : HasSequentialSetIntegralAttainment mu E)
    {f : Omega → E} (hf : Integrable f mu) :
    IsCompact (measurableSetIntegralRange mu f) :=
  (isCompact_measurableSetIntegralRange_iff_isClosed hf).mpr
    (isClosed_measurableSetIntegralRange_of_sequentialAttainment
      hattain hf)

/-- In finite dimension, the global sequential-attainment property is also
equivalent to compactness of every integrable raw range.-/
theorem hasSequentialSetIntegralAttainment_iff_isCompactRange
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E]
    (mu : Measure Omega) :
    HasSequentialSetIntegralAttainment mu E ↔
      ∀ (f : Omega → E), Integrable f mu →
        IsCompact (measurableSetIntegralRange mu f) := by
  rw [hasSequentialSetIntegralAttainment_iff_isClosedRange]
  constructor
  · intro hclosed f hf
    exact (isCompact_measurableSetIntegralRange_iff_isClosed hf).mpr
      (hclosed f hf)
  · intro hcompact f hf
    exact (hcompact f hf).isClosed

/-- Full Lyapunov convexity follows from exact divisibility once the precise
sequential-attainment gap is supplied.-/
theorem hasLyapunovConvexity_of_exactDivisibility_of_sequentialAttainment
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu)
    (hattain : HasSequentialSetIntegralAttainment mu E) :
    HasLyapunovConvexity mu E := by
  apply hasLyapunovConvexity_of_exactDivisibility_of_isClosedRange mu hmu
  intro f hf
  exact isClosed_measurableSetIntegralRange_of_sequentialAttainment
    hattain hf

/-- Full Lyapunov convexity on a finite atomless base, conditional exactly on
sequential attainment of limits of measurable set integrals.  The condition
is not discharged by the scalar Sierpiński theorem.-/
theorem hasLyapunovConvexity_of_atomless_of_sequentialAttainment
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : IsAtomlessMeasure mu)
    (hattain : HasSequentialSetIntegralAttainment mu E) :
    HasLyapunovConvexity mu E :=
  hasLyapunovConvexity_of_exactDivisibility_of_sequentialAttainment
    mu (hasExactDivisibility_of_atomless hmu) hattain

/-- Equivalent compactness-oriented bridge: if every raw integrable range is
compact, exact divisibility gives full Lyapunov convexity.-/
theorem hasLyapunovConvexity_of_exactDivisibility_of_isCompactRange
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : HasExactDivisibility mu)
    (hcompact : ∀ (f : Omega → E), Integrable f mu →
      IsCompact (measurableSetIntegralRange mu f)) :
    HasLyapunovConvexity mu E := by
  apply hasLyapunovConvexity_of_exactDivisibility_of_isClosedRange mu hmu
  intro f hf
  exact (hcompact f hf).isClosed

/-- Compactness of every raw vector-measure range, together with finite
atomlessness, implies full Lyapunov convexity.  Compactness remains an
explicit hypothesis rather than being silently inferred from atomlessness.-/
theorem hasLyapunovConvexity_of_atomless_of_isCompactRange
    {Omega E : Type*} [MeasurableSpace Omega]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (mu : Measure Omega) [IsFiniteMeasure mu]
    (hmu : IsAtomlessMeasure mu)
    (hcompact : ∀ f : Omega → E, Integrable f mu →
      IsCompact (measurableSetIntegralRange mu f)) :
    HasLyapunovConvexity mu E :=
  hasLyapunovConvexity_of_exactDivisibility_of_isCompactRange
    mu (hasExactDivisibility_of_atomless hmu) hcompact

end RandomSetTheory
