import Tengoku.Seed.Probability.Independence.Basic
import Tengoku.Seed.Probability.Process.Filtration
import Tengoku.Seed.MeasureTheory.Function.FactorsThrough

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# The strict-prefix filtration of an independent sequence

For a sequence `Y 0, Y 1, ...`, the filtration at time `i` below contains
exactly the coordinates with indices strictly smaller than `i`.  In
particular, time zero is the trivial sigma-algebra, while the current
coordinate `Y i` is independent of the finite prefix whenever the sequence is
mutually independent.

This is the canonical filtration convention needed by the finite-supremum
Rio/ghost construction: its successor Doob difference reveals coordinate
`i` over the past `(Y 0, ..., Y (i-1))`.
-/

open MeasureTheory ProbabilityTheory
open scoped BigOperators

noncomputable section

namespace ProbabilityTheory

variable {Omega Z : Type*} {mOmega : MeasurableSpace Omega}
  [MeasurableSpace Z]

/-- The filtration generated at time `i` by the strict prefix
`Y 0, ..., Y (i-1)`.-/
def strictPrefixFiltration (Y : Nat -> Omega -> Z)
    (hY : forall i, Measurable (Y i)) : Filtration Nat mOmega where
  seq i := ⨆ j : Fin i, MeasurableSpace.comap (Y j) inferInstance
  mono' i k hik := by
    apply iSup_le
    intro j
    exact le_iSup_of_le (Fin.castLE hik j) (by simp)
  le' i := by
    apply iSup_le
    intro j
    exact (hY j).comap_le

@[simp]
theorem strictPrefixFiltration_zero
    (Y : Nat -> Omega -> Z) (hY : forall i, Measurable (Y i)) :
    strictPrefixFiltration Y hY 0 = ⊥ := by
  simp [strictPrefixFiltration]

/-- The strict-prefix sigma-algebra is the pullback by the finite prefix
vector.-/
theorem strictPrefixFiltration_eq_comap
    (Y : Nat -> Omega -> Z) (hY : forall i, Measurable (Y i)) (i : Nat) :
    strictPrefixFiltration Y hY i =
      MeasurableSpace.comap (fun omega (j : Fin i) => Y j omega)
        inferInstance := by
  rw [strictPrefixFiltration, MeasurableSpace.comap_process_pi]

/-- The finite prefix map is measurable.-/
theorem measurable_strictPrefix
    (Y : Nat -> Omega -> Z) (hY : forall i, Measurable (Y i)) (i : Nat) :
    Measurable (fun omega (j : Fin i) => Y j omega) := by
  exact measurable_pi_lambda _ fun j => hY j

/-- A current coordinate of a mutually independent sequence is independent
of its strict finite prefix.-/
theorem iIndepFun.indepFun_strictPrefix
    {mu : Measure Omega} (Y : Nat -> Omega -> Z)
    (hIndep : iIndepFun Y mu) (hY : forall i, Measurable (Y i)) (i : Nat) :
    IndepFun (fun omega (j : Fin i) => Y j omega) (Y i) mu := by
  let S : Finset Nat := Finset.range i
  let T : Finset Nat := {i}
  have hdisjoint : Disjoint S T := by
    simp [S, T]
  have hfinite := hIndep.indepFun_finset S T hdisjoint hY
  let leftMap : (S -> Z) -> (Fin i -> Z) := fun values j =>
    values ⟨j, Finset.mem_range.mpr j.isLt⟩
  let rightMap : (T -> Z) -> Z := fun values =>
    values ⟨i, Finset.mem_singleton_self i⟩
  have hleft : Measurable leftMap := by fun_prop
  have hright : Measurable rightMap := by fun_prop
  have hcomp := hfinite.comp hleft hright
  convert hcomp using 1
  · funext omega j
    rfl
  · funext omega
    rfl

/-! ## A fixed-codomain encoding of prefixes -/

/-- Encode a finite prefix in the fixed product space `Nat -> Z`, padding all
future coordinates by `z0`.  The fixed codomain is convenient for martingale
theorems whose revealed-past type cannot depend on the time index.-/
def paddedStrictPrefix (z0 : Z) (Y : Nat -> Omega -> Z)
    (i : Nat) (omega : Omega) (j : Nat) : Z :=
  if _h : j < i then Y j omega else z0

theorem measurable_paddedStrictPrefix
    (z0 : Z) (Y : Nat -> Omega -> Z)
    (hY : forall i, Measurable (Y i)) (i : Nat) :
    Measurable (paddedStrictPrefix z0 Y i) := by
  apply measurable_pi_lambda
  intro j
  by_cases hj : j < i
  · simpa [paddedStrictPrefix, hj] using hY j
  · simp [paddedStrictPrefix, hj]

/-- Padding does not change the sigma-algebra generated by the finite
prefix.-/
theorem strictPrefixFiltration_eq_comap_paddedStrictPrefix
    (z0 : Z) (Y : Nat -> Omega -> Z)
    (hY : forall i, Measurable (Y i)) (i : Nat) :
    strictPrefixFiltration Y hY i =
      MeasurableSpace.comap (paddedStrictPrefix z0 Y i) inferInstance := by
  change (⨆ j : Fin i, MeasurableSpace.comap (Y j) inferInstance) = _
  rw [MeasurableSpace.comap_process_pi]
  apply le_antisymm
  · apply iSup_le
    intro j
    apply le_iSup_of_le (j : Nat)
    simp [paddedStrictPrefix, j.isLt]
  · apply iSup_le
    intro j
    by_cases hj : j < i
    · simp only [paddedStrictPrefix, dite_eq_left hj]
      exact le_iSup
        (fun r : Fin i ↦ MeasurableSpace.comap (Y r) inferInstance)
        (⟨j, hj⟩ : Fin i)
    · simp [paddedStrictPrefix, hj]

/-- The padded strict prefix remains independent of the current coordinate.-/
theorem iIndepFun.indepFun_paddedStrictPrefix
    {mu : Measure Omega} (z0 : Z) (Y : Nat -> Omega -> Z)
    (hIndep : iIndepFun Y mu) (hY : forall i, Measurable (Y i)) (i : Nat) :
    IndepFun (paddedStrictPrefix z0 Y i) (Y i) mu := by
  have hprefix := hIndep.indepFun_strictPrefix Y hY i
  let extendPrefix : (Fin i -> Z) -> (Nat -> Z) := fun values j =>
    if h : j < i then values ⟨j, h⟩ else z0
  have hextend : Measurable extendPrefix := by
    apply measurable_pi_lambda
    intro j
    by_cases hj : j < i
    · simpa [extendPrefix, hj] using
        (measurable_pi_apply (⟨j, hj⟩ : Fin i))
    · simp [extendPrefix, hj]
  have hcomp := hprefix.comp hextend measurable_id
  convert hcomp using 1
  · funext omega j
    by_cases hj : j < i <;> simp [extendPrefix, paddedStrictPrefix, hj]
  · rfl

/-! ## Factorization of prefix conditional expectations -/

/-- Insert the currently revealed coordinate into a padded strict prefix.-/
def insertCurrentIntoPaddedPrefix (z0 : Z) (i : Nat)
    (pastAndCurrent : (Nat -> Z) × Z) (j : Nat) : Z :=
  if _hlt : j < i then pastAndCurrent.1 j
  else if j = i then pastAndCurrent.2 else z0

theorem measurable_insertCurrentIntoPaddedPrefix (z0 : Z) (i : Nat) :
    Measurable (insertCurrentIntoPaddedPrefix z0 i) := by
  apply measurable_pi_lambda
  intro j
  by_cases hlt : j < i
  · simp only [insertCurrentIntoPaddedPrefix, dite_eq_left hlt]
    exact (measurable_pi_apply j).comp measurable_fst
  · by_cases heq : j = i
    · simp only [insertCurrentIntoPaddedPrefix, dite_eq_right hlt, ite_eq_left heq]
      exact measurable_snd
    · simp only [insertCurrentIntoPaddedPrefix, dite_eq_right hlt, ite_eq_right heq]
      exact measurable_const

omit [MeasurableSpace Z] in
/-- Inserting `Y i` into its padded strict prefix gives the padded prefix at
the next time.-/
theorem insertCurrentIntoPaddedPrefix_comp
    (z0 : Z) (Y : Nat -> Omega -> Z) (i : Nat) (omega : Omega) :
    insertCurrentIntoPaddedPrefix z0 i
        (paddedStrictPrefix z0 Y i omega, Y i omega) =
      paddedStrictPrefix z0 Y (i + 1) omega := by
  funext j
  by_cases hlt : j < i
  · simp [insertCurrentIntoPaddedPrefix, paddedStrictPrefix, hlt,
      hlt.trans (Nat.lt_succ_self i)]
  · by_cases heq : j = i
    · subst j
      simp [insertCurrentIntoPaddedPrefix, paddedStrictPrefix]
    · have hgt : i < j := by omega
      have hnlt : ¬j < i + 1 := by omega
      simp [insertCurrentIntoPaddedPrefix, paddedStrictPrefix, hlt, heq, hnlt]

/-- Every next-time conditional expectation admits a strongly measurable
past/current-coordinate value function.

This is Doob--Dynkin factorization on the strict-prefix sigma-algebra.  It
constructs the structural `G_i` needed by the ghost representation; an
application still has to prove the desired replace-one modulus for a suitable
version of that value function.-/
theorem exists_stronglyMeasurable_nextPrefixValueFiber
    {mu : Measure Omega} (z0 : Z) (Y : Nat -> Omega -> Z)
    (hY : ∀ i, Measurable (Y i)) (F : Omega -> Real) (i : Nat) :
    ∃ G : (Nat -> Z) -> Z -> Real,
      StronglyMeasurable (Function.uncurry G) ∧
      mu[F | strictPrefixFiltration Y hY (i + 1)] =ᵐ[mu]
        fun omega => G (paddedStrictPrefix z0 Y i omega) (Y i omega) := by
  let Pnext : Omega -> (Nat -> Z) := paddedStrictPrefix z0 Y (i + 1)
  have hcond : StronglyMeasurable[MeasurableSpace.comap Pnext inferInstance]
      mu[F | strictPrefixFiltration Y hY (i + 1)] := by
    rw [← strictPrefixFiltration_eq_comap_paddedStrictPrefix
      z0 Y hY (i + 1)]
    exact stronglyMeasurable_condExp
  obtain ⟨H, hH, hfactor⟩ := hcond.exists_eq_measurable_comp
  let G : (Nat -> Z) -> Z -> Real := fun past current =>
    H (insertCurrentIntoPaddedPrefix z0 i (past, current))
  refine ⟨G, ?_, ?_⟩
  · exact hH.comp_measurable (measurable_insertCurrentIntoPaddedPrefix z0 i)
  · rw [hfactor]
    exact Filter.Eventually.of_forall fun omega => by
      simp only [Function.comp_apply, G, Pnext]
      rw [insertCurrentIntoPaddedPrefix_comp]

end ProbabilityTheory
