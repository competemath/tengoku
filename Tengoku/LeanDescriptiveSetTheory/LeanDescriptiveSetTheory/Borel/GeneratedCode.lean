import Tengoku.Seed.MeasureTheory.MeasurableSpace.Defs

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Codes for generated measurable spaces

This file defines a Type-valued syntax for the sets generated by a family under complement and
countable union. It proves that the syntax has exactly the same expressive power as mathlib's
`MeasurableSpace.GenerateMeasurable` predicate.
-/

open MeasurableSpace Set

universe u v

namespace DescriptiveSetTheory

variable {X : Type u} {ι : Type v}

/-- A syntax tree for the measurable sets generated by `g : ι → Set X`.-/
inductive GeneratedCode (g : ι → Set X) : Type (max u v)
  /-- A member of the generating family.-/
  | basic (i : ι)
  /-- The empty set.-/
  | empty
  /-- The complement of a coded set.-/
  | compl (c : GeneratedCode g)
  /-- A countable union of coded sets.-/
  | iUnion (c : ℕ → GeneratedCode g)

namespace GeneratedCode

variable {g : ι → Set X}

/-- Interpret a generated code as a set.-/
def eval : GeneratedCode g → Set X
  | .basic i => g i
  | .empty => ∅
  | .compl c => (eval c)ᶜ
  | .iUnion c => ⋃ n, eval (c n)

/-- The interpretation of a basic code is its generator.-/
@[simp] theorem eval_basic (i : ι) : eval (.basic i : GeneratedCode g) = g i := rfl

/-- The interpretation of the empty code is the empty set.-/
@[simp] theorem eval_empty : eval (.empty : GeneratedCode g) = ∅ := rfl

/-- Interpretation commutes with complement.-/
@[simp] theorem eval_compl (c : GeneratedCode g) : eval (.compl c) = (eval c)ᶜ := rfl

/-- Interpretation commutes with countable union.-/
@[simp] theorem eval_iUnion (c : ℕ → GeneratedCode g) :
    eval (.iUnion c) = ⋃ n, eval (c n) := rfl

/-- A code for the union of two coded sets.-/
def union (c d : GeneratedCode g) : GeneratedCode g :=
  .iUnion fun n => if n = 0 then c else d

/-- Interpretation commutes with binary union.-/
@[simp] theorem eval_union (c d : GeneratedCode g) : eval (union c d) = eval c ∪ eval d := by
  ext x
  simp only [union, eval_iUnion, mem_iUnion, mem_union]
  constructor
  · rintro ⟨n, hn⟩
    by_cases h : n = 0
    · left
      simpa [h] using hn
    · right
      simpa [h] using hn
  · rintro (hx | hx)
    · exact ⟨0, by simpa using hx⟩
    · exact ⟨1, by simpa using hx⟩

/-- A code for the intersection of two coded sets.-/
def inter (c d : GeneratedCode g) : GeneratedCode g :=
  .compl (union (.compl c) (.compl d))

/-- Interpretation commutes with binary intersection.-/
@[simp] theorem eval_inter (c d : GeneratedCode g) : eval (inter c d) = eval c ∩ eval d := by
  simp [inter]

/-- A code for the set difference of two coded sets.-/
def diff (c d : GeneratedCode g) : GeneratedCode g := inter c (.compl d)

/-- Interpretation commutes with set difference.-/
@[simp] theorem eval_diff (c d : GeneratedCode g) : eval (diff c d) = eval c \ eval d := by
  simp [diff, Set.sdiff_eq]

/-- A code for a countable intersection.-/
def iInter (c : ℕ → GeneratedCode g) : GeneratedCode g :=
  .compl (.iUnion fun n => .compl (c n))

/-- Interpretation commutes with countable intersection.-/
@[simp] theorem eval_iInter (c : ℕ → GeneratedCode g) : eval (iInter c) = ⋂ n, eval (c n) := by
  simp [iInter]

/-- Codes are semantically equivalent when they denote the same set.-/
instance : Setoid (GeneratedCode g) where
  r c d := c.eval = d.eval
  iseqv := ⟨fun _ => rfl, fun h => h.symm, fun hcd hde => hcd.trans hde⟩

/-- Semantic code equivalence is equality of interpretations.-/
theorem equiv_iff (c d : GeneratedCode g) : c ≈ d ↔ c.eval = d.eval := Iff.rfl

/-- Every generated code denotes a `GenerateMeasurable` set.-/
theorem generateMeasurable_eval (c : GeneratedCode g) :
    GenerateMeasurable (range g) c.eval := by
  induction c with
  | basic i => exact .basic _ ⟨i, rfl⟩
  | empty => exact .empty
  | compl c ih => exact .compl _ ih
  | iUnion c ih => exact .iUnion _ ih

/-- Every `GenerateMeasurable` set has a generated code with the same interpretation.-/
theorem exists_code_of_generateMeasurable {s : Set X}
    (hs : GenerateMeasurable (range g) s) : ∃ c : GeneratedCode g, c.eval = s := by
  induction hs with
  | basic s hs =>
      obtain ⟨i, rfl⟩ := hs
      exact ⟨.basic i, rfl⟩
  | empty => exact ⟨.empty, rfl⟩
  | compl s _ ih =>
      obtain ⟨c, rfl⟩ := ih
      exact ⟨.compl c, rfl⟩
  | iUnion f _ ih =>
      choose c hc using ih
      exact ⟨.iUnion c, by simp only [eval_iUnion, hc]⟩

/-- A set is generated by `g` exactly when it is the interpretation of a generated code.-/
theorem generateMeasurable_iff_exists_code {s : Set X} :
    GenerateMeasurable (range g) s ↔ ∃ c : GeneratedCode g, c.eval = s :=
  ⟨exists_code_of_generateMeasurable, fun ⟨c, hc⟩ => hc ▸ generateMeasurable_eval c⟩

end GeneratedCode
end DescriptiveSetTheory
