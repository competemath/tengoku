import Tengoku.LeanDescriptiveSetTheory.LeanDescriptiveSetTheory.Hyperspace.Compacts
import Tengoku.Seed.MeasureTheory.MeasurableSpace.Prod

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# The Effros measurable space of closed sets

The Effros measurable structure on `TopologicalSpace.Closeds X` is generated by the sets of closed
sets meeting an open subset of `X`.  This file deliberately defines only a named measurable space;
it does not install a topology or a global measurable-space instance on mathlib's closed-set type.
-/

open MeasurableSpace Set TopologicalSpace

universe u v

namespace DescriptiveSetTheory

variable {X : Type u} {Y : Type v} [TopologicalSpace X]

/-- Closed subsets of `X` meeting `U`.-/
def closedHit (U : Set X) : Set (Closeds X) :=
  {F | ((F : Set X) ∩ U).Nonempty}

@[simp] theorem mem_closedHit {F : Closeds X} {U : Set X} :
    F ∈ closedHit U ↔ ((F : Set X) ∩ U).Nonempty :=
  Iff.rfl

/-- Open-hit generators for the Effros measurable structure.-/
def effrosGenerators (X : Type u) [TopologicalSpace X] : Set (Set (Closeds X)) :=
  {A | ∃ U : Set X, IsOpen U ∧ A = closedHit U}

/-- The Effros measurable structure on all closed subsets, including the empty set.-/
@[reducible] def effrosMeasurableSpace
    (X : Type u) [TopologicalSpace X] : MeasurableSpace (Closeds X) :=
  generateFrom (effrosGenerators X)

/-- Every open-hit generator is Effros measurable.-/
theorem measurableSet_closedHit {U : Set X} (hU : IsOpen U) :
    @MeasurableSet (Closeds X) (effrosMeasurableSpace X) (closedHit U) :=
  measurableSet_generateFrom ⟨U, hU, rfl⟩

/-- A measurable space contains the Effros measurable structure exactly when all open-hit sets are
measurable in it.-/
theorem effrosMeasurableSpace_le_iff (m : MeasurableSpace (Closeds X)) :
    effrosMeasurableSpace X ≤ m ↔
      ∀ U : Set X, IsOpen U → @MeasurableSet (Closeds X) m (closedHit U) := by
  constructor
  · intro h U hU
    exact h _ (measurableSet_closedHit hU)
  · intro h
    apply generateFrom_le
    rintro A ⟨U, hU, rfl⟩
    exact h U hU

/-- A map into closed sets is Effros measurable exactly when every open-hit preimage is
measurable.-/
theorem measurable_effros_iff [mY : MeasurableSpace Y] (f : Y → Closeds X) :
    @Measurable Y (Closeds X) mY (effrosMeasurableSpace X) f ↔
      ∀ U : Set X, IsOpen U → MeasurableSet (f ⁻¹' closedHit U) := by
  constructor
  · intro hf U hU
    exact hf (measurableSet_closedHit hU)
  · intro hf
    apply measurable_generateFrom
    rintro A ⟨U, hU, rfl⟩
    exact hf U hU

/-- The Effros measurable structure generated only by hits of a displayed countable basis.-/
@[reducible] def basisEffrosMeasurableSpace (b : ℕ → Set X) : MeasurableSpace (Closeds X) :=
  generateFrom (range fun n => closedHit (b n))

/-- A countable topological basis generates the full Effros measurable structure.-/
theorem basisEffrosMeasurableSpace_eq (b : ℕ → Set X)
    (hb : IsTopologicalBasis (range b)) :
    basisEffrosMeasurableSpace b = effrosMeasurableSpace X := by
  classical
  apply le_antisymm
  · apply generateFrom_le
    rintro A ⟨n, rfl⟩
    exact measurableSet_closedHit (hb.isOpen (mem_range_self n))
  · letI : MeasurableSpace (Closeds X) := basisEffrosMeasurableSpace b
    apply generateFrom_le
    rintro A ⟨U, hU, rfl⟩
    let H : ℕ → Set (Closeds X) := fun n => if b n ⊆ U then closedHit (b n) else ∅
    have hH : ∀ n, @MeasurableSet (Closeds X) (basisEffrosMeasurableSpace b) (H n) := by
      intro n
      by_cases hn : b n ⊆ U
      · change @MeasurableSet (Closeds X) (basisEffrosMeasurableSpace b)
          (if b n ⊆ U then closedHit (b n) else ∅)
        rw [ite_eq_left hn]
        exact measurableSet_generateFrom (mem_range_self n)
      · change @MeasurableSet (Closeds X) (basisEffrosMeasurableSpace b)
          (if b n ⊆ U then closedHit (b n) else ∅)
        rw [ite_eq_right hn]
        exact MeasurableSet.empty
    have hEq : closedHit U = ⋃ n, H n := by
      ext F
      constructor
      · rintro ⟨x, hxF, hxU⟩
        obtain ⟨V, hVB, hxV, hVU⟩ := hb.exists_subset_of_mem_open hxU hU
        obtain ⟨n, rfl⟩ := hVB
        refine mem_iUnion.2 ⟨n, ?_⟩
        change F ∈ (if b n ⊆ U then closedHit (b n) else ∅)
        rw [ite_eq_left hVU]
        exact ⟨x, hxF, hxV⟩
      · intro hF
        obtain ⟨n, hn⟩ := mem_iUnion.1 hF
        by_cases hbn : b n ⊆ U
        · change F ∈ (if b n ⊆ U then closedHit (b n) else ∅) at hn
          rw [ite_eq_left hbn] at hn
          obtain ⟨x, hxF, hxb⟩ : ((F : Set X) ∩ b n).Nonempty := hn
          exact ⟨x, hxF, hbn hxb⟩
        · change F ∈ (if b n ⊆ U then closedHit (b n) else ∅) at hn
          rw [ite_eq_right hbn] at hn
          simp at hn
    rw [hEq]
    exact MeasurableSet.iUnion hH

/-- The canonical map from compact sets to closed sets is Borel-to-Effros measurable.-/
theorem measurable_compactsToCloseds [T2Space X] :
    @Measurable (Compacts X) (Closeds X) compactsBorelMeasurableSpace
      (effrosMeasurableSpace X) Compacts.toCloseds := by
  letI : MeasurableSpace (Compacts X) := compactsBorelMeasurableSpace
  rw [measurable_effros_iff]
  intro U hU
  change @MeasurableSet (Compacts X) compactsBorelMeasurableSpace
    {K | ((K : Set X) ∩ U).Nonempty}
  exact measurableSet_compactsHit hU

/-- Membership with coordinate order `(closed set, point)`.-/
def closedMembership : Set (Closeds X × X) :=
  {p | p.2 ∈ p.1}

@[simp] theorem mem_closedMembership {F : Closeds X} {x : X} :
    (F, x) ∈ closedMembership ↔ x ∈ F :=
  Iff.rfl

/-- Relative to a displayed countable basis, closed-set membership is measurable for the product
of the Effros structure and any measurable structure containing the open sets of `X`.-/
theorem measurableSet_closedMembership_of_basis [mX : MeasurableSpace X]
    [OpensMeasurableSpace X] (b : ℕ → Set X) (hb : IsTopologicalBasis (range b)) :
    @MeasurableSet (Closeds X × X) ((effrosMeasurableSpace X).prod mX)
      closedMembership := by
  letI : MeasurableSpace (Closeds X) := effrosMeasurableSpace X
  let A : ℕ → Set (Closeds X × X) := fun n =>
    {p | p.2 ∉ b n} ∪ {p | p.1 ∈ closedHit (b n)}
  have hA : ∀ n, MeasurableSet (A n) := by
    intro n
    have hOpen : IsOpen (b n) := hb.isOpen (mem_range_self n)
    have hLeft : MeasurableSet {p : Closeds X × X | p.2 ∉ b n} := by
      change MeasurableSet (Prod.snd ⁻¹' (b n)ᶜ)
      exact measurable_snd hOpen.measurableSet.compl
    have hRight : MeasurableSet {p : Closeds X × X | p.1 ∈ closedHit (b n)} := by
      change MeasurableSet (Prod.fst ⁻¹' closedHit (b n))
      exact measurable_fst (measurableSet_closedHit hOpen)
    exact hLeft.union hRight
  have hEq : closedMembership = ⋂ n, A n := by
    ext p
    constructor
    · intro hp
      rw [mem_iInter]
      intro n
      by_cases hpn : p.2 ∈ b n
      · exact Or.inr ⟨p.2, hp, hpn⟩
      · exact Or.inl hpn
    · intro hp
      rw [mem_iInter] at hp
      by_contra hnot
      have hxCompl : p.2 ∈ ((p.1 : Set X)ᶜ) := hnot
      obtain ⟨V, hVB, hxV, hVF⟩ :=
        hb.exists_subset_of_mem_open hxCompl p.1.isClosed.isOpen_compl
      obtain ⟨n, rfl⟩ := hVB
      rcases hp n with hxb | hhit
      · exact hxb hxV
      · obtain ⟨y, hyF, hyb⟩ := hhit
        exact (hVF hyb) hyF
  rw [hEq]
  exact MeasurableSet.iInter hA

/-- Closed-set membership is measurable for every second-countable base space whose open sets are
measurable.-/
theorem measurableSet_closedMembership [mX : MeasurableSpace X]
    [OpensMeasurableSpace X] [SecondCountableTopology X] :
    @MeasurableSet (Closeds X × X) ((effrosMeasurableSpace X).prod mX)
      closedMembership := by
  obtain ⟨b, hb⟩ := exists_seq_basis X
  exact measurableSet_closedMembership_of_basis b hb

/-- Membership with the coordinates swapped to `(point, closed set)`.-/
def pointClosedMembership : Set (X × Closeds X) :=
  {p | p.1 ∈ p.2}

@[simp] theorem mem_pointClosedMembership {F : Closeds X} {x : X} :
    (x, F) ∈ pointClosedMembership ↔ x ∈ F :=
  Iff.rfl

/-- The coordinate-swapped membership relation is measurable in the correspondingly swapped
product measurable space.-/
theorem measurableSet_pointClosedMembership [mX : MeasurableSpace X]
    [OpensMeasurableSpace X] [SecondCountableTopology X] :
    @MeasurableSet (X × Closeds X) (mX.prod (effrosMeasurableSpace X))
      pointClosedMembership := by
  letI : MeasurableSpace (Closeds X) := effrosMeasurableSpace X
  change MeasurableSet (Prod.swap ⁻¹' closedMembership)
  exact measurable_swap measurableSet_closedMembership

/-- The singleton closed-set map is Borel-to-Effros measurable.-/
theorem measurable_singletonCloseds [T1Space X] :
    @Measurable X (Closeds X) (borel X) (effrosMeasurableSpace X)
      ({·} : X → Closeds X) := by
  letI : MeasurableSpace X := borel X
  rw [measurable_effros_iff]
  intro U hU
  have hpre : ({·} : X → Closeds X) ⁻¹' closedHit U = U := by
    ext x
    simp [closedHit]
  rw [hpre]
  exact measurableSet_generateFrom hU

/-- The constant empty closed-set map is Effros measurable.-/
theorem measurable_const_emptyCloseds [MeasurableSpace Y] :
    @Measurable Y (Closeds X) inferInstance (effrosMeasurableSpace X)
      (fun _ => (⊥ : Closeds X)) := by
  rw [measurable_effros_iff]
  intro U hU
  simp [closedHit]

end DescriptiveSetTheory
