import Tengoku.LeanDescriptiveSetTheory.LeanDescriptiveSetTheory.Tree.Basic
import Tengoku.Seed.MeasureTheory.Constructions.Polish.Basic
import Tengoku.Seed.Topology.MetricSpace.PiNat

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Closed tree bodies and analytic projections

This file connects three standard views used in descriptive set theory.

* `treeOfSet s` contains the finite prefixes realized by elements of `s`.
* Its body is exactly `closure s`; in particular, every closed subset of a sequence space is the
  body of a tree.
* A tree on a product alphabet has a closed paired body, and projecting that body onto its first
  sequence coordinate gives a mathlib `MeasureTheory.AnalyticSet`.

The analytic-set conclusion deliberately reuses mathlib's definition and closure theorems. No
competing notion of analytic set is introduced.
-/

open Set

universe u v

namespace DescriptiveSetTheory.Tree

variable {A : Type u} {B : Type v}

/-- A finite list agrees coordinatewise with the beginning of an infinite sequence.-/
def IsInitialSegmentOf (l : List A) (x : ℕ → A) : Prop :=
  ∀ i (hi : i < l.length), l[i] = x i

/-- The tree of all finite initial segments realized by points of `s`.-/
def treeOfSet (s : Set (ℕ → A)) : Descriptive.tree A where
  val := {l | ∃ x ∈ s, IsInitialSegmentOf l x}
  property := by
    intro l a h
    rcases h with ⟨x, hxs, hl⟩
    refine ⟨x, hxs, fun i hi => ?_⟩
    have := hl i (by simpa using Nat.le_of_lt hi)
    simpa [List.getElem_append, hi] using this

@[simp]
theorem mem_treeOfSet {s : Set (ℕ → A)} {l : List A} :
    l ∈ treeOfSet s ↔ ∃ x ∈ s, IsInitialSegmentOf l x :=
  Iff.rfl

/-- Every initial segment of a point of `s` belongs to `treeOfSet s`.-/
theorem initialSegment_mem_treeOfSet {s : Set (ℕ → A)} {x : ℕ → A} (hx : x ∈ s)
    (n : ℕ) : initialSegment x n ∈ treeOfSet s := by
  refine ⟨x, hx, fun i hi => ?_⟩
  simp [initialSegment]

/-- The generating set is contained in the body of its prefix tree.-/
theorem subset_body_treeOfSet (s : Set (ℕ → A)) : s ⊆ body (treeOfSet s) := by
  intro x hx n
  exact initialSegment_mem_treeOfSet hx n

/-- The body of the prefix tree generated by `s` is exactly the closure of `s`.-/
theorem body_treeOfSet_eq_closure [TopologicalSpace A] [DiscreteTopology A]
    (s : Set (ℕ → A)) : body (treeOfSet s) = closure s := by
  apply Set.Subset.antisymm
  · intro x hx
    refine (PiNat.isTopologicalBasis_cylinders fun _ : ℕ => A).mem_closure_iff.mpr ?_
    intro o ho hxo
    rcases ho with ⟨z, n, rfl⟩
    rcases hx n with ⟨y, hys, hy⟩
    refine ⟨y, ?_, hys⟩
    rw [PiNat.mem_cylinder_iff] at hxo ⊢
    intro i hi
    have hxy : x i = y i := by
      simpa [initialSegment] using hy i (by simpa using hi)
    exact hxy.symm.trans (hxo i hi)
  · exact closure_minimal (subset_body_treeOfSet s) (isClosed_body (treeOfSet s))

/-- Every closed subset of a sequence space is the body of its finite-prefix tree.-/
theorem body_treeOfSet_of_isClosed [TopologicalSpace A] [DiscreteTopology A]
    {s : Set (ℕ → A)} (hs : IsClosed s) : body (treeOfSet s) = s := by
  rw [body_treeOfSet_eq_closure, hs.closure_eq]

/-- Zip a pair of infinite sequences into a sequence over the product alphabet.-/
def pairSequences (p : (ℕ → A) × (ℕ → B)) : ℕ → A × B :=
  fun n => (p.1 n, p.2 n)

/-- Initial segments commute with coordinatewise pairing.-/
theorem initialSegment_pairSequences (x : ℕ → A) (y : ℕ → ℕ) (n : ℕ) :
    initialSegment (pairSequences (x, y)) n =
      (initialSegment x n).zip (initialSegment y n) := by
  apply List.ext_get
  · simp
  · intro i hi₁ hi₂
    simp [initialSegment, pairSequences]

/-- Zipping two sequences is continuous in the product topologies.-/
theorem continuous_pairSequences [TopologicalSpace A] [TopologicalSpace B] :
    Continuous (pairSequences : ((ℕ → A) × (ℕ → B)) → ℕ → A × B) := by
  exact continuous_pi fun n =>
    ((continuous_apply n).comp continuous_fst).prodMk
      ((continuous_apply n).comp continuous_snd)

/-- Split a sequence over a product alphabet into its two coordinate sequences.-/
def unpairSequences (z : ℕ → A × B) : (ℕ → A) × (ℕ → B) :=
  (fun n => (z n).1, fun n => (z n).2)

/-- Splitting a sequence over a product alphabet is continuous.-/
theorem continuous_unpairSequences [TopologicalSpace A] [TopologicalSpace B] :
    Continuous (unpairSequences : (ℕ → A × B) → (ℕ → A) × (ℕ → B)) := by
  exact (continuous_pi fun n => (continuous_apply n).fst).prodMk
    (continuous_pi fun n => (continuous_apply n).snd)

/-- Coordinatewise pairing is a homeomorphism between paired and product-alphabet sequences.-/
def pairSequencesHomeomorph [TopologicalSpace A] [TopologicalSpace B] :
    ((ℕ → A) × (ℕ → B)) ≃ₜ (ℕ → A × B) where
  toFun := pairSequences
  invFun := unpairSequences
  left_inv p := by
    ext n <;> rfl
  right_inv z := by
    ext n <;> rfl
  continuous_toFun := continuous_pairSequences
  continuous_invFun := continuous_unpairSequences

@[simp]
theorem pairSequencesHomeomorph_apply [TopologicalSpace A] [TopologicalSpace B]
    (p : (ℕ → A) × (ℕ → B)) : pairSequencesHomeomorph p = pairSequences p :=
  rfl

@[simp]
theorem pairSequencesHomeomorph_symm_apply [TopologicalSpace A] [TopologicalSpace B]
    (z : ℕ → A × B) :
    (pairSequencesHomeomorph (A := A) (B := B)).symm z = unpairSequences z :=
  rfl

/-- The body of a product-alphabet tree, expressed on a pair of sequence spaces.-/
def pairedBody (T : Descriptive.tree (A × B)) : Set ((ℕ → A) × (ℕ → B)) :=
  pairSequences ⁻¹' body T

/-- The paired body of a product-alphabet tree is closed.-/
theorem isClosed_pairedBody [TopologicalSpace A] [DiscreteTopology A]
    [TopologicalSpace B] [DiscreteTopology B] (T : Descriptive.tree (A × B)) :
    IsClosed (pairedBody T) :=
  (isClosed_body T).preimage continuous_pairSequences

/-- Project a product-alphabet tree body onto its first sequence coordinate.-/
def projectedBody (T : Descriptive.tree (A × B)) : Set (ℕ → A) :=
  Prod.fst '' pairedBody T

@[simp]
theorem mem_projectedBody {T : Descriptive.tree (A × B)} {x : ℕ → A} :
    x ∈ projectedBody T ↔ ∃ y : ℕ → B, pairSequences (x, y) ∈ body T := by
  constructor
  · rintro ⟨p, hp, rfl⟩
    exact ⟨p.2, hp⟩
  · rintro ⟨y, hy⟩
    exact ⟨(x, y), hy, rfl⟩

/-- The projection of a product-alphabet tree body is analytic in mathlib's sense.-/
theorem analyticSet_projectedBody [TopologicalSpace A] [DiscreteTopology A]
    [TopologicalSpace B] [DiscreteTopology B] [PolishSpace (ℕ → A)]
    [PolishSpace (ℕ → B)] (T : Descriptive.tree (A × B)) :
    MeasureTheory.AnalyticSet (projectedBody T) := by
  exact (isClosed_pairedBody T).analyticSet.image_of_continuous continuous_fst

end DescriptiveSetTheory.Tree
