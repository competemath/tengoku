module

public import Tengoku.T3ModelCompanion.T3.GroupTheory.Subgroup
public import Tengoku.T3ModelCompanion.T3.GroupTheory.Roots.DefectBasis
public import Tengoku.T3ModelCompanion.T3.GroupTheory.Roots.SharedTriple

