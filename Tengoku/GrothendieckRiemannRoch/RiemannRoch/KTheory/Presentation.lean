import Tengoku.Seed.Algebra.BigOperators.Finsupp.Basic
import Tengoku.Seed.Algebra.Group.Subgroup.Basic
import Tengoku.Seed.Algebra.Group.Subgroup.Lattice
import Tengoku.Seed.Data.Finsupp.SMul
import Tengoku.Seed.GroupTheory.QuotientGroup.Basic
import Tengoku.Seed.Tactic.Abel

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Grothendieck groups presented by exact triples

This is the additive foundation needed by higher-dimensional Riemann--Roch. Given a type of
objects and a predicate `Exact A B C`, the group is generated by object classes with the genuine
relations `[B] = [A] + [C]`. The construction is a quotient of the free abelian group, and the
universal additive lift is proved rather than postulated.

Future geometric layers instantiate `Object` by vector bundles, perfect complexes, or coherent
sheaves and `Exact` by the corresponding exact-sequence predicate.
-/

noncomputable section

open scoped BigOperators

universe u v w

namespace ExactGrothendieck

variable (Object : Type u) (Exact : Object → Object → Object → Prop)

/-- The free relation associated to an exact triple `0 → A → B → C → 0`.-/
def relation (A B C : Object) : Object →₀ ℤ :=
  Finsupp.single B 1 - Finsupp.single A 1 - Finsupp.single C 1

/-- The set of exact-sequence relations.-/
def relationSet : Set (Object →₀ ℤ) :=
  {z | ∃ A B C, Exact A B C ∧ z = relation Object A B C}

/-- The subgroup generated by all exact-sequence relations.-/
def relations : AddSubgroup (Object →₀ ℤ) :=
  AddSubgroup.closure (relationSet Object Exact)

/-- The Grothendieck group presented by exact triples.-/
abbrev Group := (Object →₀ ℤ) ⧸ relations Object Exact

/-- The class of an object in the Grothendieck group.-/
def classOf (A : Object) : Group Object Exact :=
  QuotientAddGroup.mk' (relations Object Exact) (Finsupp.single A 1)

/-- A declared exact triple gives the defining Grothendieck-group relation.-/
theorem classOf_middle (A B C : Object) (h : Exact A B C) :
    classOf Object Exact B = classOf Object Exact A + classOf Object Exact C := by
  change (QuotientAddGroup.mk' (relations Object Exact)) (Finsupp.single B 1) =
    (QuotientAddGroup.mk' (relations Object Exact)) (Finsupp.single A 1) +
      (QuotientAddGroup.mk' (relations Object Exact)) (Finsupp.single C 1)
  rw [← map_add]
  apply QuotientAddGroup.eq_iff_sub_mem.mpr
  apply AddSubgroup.subset_closure
  refine ⟨A, B, C, h, ?_⟩
  simp only [relation, sub_eq_add_neg]
  abel

/-- Additive maps out of the Grothendieck group are determined by object classes.-/
theorem hom_ext {A : Type v} [AddCommGroup A]
    {f g : Group Object Exact →+ A}
    (h : ∀ x, f (classOf Object Exact x) = g (classOf Object Exact x)) : f = g := by
  apply QuotientAddGroup.addMonoidHom_ext (relations Object Exact)
  apply Finsupp.liftAddHom.symm.injective
  funext x
  apply AddMonoidHom.ext
  intro n
  change f ((QuotientAddGroup.mk' (relations Object Exact)) (Finsupp.single x n)) =
    g ((QuotientAddGroup.mk' (relations Object Exact)) (Finsupp.single x n))
  have hsingle : Finsupp.single x n = n • Finsupp.single x (1 : ℤ) :=
    (Finsupp.smul_single_one x n).symm
  simp only [hsingle, map_zsmul]
  exact congrArg (fun z => n • z) (h x)

section Universal

variable {Object Exact} {A : Type v} [AddCommGroup A]

/-- The additive extension of a function on generators to the free abelian group.-/
def freeLift (f : Object → A) : (Object →₀ ℤ) →+ A :=
  Finsupp.liftAddHom fun x =>
    { toFun := fun n => n • f x
      map_zero' := zero_zsmul (f x)
      map_add' := fun m n => add_zsmul (f x) m n }

@[simp]
theorem freeLift_single (f : Object → A) (x : Object) (n : ℤ) :
    freeLift f (Finsupp.single x n) = n • f x :=
  Finsupp.liftAddHom_apply_single _ _ _

/-- An exact-additive function kills the subgroup of defining relations.-/
theorem relations_le_ker (f : Object → A)
    (hadd : ∀ A B C, Exact A B C → f B = f A + f C) :
    relations Object Exact ≤ (freeLift f).ker := by
  change AddSubgroup.closure (relationSet Object Exact) ≤ (freeLift f).ker
  rw [AddSubgroup.closure_le]
  rintro z ⟨A, B, C, h, rfl⟩
  change freeLift f (relation Object A B C) = 0
  simp only [relation, map_sub, freeLift_single, one_zsmul]
  rw [hadd A B C h]
  abel

/-- Universal additive lift from the exact Grothendieck group.-/
def lift (f : Object → A)
    (hadd : ∀ A B C, Exact A B C → f B = f A + f C) :
    Group Object Exact →+ A :=
  QuotientAddGroup.lift (relations Object Exact) (freeLift f) (relations_le_ker f hadd)

@[simp]
theorem lift_classOf (f : Object → A)
    (hadd : ∀ A B C, Exact A B C → f B = f A + f C) (x : Object) :
    lift f hadd (classOf Object Exact x) = f x := by
  change (QuotientAddGroup.lift (relations Object Exact) (freeLift f) _)
      ((QuotientAddGroup.mk' (relations Object Exact)) (Finsupp.single x 1)) = f x
  erw [QuotientAddGroup.lift_mk']
  rw [freeLift_single, one_zsmul]

end Universal

section Functoriality

variable {Object Exact}
variable {Object' : Type v} {Exact' : Object' → Object' → Object' → Prop}

/-- The map on exact Grothendieck groups induced by an exact-triple-preserving object map.-/
def map (F : Object → Object')
    (hF : ∀ A B C, Exact A B C → Exact' (F A) (F B) (F C)) :
    Group Object Exact →+ Group Object' Exact' :=
  lift (fun E => classOf Object' Exact' (F E)) fun A B C h =>
    classOf_middle Object' Exact' (F A) (F B) (F C) (hF A B C h)

@[simp]
theorem map_classOf (F : Object → Object')
    (hF : ∀ A B C, Exact A B C → Exact' (F A) (F B) (F C)) (E : Object) :
    map F hF (classOf Object Exact E) = classOf Object' Exact' (F E) :=
  lift_classOf _ _ _

/-- The identity object map induces the identity on the Grothendieck group.-/
theorem map_id :
    map (Object := Object) (Exact := Exact) (Object' := Object) (Exact' := Exact)
        (fun E => E) (fun _ _ _ h => h) =
      AddMonoidHom.id (Group Object Exact) := by
  apply hom_ext Object Exact
  intro E
  simp

variable {Object'' : Type w} {Exact'' : Object'' → Object'' → Object'' → Prop}

/-- Maps induced on Grothendieck groups respect composition.-/
theorem map_comp (F : Object → Object')
    (hF : ∀ A B C, Exact A B C → Exact' (F A) (F B) (F C))
    (G : Object' → Object'')
    (hG : ∀ A B C, Exact' A B C → Exact'' (G A) (G B) (G C)) :
    (map G hG).comp (map F hF) =
      map (fun E => G (F E)) (fun A B C h => hG (F A) (F B) (F C) (hF A B C h)) := by
  apply hom_ext Object Exact
  intro E
  simp

end Functoriality

end ExactGrothendieck
