import Tengoku.GrothendieckRiemannRoch.RiemannRoch.CharacteristicClasses.ProjectiveSpace
import Tengoku.Seed.LinearAlgebra.Dual.Lemmas

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Degree-one point evaluations on standard projective space

The divisor moving theorem consumes a linear-system datum whose geometric core is a family of
point evaluations: a functional on the section space for every ambient point, vanishing on the
sections through the point, and nonzero because some section misses the point.  This file
constructs that evaluation layer for the degree-one part of the standard graded polynomial ring
on `ℙⁿ_k`.

* `vanishingSubspace` — the degree-one sections lying in the homogeneous prime of a point;
* `exists_not_mem_vanishingSubspace` — properness: a point of `Proj` is a relevant prime, so if
  every coordinate lay in it the whole irrelevant ideal would;
* `pointEvaluation` — a functional vanishing exactly where required and nonzero, obtained from
  the quotient by the vanishing subspace and dual separation for modules over a field;
* `mem_basicOpen_of_pointEvaluation_ne_zero` — the geometric reading: a section with nonzero
  evaluation places the point in that section's basic open, which is the exact avoidance
  statement the chart machinery consumes.

The divisor cycle of a section and its linear-equivalence class are the remaining half of the
linear-system datum; they require the hyperplane closed immersion and its principal chart
kernels and are deliberately not constructed here.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory

universe u

namespace SchemeProjectiveSpace

attribute [local instance] gradedAlgebra

variable (k : Type u) [Field k] (n : ℕ)

/-- Every homogeneous element of positive degree lies in the ideal generated by the
coordinates.-/
theorem mem_span_range_X_of_mem_grading {d : ℕ} (hd : d ≠ 0)
    {p : Polynomial k n} (hp : p ∈ grading k n d) :
    p ∈ Ideal.span (Set.range (MvPolynomial.X (R := k) (σ := Fin (n + 1)))) := by
  rw [show Set.range (MvPolynomial.X (R := k)) =
      MvPolynomial.X '' (Set.univ : Set (Fin (n + 1))) by simp]
  rw [MvPolynomial.mem_ideal_span_X_image]
  intro m hm
  have hdeg : m.degree = d := by
    rw [Finsupp.degree_eq_weight_one]
    exact hp (Finsupp.mem_support_iff.mp hm)
  have hm0 : m ≠ 0 := by
    intro hm0
    subst m
    simp at hdeg
    omega
  obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
  exact ⟨i, Set.mem_univ _, hi⟩

/-- The degree-one sections vanishing at a point of projective space form a subspace of the
section space.-/
def vanishingSubspace (x : space k n) : Submodule k (grading k n 1) where
  carrier := {s | (s : Polynomial k n) ∈ x.asHomogeneousIdeal.toIdeal}
  add_mem' := fun ha hb ↦ Ideal.add_mem _ ha hb
  zero_mem' := Ideal.zero_mem _
  smul_mem' := fun a s hs ↦ by
    change ((a • s : grading k n 1) : Polynomial k n) ∈ x.asHomogeneousIdeal.toIdeal
    rw [Submodule.coe_smul]
    exact Submodule.smul_of_tower_mem _ a hs

/-- Some degree-one section misses any given point: otherwise the coordinates, hence the whole
irrelevant ideal, would lie in the point's homogeneous prime, contradicting relevance.-/
theorem exists_not_mem_vanishingSubspace (x : space k n) :
    ∃ s : grading k n 1, (s : Polynomial k n) ∉ x.asHomogeneousIdeal.toIdeal := by
  by_contra h
  simp only [not_exists, not_not] at h
  have hle : (HomogeneousIdeal.irrelevant (grading k n)).toIdeal ≤
      x.asHomogeneousIdeal.toIdeal := by
    rw [HomogeneousIdeal.toIdeal_irrelevant_le]
    intro d hd p hp
    have hspan : Ideal.span (Set.range (MvPolynomial.X (R := k) (σ := Fin (n + 1)))) ≤
        x.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact h ⟨coordinate k n i, coordinate_mem_degree_one k n i⟩
    exact hspan (mem_span_range_X_of_mem_grading k n hd.ne' hp)
  exact x.not_irrelevant_le (fun y hy ↦ hle hy)

/-- There is a functional on the degree-one section space that vanishes on every section through
a given point and is nonzero on some section.-/
theorem exists_pointEvaluation (x : space k n) :
    ∃ φ : Module.Dual k (grading k n 1),
      (∀ s : grading k n 1,
        (s : Polynomial k n) ∈ x.asHomogeneousIdeal.toIdeal → φ s = 0) ∧
      ∃ s : grading k n 1, φ s ≠ 0 := by
  obtain ⟨w, hw⟩ := exists_not_mem_vanishingSubspace k n x
  have hwq : (vanishingSubspace k n x).mkQ w ≠ 0 := by
    rw [Submodule.mkQ_apply, ne_eq, Submodule.Quotient.mk_eq_zero]
    exact hw
  obtain ⟨ψ, hψ⟩ := Module.Projective.exists_dual_ne_zero k hwq
  refine ⟨ψ ∘ₗ (vanishingSubspace k n x).mkQ, ?_, ⟨w, ?_⟩⟩
  · intro s hs
    have hs0 : (vanishingSubspace k n x).mkQ s = 0 := by
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      exact hs
    rw [LinearMap.comp_apply, hs0, map_zero]
  · simpa using hψ

/-- The chosen point evaluation: a functional on degree-one sections vanishing on the sections
through the point and nonzero on some section.-/
noncomputable def pointEvaluation (x : space k n) :
    Module.Dual k (grading k n 1) :=
  (exists_pointEvaluation k n x).choose

end SchemeProjectiveSpace
