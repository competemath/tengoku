import Tengoku.Seed.RingTheory.Regular.RegularSequence
import Tengoku.Seed.RingTheory.MvPolynomial.Ideal

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Route CIIL1D, leaf `KoszulChartAlgebra`: coordinate variables are a weakly regular sequence

The pure-algebra core of the zero-section chart: over an arbitrary commutative ring `R`, the
variables `X₀, …, X_{n-1}` form a weakly regular sequence in `R[X₀, …, X_{n-1}]`
(`isWeaklyRegular_X_ofFn`), by the monomial criterion for ideals generated by variables.
-/

set_option autoImplicit false
noncomputable section
open MvPolynomial

namespace SchemeKTheory.KoszulChartAlgebra

variable (R : Type*) [CommRing R]

theorem mem_ofList_X_take {n : ℕ} (i : ℕ) (p : MvPolynomial (Fin n) R) :
    p ∈ Ideal.ofList ((List.ofFn (fun j : Fin n => (X j : MvPolynomial (Fin n) R))).take i) ↔
      ∀ m ∈ p.support, ∃ j : Fin n, (j : ℕ) < i ∧ m j ≠ 0 := by
  have h : { r | r ∈ (List.ofFn (fun j : Fin n => (X j : MvPolynomial (Fin n) R))).take i } =
      (X '' {j : Fin n | (j : ℕ) < i} : Set (MvPolynomial (Fin n) R)) := by
    ext r
    simp only [Set.mem_ofPred_eq, Set.mem_image]
    constructor
    · intro hr
      obtain ⟨k, hk, rfl⟩ := List.mem_iff_getElem.mp hr
      simp only [List.getElem_take, List.getElem_ofFn] at *
      refine ⟨⟨k, by simp at hk; omega⟩, ?_, rfl⟩
      simp at hk; exact lt_of_lt_of_le hk.1 le_rfl
    · rintro ⟨j, hj, rfl⟩
      refine List.mem_iff_getElem.mpr ⟨j, ?_, ?_⟩
      · simp; omega
      · simp
  rw [Ideal.ofList, h, mem_ideal_span_X_image]
  simp only [Set.mem_ofPred_eq]

/-- The augmentation ideal of `R[X₀, …, X_{n-1}]` (kernel of the constant coefficient) is
generated by the variables.-/
theorem ker_constantCoeff_eq_span_X (n : ℕ) :
    RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin n) R →+* R) =
      Ideal.span (Set.range (fun j : Fin n => (X j : MvPolynomial (Fin n) R))) := by
  ext p
  rw [RingHom.mem_ker]
  have h : Set.range (fun j : Fin n => (X j : MvPolynomial (Fin n) R)) =
      (X '' (Set.univ : Set (Fin n)) : Set (MvPolynomial (Fin n) R)) := by
    ext r; simp
  rw [h, mem_ideal_span_X_image]
  constructor
  · intro h0 m hm
    by_contra hcon
    push Not at hcon
    have : m = 0 := by
      ext i; simpa using hcon i trivial
    subst this
    apply (mem_support_iff.mp hm)
    simpa [constantCoeff_eq] using h0
  · intro h
    by_contra h0
    have hm : (0 : Fin n →₀ ℕ) ∈ p.support := by
      rw [mem_support_iff]; simpa [constantCoeff_eq] using h0
    obtain ⟨i, -, hi⟩ := h _ hm
    simp at hi

end SchemeKTheory.KoszulChartAlgebra
