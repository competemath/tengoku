import Tengoku.Seed.Algebra.Algebra.Equiv
import Tengoku.Seed.Algebra.Polynomial.Degree.IsMonicOfDegree
import Tengoku.Seed.LinearAlgebra.Basis.Basic
import Tengoku.Seed.RingTheory.AdjoinRoot

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Algebraic normal form for the projective-bundle formula

For a commutative coefficient ring `A`, a rank `r`, and lower coefficients
`a₀, ..., aᵣ₋₁`, this file packages the monic quotient

`A[ξ] / (ξʳ + ∑ i < r, aᵢ ξⁱ)`.

Its distinguished element `ξ` satisfies the displayed relation, and
`1, ξ, ..., ξʳ⁻¹` is an `A`-basis.  Thus the quotient is canonically equivalent, as an
`A`-module, to the finite direct sum `Fin r →₀ A`.  This is the algebraic normal form used by
both the Chow and `K₀` projective-bundle formulas; the later geometric step is to construct the
comparison homomorphism and prove that it is an isomorphism.
-/

set_option autoImplicit false

noncomputable section

open Polynomial

universe u v

namespace SchemeProjectiveBundle

variable (A : Type u) [CommRing A] (r : ℕ)

/-- The lower-degree part of a monic projective-bundle relation.-/
def projectiveBundleRelationLower (a : Fin r → A) : A[X] :=
  ∑ i : Fin r, C (a i) * X ^ (i : ℕ)

/-- The monic relation whose root is the tautological generator in the algebraic model.-/
def projectiveBundleRelationPolynomial (a : Fin r → A) : A[X] :=
  X ^ r + projectiveBundleRelationLower A r a

/--
@isnad1 id=lt.0h3v.s5.9a97d7d9c959 from=translated src=- shape=d4bf4ea6 vocab=5c62c20d
-/
theorem projectiveBundleRelationLower_degree_lt (a : Fin r → A) :
    (projectiveBundleRelationLower A r a).degree < r := by
  exact degree_sum_fin_lt a

/--
@isnad1 id=ismonico.0h3v.s4.8c1d2791cd0e from=translated src=- shape=3590a353 vocab=bfd272ca
-/
theorem projectiveBundleRelationPolynomial_isMonicOfDegree
    [Nontrivial A] (a : Fin r → A) :
    (projectiveBundleRelationPolynomial A r a).IsMonicOfDegree r := by
  by_cases hr : r = 0
  · subst r
    simp [projectiveBundleRelationPolynomial, projectiveBundleRelationLower]
  · refine (isMonicOfDegree_X_pow A r).add_right ?_
    let q := projectiveBundleRelationLower A r a
    change q.natDegree < r
    by_cases hq : q = 0
    · rw [hq, natDegree_zero]
      exact Nat.pos_of_ne_zero hr
    · exact (natDegree_lt_iff_degree_lt hq).2
        (projectiveBundleRelationLower_degree_lt A r a)

/--
@isnad1 id=monic.0h3v.s4.c013f2de8e15 from=translated src=- shape=eac0b288 vocab=4056fb32
-/
theorem projectiveBundleRelationPolynomial_monic
    [Nontrivial A] (a : Fin r → A) :
    (projectiveBundleRelationPolynomial A r a).Monic :=
  (projectiveBundleRelationPolynomial_isMonicOfDegree A r a).monic

/--
@isnad1 id=eq.0h3v.s4.eecc135f1f30 from=translated src=- shape=5b3b2c09 vocab=682032c2
-/
theorem projectiveBundleRelationPolynomial_natDegree
    [Nontrivial A] (a : Fin r → A) :
    (projectiveBundleRelationPolynomial A r a).natDegree = r :=
  (projectiveBundleRelationPolynomial_isMonicOfDegree A r a).natDegree_eq

/-- The universal commutative ring generated by one class subject to a monic relation of
degree `r`.-/
abbrev ProjectiveBundleFormulaModel [Nontrivial A] (a : Fin r → A) :=
  AdjoinRoot (projectiveBundleRelationPolynomial A r a)

namespace ProjectiveBundleFormulaModel

variable [Nontrivial A] (a : Fin r → A)

/-- The distinguished generator of the projective-bundle formula model.-/
def xi : ProjectiveBundleFormulaModel A r a :=
  AdjoinRoot.root (projectiveBundleRelationPolynomial A r a)

/-- The canonical power basis `1, ξ, ..., ξʳ⁻¹`.-/
noncomputable def basis :
    Module.Basis (Fin r) A (ProjectiveBundleFormulaModel A r a) :=
  (AdjoinRoot.powerBasis'
      (projectiveBundleRelationPolynomial_monic A r a)).basis.reindex
    (finCongr (projectiveBundleRelationPolynomial_natDegree A r a))

/-- Coefficients in the unique expansion in powers of `ξ`.-/
noncomputable def coefficientEquiv :
    ProjectiveBundleFormulaModel A r a ≃ₗ[A] Fin r →₀ A :=
  (basis A r a).repr

/-- Reconstruct an element of the model from its finite coefficient vector.-/
noncomputable def ofCoefficients :
    (Fin r →₀ A) ≃ₗ[A] ProjectiveBundleFormulaModel A r a :=
  (coefficientEquiv A r a).symm

/--
@isnad1 id=eq.0h4v.s10.014d30f3f356 from=translated src=- shape=69a61c69 vocab=62b48d1a
-/
@[simp]
theorem coefficientEquiv_ofCoefficients (c : Fin r →₀ A) :
    coefficientEquiv A r a (ofCoefficients A r a c) = c :=
  (coefficientEquiv A r a).apply_symm_apply c

/--
@isnad1 id=eq.0h4v.s10.4f7d1739eaa6 from=translated src=- shape=ada8cc58 vocab=62b48d1a
-/
@[simp]
theorem ofCoefficients_coefficientEquiv
    (x : ProjectiveBundleFormulaModel A r a) :
    ofCoefficients A r a (coefficientEquiv A r a x) = x :=
  (coefficientEquiv A r a).symm_apply_apply x

/-- The tautological generator satisfies the chosen monic relation.
@isnad1 id=eq.0h3v.s8.bdb9b9c39a84 from=translated src=- shape=e2f1ef50 vocab=0becaa55
-/
theorem aeval_relation :
    aeval (xi A r a) (projectiveBundleRelationPolynomial A r a) = 0 := by
  exact AdjoinRoot.eval₂_root (projectiveBundleRelationPolynomial A r a)

/-- Expanded form of the tautological relation.
@isnad1 id=eq.0h3v.s8.bfef039bd21d from=translated src=- shape=4a01f0d3 vocab=fce4734c
-/
theorem xi_pow_rank :
    xi A r a ^ r =
      -∑ i : Fin r, algebraMap A (ProjectiveBundleFormulaModel A r a) (a i) *
        xi A r a ^ (i : ℕ) := by
  have h := aeval_relation A r a
  simp only [projectiveBundleRelationPolynomial,
    projectiveBundleRelationLower, map_add, aeval_X_pow,
    map_sum, aeval_mul, aeval_C] at h
  exact eq_neg_of_add_eq_zero_left h

/-- Evaluation at any root of the relation gives an algebra homomorphism out of the model.-/
noncomputable def lift
    {B : Type v} [CommRing B] [Algebra A B]
    (y : B)
    (hy : aeval y (projectiveBundleRelationPolynomial A r a) = 0) :
    ProjectiveBundleFormulaModel A r a →ₐ[A] B := by
  let i : A →ₐ[A] B := Algebra.ofId A B
  have hi : i.toRingHom = algebraMap A B := by
    simp [i]
  exact AdjoinRoot.liftAlgHom
    (projectiveBundleRelationPolynomial A r a) i y (by
      change eval₂ i.toRingHom y
        (projectiveBundleRelationPolynomial A r a) = 0
      rw [hi]
      simpa only [aeval_def] using hy)

/--
@isnad1 id=eq.1h5v.s8.5a7e727a831a from=translated src=- shape=9993a7b7 vocab=9ab42af7
-/
@[simp]
theorem lift_xi
    {B : Type v} [CommRing B] [Algebra A B]
    (y : B)
    (hy : aeval y (projectiveBundleRelationPolynomial A r a) = 0) :
    lift A r a y hy (xi A r a) = y := by
  exact AdjoinRoot.liftAlgHom_root _ _ _ _

/-- The evaluation homomorphism is the unique `A`-algebra map taking `ξ` to the chosen root.
@isnad1 id=eq.2h6v.s8.ee7309105e26 from=translated src=- shape=551ae066 vocab=9ab42af7
-/
theorem lift_unique
    {B : Type v} [CommRing B] [Algebra A B]
    (y : B)
    (hy : aeval y (projectiveBundleRelationPolynomial A r a) = 0)
    (f : ProjectiveBundleFormulaModel A r a →ₐ[A] B)
    (hf : f (xi A r a) = y) :
    f = lift A r a y hy := by
  apply AdjoinRoot.algHom_ext
  change f (xi A r a) = lift A r a y hy (xi A r a)
  rw [hf, lift_xi]

omit [Nontrivial A] in
/-- A positive-rank power basis in the target makes its structural map from the coefficient
ring injective.  Once the geometric projective-bundle comparison supplies such a basis, this
is precisely the pullback-injectivity conclusion used by the splitting principle.
@isnad1 id=injectiv.2h5v.s7.d32dc9a3028e from=translated src=- shape=53c16af0 vocab=7cb682fa
-/
theorem algebraMap_injective_of_power_basis
    {B : Type v} [CommRing B] [Algebra A B]
    (hr : 0 < r)
    (y : B)
    (b : Module.Basis (Fin r) A B)
    (hb : ∀ i : Fin r, b i = y ^ (i : ℕ)) :
    Function.Injective (algebraMap A B) := by
  let i0 : Fin r := ⟨0, hr⟩
  intro x z hxz
  have hsmul :
      x • b i0 = z • b i0 := by
    rw [hb i0]
    simpa [i0, Algebra.smul_def] using hxz
  have hcoord := congrArg (fun w ↦ b.repr w i0) hsmul
  simpa using hcoord

end ProjectiveBundleFormulaModel

/-- Convert positive Chern coefficients `c₁, ..., cᵣ` to the ascending lower coefficients of
the standard relation

`ξʳ - c₁ ξʳ⁻¹ + c₂ ξʳ⁻² - ... + (-1)ʳ cᵣ = 0`.-/
def chernRelationCoefficients (c : Fin r → A) : Fin r → A :=
  fun i ↦ (-1 : A) ^ ((Fin.rev i : ℕ) + 1) * c (Fin.rev i)

/-- The projective-bundle formula model with the standard alternating Chern relation.-/
abbrev ChernProjectiveBundleFormulaModel [Nontrivial A] (c : Fin r → A) :=
  ProjectiveBundleFormulaModel A r (chernRelationCoefficients A r c)

/-- The tautological generator in the model with the alternating Chern relation.-/
def chernXi [Nontrivial A] (c : Fin r → A) :
    ChernProjectiveBundleFormulaModel A r c :=
  ProjectiveBundleFormulaModel.xi A r (chernRelationCoefficients A r c)

/-- The alternating Chern relation in its ascending-coefficient normal form.
@isnad1 id=eq.0h3v.s9.08a3aec2f6c0 from=translated src=- shape=bc006f2b vocab=6c2391c2
-/
theorem chernXi_pow_rank [Nontrivial A] (c : Fin r → A) :
    chernXi A r c ^ r =
      -∑ i : Fin r,
        algebraMap A (ChernProjectiveBundleFormulaModel A r c)
            ((-1 : A) ^ ((Fin.rev i : ℕ) + 1) * c (Fin.rev i)) *
          chernXi A r c ^ (i : ℕ) := by
  exact ProjectiveBundleFormulaModel.xi_pow_rank A r
    (chernRelationCoefficients A r c)

/-- The powers of the Chern-model generator form the canonical direct-sum basis.-/
noncomputable def chernBasis [Nontrivial A] (c : Fin r → A) :
    Module.Basis (Fin r) A (ChernProjectiveBundleFormulaModel A r c) :=
  ProjectiveBundleFormulaModel.basis A r
    (chernRelationCoefficients A r c)

end SchemeProjectiveBundle
