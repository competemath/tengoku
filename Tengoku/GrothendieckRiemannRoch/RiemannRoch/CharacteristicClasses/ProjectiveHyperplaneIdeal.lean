import Tengoku.GrothendieckRiemannRoch.RiemannRoch.CharacteristicClasses.ProjectiveHyperplane
import Tengoku.GrothendieckRiemannRoch.RiemannRoch.CharacteristicClasses.ProjectiveQuotient
import Tengoku.Seed.RingTheory.Localization.Algebra

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Hyperplanes as projective closed subschemes

This file applies the homogeneous-quotient construction to a degree-one equation.  On every
degree-one basic open, it computes the kernel of the induced map of homogeneous away rings: it
is generated by the degree-zero fraction `s / f`.  For standard projective space, taking `f` to
be a coordinate gives the principal affine equations of the hyperplane cut out by `s`.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory DirectSum HomogeneousLocalization

universe u

namespace GradedIdealQuotient

variable {R A : Type u} [CommRing R] [CommRing A] [Algebra R A]
variable (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]

/-- The homogeneous principal ideal generated by a homogeneous element.-/
def principalIdeal {d : ℕ} (s : A) (hs : s ∈ 𝒜 d) : HomogeneousIdeal 𝒜 where
  __ := Ideal.span {s}
  is_homogeneous' := Ideal.homogeneous_span 𝒜 {s} (by
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst x
    exact ⟨d, hs⟩)

/--
@isnad1 id=eq.1h5v.s8.b5860e4542f8 from=translated src=- shape=3ef0c7e2 vocab=c6bd8eec
-/
@[simp]
theorem principalIdeal_toIdeal {d : ℕ} (s : A) (hs : s ∈ 𝒜 d) :
    (principalIdeal 𝒜 s hs).toIdeal = Ideal.span {s} :=
  rfl

/-- The degree-zero equation `s / f` on the degree-one basic open `D₊(f)`.-/
def awayEquation (s f : A) (hs : s ∈ 𝒜 1) (hf : f ∈ 𝒜 1) :
    HomogeneousLocalization.Away 𝒜 f :=
  HomogeneousLocalization.Away.mk 𝒜 hf 1 s (by simpa using hs)

/-- The quotient map on a degree-one basic open has principal kernel generated by `s / f`.
@isnad1 id=eq.2h5v.s15.bb5040ee9bdd from=translated src=- shape=d645933f vocab=4e6d8faf
-/
theorem ker_awayMap_principal (s f : A) (hs : s ∈ 𝒜 1) (hf : f ∈ 𝒜 1) :
    RingHom.ker (HomogeneousLocalization.Away.map
      (quotientMap 𝒜 (principalIdeal 𝒜 s hs)) f) =
      Ideal.span {awayEquation 𝒜 s f hs hf} := by
  apply le_antisymm
  · intro z hz
    obtain ⟨m, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hf z
    rw [RingHom.mem_ker] at hz
    have hzval := congrArg HomogeneousLocalization.val hz
    simp only [HomogeneousLocalization.Away.map_mk,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_zero] at hzval
    rw [Localization.mk_eq_mk'] at hzval
    obtain ⟨⟨_, r, rfl⟩, hr⟩ := (IsLocalization.mk'_eq_zero_iff _ _).mp hzval
    have hmem : f ^ r * a ∈ (principalIdeal 𝒜 s hs).toIdeal := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      simpa only [quotientMap_apply, map_mul, map_pow] using hr
    rw [principalIdeal_toIdeal, Ideal.mem_span_singleton'] at hmem
    obtain ⟨b, hb⟩ := hmem
    let b' : 𝒜 (r + m) := DirectSum.decompose 𝒜 (b * f) (r + m)
    have hb' : (b' : A) * s = f ^ (r + 1) * a := by
      have hmul : (b * f) * s = f ^ (r + 1) * a := by
        calc
          (b * f) * s = f * (b * s) := by ring
          _ = f * (f ^ r * a) := by rw [hb]
          _ = f ^ (r + 1) * a := by ring
      calc
        (b' : A) * s =
            (DirectSum.decompose 𝒜 ((b * f) * s) ((r + m) + 1) : A) := by
          exact (DirectSum.coe_decompose_mul_add_of_right_mem 𝒜 hs).symm
        _ = (DirectSum.decompose 𝒜 (f ^ (r + 1) * a) ((r + m) + 1) : A) := by
          rw [hmul]
        _ = f ^ (r + 1) * a := by
          apply DirectSum.decompose_of_mem_same
          convert SetLike.mul_mem_graded (SetLike.pow_mem_graded (r + 1) hf) ha using 1 <;>
            simp [add_assoc, add_comm]
    rw [Ideal.mem_span_singleton']
    refine ⟨HomogeneousLocalization.Away.mk 𝒜 hf (r + m) b' (by simpa using b'.2), ?_⟩
    apply HomogeneousLocalization.val_injective
    simp only [awayEquation, HomogeneousLocalization.val_mul,
      HomogeneousLocalization.Away.val_mk, Localization.mk_mul]
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, one_mul, Submonoid.coe_mul]
    rw [hb']
    ring
  · rw [Ideal.span_le]
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    subst z
    change HomogeneousLocalization.Away.map
      (quotientMap 𝒜 (principalIdeal 𝒜 s hs)) f (awayEquation 𝒜 s f hs hf) = 0
    rw [awayEquation, HomogeneousLocalization.Away.map_mk]
    apply HomogeneousLocalization.val_injective
    simp only [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_zero]
    rw [Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, one_mul]
    change Ideal.Quotient.mk (principalIdeal 𝒜 s hs).toIdeal s = 0
    rw [Ideal.Quotient.eq_zero_iff_mem, principalIdeal_toIdeal]
    exact Ideal.subset_span (Set.mem_singleton s)

end GradedIdealQuotient

namespace SchemeProjectiveSpace

attribute [local instance] gradedAlgebra

variable (k : Type u) [Field k] (n : ℕ)

/-- The homogeneous ideal cutting out the hyperplane defined by a degree-one section.-/
abbrev hyperplaneIdeal (s : grading k n 1) : HomogeneousIdeal (grading k n) :=
  GradedIdealQuotient.principalIdeal (grading k n) s s.2

/-- The projective scheme cut out by a degree-one section.-/
noncomputable def hyperplane (s : grading k n 1) : Scheme :=
  Proj (GradedIdealQuotient.grading (grading k n) (hyperplaneIdeal k n s))

/-- The canonical closed immersion of a hyperplane into projective space.-/
noncomputable def hyperplaneι (s : grading k n 1) : hyperplane k n s ⟶ space k n :=
  GradedIdealQuotient.projMap (grading k n) (hyperplaneIdeal k n s)

/-- The affine equation of a hyperplane on the `i`th standard coordinate chart.-/
def hyperplaneChartEquation (s : grading k n 1) (i : Fin (n + 1)) :
    HomogeneousLocalization.Away (grading k n) (coordinate k n i) :=
  GradedIdealQuotient.awayEquation (grading k n) s (coordinate k n i) s.2
    (coordinate_mem_degree_one k n i)

end SchemeProjectiveSpace
