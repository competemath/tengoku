import Tengoku.GrothendieckRiemannRoch.RiemannRoch.Chow.PrincipalBaseChange

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Transport of principal stalk kernels

The affine principal-pullback calculation is useful on an arbitrary scheme only after it can be
transported across the isomorphisms occurring in local charts.  This file isolates that transport
step.  The algebraic engine below says that a commuting square of ring homomorphisms with
isomorphisms on both vertical sides carries a principal kernel to the corresponding principal
kernel.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory Limits

universe u

namespace AlgebraicGeometry.Chow

/-- A commuting square of ring homomorphisms with equivalences on the vertical sides transports
a kernel generated by one element to the kernel generated by its image.-/
theorem ker_eq_span_singleton_of_equiv_commutes
    {A B C D : Type u} [CommRing A] [CommRing B] [CommRing C] [CommRing D]
    (f : A →+* B) (g : C →+* D) (eA : A ≃+* C) (eB : B ≃+* D)
    (h : eB.toRingHom.comp f = g.comp eA.toRingHom)
    (a : A) (hf : RingHom.ker f = Ideal.span {a}) :
    RingHom.ker g = Ideal.span {eA a} := by
  calc
    RingHom.ker g = (RingHom.ker f).map eA := by
      ext c
      rw [Ideal.mem_map_of_equiv]
      constructor
      · intro hc
        refine ⟨eA.symm c, ?_, eA.apply_symm_apply c⟩
        rw [RingHom.mem_ker]
        apply eB.injective
        rw [map_zero]
        calc
          eB (f (eA.symm c)) = g (eA (eA.symm c)) :=
            DFunLike.congr_fun h (eA.symm c)
          _ = g c := by rw [eA.apply_symm_apply]
          _ = 0 := RingHom.mem_ker.mp hc
      · rintro ⟨b, hb, rfl⟩
        rw [RingHom.mem_ker]
        calc
          g (eA b) = eB (f b) := (DFunLike.congr_fun h b).symm
          _ = 0 := by rw [RingHom.mem_ker.mp hb, map_zero]
    _ = Ideal.span {eA a} := by
      rw [hf, Ideal.map_span, Set.image_singleton]

/-- The reverse form of `ker_eq_span_singleton_of_equiv_commutes`: a principal kernel on the
lower-right side of the square pulls back to the inverse image of its generator.-/
theorem ker_eq_span_singleton_of_equiv_commutes_symm
    {A B C D : Type u} [CommRing A] [CommRing B] [CommRing C] [CommRing D]
    (f : A →+* B) (g : C →+* D) (eA : A ≃+* C) (eB : B ≃+* D)
    (h : eB.toRingHom.comp f = g.comp eA.toRingHom)
    (c : C) (hg : RingHom.ker g = Ideal.span {c}) :
    RingHom.ker f = Ideal.span {eA.symm c} := by
  apply ker_eq_span_singleton_of_equiv_commutes g f eA.symm eB.symm _ c hg
  ext x
  apply eB.injective
  calc
    eB (eB.symm (g x)) = g x := eB.apply_symm_apply (g x)
    _ = g (eA (eA.symm x)) := by rw [eA.apply_symm_apply]
    _ = eB (f (eA.symm x)) :=
      (DFunLike.congr_fun h (eA.symm x)).symm

/-- The target-stalk isomorphism induced by an isomorphism between two scheme arrows.  Its first
factor accounts for the equality of the two target points, and its second factor is the stalk map
of the target isomorphism.-/
noncomputable def targetStalkIsoOfArrowIso
    {Z X Z' X' : Scheme.{u}} (i : Z ⟶ X) (j : Z' ⟶ X')
    (eZ : Z ≅ Z') (eX : X ≅ X')
    (h : eZ.hom ≫ j = i ≫ eX.hom) (z : Z) :
    X'.presheaf.stalk (j (eZ.hom z)) ≅ X.presheaf.stalk (i z) :=
  X'.presheaf.stalkCongr (.of_eq (by
    change (eZ.hom ≫ j) z = (i ≫ eX.hom) z
    rw [h])) ≪≫
      asIso (eX.hom.stalkMap (i z))

/-- The source-stalk isomorphism induced by the source isomorphism of two scheme arrows.-/
noncomputable def sourceStalkIsoOfArrowIso
    {Z Z' : Scheme.{u}} (eZ : Z ≅ Z') (z : Z) :
    Z'.presheaf.stalk (eZ.hom z) ≅ Z.presheaf.stalk z :=
  asIso (eZ.hom.stalkMap z)

set_option backward.isDefEq.respectTransparency false in
/-- The stalk square associated to an isomorphism of scheme arrows commutes.-/
theorem stalkMap_square_of_arrow_iso
    {Z X Z' X' : Scheme.{u}} (i : Z ⟶ X) (j : Z' ⟶ X')
    (eZ : Z ≅ Z') (eX : X ≅ X')
    (h : eZ.hom ≫ j = i ≫ eX.hom) (z : Z) :
    j.stalkMap (eZ.hom z) ≫ (sourceStalkIsoOfArrowIso eZ z).hom =
      (targetStalkIsoOfArrowIso i j eZ eX h z).hom ≫ i.stalkMap z := by
  change j.stalkMap (eZ.hom z) ≫ eZ.hom.stalkMap z =
    (X'.presheaf.stalkCongr (.of_eq (by
      change (eZ.hom ≫ j) z = (i ≫ eX.hom) z
      rw [h]))).hom ≫ eX.hom.stalkMap (i z) ≫ i.stalkMap z
  calc
    j.stalkMap (eZ.hom z) ≫ eZ.hom.stalkMap z =
        (eZ.hom ≫ j).stalkMap z :=
      (Scheme.Hom.stalkMap_comp eZ.hom j z).symm
    _ = (X'.presheaf.stalkCongr (.of_eq (h ▸ rfl))).hom ≫
        (i ≫ eX.hom).stalkMap z :=
      Scheme.Hom.stalkMap_congr_hom (eZ.hom ≫ j) (i ≫ eX.hom) h z
    _ = (X'.presheaf.stalkCongr (.of_eq (h ▸ rfl))).hom ≫
        (eX.hom.stalkMap (i z) ≫ i.stalkMap z) := by
      rw [Scheme.Hom.stalkMap_comp]
    _ = ((X'.presheaf.stalkCongr (.of_eq (h ▸ rfl))).hom ≫
        eX.hom.stalkMap (i z)) ≫ i.stalkMap z :=
      (Category.assoc _ _ _).symm

/-- A stalk element in one presentation of a scheme arrow, transported to an isomorphic
presentation.-/
noncomputable def principalStalkElementOfArrowIso
    {Z X Z' X' : Scheme.{u}} (i : Z ⟶ X) (j : Z' ⟶ X')
    (eZ : Z ≅ Z') (eX : X ≅ X')
    (h : eZ.hom ≫ j = i ≫ eX.hom) (z : Z)
    (a : X'.presheaf.stalk (j (eZ.hom z))) : X.presheaf.stalk (i z) :=
  (targetStalkIsoOfArrowIso i j eZ eX h z).hom a

/-- A principal stalk kernel is preserved by an isomorphism of scheme arrows.  This is the
transport interface needed to move the affine principal-pullback calculation through local
scheme charts.-/
theorem ker_stalkMap_eq_span_of_arrow_iso
    {Z X Z' X' : Scheme.{u}} (i : Z ⟶ X) (j : Z' ⟶ X')
    (eZ : Z ≅ Z') (eX : X ≅ X')
    (h : eZ.hom ≫ j = i ≫ eX.hom) (z : Z)
    (a : X'.presheaf.stalk (j (eZ.hom z)))
    (hker : RingHom.ker (j.stalkMap (eZ.hom z)).hom = Ideal.span {a}) :
    RingHom.ker (i.stalkMap z).hom =
      Ideal.span {principalStalkElementOfArrowIso i j eZ eX h z a} := by
  apply ker_eq_span_singleton_of_equiv_commutes
    (j.stalkMap (eZ.hom z)).hom (i.stalkMap z).hom
    (targetStalkIsoOfArrowIso i j eZ eX h z).commRingCatIsoToRingEquiv
    (sourceStalkIsoOfArrowIso eZ z).commRingCatIsoToRingEquiv
    _ a hker
  change ((j.stalkMap (eZ.hom z)) ≫
    (sourceStalkIsoOfArrowIso eZ z).hom).hom =
      ((targetStalkIsoOfArrowIso i j eZ eX h z).hom ≫
        i.stalkMap z).hom
  exact congrArg CommRingCat.Hom.hom
    (stalkMap_square_of_arrow_iso i j eZ eX h z)

/-- A generator for the first projection of the swapped pullback, transported across pullback
symmetry to the target stalk of the original second projection.-/
noncomputable def principalStalkElementOfPullbackSymmetry
    {Z X Y : Scheme.{u}} (i : Z ⟶ Y) (f : X ⟶ Y)
    (z : (pullback i f : Scheme.{u}))
    (a : X.presheaf.stalk
      (pullback.fst f i ((pullbackSymmetry i f).hom z))) :
    X.presheaf.stalk (pullback.snd i f z) :=
  principalStalkElementOfArrowIso
    (pullback.snd i f) (pullback.fst f i)
    (pullbackSymmetry i f) (Iso.refl X) (by
      simpa using pullbackSymmetry_hom_comp_fst i f) z a

/-- A principal-kernel formula for the first projection in the swapped pullback gives the
corresponding formula for the original second projection.-/
theorem ker_stalkMap_pullback_snd_eq_span_of_symmetry
    {Z X Y : Scheme.{u}} (i : Z ⟶ Y) (f : X ⟶ Y)
    (z : (pullback i f : Scheme.{u}))
    (a : X.presheaf.stalk
      (pullback.fst f i ((pullbackSymmetry i f).hom z)))
    (hker : RingHom.ker
      ((pullback.fst f i).stalkMap ((pullbackSymmetry i f).hom z)).hom =
        Ideal.span {a}) :
    RingHom.ker ((pullback.snd i f).stalkMap z).hom =
      Ideal.span {principalStalkElementOfPullbackSymmetry i f z a} := by
  exact ker_stalkMap_eq_span_of_arrow_iso
    (pullback.snd i f) (pullback.fst f i)
    (pullbackSymmetry i f) (Iso.refl X) (by
      simpa using pullbackSymmetry_hom_comp_fst i f) z a hker

/-- Successive transports along equal scheme points agree with direct transport.-/
theorem stalkCongr_comp_apply_of_eq
    (X : Scheme.{u}) {p q r s : X}
    (hpq : p = q) (hqr : q = r) (hrs : r = s) (hps : p = s)
    (a : X.presheaf.stalk p) :
    (X.presheaf.stalkCongr (.of_eq hrs)).hom
        ((X.presheaf.stalkCongr (.of_eq hqr)).hom
          ((X.presheaf.stalkCongr (.of_eq hpq)).hom a)) =
      (X.presheaf.stalkCongr (.of_eq hps)).hom a := by
  subst q
  subst r
  subst s
  simp

/-- Two successive transports along equal scheme points agree with direct transport.-/
theorem stalkCongr_comp_apply_of_eq_two
    (X : Scheme.{u}) {p q r : X}
    (hpq : p = q) (hqr : q = r) (hpr : p = r)
    (a : X.presheaf.stalk p) :
    (X.presheaf.stalkCongr (.of_eq hqr)).hom
        ((X.presheaf.stalkCongr (.of_eq hpq)).hom a) =
      (X.presheaf.stalkCongr (.of_eq hpr)).hom a := by
  subst q
  subst r
  simp

/-- Inverses of isomorphism-valued stalk maps are natural under equality of source points.-/
theorem stalkMap_inv_naturality_of_point_eq
    {X Y : Scheme.{u}} (f : X ⟶ Y) {p q : X} (h : p = q)
    [IsIso (f.stalkMap p)] [IsIso (f.stalkMap q)]
    (a : X.presheaf.stalk p) :
    (asIso (f.stalkMap q)).inv.hom
        ((X.presheaf.stalkCongr (.of_eq h)).hom a) =
      (Y.presheaf.stalkCongr (.of_eq (congrArg f h))).hom
        ((asIso (f.stalkMap p)).inv.hom a) := by
  apply (asIso (f.stalkMap q)).commRingCatIsoToRingEquiv.injective
  change (asIso (f.stalkMap q)).hom.hom
      ((asIso (f.stalkMap q)).inv.hom
        ((X.presheaf.stalkCongr (.of_eq h)).hom a)) =
    (asIso (f.stalkMap q)).hom.hom
      ((Y.presheaf.stalkCongr (.of_eq (congrArg f h))).hom
        ((asIso (f.stalkMap p)).inv.hom a))
  rw [Iso.inv_hom_id_apply]
  have hpoint := ConcreteCategory.congr_hom
    (Scheme.Hom.stalkMap_congr_point f p q h)
      ((asIso (f.stalkMap p)).inv.hom a)
  simp only [ConcreteCategory.comp_apply] at hpoint
  have hp : (f.stalkMap p).hom ((asIso (f.stalkMap p)).inv.hom a) = a := by
    change (asIso (f.stalkMap p)).hom.hom
      ((asIso (f.stalkMap p)).inv.hom a) = a
    exact (asIso (f.stalkMap p)).inv_hom_id_apply a
  rw [hp] at hpoint
  exact hpoint

/-- Transport an ambient stalk element to the description of the same point used by the swapped
pullback square.-/
noncomputable def pullbackSymmetryAmbientStalkElement
    {Z X Y : Scheme.{u}} (i : Z ⟶ Y) (f : X ⟶ Y)
    (z : (pullback i f : Scheme.{u}))
    (a : Y.presheaf.stalk (i (pullback.fst i f z))) :
    Y.presheaf.stalk
      (i (pullback.snd f i ((pullbackSymmetry i f).hom z))) :=
  (Y.presheaf.stalkCongr (.of_eq (congrArg i (by
    change pullback.fst i f z =
      ((pullbackSymmetry i f).hom ≫ pullback.snd f i) z
    rw [pullbackSymmetry_hom_comp_snd])))).hom a

/-- The canonical base-change image formed after swapping the pullback factors, transported
back to the target stalk of the original second projection.-/
noncomputable def pullbackSymmetryBaseChangeStalkElement
    {Z X Y : Scheme.{u}} (i : Z ⟶ Y) (f : X ⟶ Y)
    (z : (pullback i f : Scheme.{u}))
    (a : Y.presheaf.stalk (i (pullback.fst i f z))) :
    X.presheaf.stalk (pullback.snd i f z) :=
  principalStalkElementOfPullbackSymmetry i f z
    (pullbackBaseChangeStalkElement f i ((pullbackSymmetry i f).hom z)
      (pullbackSymmetryAmbientStalkElement i f z a))

/-- Pullback symmetry does not change the canonical image of an ambient stalk element: the
first-projection construction on the swapped square is the second-projection construction on
the original square.-/
theorem pullbackSymmetryBaseChangeStalkElement_eq
    {Z X Y : Scheme.{u}} (i : Z ⟶ Y) (f : X ⟶ Y)
    (z : (pullback i f : Scheme.{u}))
    (a : Y.presheaf.stalk (i (pullback.fst i f z))) :
    pullbackSymmetryBaseChangeStalkElement i f z a =
      pullbackBaseChangeSndStalkElement i f z a := by
  have hZ : pullback.fst i f z =
      pullback.snd f i ((pullbackSymmetry i f).hom z) := by
    change pullback.fst i f z =
      ((pullbackSymmetry i f).hom ≫ pullback.snd f i) z
    rw [pullbackSymmetry_hom_comp_snd]
  have hX : pullback.fst f i ((pullbackSymmetry i f).hom z) =
      pullback.snd i f z := by
    change ((pullbackSymmetry i f).hom ≫ pullback.fst f i) z =
      pullback.snd i f z
    rw [pullbackSymmetry_hom_comp_fst]
  have hSwap :
      i (pullback.snd f i ((pullbackSymmetry i f).hom z)) =
        f (pullback.fst f i ((pullbackSymmetry i f).hom z)) := by
    change (pullback.snd f i ≫ i) ((pullbackSymmetry i f).hom z) =
      (pullback.fst f i ≫ f) ((pullbackSymmetry i f).hom z)
    rw [pullback.condition]
  have hOriginal : i (pullback.fst i f z) = f (pullback.snd i f z) := by
    change (pullback.fst i f ≫ i) z = (pullback.snd i f ≫ f) z
    rw [pullback.condition]
  let b := (Y.presheaf.stalkCongr (.of_eq hSwap)).hom
    ((Y.presheaf.stalkCongr (.of_eq (congrArg i hZ))).hom a)
  have hpointMap :
      (X.presheaf.stalkCongr (.of_eq hX)).hom
          ((f.stalkMap
            (pullback.fst f i ((pullbackSymmetry i f).hom z))).hom b) =
        (f.stalkMap (pullback.snd i f z)).hom
          ((Y.presheaf.stalkCongr (.of_eq (congrArg f hX))).hom b) := by
    simpa only [ConcreteCategory.comp_apply] using
      ConcreteCategory.congr_hom
        (Scheme.Hom.stalkMap_congr_point f
          (pullback.fst f i ((pullbackSymmetry i f).hom z))
          (pullback.snd i f z) hX) b
  have hambient :
      (Y.presheaf.stalkCongr (.of_eq (congrArg f hX))).hom b =
        (Y.presheaf.stalkCongr (.of_eq hOriginal)).hom a := by
    exact stalkCongr_comp_apply_of_eq Y
      (congrArg i hZ) hSwap (congrArg f hX) hOriginal a
  change
    ((Iso.refl X).hom.stalkMap (pullback.snd i f z)).hom
        ((X.presheaf.stalkCongr (.of_eq hX)).hom
          ((f.stalkMap
            (pullback.fst f i ((pullbackSymmetry i f).hom z))).hom b)) =
      (f.stalkMap (pullback.snd i f z)).hom
        ((Y.presheaf.stalkCongr (.of_eq hOriginal)).hom a)
  calc
    _ = (X.presheaf.stalkCongr (.of_eq hX)).hom
          ((f.stalkMap
            (pullback.fst f i ((pullbackSymmetry i f).hom z))).hom b) := by
      change ((𝟙 X : X ⟶ X).stalkMap (pullback.snd i f z)).hom _ = _
      rw [Scheme.Hom.stalkMap_id]
      rfl
    _ = (f.stalkMap (pullback.snd i f z)).hom
          ((Y.presheaf.stalkCongr (.of_eq (congrArg f hX))).hom b) :=
      hpointMap
    _ = _ := congrArg
      (fun y ↦ (f.stalkMap (pullback.snd i f z)).hom y) hambient

/-- Exact specified-generator form of the pullback-symmetry kernel transfer.-/
theorem ker_stalkMap_pullback_snd_eq_span_pullbackBaseChangeSndStalkElement_of_symmetry
    {Z X Y : Scheme.{u}} (i : Z ⟶ Y) (f : X ⟶ Y)
    (z : (pullback i f : Scheme.{u}))
    (a : Y.presheaf.stalk (i (pullback.fst i f z)))
    (hker : RingHom.ker
      ((pullback.fst f i).stalkMap ((pullbackSymmetry i f).hom z)).hom =
        Ideal.span {
          pullbackBaseChangeStalkElement f i ((pullbackSymmetry i f).hom z)
            (pullbackSymmetryAmbientStalkElement i f z a)}) :
    RingHom.ker ((pullback.snd i f).stalkMap z).hom =
      Ideal.span {pullbackBaseChangeSndStalkElement i f z a} := by
  rw [ker_stalkMap_pullback_snd_eq_span_of_symmetry i f z
    (pullbackBaseChangeStalkElement f i ((pullbackSymmetry i f).hom z)
      (pullbackSymmetryAmbientStalkElement i f z a)) hker]
  change Ideal.span {pullbackSymmetryBaseChangeStalkElement i f z a} = _
  rw [pullbackSymmetryBaseChangeStalkElement_eq]

/-- The target-stalk isomorphism in a commutative square whose vertical stalk maps are
isomorphisms.  Unlike `targetStalkIsoOfArrowIso`, the vertical scheme morphisms themselves need
not be isomorphisms; open immersions are the main application.-/
noncomputable def targetStalkIsoOfIsIsoSquare
    {Z X Z' X' : Scheme.{u}} (i : Z ⟶ X) (j : Z' ⟶ X')
    (s : Z' ⟶ Z) (t : X' ⟶ X) (h : s ≫ i = j ≫ t) (z : Z')
    [IsIso (t.stalkMap (j z))] :
    X.presheaf.stalk (i (s z)) ≅ X'.presheaf.stalk (j z) :=
  X.presheaf.stalkCongr (.of_eq (by
    change (s ≫ i) z = (j ≫ t) z
    rw [h])) ≪≫
      asIso (t.stalkMap (j z))

/-- The source-stalk isomorphism in a commutative square whose left vertical stalk map is an
isomorphism.-/
noncomputable def sourceStalkIsoOfIsIsoSquare
    {Z Z' : Scheme.{u}} (s : Z' ⟶ Z) (z : Z') [IsIso (s.stalkMap z)] :
    Z.presheaf.stalk (s z) ≅ Z'.presheaf.stalk z :=
  asIso (s.stalkMap z)

set_option backward.isDefEq.respectTransparency false in
/-- The stalk maps in a commutative scheme square commute after inserting the canonical point
transport.-/
theorem stalkMap_square_of_isIso_stalkMaps
    {Z X Z' X' : Scheme.{u}} (i : Z ⟶ X) (j : Z' ⟶ X')
    (s : Z' ⟶ Z) (t : X' ⟶ X) (h : s ≫ i = j ≫ t) (z : Z')
    [IsIso (s.stalkMap z)] [IsIso (t.stalkMap (j z))] :
    i.stalkMap (s z) ≫ (sourceStalkIsoOfIsIsoSquare s z).hom =
      (targetStalkIsoOfIsIsoSquare i j s t h z).hom ≫ j.stalkMap z := by
  change i.stalkMap (s z) ≫ s.stalkMap z =
    (X.presheaf.stalkCongr (.of_eq (by
      change (s ≫ i) z = (j ≫ t) z
      rw [h]))).hom ≫ t.stalkMap (j z) ≫ j.stalkMap z
  calc
    i.stalkMap (s z) ≫ s.stalkMap z = (s ≫ i).stalkMap z :=
      (Scheme.Hom.stalkMap_comp s i z).symm
    _ = (X.presheaf.stalkCongr (.of_eq (h ▸ rfl))).hom ≫
        (j ≫ t).stalkMap z :=
      Scheme.Hom.stalkMap_congr_hom (s ≫ i) (j ≫ t) h z
    _ = (X.presheaf.stalkCongr (.of_eq (h ▸ rfl))).hom ≫
        (t.stalkMap (j z) ≫ j.stalkMap z) := by
      rw [Scheme.Hom.stalkMap_comp]
    _ = ((X.presheaf.stalkCongr (.of_eq (h ▸ rfl))).hom ≫
        t.stalkMap (j z)) ≫ j.stalkMap z :=
      (Category.assoc _ _ _).symm

/-- A generator on the locally restricted side of a square, pulled back to the original target
stalk.-/
noncomputable def principalStalkElementOfIsIsoSquare
    {Z X Z' X' : Scheme.{u}} (i : Z ⟶ X) (j : Z' ⟶ X')
    (s : Z' ⟶ Z) (t : X' ⟶ X) (h : s ≫ i = j ≫ t) (z : Z')
    [IsIso (t.stalkMap (j z))] (a : X'.presheaf.stalk (j z)) :
    X.presheaf.stalk (i (s z)) :=
  (targetStalkIsoOfIsIsoSquare i j s t h z).inv a

/-- Mapping a target element back through an open/iso-stalk square and then along the original
arrow is the same as mapping on the restricted side and transporting back along the source
vertical stalk isomorphism.-/
theorem stalkMap_principalStalkElementOfIsIsoSquare
    {Z X Z' X' : Scheme.{u}} (i : Z ⟶ X) (j : Z' ⟶ X')
    (s : Z' ⟶ Z) (t : X' ⟶ X) (h : s ≫ i = j ≫ t) (z : Z')
    [IsIso (s.stalkMap z)] [IsIso (t.stalkMap (j z))]
    (a : X'.presheaf.stalk (j z)) :
    (i.stalkMap (s z)).hom
        (principalStalkElementOfIsIsoSquare i j s t h z a) =
      (sourceStalkIsoOfIsIsoSquare s z).inv.hom ((j.stalkMap z).hom a) := by
  apply (sourceStalkIsoOfIsIsoSquare s z).commRingCatIsoToRingEquiv.injective
  change ((i.stalkMap (s z) ≫ (sourceStalkIsoOfIsIsoSquare s z).hom).hom
      ((targetStalkIsoOfIsIsoSquare i j s t h z).inv.hom a)) = _
  rw [stalkMap_square_of_isIso_stalkMaps i j s t h z]
  simp
  exact ((sourceStalkIsoOfIsIsoSquare s z).inv_hom_id_apply
    ((j.stalkMap z).hom a)).symm

/-- A principal kernel computed after a local restriction determines the original stalk kernel
whenever both vertical maps in the restriction square induce stalk isomorphisms.-/
theorem ker_stalkMap_eq_span_of_isIso_square
    {Z X Z' X' : Scheme.{u}} (i : Z ⟶ X) (j : Z' ⟶ X')
    (s : Z' ⟶ Z) (t : X' ⟶ X) (h : s ≫ i = j ≫ t) (z : Z')
    [IsIso (s.stalkMap z)] [IsIso (t.stalkMap (j z))]
    (a : X'.presheaf.stalk (j z))
    (hker : RingHom.ker (j.stalkMap z).hom = Ideal.span {a}) :
    RingHom.ker (i.stalkMap (s z)).hom =
      Ideal.span {principalStalkElementOfIsIsoSquare i j s t h z a} := by
  apply ker_eq_span_singleton_of_equiv_commutes_symm
    (i.stalkMap (s z)).hom (j.stalkMap z).hom
    (targetStalkIsoOfIsIsoSquare i j s t h z).commRingCatIsoToRingEquiv
    (sourceStalkIsoOfIsIsoSquare s z).commRingCatIsoToRingEquiv
    _ a hker
  change ((i.stalkMap (s z)) ≫
    (sourceStalkIsoOfIsIsoSquare s z).hom).hom =
      ((targetStalkIsoOfIsIsoSquare i j s t h z).hom ≫
        j.stalkMap z).hom
  exact congrArg CommRingCat.Hom.hom
    (stalkMap_square_of_isIso_stalkMaps i j s t h z)

end AlgebraicGeometry.Chow
