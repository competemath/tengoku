import Tengoku.GrothendieckRiemannRoch.RiemannRoch.Chow.RegularLocalHeightOneDVR
import Tengoku.GrothendieckRiemannRoch.RiemannRoch.Chow.RegularLocalDomainGeneral
import Tengoku.Seed.RingTheory.LocalRing.Module

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# P2.3: height-one localizations of a regular local surface are DVRs

This file closes the P2 plate's hard brick

`IsRegularLocalRing.isDiscreteValuationRing_localization_height_one`.

## Route decision (P2.3), settled 2026-07-27

The route-decision spike owed by `docs/CONSTRUCTION_SELF_BUILD_BRICKS.md` §P2.3 resolves in
favour of **(e), an elementary dimension-two argument** — *not* the planning default (h).
Routes (h) homological (Auslander–Buchsbaum + Serre's characterization) and (c) completion
(Cohen structure + Weierstrass preparation) are both unnecessary: neither the associated
graded ring, nor global dimension, nor `Tor` balancing, nor depth is used below.

The argument, and the reason it is not circular:

* Regularity enters **only** through the fact that the maximal ideal is generated by a
  two-term regular sequence.  Concretely, for `a ∈ m ∖ m²` the quotient `R ⧸ (a)` is a
  one-dimensional regular local ring, hence a domain (P2.2), so any `b ∉ (a)` is regular
  modulo `a`.  This is what fails for a non-regular two-dimensional local domain.
* Consequently the syzygies of `(a, b)` are generated by the Koszul relation
  `a * b - b * a = 0` (`exists_koszul_coeff`).
* Prime avoidance chooses the first parameter `a` outside `p` as well as outside `m²`;
  since `p` is prime this forces the Koszul coefficient to lie in `p`, so the presentation
  of `m` tensored with `p` has no kernel: `m ⊗ p → p` is injective
  (`maximalIdeal_rTensor_injective_of_prime`).  This is `Tor₁(k, p) = 0` in concrete form.
* Mathlib's `Module.free_of_maximalIdeal_rTensor_injective` then makes `p` a free module,
  and a free ideal of a domain has rank one, i.e. is principal (`isPrincipal_of_free`).
* A principal height-one prime localizes to a one-dimensional regular local ring, which is
  a DVR by the terminal step already recorded in `RegularLocalHeightOneDVR.lean`.

### Circularity traps avoided (as required by the brick spec)

* We never use "`R` normal ⇒ DVR via `IsDiscreteValuationRing.TFAE`": normality of `R` is
  never asserted, and the only `TFAE`-flavoured input is the cotangent-space criterion for a
  ring already known to be regular.
* We never use "Nagata with `R[1/x]` a PID": no localization other than `Localization.AtPrime p`
  itself appears, and its regularity is deduced from principality of `p`, not assumed.

## Main results

* `IsRegularLocalRing.exists_koszul_data` — the Koszul data `(a, b)` avoiding `p`.
* `IsRegularLocalRing.isPrincipal_of_height_one` — height-one primes of a two-dimensional
  regular local ring are principal.  (This is also the height-one principality input that
  P2.4's Nagata criterion asks for.)
* `IsRegularLocalRing.isDiscreteValuationRing_localization_height_one` — the plate theorem.
-/

noncomputable section

universe u

open IsLocalRing TensorProduct

variable {R : Type u} [CommRing R]

namespace IsRegularLocalRing

/-! ### The Koszul syzygy of a two-term regular sequence -/

/-- If `a` is a nonzerodivisor and `b` is a nonzerodivisor modulo `a`, then every relation
`a * u + b * v = 0` is a multiple of the Koszul relation `a * b - b * a = 0`.
@isnad1 id=ex.3h5v.s7.ff33419d6dd2 from=translated src=- shape=1b115886 vocab=7ffe8dd0
-/
theorem exists_koszul_coeff [IsDomain R] {a b : R} (ha : a ≠ 0)
    (hb : ∀ v : R, a ∣ b * v → a ∣ v) {u v : R} (h : a * u + b * v = 0) :
    ∃ c : R, v = a * c ∧ u = -(b * c) := by
  obtain ⟨c, hc⟩ := hb v ⟨-u, by linear_combination h⟩
  refine ⟨c, hc, ?_⟩
  have hz : a * (u + b * c) = 0 := by rw [hc] at h; linear_combination h
  rcases mul_eq_zero.mp hz with h' | h'
  · exact absurd h' ha
  · linear_combination h'

/-! ### Vanishing of `Tor₁(k, p)` -/

/-- **Key vanishing.**  Let `m = span {a, b}` with `(a, b)` a regular sequence, and let `p` be a
prime ideal with `a ∉ p`.  Then `m ⊗ p → p` is injective.

Concretely this is `Tor₁(R/m, p) = 0`: an element of `m ⊗ p` is `a ⊗ u + b ⊗ v`, the relation
`a * u + b * v = 0` is Koszul by `exists_koszul_coeff`, and its coefficient lies in `p`
because `a ∉ p` and `p` is prime — so the element is the image of the Koszul relation, i.e. `0`.
@isnad1 id=injectiv.4h4v.s11.b79541dd4b5a from=translated src=- shape=e0a3b230 vocab=291def4c
-/
theorem maximalIdeal_rTensor_injective_of_prime [IsDomain R] [IsLocalRing R]
    {a b : R} (ha : a ≠ 0) (hb : ∀ v : R, a ∣ b * v → a ∣ v)
    (hm : maximalIdeal R = Ideal.span {a, b})
    (p : Ideal R) [hp : p.IsPrime] (hap : a ∉ p) :
    Function.Injective ((maximalIdeal R).subtype.rTensor (p : Submodule R R)) := by
  classical
  have hamem : a ∈ maximalIdeal R := by rw [hm]; exact Ideal.subset_span (by simp)
  have hbmem : b ∈ maximalIdeal R := by rw [hm]; exact Ideal.subset_span (by simp)
  set A : (maximalIdeal R : Submodule R R) := ⟨a, hamem⟩ with hA
  set B : (maximalIdeal R : Submodule R R) := ⟨b, hbmem⟩ with hB
  -- since `m` is generated by `a` and `b`, every tensor is `A ⊗ u + B ⊗ v`
  have hgen : ∀ ξ : (maximalIdeal R : Submodule R R) ⊗[R] (p : Submodule R R),
      ∃ u v : (p : Submodule R R), ξ = A ⊗ₜ u + B ⊗ₜ v := by
    intro ξ
    induction ξ using TensorProduct.induction_on with
    | zero => exact ⟨0, 0, by simp⟩
    | tmul x n =>
        obtain ⟨r, s, hrs⟩ : ∃ r s : R, r * a + s * b = (x : R) := by
          have hx : (x : R) ∈ Ideal.span ({a, b} : Set R) := by rw [← hm]; exact x.2
          exact Ideal.mem_span_pair.mp hx
        refine ⟨r • n, s • n, ?_⟩
        rw [← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul, ← TensorProduct.add_tmul]
        congr 1
        apply Subtype.ext
        simp [hA, hB, ← hrs]
    | add x y hx hy =>
        obtain ⟨u₁, v₁, h₁⟩ := hx
        obtain ⟨u₂, v₂, h₂⟩ := hy
        exact ⟨u₁ + u₂, v₁ + v₂, by
          rw [h₁, h₂, TensorProduct.tmul_add, TensorProduct.tmul_add]; abel⟩
  rw [injective_iff_map_eq_zero]
  intro ξ hξ
  obtain ⟨u, v, rfl⟩ := hgen ξ
  -- read off the relation in `R`
  have hrel : a * (u : R) + b * (v : R) = 0 := by
    have h1 := congrArg (TensorProduct.lid R (p : Submodule R R)) hξ
    simpa [hA, hB, Algebra.smul_def] using congrArg Subtype.val h1
  obtain ⟨c, hcv, hcu⟩ := exists_koszul_coeff ha hb hrel
  -- primality of `p` together with `a ∉ p` puts the Koszul coefficient inside `p`
  have hcp : c ∈ p := by
    rcases hp.mem_or_mem (show a * c ∈ p by rw [← hcv]; exact v.2) with h | h
    · exact absurd h hap
    · exact h
  set C : (p : Submodule R R) := ⟨c, hcp⟩ with hC
  have hu : u = -(b • C) := by apply Subtype.ext; simpa [hC] using hcu
  have hv : v = a • C := by apply Subtype.ext; simpa [hC] using hcv
  have key : A ⊗ₜ[R] u + B ⊗ₜ[R] v = (a • B - b • A) ⊗ₜ[R] C := by
    rw [hu, hv]
    simp only [TensorProduct.sub_tmul, TensorProduct.smul_tmul, TensorProduct.tmul_neg]
    abel
  have hzero : a • B - b • A = 0 := by
    apply Subtype.ext
    simp only [hA, hB, Submodule.coe_sub, SetLike.val_smul, smul_eq_mul,
      ZeroMemClass.coe_zero]
    ring
  rw [key, hzero, TensorProduct.zero_tmul]

/-! ### A free ideal of a domain is principal -/

/-- A free ideal of an integral domain has rank one, hence is principal: two distinct basis
vectors `e i, e j` would satisfy the nontrivial relation `e j • e i - e i • e j = 0`.
@isnad1 id=isprinci.1h2v.s8.b7e0f1b5b97e from=translated src=- shape=360dd95e vocab=a764899d
-/
theorem isPrincipal_of_free [IsDomain R] (p : Ideal R)
    [Module.Free R (p : Submodule R R)] [Module.Finite R (p : Submodule R R)]
    (hp0 : p ≠ ⊥) : Submodule.IsPrincipal p := by
  classical
  set bs := Module.Free.chooseBasis R (p : Submodule R R) with hbs
  have hne : Nonempty (Module.Free.ChooseBasisIndex R (p : Submodule R R)) := by
    by_contra hemp
    apply hp0
    rw [Submodule.eq_bot_iff]
    intro z hz
    have hz0 : (⟨z, hz⟩ : (p : Submodule R R)) = 0 :=
      bs.ext_elem (fun i => absurd ⟨i⟩ hemp)
    exact congrArg Subtype.val hz0
  have hsub : Subsingleton (Module.Free.ChooseBasisIndex R (p : Submodule R R)) := by
    refine ⟨fun i j => ?_⟩
    by_contra hij
    have hli := bs.linearIndependent
    set l : Module.Free.ChooseBasisIndex R (p : Submodule R R) →₀ R :=
      Finsupp.single i ((bs j : (p : Submodule R R)) : R) -
        Finsupp.single j ((bs i : (p : Submodule R R)) : R) with hl
    have hlc : Finsupp.linearCombination R bs l = 0 := by
      rw [hl]
      simp only [map_sub, Finsupp.linearCombination_single, sub_eq_zero]
      apply Subtype.ext
      simp only [SetLike.val_smul, smul_eq_mul]
      ring
    have hl0 := linearIndependent_iff.mp hli l hlc
    have hbj : ((bs j : (p : Submodule R R)) : R) = 0 := by
      have h2 := congrArg (fun t => t i) hl0
      simpa [hl, Finsupp.single_apply, hij, Ne.symm hij] using h2
    exact bs.ne_zero j (Subtype.ext hbj)
  obtain ⟨i⟩ := hne
  refine ⟨⟨((bs i : (p : Submodule R R)) : R), ?_⟩⟩
  apply le_antisymm
  · intro z hz
    have hmem : (⟨z, hz⟩ : (p : Submodule R R)) ∈ Submodule.span R (Set.range bs) := by
      rw [bs.span_eq]; trivial
    have hrange : Set.range bs = {bs i} := by
      ext y
      constructor
      · rintro ⟨j, rfl⟩; rw [Subsingleton.elim j i]; rfl
      · rintro rfl; exact ⟨i, rfl⟩
    rw [hrange, Submodule.mem_span_singleton] at hmem
    obtain ⟨r, hr⟩ := hmem
    refine Ideal.mem_span_singleton.mpr ⟨r, ?_⟩
    have h3 := congrArg Subtype.val hr
    simpa [Algebra.smul_def, mul_comm] using h3.symm
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact (bs i).2

/-! ### Choosing the Koszul data -/

/-- In a two-dimensional regular local ring, a height-one prime `p` avoids a suitable minimal
generator `a` of `m`, and the complementary generator `b` is regular modulo `a`.

Prime avoidance applies to `m ⊄ m² ∪ p`: containment in `m²` contradicts `m² < m`, and
containment in `p` would force `p = m`, whose height is the dimension `2`, not `1`.
@isnad1 id=ex.2h2v.s7.359900700df4 from=translated src=- shape=e4cb01ee vocab=ca0c2e2c
-/
theorem exists_koszul_data [IsRegularLocalRing R] (hdim : ringKrullDim R = 2)
    (p : Ideal R) [hp : p.IsPrime] (hph : p.height = 1) :
    ∃ a b : R, maximalIdeal R = Ideal.span {a, b} ∧ a ∉ p ∧
      ∀ v : R, a ∣ b * v → a ∣ v := by
  classical
  letI : DecidableEq R := Classical.decEq R
  haveI : IsDomain R := isDomain_of_isRegularLocalRing R
  have hdim0 : ringKrullDim R ≠ 0 := by rw [hdim]; decide
  have hsq : maximalIdeal R ^ 2 < maximalIdeal R :=
    maximalIdeal_sq_lt_of_ringKrullDim_ne_zero hdim0
  have hple : p ≤ maximalIdeal R := IsLocalRing.le_maximalIdeal_of_isPrime p
  have hpne : p ≠ maximalIdeal R := by
    intro h
    rw [h] at hph
    rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, hph] at hdim
    exact absurd hdim (by decide)
  have havoid : ¬ ((maximalIdeal R : Set R) ⊆ (maximalIdeal R ^ 2 : Ideal R) ∪ (p : Set R)) := by
    rw [Ideal.subset_union]
    rintro (h | h)
    · exact absurd (le_antisymm h hsq.le) (by simpa using hsq.ne')
    · exact hpne (le_antisymm hple h)
  obtain ⟨a, hamem, hanot⟩ := Set.not_subset.mp havoid
  have ha2 : a ∉ maximalIdeal R ^ 2 := fun h => hanot (Or.inl h)
  have hap : a ∉ p := fun h => hanot (Or.inr h)
  -- a minimal generating set of `m` containing `a`; it has two elements
  obtain ⟨t, hat, hcard, hspan⟩ :=
    exists_finset_span_card_eq_spanFinrank_containing (R := R) hamem ha2
  have hrank : (maximalIdeal R).spanFinrank = 2 := by
    have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
    rw [hdim] at h
    exact_mod_cast h
  rw [hrank] at hcard
  obtain ⟨x, y, hxy, rfl⟩ := Finset.card_eq_two.mp hcard
  obtain ⟨b, hab⟩ : ∃ b : R, Submodule.span R (({x, y} : Finset R) : Set R)
      = Ideal.span {a, b} := by
    rcases Finset.mem_insert.mp hat with rfl | hay
    · exact ⟨y, by simp [Ideal.span]⟩
    · rw [Finset.mem_singleton] at hay
      subst hay
      exact ⟨x, by simp [Ideal.span, Set.pair_comm]⟩
  have hm : maximalIdeal R = Ideal.span {a, b} := by rw [← hspan, hab]
  -- `b` is not a multiple of `a`, else `m` would be principal
  have hbspan : b ∉ Ideal.span ({a} : Set R) := by
    intro hb
    have hle : maximalIdeal R ≤ Ideal.span ({a} : Set R) := by
      rw [hm, Ideal.span_le]
      rintro z (rfl | rfl)
      · exact Ideal.subset_span rfl
      · exact hb
    have heq : maximalIdeal R = Ideal.span ({a} : Set R) :=
      le_antisymm hle (by rw [hm]; exact Ideal.span_mono (by simp))
    have : (maximalIdeal R).spanFinrank ≤ 1 := by
      rw [heq]
      simpa only [← Set.ncard_singleton a] using
        Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_singleton a)
    omega
  -- `R ⧸ (a)` is a one-dimensional regular local ring, hence a domain: `b` is regular mod `a`
  refine ⟨a, b, hm, hap, fun v hv => ?_⟩
  haveI : IsRegularLocalRing (R ⧸ Ideal.span ({a} : Set R)) :=
    quotient_span_singleton_isRegularLocalRing hamem ha2
  haveI : IsDomain (R ⧸ Ideal.span ({a} : Set R)) := isDomain_of_isRegularLocalRing _
  have hbq : (Ideal.Quotient.mk (Ideal.span ({a} : Set R)) b) ≠ 0 := by
    simpa [Ideal.Quotient.eq_zero_iff_mem] using hbspan
  have hmul : (Ideal.Quotient.mk (Ideal.span ({a} : Set R)) b) *
      (Ideal.Quotient.mk (Ideal.span ({a} : Set R)) v) = 0 := by
    rw [← map_mul]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr hv)
  rcases mul_eq_zero.mp hmul with h | h
  · exact absurd h hbq
  · exact Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h)

/-! ### Height-one primes are principal -/

/-- **Height-one principality.**  Every height-one prime of a two-dimensional regular local
ring is principal.  This is also exactly the input P2.4's Nagata criterion requires.
@isnad1 id=isprinci.2h2v.s6.e4e45291da0c from=translated src=- shape=6d9d75dc vocab=341dbf86
-/
theorem isPrincipal_of_height_one [IsRegularLocalRing R] (hdim : ringKrullDim R = 2)
    (p : Ideal R) [hp : p.IsPrime] (hph : p.height = 1) : Submodule.IsPrincipal p := by
  classical
  haveI : IsDomain R := isDomain_of_isRegularLocalRing R
  obtain ⟨a, b, hm, hap, hbdvd⟩ := exists_koszul_data hdim p hph
  have ha0 : a ≠ 0 := fun h => hap (h ▸ p.zero_mem)
  have hp0 : p ≠ ⊥ := by
    intro h
    rw [h, Ideal.height_bot] at hph
    exact absurd hph (by decide)
  haveI : Module.Finite R (p : Submodule R R) :=
    Module.Finite.iff_fg.mpr (IsNoetherian.noetherian p)
  haveI : Module.FinitePresentation R (p : Submodule R R) :=
    Module.finitePresentation_of_finite R _
  haveI : Module.Free R (p : Submodule R R) :=
    Module.free_of_maximalIdeal_rTensor_injective
      (maximalIdeal_rTensor_injective_of_prime ha0 hbdvd hm p hap)
  exact isPrincipal_of_free p hp0

/-! ### The plate theorem -/

/-- **P2.3.**  Every height-one localization of a two-dimensional regular local ring is a
discrete valuation ring.
@isnad1 id=isdiscre.2h2v.s6.09b12bd922ba from=translated src=- shape=1820be83 vocab=3e484dc3
-/
theorem isDiscreteValuationRing_localization_height_one (R : Type u) [CommRing R]
    [IsRegularLocalRing R] (hdim : ringKrullDim R = 2)
    (p : Ideal R) [p.IsPrime] (hph : p.height = 1) :
    letI := isDomain_of_isRegularLocalRing R
    IsDiscreteValuationRing (Localization.AtPrime p) := by
  classical
  letI : IsDomain R := isDomain_of_isRegularLocalRing R
  obtain ⟨f, hf⟩ := (isPrincipal_of_height_one hdim p hph).principal
  haveI : IsRegularLocalRing (Localization.AtPrime p) := by
    apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
    have hmap : maximalIdeal (Localization.AtPrime p)
        = Ideal.span {algebraMap R (Localization.AtPrime p) f} := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal]
      have hps := congrArg (Ideal.map (algebraMap R (Localization.AtPrime p))) hf
      rw [hps, Ideal.map_span, Set.image_singleton]
    rw [ringKrullDim_localizationAtPrime_eq_one_of_height_eq_one p hph, hmap]
    simpa only [Nat.cast_le_one,
      ← Set.ncard_singleton (algebraMap R (Localization.AtPrime p) f)] using
      Submodule.spanFinrank_span_le_ncard_of_finite
        (Set.finite_singleton (algebraMap R (Localization.AtPrime p) f))
  exact isDiscreteValuationRing_localizationAtPrime_of_height_one_of_regular p hph

end IsRegularLocalRing
