import Tengoku.GrothendieckRiemannRoch.RiemannRoch.Chow.PrincipalOpenChart
import Tengoku.Seed.AlgebraicGeometry.IdealSheaf.Functorial
import Tengoku.Seed.AlgebraicGeometry.Restrict

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Principal charts from ideal sheaves

For an ideal sheaf `I` on `X`, Mathlib constructs its closed subscheme by gluing the affine
quotients `Spec(Γ(X,U)/I(U))`.  This file connects that construction to
`PrincipalOpenPullbackChart`: if `I(U)` is generated by one section `a`, the pullback of the
closed subscheme to `U` is presented by `Spec(Γ(X,U)/(a)) → Spec Γ(X,U)`.

This is the sheaf-to-chart existence layer missing from the affine principal kernel calculation.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory Limits

universe u

namespace AlgebraicGeometry.Chow

/-- An ideal sheaf is locally principal when every point has an affine neighbourhood on which
the ideal of sections is generated by one element.-/
def IdealSheafIsLocallyPrincipal
    {X : Scheme.{u}} (I : X.IdealSheafData) : Prop :=
  ∀ x : X, ∃ U : X.affineOpens, x ∈ U.1 ∧
    ∃ a : Γ(X, U), I.ideal U = Ideal.span {a}

/-- Concrete locally principal ideal-sheaf data around a specified point of its associated
closed subscheme.-/
structure PrincipalIdealSheafChartAt
    {X : Scheme.{u}} (I : X.IdealSheafData) (z : I.subscheme) where
  /-- Affine target neighbourhood containing the image of `z`.-/
  U : X.affineOpens
  /-- The image of `z` belongs to the chosen affine neighbourhood.-/
  mem : I.subschemeι z ∈ U.1
  /-- A generator of the ideal on this neighbourhood.-/
  equation : Γ(X, U)
  /-- The ideal of sections is generated by `equation`.-/
  ideal_eq : I.ideal U = Ideal.span {equation}

namespace PrincipalIdealSheafChartAt

variable {X : Scheme.{u}} {I : X.IdealSheafData} {z : I.subscheme}

/-- The image of the specified closed-subscheme point as a point of the chosen target open.-/
noncomputable def openPoint (d : PrincipalIdealSheafChartAt I z) : d.U.1.toScheme :=
  ⟨I.subschemeι z, d.mem⟩

end PrincipalIdealSheafChartAt

namespace IdealSheafIsLocallyPrincipal

variable {X : Scheme.{u}} {I : X.IdealSheafData}

/-- A locally principal ideal sheaf supplies principal affine chart data around every point of
its associated closed subscheme.
@isnad1 id=nonempty.1h3v.s4.cfda7ae5ff5b from=translated src=- shape=b268e9a3 vocab=3d31ca3f
-/
theorem exists_chartAt (hI : IdealSheafIsLocallyPrincipal I) (z : I.subscheme) :
    Nonempty (PrincipalIdealSheafChartAt I z) := by
  obtain ⟨U, hzU, a, ha⟩ := hI (I.subschemeι z)
  exact ⟨⟨U, hzU, a, ha⟩⟩

/-- A chosen principal affine chart around a point of a locally principal closed subscheme.-/
noncomputable def chartAt (hI : IdealSheafIsLocallyPrincipal I) (z : I.subscheme) :
    PrincipalIdealSheafChartAt I z :=
  Classical.choice (hI.exists_chartAt z)

end IdealSheafIsLocallyPrincipal

/-- A closed immersion is locally principal when its scheme-theoretic kernel ideal sheaf is
locally generated by one section on affine neighbourhoods.-/
def IsLocallyPrincipalClosedImmersion
    {Z X : Scheme.{u}} (f : Z ⟶ X) : Prop :=
  IdealSheafIsLocallyPrincipal f.ker

end AlgebraicGeometry.Chow
