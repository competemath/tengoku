import Tengoku.GrothendieckRiemannRoch.RiemannRoch.Chow.FiniteIntersection
import Tengoku.GrothendieckRiemannRoch.RiemannRoch.Chow.PrincipalOrderLength

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Principal stalk quotients and local intersection length

The stalk map of a closed immersion is surjective. The first isomorphism theorem therefore
identifies its source stalk with the target stalk modulo the kernel, compatibly with the target-
stalk module structure. Consequently the morphism's local length is the length of that quotient.
When the kernel is generated by one nonzero element at a codimension-one point, the local length
is exactly the corresponding principal-divisor coefficient. The same statement is specialized to
the local multiplicity in a finite closed intersection.
-/

noncomputable section

open AlgebraicGeometry Order

universe u

namespace AlgebraicGeometry.Chow

/-- The local length of a closed immersion is the length of the target stalk modulo the kernel of
the induced stalk map.
@isnad1 id=eq.0h4v.s13.1cd72752b0d3 from=translated src=- shape=733af861 vocab=7f8cfe6a
-/
theorem morphismLocalLength_eq_length_quotient_ker
    {Z X : Scheme.{u}} (f : Z ⟶ X) [IsClosedImmersion f] (z : Z) :
    morphismLocalLength f z =
      Module.length (X.presheaf.stalk (f z))
        ((X.presheaf.stalk (f z)) ⧸ RingHom.ker (f.stalkMap z).hom) := by
  unfold morphismLocalLength
  letI : Algebra ↑(X.presheaf.stalk (f z)) ↑(Z.presheaf.stalk z) :=
    (f.stalkMap z).hom.toAlgebra
  let eRing :
      (↑(X.presheaf.stalk (f z)) ⧸ RingHom.ker (f.stalkMap z).hom) ≃+*
        ↑(Z.presheaf.stalk z) :=
    RingHom.quotientKerEquivOfSurjective (f.stalkMap_surjective z)
  let eAlg :
      (↑(X.presheaf.stalk (f z)) ⧸ RingHom.ker (f.stalkMap z).hom) ≃ₐ[
        ↑(X.presheaf.stalk (f z))] ↑(Z.presheaf.stalk z) :=
    AlgEquiv.ofRingEquiv (f := eRing) (by
      intro r
      exact RingHom.quotientKerEquivOfSurjective_apply_mk
        (f.stalkMap_surjective z) r)
  exact eAlg.toLinearEquiv.length_eq.symm

/-- If the stalk-map kernel of a closed immersion is principal, its local length is the length of
that principal quotient.
@isnad1 id=eq.1h5v.s13.0f5223fb5a33 from=translated src=- shape=9a3d20e1 vocab=2d39e0dd
-/
theorem morphismLocalLength_eq_length_principalQuotient
    {Z X : Scheme.{u}} (f : Z ⟶ X) [IsClosedImmersion f] (z : Z)
    (a : X.presheaf.stalk (f z))
    (hker : RingHom.ker (f.stalkMap z).hom = Ideal.span {a}) :
    morphismLocalLength f z =
      Module.length (X.presheaf.stalk (f z))
        ((X.presheaf.stalk (f z)) ⧸ Ideal.span {a}) := by
  rw [morphismLocalLength_eq_length_quotient_ker f z, hker]

