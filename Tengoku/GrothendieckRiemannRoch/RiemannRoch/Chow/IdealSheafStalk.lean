import Tengoku.Seed.AlgebraicGeometry.IdealSheaf.Basic
import Tengoku.Seed.AlgebraicGeometry.Noetherian
import Tengoku.Seed.RingTheory.Localization.Ideal

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Stalks of ideal sheaves, and descent of principality

`Scheme.IdealSheafData` in the frozen base records an ideal `I(U) ≤ Γ(X, U)` for every affine open
together with the basic-open compatibility, but carries no stalk.  This file adds one and proves
the descent statement the locally principal machinery needs.

* `IdealSheafData.stalk I x` is the ideal of `𝒪_{X,x}` generated by the germs of the sections of
  `I` over the affine opens containing `x`.  `IdealSheafData.stalk_eq` computes it on any single
  affine open, using `IdealSheafData.map_ideal` for chart-independence.
* `IdealSheafData.exists_ideal_eq_span_of_stalk_eq_span` descends principality: on a locally
  Noetherian scheme, if the stalk at `x` is principal then the ideal of sections is principal on
  some affine open around `x`.  This is the converse direction of
  `Chow/PrincipalIdealSheafChart.lean`'s `IdealSheafIsLocallyPrincipal`, and the step that turns
  a statement about a local ring — for instance factoriality of a two-dimensional regular local
  ring — into the chart datum the intersection machinery consumes.

The descent is the usual denominator-clearing argument: pick an affine chart `U ∋ x`, so that
`𝒪_{X,x}` is the localization of `R = Γ(X, U)` at `p = p_x`.  Replace the stalk generator by
`a/1` for a section `a`.  Finitely many generators `g` of `I(U)` each satisfy `t_g · g = b_g · a`
for some `t_g ∉ p`, and some `m₀ ∉ p` has `m₀ · a ∈ I(U)`.  On the basic open of the product of
these denominators every `t_g` and `m₀` becomes a unit, so there `I` is generated by `a`.
-/

set_option autoImplicit false

noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- Germ-extension of the sections of an ideal sheaf is compatible with shrinking the affine
open.-/
theorem map_germ_of_le {U V : X.affineOpens} (h : U ≤ V) {x : X} (hx : x ∈ U.1) :
    (I.ideal U).map (X.presheaf.germ U.1 x hx).hom
      = (I.ideal V).map (X.presheaf.germ V.1 x (h hx)).hom := by
  conv_lhs => rw [← I.map_ideal h]
  simp only [Ideal.map_map, ← CommRingCat.hom_comp, TopCat.Presheaf.germ_res']

/-- The germ-extension of the sections of an ideal sheaf does not depend on the affine open.-/
theorem map_germ_eq {U V : X.affineOpens} {x : X} (hU : x ∈ U.1) (hV : x ∈ V.1) :
    (I.ideal U).map (X.presheaf.germ U.1 x hU).hom
      = (I.ideal V).map (X.presheaf.germ V.1 x hV).hom := by
  obtain ⟨f, g, e, hxf⟩ := exists_basicOpen_le_affine_inter U.2 V.2 x ⟨hU, hV⟩
  have hWU : X.affineBasicOpen f ≤ U := X.affineBasicOpen_le f
  have hWV : X.affineBasicOpen f ≤ V := fun z hz => X.basicOpen_le g (e ▸ hz)
  rw [← I.map_germ_of_le hWU (x := x) hxf, ← I.map_germ_of_le hWV (x := x) hxf]

/-- **The stalk of an ideal sheaf.**  The ideal of `𝒪_{X,x}` generated by the germs of the
sections of `I` over any affine open containing `x`; see `stalk_eq`.-/
def stalk (x : X) : Ideal (X.presheaf.stalk x) :=
  ⨆ U : { U : X.affineOpens // x ∈ U.1 }, (I.ideal U.1).map (X.presheaf.germ U.1.1 x U.2).hom

theorem stalk_eq {x : X} {U : X.affineOpens} (hx : x ∈ U.1) :
    I.stalk x = (I.ideal U).map (X.presheaf.germ U.1 x hx).hom := by
  refine le_antisymm (iSup_le fun V => (I.map_germ_eq V.2 hx).le) ?_
  exact le_iSup (fun V : { U : X.affineOpens // x ∈ U.1 } =>
    (I.ideal V.1).map (X.presheaf.germ V.1.1 x V.2).hom) ⟨U, hx⟩

end AlgebraicGeometry.Scheme.IdealSheafData
