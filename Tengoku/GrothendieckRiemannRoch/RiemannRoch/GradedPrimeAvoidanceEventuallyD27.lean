import Tengoku.GrothendieckRiemannRoch.RiemannRoch.GradedPrimeAvoidanceD26

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Graded prime avoidance, eventual form (route D27)

Pure algebra.  If every homogeneous prime in a finite family is eventually nonzero in each degree
(i.e. `R_d ⊄ p` for all `d ≥ N`), then there is `m0` such that for every `m ≥ m0` there is a
homogeneous element of degree exactly `m` outside all of them.  No infinite-field hypothesis.

Honest hypotheses: `R_d ⊄ p` for large `d` is automatic when some element of degree `1` is outside
`p` (take powers), e.g. when `R` is generated over `R_0` by `R_1` and `R_+ ⊄ p`.
-/

open DirectSum

namespace RiemannRoch.GradedAvoidD27

open RiemannRoch.GradedAvoidD26

variable {A σ : Type*} [CommRing A] [SetLike σ A] [AddSubmonoidClass σ A] (𝒜 : ℕ → σ)
  [GradedRing 𝒜]

theorem graded_prime_avoidance_eventually (S : Finset (Ideal A))
    (hS : ∀ p ∈ S, p.IsPrime ∧ p.IsHomogeneous 𝒜 ∧ ∃ N, ∀ d, N ≤ d → ∃ h ∈ 𝒜 d, h ∉ p) :
    ∃ m0, ∀ m, m0 ≤ m → ∃ f ∈ 𝒜 m, ∀ p ∈ S, f ∉ p := by
  classical
  induction S using Finset.strongInduction with
  | H S ih =>
  rcases S.eq_empty_or_nonempty with rfl | hne
  · exact ⟨0, fun m _ => ⟨0, zero_mem _, by simp⟩⟩
  obtain ⟨p, hpS, hmin⟩ := S.exists_minimal hne
  obtain ⟨hpp, hph, N, hN⟩ := hS p hpS
  obtain ⟨m0', hm0'⟩ :=
    ih (S.erase p) (Finset.erase_ssubset hpS) fun q hq => hS q (Finset.mem_of_mem_erase hq)
  have hT : ∀ q ∈ S.erase p, q.IsHomogeneous 𝒜 ∧ ¬ q ≤ p := by
    intro q hq
    have hqp : q ≠ p := Finset.ne_of_mem_erase hq
    have hqS := Finset.mem_of_mem_erase hq
    exact ⟨(hS q hqS).2.1, fun hle => hqp (le_antisymm hle (hmin hqS hle))⟩
  obtain ⟨n, a, ha, haT, hap⟩ := exists_homogeneous_mem_forall_not_mem 𝒜 hpp _ hT
  refine ⟨max m0' (n + N), fun m hm => ?_⟩
  have hm1 : m0' ≤ m := le_trans (le_max_left _ _) hm
  have hm2 : n + N ≤ m := le_trans (le_max_right _ _) hm
  obtain ⟨f, hf, hfS⟩ := hm0' m hm1
  by_cases hfp : f ∈ p
  · obtain ⟨h, hh, hhp⟩ := hN (m - n) (by omega)
    have hg : f + a * h ∈ 𝒜 m := by
      have : a * h ∈ 𝒜 m := by
        have := SetLike.mul_mem_graded ha hh
        rwa [show n + (m - n) = m by omega] at this
      exact add_mem hf this
    refine ⟨f + a * h, hg, fun q hq hgq => ?_⟩
    by_cases hqp : q = p
    · subst hqp
      have : a * h ∈ q := by simpa using q.sub_mem hgq hfp
      rcases (hS q hq).1.mem_or_mem this with h1 | h1
      · exact hap h1
      · exact hhp h1
    · have hqE : q ∈ S.erase p := Finset.mem_erase.2 ⟨hqp, hq⟩
      have hax : a * h ∈ q := Ideal.mul_mem_right _ _ (haT q hqE)
      have : f ∈ q := by simpa using q.sub_mem hgq hax
      exact hfS q hqE this
  · refine ⟨f, hf, fun q hq hfq => ?_⟩
    by_cases hqp : q = p
    · exact hfp (hqp ▸ hfq)
    · exact hfS q (Finset.mem_erase.2 ⟨hqp, hq⟩) hfq

/-- Evaluation form, eventual: `φ i` nonzero on `𝒜 d` for all large `d`.-/
theorem exists_homogeneous_eval_ne_zero_eventually {ι : Type*} (s : Finset ι) {K : ι → Type*}
    [∀ i, CommRing (K i)] [∀ i, IsDomain (K i)] (φ : ∀ i, A →+* K i)
    (hφ : ∀ i ∈ s, ∃ N, ∀ d, N ≤ d → ∃ h ∈ 𝒜 d, φ i h ≠ 0) :
    ∃ m0, ∀ m, m0 ≤ m → ∃ f ∈ 𝒜 m, ∀ i ∈ s, φ i f ≠ 0 := by
  classical
  let P : ι → Ideal A := fun i => ((RingHom.ker (φ i)).homogeneousCore 𝒜).toIdeal
  obtain ⟨m0, hm0⟩ := graded_prime_avoidance_eventually 𝒜 (s.image P) (by
    intro p hp
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.1 hp
    obtain ⟨N, hN⟩ := hφ i hi
    refine ⟨(RingHom.ker_isPrime (φ i)).homogeneousCore,
      (Ideal.homogeneousCore 𝒜 _).isHomogeneous, N, fun d hd => ?_⟩
    obtain ⟨h, hh, hne⟩ := hN d hd
    exact ⟨h, hh, fun hmem => hne <|
      (RingHom.mem_ker).1 (Ideal.toIdeal_homogeneousCore_le 𝒜 _ hmem)⟩)
  refine ⟨m0, fun m hm => ?_⟩
  obtain ⟨f, hf, hfS⟩ := hm0 m hm
  refine ⟨f, hf, fun i hi hz => hfS (P i) (Finset.mem_image_of_mem _ hi) ?_⟩
  exact Ideal.mem_homogeneousCore_of_homogeneous_of_mem ⟨m, hf⟩ (RingHom.mem_ker.2 hz)

/-- Degree-one form: each `φ i` is nonzero on `𝒜 1` (e.g. `R` generated by `R_1`, `φ i` nonzero
on `R_+`).-/
theorem exists_homogeneous_eval_ne_zero_eventually_of_degree_one {ι : Type*} (s : Finset ι)
    {K : ι → Type*} [∀ i, CommRing (K i)] [∀ i, IsDomain (K i)] (φ : ∀ i, A →+* K i)
    (hφ : ∀ i ∈ s, ∃ ℓ ∈ 𝒜 1, φ i ℓ ≠ 0) :
    ∃ m0, ∀ m, m0 ≤ m → ∃ f ∈ 𝒜 m, ∀ i ∈ s, φ i f ≠ 0 := by
  refine exists_homogeneous_eval_ne_zero_eventually 𝒜 s φ fun i hi => ⟨0, fun d _ => ?_⟩
  obtain ⟨ℓ, hℓ, hne⟩ := hφ i hi
  exact ⟨ℓ ^ d, by simpa using SetLike.pow_mem_graded d hℓ, by
    rw [map_pow]; exact pow_ne_zero _ hne⟩

/-- Packaging for twisted comparisons: eventually, simultaneously in degrees `m` and `m+1`
(and, with `k`, in `m` and `m+k`), avoiders exist.-/
theorem exists_eventually_avoiders_shift {ι : Type*} (s : Finset ι) {K : ι → Type*}
    [∀ i, CommRing (K i)] [∀ i, IsDomain (K i)] (φ : ∀ i, A →+* K i)
    (hφ : ∀ i ∈ s, ∃ N, ∀ d, N ≤ d → ∃ h ∈ 𝒜 d, φ i h ≠ 0) (k : ℕ) :
    ∃ m0, ∀ m, m0 ≤ m →
      (∃ f ∈ 𝒜 m, ∀ i ∈ s, φ i f ≠ 0) ∧ (∃ g ∈ 𝒜 (m + k), ∀ i ∈ s, φ i g ≠ 0) := by
  obtain ⟨m0, hm0⟩ := exists_homogeneous_eval_ne_zero_eventually 𝒜 s φ hφ
  exact ⟨m0, fun m hm => ⟨hm0 m hm, hm0 (m + k) (by omega)⟩⟩

end RiemannRoch.GradedAvoidD27
