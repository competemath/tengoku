import Tengoku.Seed.RingTheory.IntegralClosure.IsIntegral.Basic
import Tengoku.Seed.RingTheory.Adjoin.FG
import Tengoku.Seed.Order.CompactlyGenerated.Basic
import Tengoku.Seed.RingTheory.Noetherian.Basic
import Tengoku.GrothendieckRiemannRoch.RiemannRoch.RelativeRiemannRoch.AdamsWeightTensorSTEPW
import Tengoku.GrothendieckRiemannRoch.RiemannRoch.RelativeRiemannRoch.WeightAlgebraRG6B

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# STEPW: finite-dimensional `Ψ`-stable subalgebras and the bridge to `RG6B.WeightHyp`

Let `K` be a `ℚ`-algebra in which every element has a weight filtration (`HasFilt`), e.g.
`K₀(X) ⊗ ℚ`.  For finitely many `x₁, …, xₙ ∈ K` there is a finite-dimensional subalgebra `S`,
stable under all `Ψ j` (`j ≥ 2`), containing the `xᵢ` (`exists_finite_stable_subalgebra`): it is
generated by the homogeneous components of the `xᵢ` (weight `0` components are scalars, positive
weight components are nilpotent).  `S` inherits weight filtrations, hence its own Adams-weight
grading, and finite-dimensionality gives `D' := max weight` with `W p = ⊥` for `p > D'`
(`subalg_weightHyp`): this is `RG6B.WeightHyp` on `S` (note `D'` is a maximal weight, *not*
`dim S`).
-/

set_option autoImplicit false

noncomputable section

open Module

namespace STEPW

variable {K : Type*} [CommRing K] [Algebra ℚ K] {Ψ : ℕ → K →ₐ[ℚ] K} {ρ : K →ₐ[ℚ] ℚ}

/-- A subalgebra stable under `Ψ j` for `j ≥ 2`.-/
def StableSub (Ψ : ℕ → K →ₐ[ℚ] K) (S : Subalgebra ℚ K) : Prop :=
  ∀ j : ℕ, 2 ≤ j → ∀ x ∈ S, Ψ j x ∈ S

/-- The restriction of `Ψ` to a stable subalgebra (the identity for `j < 2`).-/
def subPsi (S : Subalgebra ℚ K) (hS : StableSub Ψ S) (j : ℕ) : S →ₐ[ℚ] S :=
  if h : 2 ≤ j then ((Ψ j).comp S.val).codRestrict S (fun x ↦ hS j h x.1 x.2)
  else AlgHom.id ℚ S

/-- The rank on a subalgebra.-/
def subRho (S : Subalgebra ℚ K) (ρ : K →ₐ[ℚ] ℚ) : S →ₐ[ℚ] ℚ := ρ.comp S.val

section Weights

variable (H : ∀ x : K, HasFilt Ψ ρ x)
  (hcomm : ∀ j j', 2 ≤ j → 2 ≤ j' → ∀ x, Ψ j (Ψ j' x) = Ψ j' (Ψ j x))

include H hcomm

/-- Existence of a finite-dimensional stable subalgebra containing finitely many given elements.
@isnad1 id=ex.2h4v.s8.4a030ab9e110 from=translated src=- shape=d48ca06c vocab=3130980e
-/
theorem exists_finite_stable_subalgebra (xs : Finset K) :
    ∃ S : Subalgebra ℚ K, Module.Finite ℚ S ∧ StableSub Ψ S ∧ ∀ x ∈ xs, x ∈ S := by
  classical
  letI := gradedAlgebra (Ψ := Ψ) (ρ := ρ) 2 H le_rfl
  let comp : K → ℕ → K := fun x p ↦ (DirectSum.decompose (W Ψ 2) x p : K)
  let G : Set K := ⋃ x ∈ xs, (fun p ↦ comp x p) '' ((DirectSum.decompose (W Ψ 2) x).support : Set ℕ)
  have hGfin : G.Finite := by
    refine Set.Finite.biUnion xs.finite_toSet fun x _ ↦ Set.Finite.image _ (Finset.finite_toSet _)
  have hGW : ∀ g ∈ G, ∃ p, g ∈ W Ψ 2 p := by
    intro g hg
    simp only [G, Set.mem_iUnion, Set.mem_image] at hg
    obtain ⟨x, _, p, _, rfl⟩ := hg
    exact ⟨p, (DirectSum.decompose (W Ψ 2) x p).2⟩
  have hGint : ∀ g ∈ G, IsIntegral ℚ g := by
    intro g hg
    obtain ⟨p, hp⟩ := hGW g hg
    rcases Nat.eq_zero_or_pos p with rfl | hp0
    · rw [W_zero_eq_span 2 H le_rfl] at hp
      obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hp
      rw [← Algebra.algebraMap_eq_smul_one]
      exact isIntegral_algebraMap
    · obtain ⟨-, n, hn⟩ := rank_eq_zero_of_mem_W 2 H le_rfl hp0 hp
      exact ⟨Polynomial.X ^ n, Polynomial.monic_X_pow n, by simpa using hn⟩
  refine ⟨Algebra.adjoin ℚ G, Algebra.finite_adjoin_of_finite_of_isIntegral hGfin hGint, ?_, ?_⟩
  · intro j hj x hx
    have hle : Algebra.adjoin ℚ G ≤ (Algebra.adjoin ℚ G).comap (Ψ j) := by
      rw [Algebra.adjoin_le_iff]
      intro g hg
      obtain ⟨p, hp⟩ := hGW g hg
      have hp' : g ∈ W Ψ j p := by rwa [← W_eq Ψ ρ H hcomm (le_refl 2) hj p]
      rw [SetLike.mem_coe, Subalgebra.mem_comap, mem_W.mp hp']
      exact Subalgebra.smul_mem _ (Algebra.subset_adjoin hg) _
    exact hle hx
  · intro x hx
    rw [← DirectSum.sum_support_decompose (W Ψ 2) x]
    refine Subalgebra.sum_mem _ fun p hp ↦ Algebra.subset_adjoin ?_
    simp only [G, Set.mem_iUnion, Set.mem_image]
    exact ⟨x, hx, p, by simpa using hp, rfl⟩

end Weights

end STEPW
