import Tengoku

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Recognizing `ℤ/2`

A group generated by a single element `g` with `g * g = 1` and `g ≠ 1` is isomorphic
to `Multiplicative (ZMod 2)`.

Main declarations:

* `Submission.nonempty_mulEquiv_zmodTwo`: from `g * g = 1`, `zpowers g = ⊤`, `g ≠ 1`;
* `Submission.nonempty_mulEquiv_zmodTwo_of_orderOf_eq_two`: variant taking
  `orderOf g = 2` instead of `g * g = 1` and `g ≠ 1`;
* `Submission.nonempty_mulEquiv_zmodTwo_of_card_eq_two`: every group with exactly
  two elements is isomorphic to multiplicative `ZMod 2`.
-/

namespace Submission

/-- A group generated by an element of order dividing two which is nontrivial is
isomorphic to `ℤ/2` (written multiplicatively).
@isnad1 id=nonempty.3h2v.s7.fd57754699c4 from=translated src=- shape=752bd6f8 vocab=9a200092
-/
theorem nonempty_mulEquiv_zmodTwo (G : Type*) [Group G] (g : G) (hsq : g * g = 1)
    (hgen : Subgroup.zpowers g = ⊤) (hne : g ≠ 1) :
    Nonempty (G ≃* Multiplicative (ZMod 2)) := by
  have hg : ∀ y : G, y ∈ Subgroup.zpowers g := fun y => hgen ▸ Subgroup.mem_top y
  have horder : orderOf g = 2 := orderOf_eq_prime (by rwa [pow_two]) hne
  have hcard : Nat.card G = 2 := by
    rw [← Subgroup.card_top, ← hgen, Nat.card_zpowers, horder]
  exact ⟨(zmodMulEquivOfGenerator hg hcard).symm⟩

/-- Variant of `nonempty_mulEquiv_zmodTwo` taking `orderOf g = 2`.
@isnad1 id=nonempty.2h2v.s6.93afc8130223 from=translated src=- shape=643f978a vocab=69197571
-/
theorem nonempty_mulEquiv_zmodTwo_of_orderOf_eq_two (G : Type*) [Group G] (g : G)
    (horder : orderOf g = 2) (hgen : Subgroup.zpowers g = ⊤) :
    Nonempty (G ≃* Multiplicative (ZMod 2)) := by
  refine nonempty_mulEquiv_zmodTwo G g ?_ hgen ?_
  · have h := pow_orderOf_eq_one g
    rwa [horder, pow_two] at h
  · intro h
    rw [h, orderOf_one] at horder
    norm_num at horder

/-- Every group whose underlying type has exactly two elements is the cyclic group
of order two.  This form lets the geometric argument prove only that a `ZMod 2`-valued
invariant is bijective; no separate geometric additivity theorem is needed.
@isnad1 id=nonempty.1h1v.s6.7b308c2e0d63 from=translated src=- shape=eed2f67e vocab=cdb5119d
-/
theorem nonempty_mulEquiv_zmodTwo_of_card_eq_two (G : Type*) [Group G]
    (hcard : Nat.card G = 2) :
    Nonempty (G ≃* Multiplicative (ZMod 2)) := by
  obtain ⟨g, hg, hunique⟩ := (Nat.card_eq_two_iff' (1 : G)).mp hcard
  have hsq : g * g = 1 := by
    by_contra hgg
    have heq : g * g = g := hunique (g * g) hgg
    have : g = 1 := by
      apply mul_left_cancel (a := g)
      simpa using heq
    exact hg this
  have hgen : Subgroup.zpowers g = ⊤ := by
    apply top_unique
    intro y _
    by_cases hy : y = 1
    · simpa [hy]
    · rw [hunique y hy]
      exact Subgroup.mem_zpowers g
  exact nonempty_mulEquiv_zmodTwo G g hsq hgen hg

end Submission
