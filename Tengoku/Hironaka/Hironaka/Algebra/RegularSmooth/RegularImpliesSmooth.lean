/-!
# Regular implies smooth

The implication (2) ⇒ (1) of [Sta, Tag 00TV]: if `S` is a finite type algebra over the field `k`
and `𝔮 ⊆ S` a prime with `S_𝔮` a regular local ring and residue field `κ` formally smooth over
`k`, then `S` is smooth at `𝔮`. The proof goes through Mathlib's Jacobian criterion as follows.

*The presentation.* Choose a surjection `φ : k[x_1, …, x_N] → S`, put `Q = φ⁻¹(𝔮)`, `P = k[x]_Q`,
`R = S_𝔮`; the localized map `g : P → R` is a local surjection with finitely generated kernel `I`,
`P` is formally smooth over `k` with `Ω[P⁄k]` finite free (`Presentation.lean`), so
Mathlib's Jacobian criterion
(`FormallySmooth.iff_injective_cotangentComplexBaseChange_residueField`) reduces smoothness of
`R` over `k` to the injectivity of `κ ⊗_P I → κ ⊗_P Ω[P⁄k]`,
`a ⊗ y ↦ a · (1 ⊗ d y)`, where `κ = κ(R)`.

*The kernel is generated by parameters.* `P` is regular local (`Polynomial.lean`) and `P/I ≅ R` is
regular local, so by [Sta, Tag 00NR] (`Hironaka/Algebra/Local/QuotientParameters.lean`) `I` is
generated by an initial segment `x_1, …, x_c` of a regular system of parameters of `P`. Hence
`κ ⊗_P I` is spanned by the `1 ⊗ x_j`, `j ≤ c`, whose images are the `1 ⊗ d x_j`.

*The images are independent.* The classes of `x_1, …, x_c` are linearly independent in
`𝔪_P/𝔪_P²` (`Hironaka/Algebra/Local/RegularSystem.lean`), and the conormal map
`𝔪_P/𝔪_P² → κ(P) ⊗_P Ω[P⁄k]` is injective because `κ(P)` is formally smooth over `k`
([Sta, Tag 00TU], `Cotangent.lean`): `κ(P) ≅ κ(R)` along `g`, and formal smoothness transports
along this `k`-algebra isomorphism. So the `1 ⊗ d x_j` are independent over `κ(P)` in
`κ(P) ⊗_P Ω[P⁄k]`, and then over `κ(R)` in `κ(R) ⊗_P Ω[P⁄k]`, the two tensor products being
identified semilinearly (`linearIndependent_tmul_of_bijective_residueField_map`).

*Conclusion.* A linear map that sends a spanning family to a linearly independent family is
injective: writing an element of the kernel as `∑ a_j (1 ⊗ x_j)`, its image `∑ a_j (1 ⊗ d x_j)`
vanishes only if all `a_j = 0`. Over a perfect field every essentially finite type field
extension is formally smooth (Mathlib's `FormallySmooth.of_perfectField`), which gives the form
used for schemes in `Hironaka/Algebra/RegularSmooth/RegularSmoothEquiv.lean`.
-/

@[expose] public section

universe u v

open IsLocalRing KaehlerDifferential
open scoped TensorProduct

namespace Algebra

section Transport

variable {k : Type*} [CommRing k] {P L : Type*} [CommRing P] [CommRing L] [IsLocalRing P]
  [IsLocalRing L] [Algebra k P] [Algebra k L] [Algebra P L] [IsScalarTower k P L]
  [IsLocalHom (algebraMap P L)]

/-- A local `k`-algebra map `P → L` inducing a bijection of residue fields gives a `k`-algebra
isomorphism `κ(P) ≃ κ(L)`.-/
noncomputable def residueFieldAlgEquivOfBijective
    (hbij : Function.Bijective (ResidueField.map (algebraMap P L))) :
    ResidueField P ≃ₐ[k] ResidueField L :=
  AlgEquiv.ofRingEquiv (f := RingEquiv.ofBijective (ResidueField.map (algebraMap P L)) hbij)
    fun c => by
      change ResidueField.map (algebraMap P L) (algebraMap k (ResidueField P) c) =
        algebraMap k (ResidueField L) c
      rw [IsScalarTower.algebraMap_apply k P (ResidueField P), ResidueField.algebraMap_eq,
        ResidueField.map_residue, ← IsScalarTower.algebraMap_apply,
        IsScalarTower.algebraMap_apply k L (ResidueField L), ResidueField.algebraMap_eq]

/-- Formal smoothness of `κ(L)` over `k` transports to `κ(P)` along the residue field bijection.
@isnad1 id=formally.1h3v.s8.3da3ceb356a1 from=translated src=- shape=c9a8b3de vocab=024334f4
-/
theorem FormallySmooth.residueField_of_bijective
    (hbij : Function.Bijective (ResidueField.map (algebraMap P L)))
    [Algebra.FormallySmooth k (ResidueField L)] : Algebra.FormallySmooth k (ResidueField P) :=
  Algebra.FormallySmooth.of_equiv (residueFieldAlgEquivOfBijective hbij).symm

end Transport

section Kernel

