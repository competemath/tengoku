/-
# Generated ideals, and symmetric operads presented by relators

The ideals of a symmetric operad are ordered by inclusion and closed under intersections
(`SymOperadIdeal.sInf`), so every family of elements `r n ⊆ P (Fin n)` generates an ideal, the
smallest one containing it (`SymOperadIdeal.span`, `subset_span`, `span_le`). Relators are given on
the standard input sets `Fin n`: an ideal is stable under relabelling, so it contains every
relabelling of a relator as soon as it contains the relator (`map_mem_span`).

The quotient by a generated ideal is **the operad presented by the relators**. A morphism out of it
is a morphism out of `P` killing the relators (`presHomEquiv`), because a morphism kills an ideal
exactly when the ideal lies in its kernel (`span_le_ker_iff`). Taking for `P` the linearization of
a set operad presented by generators and relations, `Lin R (Pres T ρ)` (for instance the free one,
`FreeSet T`, or the one in which some generators are symmetric), this is the operad in `R`-modules
presented by generators, by set-theoretic relations, and by linear relators, and its morphisms are
the generator values satisfying both kinds of relation (`presLinHomEquiv`); in particular they are
determined by the generators (`Pres.lin_hom_ext`, `presLin_hom_ext`).
-/
import Tengoku.LeanOperads.Operad.SymQuot
import Tengoku.LeanOperads.Operad.SetPresentation

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

universe u v w

namespace Operad

open Sym

namespace SymOperadIdeal

variable {R : Type u} [CommRing R]
  {P : (A : Type) → [Fintype A] → [DecidableEq A] → Type v}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (P A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module R (P A)] [SymOperad R P]

/--
@isnad1 id=eq.1h4v.s7.d52345b4ee23 from=translated src=- shape=87400113 vocab=407fd880
-/
@[ext] lemma ext {I J : SymOperadIdeal R P}
    (h : ∀ (A : Type) [Fintype A] [DecidableEq A], I.sub A = J.sub A) : I = J := by
  obtain ⟨I, _, _, _⟩ := I
  obtain ⟨J, _, _, _⟩ := J
  have : @I = @J := by
    funext A _ _
    exact h A
  subst this
  rfl

/-- **Ideals are ordered by inclusion**, input set by input set.-/
instance : PartialOrder (SymOperadIdeal R P) where
  le I J := ∀ (A : Type) [Fintype A] [DecidableEq A], I.sub A ≤ J.sub A
  le_refl _ _ _ _ := le_rfl
  le_trans _ _ _ hIJ hJK A _ _ := (hIJ A).trans (hJK A)
  le_antisymm _ _ hIJ hJI := ext fun A _ _ => le_antisymm (hIJ A) (hJI A)

/--
@isnad1 id=iff.0h4v.s8.863ef1097020 from=translated src=- shape=cb7d76c9 vocab=7bfaae27
-/
lemma le_def {I J : SymOperadIdeal R P} :
    I ≤ J ↔ ∀ (A : Type) [Fintype A] [DecidableEq A], I.sub A ≤ J.sub A := Iff.rfl

/-- **The intersection of a set of ideals is an ideal.**-/
def sInf (S : Set (SymOperadIdeal R P)) : SymOperadIdeal R P where
  sub A _ _ := ⨅ I ∈ S, I.sub A
  map_mem := by
    intro A B _ _ _ _ e x hx
    simp only [Submodule.mem_iInf] at hx ⊢
    exact fun I hI => I.map_mem e (hx I hI)
  comp_mem_left := by
    intro A B _ _ _ _ i x y hx
    simp only [Submodule.mem_iInf] at hx ⊢
    exact fun I hI => I.comp_mem_left i y (hx I hI)
  comp_mem_right := by
    intro A B _ _ _ _ i x y hy
    simp only [Submodule.mem_iInf] at hy ⊢
    exact fun I hI => I.comp_mem_right i x (hy I hI)

/--
@isnad1 id=iff.0h5v.s8.ad63efc53103 from=translated src=- shape=146eca9a vocab=ba0964ba
-/
lemma mem_sInf {S : Set (SymOperadIdeal R P)} {A : Type} [Fintype A] [DecidableEq A] {x : P A} :
    x ∈ (sInf S).sub A ↔ ∀ I ∈ S, x ∈ I.sub A := by
  simp only [sInf, Submodule.mem_iInf]

/--
@isnad1 id=le.1h4v.s7.fa92304525e4 from=translated src=- shape=97b29832 vocab=1aec9496
-/
lemma sInf_le {S : Set (SymOperadIdeal R P)} {I : SymOperadIdeal R P} (h : I ∈ S) :
    sInf S ≤ I :=
  fun _ _ _ _ hx => mem_sInf.1 hx I h

/--
@isnad1 id=le.1h4v.s7.ae59af552547 from=translated src=- shape=334261a5 vocab=1aec9496
-/
lemma le_sInf {S : Set (SymOperadIdeal R P)} {J : SymOperadIdeal R P} (h : ∀ I ∈ S, J ≤ I) :
    J ≤ sInf S :=
  fun A _ _ _ hx => mem_sInf.2 fun I hI => h I hI A hx

variable (R) in
/-- **The ideal generated by relators** `r n ⊆ P (Fin n)`: the smallest ideal containing them.-/
def span (r : ∀ n : ℕ, Set (P (Fin n))) : SymOperadIdeal R P :=
  sInf {I | ∀ n, r n ⊆ I.sub (Fin n)}

variable {r : ∀ n : ℕ, Set (P (Fin n))}

/--
@isnad1 id=le.0h4v.s7.a44cd7479bc3 from=translated src=- shape=1cfadee5 vocab=ff1e62e7
-/
lemma subset_span (n : ℕ) : r n ⊆ (span R r).sub (Fin n) :=
  fun _ hx => mem_sInf.2 fun _ hI => hI n hx

/-- **The generated ideal lies in an ideal exactly when the relators do.**
@isnad1 id=iff.0h4v.s8.eaf20e39f568 from=translated src=- shape=664e456c vocab=f15ddd00
-/
lemma span_le {I : SymOperadIdeal R P} : span R r ≤ I ↔ ∀ n, r n ⊆ I.sub (Fin n) :=
  ⟨fun h n _ hx => h _ (subset_span n hx), fun h => sInf_le h⟩

/--
@isnad1 id=le.1h4v.s7.057b7abd59c7 from=translated src=- shape=3b808edb vocab=3abd603e
-/
lemma span_mono {r' : ∀ n : ℕ, Set (P (Fin n))} (h : ∀ n, r n ⊆ r' n) :
    span R r ≤ span R r' :=
  span_le.2 fun n => (h n).trans (subset_span n)

variable {Q : (A : Type) → [Fintype A] → [DecidableEq A] → Type w}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (Q A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module R (Q A)] [SymOperad R Q]

/-- **A morphism kills the generated ideal exactly when it kills the relators.**
@isnad1 id=iff.0h5v.s9.1c7a90fb7ee2 from=translated src=- shape=98d7be97 vocab=1e3be6c2
-/
lemma span_le_ker_iff (φ : SymOperadHom R P Q) :
    span R r ≤ φ.ker ↔ ∀ n, ∀ x ∈ r n, φ.app (Fin n) x = 0 := by
  rw [span_le]
  refine forall_congr' fun n => ⟨fun h x hx => ?_, fun h x hx => ?_⟩
  · exact (SymOperadHom.mem_ker φ x).1 (h hx)
  · exact (SymOperadHom.mem_ker φ x).2 (h x hx)

/-- A morphism killing the relators kills every element of the generated ideal.
@isnad1 id=eq.2h7v.s9.b8c8520edf19 from=translated src=- shape=36828df1 vocab=813eaa11
-/
lemma app_eq_zero_of_mem_span (φ : SymOperadHom R P Q) (hφ : ∀ n, ∀ x ∈ r n, φ.app (Fin n) x = 0)
    {A : Type} [Fintype A] [DecidableEq A] {x : P A} (hx : x ∈ (span R r).sub A) :
    φ.app A x = 0 :=
  (SymOperadHom.mem_ker φ x).1 ((span_le_ker_iff φ).2 hφ A hx)

/-- **The universal property of a presented operad**: a morphism out of the quotient by the ideal
generated by `r` is a morphism out of `P` killing `r`.-/
noncomputable def presHomEquiv :
    SymOperadHom R (span R r).Quot Q
      ≃ {φ : SymOperadHom R P Q // ∀ n, ∀ x ∈ r n, φ.app (Fin n) x = 0} where
  toFun ψ := ⟨ψ.comp (span R r).projHom, fun n x hx => by
    show ψ.app _ ((span R r).proj _ x) = 0
    rw [((span R r).proj_eq_zero_iff x).2 (subset_span n hx), map_zero]⟩
  invFun φ := (span R r).liftHom φ.1 fun _ _ _ _ hx => app_eq_zero_of_mem_span φ.1 φ.2 hx
  left_inv ψ := ((span R r).liftHom_unique _ _ ψ rfl).symm
  right_inv φ := Subtype.ext ((span R r).liftHom_comp_projHom _ _)

/--
@isnad1 id=eq.0h7v.s12.4882886cec74 from=translated src=- shape=cb1c9852 vocab=d42664a6
-/
@[simp] lemma presHomEquiv_symm_mk (φ : {φ : SymOperadHom R P Q // ∀ n, ∀ x ∈ r n,
    φ.app (Fin n) x = 0}) {A : Type} [Fintype A] [DecidableEq A] (x : P A) :
    (presHomEquiv.symm φ).app A (Submodule.Quotient.mk x) = φ.1.app A x := rfl

end SymOperadIdeal

section Linear

open SymOperadIdeal

variable (R : Type u) [CommRing R] {T : ℕ → Type w}
  {ρ : ∀ {A : Type} [Fintype A] [DecidableEq A], Syn T A → Syn T A → Prop}
  {Q : (A : Type) → [Fintype A] → [DecidableEq A] → Type w}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (Q A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module R (Q A)] [SymOperad R Q]
  (r : ∀ n : ℕ, Set (Lin R (Pres T ρ) (Fin n)))

/-- **Operads in modules presented by generators, set-theoretic relations and linear relators**:
a morphism out of `Lin R (Pres T ρ)` modulo the ideal generated by `r` is a choice of generator
values satisfying the relations `ρ`, whose linear extension kills `r`.-/
noncomputable def presLinHomEquiv :
    SymOperadHom R (span R r).Quot Q
      ≃ {f : {f : ∀ n, T n → Und R Q (Fin n) // Pres.Respects ρ f} //
          ∀ n, ∀ x ∈ r n, ((Pres.linHomEquiv R).symm f).app (Fin n) x = 0} :=
  presHomEquiv.trans
    { toFun := fun φ => ⟨Pres.linHomEquiv R φ.1, by
        rw [Equiv.symm_apply_apply]
        exact φ.2⟩
      invFun := fun f => ⟨(Pres.linHomEquiv R).symm f.1, f.2⟩
      left_inv := fun φ => Subtype.ext (Equiv.symm_apply_apply _ _)
      right_inv := fun f => Subtype.ext (Equiv.apply_symm_apply _ _) }

end Linear

section PresExt

variable {R : Type*} [CommRing R] {T : ℕ → Type*}
  {ρ : ∀ {A : Type} [Fintype A] [DecidableEq A], Syn T A → Syn T A → Prop}
  {r : ∀ n : ℕ, Set (Lin R (Pres T ρ) (Fin n))}
  {Q : (A : Type) → [Fintype A] → [DecidableEq A] → Type*}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (Q A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module R (Q A)] [SymOperad R Q]

/-- **Morphisms out of the linearization of a presented set operad agree when they agree on the
generators.**
@isnad1 id=eq.1h6v.s10.b369f85cb01b from=translated src=- shape=857e3782 vocab=6e77df1e
-/
theorem Pres.lin_hom_ext {φ ψ : SymOperadHom R (Lin R (Pres T ρ)) Q}
    (h : ∀ (n : ℕ) (g : T n),
      φ.app _ (Finsupp.single (Pres.gen g) 1) = ψ.app _ (Finsupp.single (Pres.gen g) 1)) :
    φ = ψ := by
  apply (Operad.linHomEquiv R).symm.injective
  exact Pres.hom_ext fun n g => congrArg (Und.of R Q) (h n g)

/-- **Morphisms out of an operad presented by generators and linear relators agree when they
agree on the generators.**
@isnad1 id=eq.1h7v.s13.1050bcc7d554 from=translated src=- shape=6b3e0347 vocab=e5a1ee25
-/
theorem presLin_hom_ext {φ ψ : SymOperadHom R (SymOperadIdeal.span R r).Quot Q}
    (h : ∀ (n : ℕ) (g : T n),
      φ.app _ ((SymOperadIdeal.span R r).proj _ (Finsupp.single (Pres.gen g) 1))
        = ψ.app _ ((SymOperadIdeal.span R r).proj _ (Finsupp.single (Pres.gen g) 1))) :
    φ = ψ := by
  apply SymOperadIdeal.presHomEquiv.injective
  apply Subtype.ext
  exact Pres.lin_hom_ext h

end PresExt

end Operad
