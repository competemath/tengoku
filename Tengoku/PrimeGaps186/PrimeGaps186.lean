  have h2 : u2 * d = r2 := Nat.div_mul_cancel (Nat.gcd_dvd_right r1 r2)
  refine ⟨h1.symm, h2.symm, ?_⟩
  rw [← h1, ← h2, Nat.lcm_mul_right]
