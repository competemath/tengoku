      ∀ D N : ℤ,
        (Int.gcd ((f : ℤ) * D) (m : ℤ) = 1 ↔ Int.gcd D (m : ℤ) = 1) ∧
        ((((f : ℤ) * D : ℤ) : ZMod q₀) = dstar ∧
