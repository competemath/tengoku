    (p.1.2, u g (p.1.1 / g), (p.1.1 / g) / u g (p.1.1 / g), p.2.1 / g)
  let ρ : ℕ → (ℕ × ℕ × ℕ × ℕ) → (ℕ × ℕ) × (ℕ × ℕ) := fun g t =>
    ((g * t.2.1 * t.2.2.1, t.1), (g * t.2.2.2, t.1))
