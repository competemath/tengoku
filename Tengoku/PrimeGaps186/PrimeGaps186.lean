        (((S.image Prod.snd).card : ℝ) * ∑ m ∈ α.support, ‖α m‖ ^ 2) *
          dispersionEnergy sm w S β c a b₁ b₂ := by
  choose c hc using fun p : ℕ × ℕ => Complex.exists_norm_eq_mul_self
    (deltaZero (finiteConvolution α β) p.1 p.2 a b₁ b₂)
  let R := S.image Prod.snd
