/--
The standard additive character of `A * L / (F₁ * F₂)`, where `F₁ = n + B * d + η₁` and `F₂ = n
+ (B + L) * d + η₂`. The phase is extended by zero unless both affine factors are units modulo
`m`.-/
noncomputable def affineReciprocalProductPhase (m : ℕ) [NeZero m]
    (A B L η₁ η₂ n d : ZMod m) : ℂ :=
  let F₁ : ZMod m := n + B * d + η₁
  let F₂ : ZMod m := n + (B + L) * d + η₂
  if IsUnit F₁ ∧ IsUnit F₂ then
    ZMod.stdAddChar (A * L * (F₁ * F₂)⁻¹)
  else 0

