        simp_rw [hkernel, ite_eq_left hdq]
        simp only [kernel, div_eq_mul_inv, mul_sub,
          mul_ite, ite_mul, one_mul, mul_one, zero_mul, mul_zero,
          Finset.sum_sub_distrib, Finset.sum_mul]
      have hfirst :
          ‖∑ m ∈ I, if m % q = (B d) % q then w d m else 0‖ ≤ F * v d / q := by
        calc
