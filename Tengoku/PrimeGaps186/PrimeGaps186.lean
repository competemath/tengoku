      have heq : a + c * ℓ₀ - (a + c * ℓ) = c * (ℓ₀ - ℓ) := by ring
      rw [heq] at hd
      exact Int.modEq_iff_dvd.mpr (hc.symm.dvd_of_dvd_mul_left hd)
