theorem harman_feature_mesh_seven_label_polylog
    (D E : ℕ) (hD : 1 ≤ D) (hE : 1 ≤ E) (x : ℝ) (hx : Real.exp 2 ≤ x) :
    let U : ℕ := ⌊8 * x⌋₊
    let L : ℕ := ⌊Real.log x⌋₊ ^ E
    let h : ℝ := (Real.log x) ^ (-(D : ℝ))
