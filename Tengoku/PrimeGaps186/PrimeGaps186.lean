            (Real.sqrt (r₁ : ℝ) * Real.sqrt (r₂ : ℝ)) := by ring
        _ = (Real.sqrt b * Real.sqrt Q) *
            (Real.sqrt (Nat.gcd r₁ r₂ : ℝ) *
              Real.sqrt (Nat.lcm r₁ r₂ : ℝ)) := by rw [hroots]
        _ = _ := by ring
    have hratio₂ : Real.sqrt (Q * (Nat.lcm r₁ r₂ : ℝ)) /
        Real.sqrt (b * (r₁ : ℝ)) =
        Real.sqrt Q * Real.sqrt (r₂ : ℝ) /
