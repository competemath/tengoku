      ∑ a ∈ SA t.1, ∑ b ∈ SB t.2,
        if mA a * mB b = n then |wa a| * |wb b| else 0
    let F (n : ℕ) : ℝ :=
      ∑ a ∈ A, ∑ b ∈ B,
        if Good a b ∧ mA a * mB b = n then wa a * wb b else 0
