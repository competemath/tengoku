        ∑ n ∈ Finset.Icc 1 x with ¬Nat.Coprime n q,
          χ n * (ArithmeticFunction.vonMangoldt n : ℂ) := by
  rw [twistedChebyshevSum, coprimeTwistedChebyshevSum]
  exact (Finset.sum_filter_add_sum_filter_not _ _ _).symm

