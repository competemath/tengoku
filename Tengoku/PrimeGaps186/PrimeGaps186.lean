theorem exists_rat_exp_interval_refinement (x : ℚ) :
    ∃ b : ℕ,
      let v : ℚ := |x| / (2 : ℚ) ^ b
      let E : ℕ → ℚ := fun M =>
        ∑ r ∈ Finset.range (M + 1), v ^ r / (r.factorial : ℚ)
      let R : ℕ → ℚ := fun M =>
        v ^ (M + 1) / ((M + 1).factorial : ℚ) *
          (1 / (1 - v / ((M + 2 : ℕ) : ℚ)))
