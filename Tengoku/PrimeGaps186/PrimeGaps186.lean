  have hN (y : Y) : N y ≤ A + E := hfiber y
  have hNsum : ∑ y : Y, N y = Fintype.card X := by
    simpa [N] using Finset.sum_card_fiberwise_eq_card_filter
      (Finset.univ : Finset X) (Finset.univ : Finset Y) g
