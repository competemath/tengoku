    apply (mul_le_mul_iff_right₀ hx0).mp
    calc
      x * 1 = x := mul_one _
      _ ≤ C * M * N := hMNlo
      _ = M * (C * N) := by ring
      _ ≤ M * x ^ 2 := mul_le_mul_of_nonneg_left hCN hM.le
      _ = x * (x * M) := by ring
