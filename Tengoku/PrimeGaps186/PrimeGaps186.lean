    rw [Finset.sum_tsub_distrib _ (fun y _ => hN y), hNsum, hcard]
    simp [mul_add]
  have hgroup : (∑ x : X, weight (g x)) = ∑ y : Y, (N y : ℂ) * weight y := by
    simpa [N, nsmul_eq_mul] using
      (Finset.sum_fiberwise' (Finset.univ : Finset X) g weight).symm
  have hrecenter : (∑ y : Y, (N y : ℂ) * weight y) =
      -∑ y : Y, ((A + E - N y : ℕ) : ℂ) * weight y := by
    simp_rw [Nat.cast_sub (hN _), sub_mul]
    rw [Finset.sum_sub_distrib, ← Finset.mul_sum, hmean]
    simp
  rw [hgroup, hrecenter, norm_neg]
