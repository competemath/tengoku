  | none => 0
  | some c =>
    if j < physicalSourceRowCount g ∧ r ≤ top ∧
        (⌊c / trialMesh⌋ : ℤ) - (d : ℤ) + 1 ≤ (r : ℤ) ∧
        (r : ℤ) ≤ (⌊G.upperRadius / trialMesh⌋ : ℤ)
    then 1 else 0

/--
