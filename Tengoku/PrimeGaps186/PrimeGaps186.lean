classes modulo `q`, summing weights with the same residue.-/
noncomputable def integerIntervalResidueWeight
    (q : ℕ) (A : ℤ) (N : ℕ) (w : ℕ → ℂ)
    (x : ZMod q) : ℂ := by
  classical
  exact ∑ n ∈ Finset.range N,
    if ((A + n : ℤ) : ZMod q) = x then w n else 0

