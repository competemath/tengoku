theorem sum_card_divisors_pow_div_le_log_pow (e Z : ℕ) :
    (∑ d ∈ Finset.Icc 1 Z, (d.divisors.card : ℝ) ^ e / (d : ℝ)) ≤
      (1 + Real.log (Z : ℝ)) ^ (2 ^ e) := by
  calc
    _ ≤ ∑ d ∈ Finset.Icc 1 Z,
        (((ArithmeticFunction.zeta : ArithmeticFunction ℕ) ^ (2 ^ e)) d : ℝ) /
          (d : ℝ) := by
      apply Finset.sum_le_sum
      intro d hd
      apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg d)
      exact_mod_cast card_divisors_pow_le_zeta_pow e d
        (Finset.mem_Icc.mp hd).1
    _ ≤ (harmonic Z : ℝ) ^ (2 ^ e) := sum_zeta_pow_div_le_harmonic_pow _ _
    _ ≤ _ := pow_le_pow_left₀ (by unfold harmonic; positivity)
      (harmonic_le_one_add_log Z) _

/--
@isnad1 id=le.7h8v.s8.9a577531e571 from=translated src=- shape=89dfcc4d vocab=8fb2220d
