theorem snoc_affine_sub (c : Fin (n + 1) → ℝ) (b : ℝ)
    (t : Fin n → ℝ) (z z₀ : ℝ) :
    ((∑ i, c i * Fin.snoc (α := fun _ => ℝ) t z i) - b) -
        ((∑ i, c i * Fin.snoc (α := fun _ => ℝ) t z₀ i) - b) =
      c (Fin.last n) * (z - z₀) := by
  rw [snoc_affine_expand, snoc_affine_expand]
  ring

