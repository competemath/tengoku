    [NeZero q₁] [NeZero q₂] [NeZero r]
    (hq : Nat.Coprime q₁ q₂)
    (hqr₁ : Nat.Coprime q₁ r) (hqr₂ : Nat.Coprime q₂ r)
    (ha : Nat.Coprime a r) (hb₁ : Nat.Coprime b₁ q₁)
    (hb₂ : Nat.Coprime b₂ q₂) :
    mixedFiberFourierCoefficient sm w q₁ q₂ r a b₁ b₂ n₁ n₂ 0 =
      if Nat.Coprime n₁ (q₁ * r) ∧ Nat.Coprime n₂ (q₂ * r) ∧
          Nat.ModEq r n₁ n₂
