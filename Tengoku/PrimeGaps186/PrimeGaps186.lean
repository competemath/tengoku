/--
The finitely supported multiplicative-algebra element for one Heath–Brown slot, localized near
`Θ^(ν i)`. Its coefficient at `n` is the slot value times the smooth profile and the Mellin
factor `n^(-t)`, sampled from `1` through `⌊Θ * Θ^(ν i)⌋₊`.-/
noncomputable def minorantHBLocalizedSlot (j : ℕ) (U Θ t : ℝ)
    (ν : Fin (2 * j) → ℕ) (i : Fin (2 * j)) : MonoidAlgebra ℂ ℕ :=
  ∑ n ∈ Finset.Icc 1 ⌊Θ * Θ ^ (ν i)⌋₊,
    MonoidAlgebra.single n
      ((minorantHBProfile Θ ((n : ℝ) / Θ ^ (ν i)) *
        Real.rpow (n : ℝ) (-t) * minorantHBSlot j U i n : ℝ) : ℂ)

