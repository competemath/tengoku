        vaughanTwistedSumOneEndpointMaximum U x q chi.1 := by
    unfold vaughanTwistedSumOneEndpointMaximum
    rw [dite_eq_left hxOne]
    exact Finset.le_sup'
      (fun z ↦ ‖vaughanTwistedSumOne U z q chi.1‖) hyComponent
  have hTwo :
