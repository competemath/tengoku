    (hn : Nat.Coprime n q) :
    χ n = χ.primitiveCharacter n := by
  have hi : IsCoprime (n : ℤ) (q : ℤ) :=
    Nat.isCoprime_iff_coprime.mpr hn
  have h := χ.primitiveCharacter_apply_of_isCoprime hi
  simpa using h.symm

