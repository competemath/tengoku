def dickmanDirectedGrid (p : ℤ) (M : ℕ) : ℕ → Array (ℚ × ℚ) :=
  Nat.rec (motive := fun _ => Array (ℚ × ℚ)) #[(1, 1)]
    (fun j G =>
      if M = 0 ∨ j < M then
        G.push (1, 1)
      else
        let previous := G.getD j (1, 1)
        let left := G.getD (j - M) (1, 1)
        let right := G.getD (j + 1 - M) (1, 1)
        let lower : ℚ :=
          previous.1 - left.2 / (2 * (j : ℚ)) -
            right.2 / (2 * ((j : ℚ) + 1))
        let upper : ℚ :=
          previous.2 - left.1 / (2 * (j : ℚ)) -
            right.1 / (2 * ((j : ℚ) + 1)) +
            1 / (2 * (M : ℚ) ^ 3)
        G.push (max 0 (lower.toDyadic p).toRat,
          min 1 (-(((-upper).toDyadic p).toRat))))

