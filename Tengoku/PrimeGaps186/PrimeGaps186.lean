    have hratioR : 0 ≤ Real.log R / Real.log Θ := Real.logb_nonneg hΘ hR
    have hMceil : (M : ℝ) < Real.log R / Real.log Θ + 1 :=
      Nat.ceil_lt_add_one hratioR
