    calc
      L ^ 2 = ‖(L : ℂ)‖ ^ 2 := by rw [Complex.norm_of_nonneg hL]
      _ = ‖∑ n, w n * transposeSum Finset.univ C v n‖ ^ 2 := by rw [hpair]
