        ∏ p ∈ (fragmentPrimes (presievingModulus H x) (x ^ ρ) β).filter
          (fun p : ℕ => (x ^ ρ) ^ α < (p : ℝ)),
          (1 + (Real.exp (-s * (Real.log p / Real.log (x ^ ρ))) - 1) / (p : ℝ)))
      atTop (nhds (Real.exp (∫ u in α..β, (Real.exp (-s * u) - 1) / u))) := by
  classical
  let S (x : ℝ) :=
    (fragmentPrimes (presievingModulus H x) (x ^ ρ) β).filter
      (fun p : ℕ => (x ^ ρ) ^ α < (p : ℝ))
  let z (x : ℝ) (p : ℕ) :=
    (Real.exp (-s * (Real.log p / Real.log (x ^ ρ))) - 1) / (p : ℝ)
  let T (x : ℝ) (p : ℕ) :=
    if Nat.Prime p ∧ ¬p ∣ presievingModulus H x then 1 / (p : ℝ) ^ 2 else 0
