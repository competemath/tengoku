  have hp1 : (1 : ℝ) ≤ p := one_le_two.trans hp2
  have hpow : (2 : ℝ) ≤ (p : ℝ) ^ s.re := by
    calc
      (2 : ℝ) ≤ p := hp2
      _ = (p : ℝ) ^ (1 : ℝ) := by rw [Real.rpow_one]
