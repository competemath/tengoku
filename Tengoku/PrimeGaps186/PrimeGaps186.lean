    {q : ℕ} [NeZero q] (chi : DirichletCharacter ℂ q)
    (x U : ℝ) : ℂ :=
  (((2 * Real.pi : ℝ) : ℂ)⁻¹) *
    (I * (∫ sigma in (-1 / 2)..(1 + 1 / Real.log x),
          dirichletExplicitFormulaIntegrand chi x
            ((sigma : ℂ) - U * I)) -
      I * (∫ sigma in (-1 / 2)..(1 + 1 / Real.log x),
          dirichletExplicitFormulaIntegrand chi x
            ((sigma : ℂ) + U * I)) +
      (∫ t in -U..U,
        dirichletExplicitFormulaIntegrand chi x
          (((-1 / 2 : ℝ) : ℂ) + t * I)))

