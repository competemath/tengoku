    (hfiber : ∀ y : Y,
      (Finset.univ.filter fun x : X => g x = y).card ≤ A + E)
    (hcard : Fintype.card X = Fintype.card Y * A)
    (hmean : ∑ y : Y, weight y = 0)
    (hweight : ∀ y : Y, ‖weight y‖ ≤ 1) :
    ‖∑ x : X, weight (g x)‖ ≤ (Fintype.card Y * E : ℕ) := by
