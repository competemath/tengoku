    dirichletPerronNaturalWeight x n = 1 := by
  simp [dirichletPerronNaturalWeight, hn.ne', hnx]

/--
@isnad1 id=eq.1h1v.s5.99b3b6d0ba45 from=translated src=- shape=c3eedc59 vocab=074dac56
