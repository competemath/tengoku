  rw [primitiveRawMeanValueCumulative_nat_eq_weightedRawEndpointMaximum]
  apply Finset.sum_le_sum
  intro q _hq
  apply mul_le_mul_of_nonneg_left
  · apply Finset.sum_le_sum
