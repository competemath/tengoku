    (∑ f ∈ S, (f.totient : ℝ)⁻¹ * Z f) =
        ∑ j ∈ Finset.range (Nat.log 2 Q + 1),
          ∑ f ∈ S.filter (fun f => exponent f = j), (f.totient : ℝ)⁻¹ * Z f :=
      hpartition _
    _ ≤ ∑ _j ∈ Finset.range (Nat.log 2 Q + 1), Eu * Ev * D :=
      Finset.sum_le_sum fun j _ => hband j
    _ = ((Nat.log 2 Q + 1 : ℕ) : ℝ) * Eu * Ev * D := by
      simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
