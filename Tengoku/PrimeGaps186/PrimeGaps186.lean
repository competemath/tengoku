/--
The zeta zero-free strip width `min (1 / 2) (1 / (M ^ 2 * log (T + 2)))`, capped to keep the
left edge at real part at least one half.-/
noncomputable def zetaZeroFreeWidth (M : ℕ) (T : ℝ) : ℝ :=
  min (1 / 2) (1 / ((M : ℝ) ^ 2 * Real.log (T + 2)))

