    dirichletPerronNaturalWeight x 0 = 0 := by
  simp [dirichletPerronNaturalWeight]

/--
@isnad1 id=eq.2h2v.s4.1beb36202922 from=translated src=- shape=4ceaabb2 vocab=e777621f
