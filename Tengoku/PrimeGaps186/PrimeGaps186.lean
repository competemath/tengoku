noncomputable def physicalSourceCover (g : Fin 6) (j : ℕ) {d : ℕ}
    (X : Fin d → FiniteMeasure ℝ) : ℝ := by
  classical
  exact
    let P := physicalSourceGroup g
    let e := physicalSourceComponentEndpoints g j
    let r : ℕ := ∑ i : Fin d, trialCellIndex (X i)
