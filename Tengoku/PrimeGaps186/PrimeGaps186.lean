        apply Finset.sum_le_sum
        intro r₁ hr₁
        calc
          _ ≤ ∑ r₂ ∈ Finset.Icc 1 (4 * R), (Nat.gcd r₁ r₂ : ℝ) := by
            apply Finset.sum_le_sum_of_subset_of_nonneg
            · intro r₂ hr₂
              obtain ⟨hr₂₀, hr₂₁⟩ := Finset.mem_Ico.mp hr₂
              exact Finset.mem_Icc.mpr ⟨hR.trans_le hr₂₀, hr₂₁.le⟩
            · intro r₂ _ _
              exact Nat.cast_nonneg _
