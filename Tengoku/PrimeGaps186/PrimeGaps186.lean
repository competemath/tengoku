@isnad1 id=eq.0h3v.s6.638b726a87b0 from=translated src=- shape=ad73a28e vocab=fcf77079
-/
theorem sum_divisors_up_to_eq_sum_positiveFactorPairs
    {Q : ℕ} {M : Type*} [AddCommMonoid M]
