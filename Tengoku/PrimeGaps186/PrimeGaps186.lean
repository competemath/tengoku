    have hp1 : (1 : ℝ) ≤ p := by linarith
    have hroot : (4 / 3 : ℝ) ≤ Real.sqrt (p : ℝ) := by
      nlinarith [Real.sq_sqrt (Nat.cast_nonneg p), Real.sqrt_nonneg (p : ℝ)]
    have hpow : (4 / 3 : ℝ) ≤ (p : ℝ) ^ s.re := by
      calc
        _ ≤ Real.sqrt (p : ℝ) := hroot
        _ = (p : ℝ) ^ (1 / 2 : ℝ) := Real.sqrt_eq_rpow _
        _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hp1 hs
    have hw : ‖chi.primitiveCharacter p * (p : ℂ) ^ (-s)‖ ≤ (3 / 4 : ℝ) := by
      rw [norm_mul, Complex.norm_natCast_cpow_of_pos hp.pos, neg_re,
        Real.rpow_neg (Nat.cast_nonneg p)]
      calc
        _ ≤ 1 * ((p : ℝ) ^ s.re)⁻¹ :=
          mul_le_mul_of_nonneg_right (chi.primitiveCharacter.norm_le_one p)
            (inv_nonneg.mpr (Real.rpow_nonneg (Nat.cast_nonneg p) _))
        _ ≤ (3 / 4 : ℝ) := by
          have h := one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 4 / 3) hpow
          norm_num [one_div] at h ⊢
          exact h
