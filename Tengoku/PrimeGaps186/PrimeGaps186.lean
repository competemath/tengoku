theorem sparse_factor_moduli_bound
    (γ θ : ℝ) (hγ : 0 ≤ γ) (hθ : 0 < θ) (hθγ : θ < 1 - γ)
    (k J : ℕ) (Cscale : ℝ) (hCscale : 1 ≤ Cscale) :
    ∃ P : ℕ, ∃ K X : ℝ, 0 < K ∧ Real.exp 1 ≤ X ∧
      ∀ x : ℝ, X ≤ x →
      ∀ N : ℝ, 1 ≤ N → N ≤ x ^ γ →
      ∀ (S : Finset ℕ), S ⊆ Finset.Icc 1 ⌊x ^ θ⌋₊ →
      ∀ a : ℕ → ℕ, (∀ q ∈ S, Nat.Coprime (a q) q) →
      ∀ (D : Finset ℕ) (w : ℕ → ℕ → ℂ) (v : ℕ → ℝ),
        (∀ d ∈ D, 0 ≤ v d) →
        (∀ d ∈ D, ∀ m ∈ Finset.Icc 1 ⌈Cscale * (x / N)⌉₊,
          ‖w d m‖ ≤ v d * (m.divisors.card : ℝ) ^ k) →
