/-- The exponentially damped sine kernel `exp (-u * t) * sin u`, with Laplace parameter `t`.-/
noncomputable def laplaceSineIntegrand (u t : ℝ) : ℝ :=
  Real.exp (-u * t) * Real.sin u

/--
The Laplace representation kernel `exp (-X * t) * (cos X + t * sin X) / (1 + t ^ 2)` used to
bound the truncated sine-integral remainder.-/
noncomputable def dirichletSineRemainderIntegrand (X t : ℝ) : ℝ :=
  Real.exp (-X * t) * (Real.cos X + t * Real.sin X) / (1 + t ^ 2)

/--
@isnad1 id=le.0h2v.s5.1065d5c489d8 from=translated src=- shape=78f99eec vocab=1d5619c5
