    (hT : 0 ≤ T) (hM : 0 < M) (ψ : ℝ → ℂ)
    (hsupport : Function.support ψ ⊆ Set.Icc (-T) T) :
    let f : ℝ → ℂ := fun t => ψ ((t - t₀) / M)
