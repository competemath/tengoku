    | 4 => u.Prime ∧ v.Prime ∧ z ≤ (u : ℝ) ∧ u < v
    | _ => u.Prime ∧ v.Prime ∧ z ≤ (u : ℝ) ∧ u ≤ v
  let NamedB (s : ℕ) : Prop := if l.val ≤ 1 then s = 1 else s.Prime ∧ z ≤ (s : ℝ)
