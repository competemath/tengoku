      0 ≤ A + (j : ℤ) ∧ (A + (j : ℤ)).toNat ∈ sm := by
    simpa only [not_or, not_lt, not_not] using (Finset.mem_filter.mp hj).2
  have hpoint (j : ℕ) (hj : 0 ≤ A + (j : ℤ)) :
      g j = f (((A + (j : ℤ)).toNat : ℕ) : ℝ) *
        F ((A + (j : ℤ)).toNat : ZMod q) := by
    simpa only [g, Int.cast_add, Int.cast_natCast] using
      congrArg (fun z : ℤ => f (z : ℝ) * F (z : ZMod q)) (Int.toNat_of_nonneg hj).symm
  have hcore : (∑ j ∈ G, g j) = ∑ n ∈ sm, f (n : ℝ) * F (n : ZMod q) := by
    refine Finset.sum_bij_ne_zero (fun j _ _ => (A + (j : ℤ)).toNat)
      ?_ ?_ ?_ ?_
