        else (R.outerThreshold : ℝ) < tail + min ((3 / 2) * p) L ∨
          (R.innerThreshold : ℝ) < 3 * p - min ((3 / 2) * p) L
      else
        if R.order ≤ 2 then (R.innerThreshold : ℝ) < tail + p
        else (R.innerThreshold : ℝ) < tail + (3 * p - min ((3 / 2) * p) L) ∨
