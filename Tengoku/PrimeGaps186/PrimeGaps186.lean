    (Finset.Icc 2 x).Nonempty :=
  ⟨2, Finset.mem_Icc.mpr ⟨le_rfl, hx⟩⟩

/--
The sum of `χ(a⁻¹) χ(n)` over all Dirichlet characters modulo `q`. Orthogonality identifies this
kernel with a totient-weighted congruence indicator when `a` is a unit.-/
noncomputable def characterOrthogonalityKernel (q a n : ℕ) : ℂ :=
  ∑ χ : DirichletCharacter ℂ q,
    χ (a : ZMod q)⁻¹ * χ (n : ZMod q)

/--
@isnad1 id=eq.1h3v.s6.fc6ae5cd3cab from=translated src=- shape=132cf98a vocab=cbc6e856
