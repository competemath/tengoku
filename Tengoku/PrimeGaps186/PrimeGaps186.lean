  have hV : 0 ≤ V := Finset.sum_nonneg hv
  let F : ℝ := Kraw * M * (Real.log M) ^ P₀ * V
  have hF : 0 ≤ F := by dsimp only [F]; positivity
  have hpoint (q : ℕ) (hqS : q ∈ S) :
      (q.divisors.card : ℝ) ^ J * ‖fullDiscrepancy f q (a q)‖ ≤
        F * (q.divisors.card : ℝ) ^ (J + 1) / q := by
