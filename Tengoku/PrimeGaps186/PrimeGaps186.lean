    |((∑ i, c i * Fin.snoc (α := fun _ => ℝ) t z i) - b) -
        ((∑ i, c i * Fin.snoc (α := fun _ => ℝ) t z₀ i) - b)| ≤
      |c (Fin.last n)| * δ := by
