/-- The trial step function restricted by the outer physical-source admissibility indicator.-/
noncomputable def trialSourceStepFunction
    (X : Fin 40 → FiniteMeasure ℝ) : ℝ :=
  physicalSourceOuterSupport X * trialStepFunction X

