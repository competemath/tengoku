open Set
/--
The unique real representative of a point of the unit additive circle in the half-open interval
`[-1 / 2, 1 / 2)`.-/
noncomputable def PrimeGap186.centeredRepresentative (z : UnitAddCircle) : ℝ :=
  AddCircle.equivIco 1 (-(1 / 2 : ℝ)) z

/--
@isnad1 id=eq.0h1v.s5.e19c82c2b07f from=translated src=- shape=4e542c2f vocab=1b8de330
-/
theorem PrimeGap186.norm_eq_abs_centeredRepresentative (z : UnitAddCircle) :
    ‖z‖ = |PrimeGap186.centeredRepresentative z| := by
