theorem primeProduct_squarefree {P : Finset ℕ}
    (hP : ∀ p ∈ P, Nat.Prime p) : Squarefree (∏ p ∈ P, p) := by
  refine Finset.squarefree_prod_of_pairwise_isCoprime (fun p hp q hq hpq => ?_)
    (fun p hp => (hP p hp).squarefree)
  exact Nat.coprime_iff_isRelPrime.mp ((Nat.coprime_primes (hP p hp) (hP q hq)).2 hpq)

