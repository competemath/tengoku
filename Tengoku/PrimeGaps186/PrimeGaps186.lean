      (ℕ × ℕ × ℕ × ℕ))) ∧
    (∀ r u v₁ v₂ q₂ : ℕ,
      (r, u, v₁, v₂, q₂) ∈ 𝒯 ↔
        (r, u, v₁, q₂) ∈ 𝒜 ∧ (r, u, v₂, q₂) ∈ 𝒜) ∧
    sourceSigmaOne 𝒜 J ψM wN M q₀ a b₁ b₂ ℓ =
      ∑ t ∈ 𝒯,
        ‖sourceDispersionFrequencyBlock (J ×ˢ J) ψM wN M
          t.1 q₀ t.2.1 t.2.2.1 t.2.2.2.1 t.2.2.2.2 a b₁ b₂ ℓ‖ := by
  intro Ω encode 𝒯
