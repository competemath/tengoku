      (∀ t : ℕ,
        (physicalSourceRow ν t).upperBand = (physicalSourceRow ν (t + 1)).lowerBand) ∧
      (∀ t : Fin (physicalSourceLadderLength ν),
        (physicalSourceRow ν t.val).lowerBand < M ↔ t.val < K) ∧
      (∀ z : ℝ,
        (((1 / 2) / physicalSourceRho : ℚ) : ℝ) < z → z ≤ (M : ℝ) →
          ∃ t : Fin (physicalSourceLadderLength ν),
            t.val < K ∧
