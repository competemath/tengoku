  have hscale := congrArg (PowerSeries.rescale z) hbase
  simp only [map_mul, map_sub, map_one, PowerSeries.rescale_X] at hscale
  let hs := PowerSeries.HasSubst.X_pow (R := R) he
  let f : PowerSeries R →ₐ[R] PowerSeries R := PowerSeries.substAlgHom hs
  have h := congrArg f hscale
  simp only [map_mul, map_sub, map_one, f, PowerSeries.substAlgHom_X] at h
  rw [PowerSeries.coe_substAlgHom hs, PowerSeries.subst_C] at h
  exact h

