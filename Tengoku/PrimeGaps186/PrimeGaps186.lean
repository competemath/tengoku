  have hwdvd : w ∣ q / d := by
    apply (Nat.dvd_div_iff_mul_dvd hd).2
    have heq : d * w = Nat.lcm d v := by
      dsimp only [w]
      rw [Nat.lcm_eq_mul_div, Nat.gcd_comm d v, Nat.mul_div_assoc _ (Nat.gcd_dvd_left v d)]
    rw [heq]
    exact Nat.lcm_dvd hd hv
  have hle : (w : ℝ) ≤ v := by exact_mod_cast Nat.div_le_self v (Nat.gcd v d)
  have hmul : (v : ℝ) ≤ (w : ℝ) * d := by
    have heq : w * Nat.gcd v d = v := Nat.div_mul_cancel (Nat.gcd_dvd_left v d)
    have hg : (Nat.gcd v d : ℝ) ≤ d := by exact_mod_cast Nat.gcd_le_right v hd0
    calc
      (v : ℝ) = (w : ℝ) * Nat.gcd v d := by exact_mod_cast heq.symm
      _ ≤ (w : ℝ) * d := mul_le_mul_of_nonneg_left hg (Nat.cast_nonneg _)
