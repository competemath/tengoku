      ∑ j ∈ Finset.range K, g j :=
    Finset.sum_filter_add_sum_filter_not (Finset.range K)
      (fun j => A + (j : ℤ) < 0 ∨ (A + (j : ℤ)).toNat ∉ sm) g
  rw [hcore] at hsplit
  rw [← hsplit]
  simp only [sub_mul, Finset.sum_sub_distrib]
  ring

