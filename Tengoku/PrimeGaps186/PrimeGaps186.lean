    (U₁ U₂ U₃ V₁ V₂ V₃ : (q : ℕ+) → ZMod (q : ℕ) → ℂ)
    (hU₁ : ∀ q ∈ S, (∑ z : ZMod (q : ℕ), ‖U₁ q z‖) ≤ D * B₁ * A)
    (hU₂ : ∀ q ∈ S, (∑ z : ZMod (q : ℕ), ‖U₂ q z‖) ≤ D * B₂ * A)
    (hU₃ : ∀ q ∈ S, (∑ z : ZMod (q : ℕ), ‖U₃ q z‖) ≤ D * B₃ * A)
