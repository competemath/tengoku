theorem labelled_angular_partition_identity
    {R : Type*} [CommSemiring R] (n d k : ℕ)
    (σ : Fin k → ℕ) (t K : Fin n → R) :
    let P : ℕ → Polynomial R := fun e =>
      ∑ j : Fin n, Polynomial.C (K j * t j ^ e) * Polynomial.X ^ j.val
