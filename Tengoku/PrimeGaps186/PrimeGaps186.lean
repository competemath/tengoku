  have htripleProductL1 (q : ℕ+) (U₁ U₂ U₃ V₁ V₂ V₃ : ZMod (q : ℕ) → ℂ) :
      (∑ z₁ : ZMod (q : ℕ), ∑ z₂ : ZMod (q : ℕ), ∑ z₃ : ZMod (q : ℕ),
