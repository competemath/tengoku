        (if physicalSourceComponentKind g j = 0 then
          N.real (Set.Ioc (e.1 : ℝ) (e.2 : ℝ)) *
            Real.exp ((physicalSourceTheta g j : ℝ) *
              ((∑ i : Fin d, ((X i).mass : ℝ)) +
                ((P.order : ℝ) - 1) * (e.2 : ℝ) - (P.threshold : ℝ) -
                ∑ i : Fin d, (X i : Measure ℝ).real (Set.Ioc (0 : ℝ) (e.1 : ℝ))))
