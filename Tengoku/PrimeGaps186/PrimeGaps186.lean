  have hφPos : (0 : ℝ) < q.totient := Nat.cast_pos.mpr (Nat.totient_pos.mpr hq)
  have hφq : (q.totient : ℝ) ≤ q := Nat.cast_le.mpr (Nat.totient_le q)
