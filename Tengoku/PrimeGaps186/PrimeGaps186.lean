    calc
      V ≤ C * x ^ (δ + 5 * ε) * H := hVhi
      _ ≤ x * x * x ^ 12 := by gcongr
      _ = _ := by ring
  have hCV : C * V ≤ x ^ 15 := by
    calc
      C * V ≤ x * x ^ 14 := mul_le_mul hCx hVupper hV.le hx0.le
      _ = _ := by ring
