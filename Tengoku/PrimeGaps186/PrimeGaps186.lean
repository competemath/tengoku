    (hLB : PowerSeries.X * PowerSeries.derivative R L = L * B)
    (hAC : PowerSeries.X * PowerSeries.derivative R A = A * C)
    (hB0 : PowerSeries.constantCoeff B = 0) (hC0 : PowerSeries.constantCoeff C = 0)
    (hL0 : PowerSeries.coeff 0 L = 1)
    (hcoeff : ∀ j, j ≤ N → PowerSeries.coeff j L = PowerSeries.coeff j A)
