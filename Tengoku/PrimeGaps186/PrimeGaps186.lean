  calc
    _ ≤ ∑ d ∈ D, (2 * F * (q.divisors.card : ℝ) / q) * v d :=
      norm_sum_le_of_le D hrow
    _ = (2 * F * (q.divisors.card : ℝ) / q) * ∑ d ∈ D, v d :=
      (Finset.mul_sum _ _ _).symm
    _ = (2 * Kraw) * M * (Real.log M) ^ P * (q.divisors.card : ℝ) / q *
