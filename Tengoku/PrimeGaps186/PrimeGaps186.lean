  have hRlower : 1 ≤ x ^ 2 * R₀ := by
    calc
      1 ≤ N := hN
      _ ≤ C * x ^ (δ + 4 * ε) * R₀ := hRlo
      _ ≤ x * x * R₀ := by gcongr
      _ = _ := by ring
  have hRQupper : R₀ * Q ≤ x ^ 2 := by
    calc
      _ ≤ C * x ^ (1 / 2 + 2 * «ω» + ε) := hRQ
      _ ≤ x * x := mul_le_mul hCx hpq (Real.rpow_nonneg hx0.le _) hx0.le
      _ = _ := by ring
  have hQupper : Q ≤ x ^ 4 := by
    calc
      Q ≤ Q * (x ^ 2 * R₀) := le_mul_of_one_le_right hQ.le hRlower
      _ = x ^ 2 * (R₀ * Q) := by ring
      _ ≤ x ^ 2 * x ^ 2 := mul_le_mul_of_nonneg_left hRQupper (sq_nonneg x)
      _ = _ := by ring
  have hCQ : C * Q ≤ x ^ 5 := by
    calc
      C * Q ≤ x * x ^ 4 := mul_le_mul hCx hQupper hQ.le hx0.le
      _ = _ := by ring
  have hden : 1 ≤ x * q * M := by
    calc
      1 ≤ x * M := hMlo
      _ ≤ (x * M) * q := le_mul_of_one_le_right (mul_nonneg hx0.le hM.le) hq
      _ = _ := by ring
  have hHupper : H ≤ x ^ 12 := by
