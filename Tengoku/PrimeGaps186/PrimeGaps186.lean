theorem unitCube_carry_eq_eulerian (m a : ℕ) :
    (MeasureTheory.volume : MeasureTheory.Measure (Fin m → ℝ))
      (Set.Icc (fun _ : Fin m => (0 : ℝ)) (fun _ => (1 : ℝ)) ∩
        {x | (a : ℝ) ≤ ∑ i : Fin m, x i ∧
          (∑ i : Fin m, x i) < (a : ℝ) + 1}) =
      (eulerianNumber m a : ℝ≥0∞) / (m.factorial : ℝ≥0∞) := by
