        Real.log (y : ℝ) - (P v : ℝ) ≤ (R v : ℝ) := by
    simpa only [hratioReal, hP, hR] using
      log_odd_partial_sum_enclosure (v : ℝ) hvreal0 hvreal1 M
  have hratioTwo :
