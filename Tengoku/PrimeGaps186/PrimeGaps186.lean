theorem exists_phases_deltaZero_mass_sq_le
    (α β : ℕ →₀ ℂ) (sm : Finset ℕ) (w : ℕ → ℝ)
    (hsm : α.support ⊆ sm) (hw₀ : ∀ m ∈ sm, 0 ≤ w m)
    (hw₁ : ∀ m ∈ α.support, 1 ≤ w m)
    (G : ℕ) (S : Finset (ℕ × ℕ))
    (hS : ∀ p ∈ S, p.1 * p.2 ∣ G)
    (a b₁ b₂ : ℕ) (ha : Nat.Coprime a G)
    (hb₁ : Nat.Coprime b₁ G) (hb₂ : Nat.Coprime b₂ G) :
    ∃ c : ℕ × ℕ → ℂ,
      (∀ p ∈ S, ‖c p‖ = 1) ∧
      ((∑ p ∈ S, ‖deltaZero (finiteConvolution α β) p.1 p.2 a b₁ b₂‖ : ℝ) : ℂ) =
