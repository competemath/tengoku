theorem average_surjective_monoidHom {A B : Type*}
    [Group A] [Group B] [Fintype A] [Fintype B]
    (φ : A →* B) (hφ : Function.Surjective φ) (F : B → ℂ) :
    (∑ a, F (φ a)) / (Fintype.card A : ℂ) =
      (∑ b, F b) / (Fintype.card B : ℂ) := by
  classical
  let k := (Finset.univ.filter (fun a => φ a = 1)).card
  have hfiber (b : B) : (Finset.univ.filter (fun a => φ a = b)).card = k :=
    MonoidHom.card_fiber_eq_of_mem_range φ (hφ b) (hφ 1)
  have hsum (H : B → ℂ) : (∑ a, H (φ a)) = (k : ℂ) * ∑ b, H b := by
    rw [← Finset.sum_fiberwise' Finset.univ φ H]
    simp_rw [Finset.sum_const, hfiber, nsmul_eq_mul]
    rw [Finset.mul_sum]
  have hcard : (Fintype.card A : ℂ) = (k : ℂ) * (Fintype.card B : ℂ) := by
    simpa using hsum (fun _ => 1)
  apply (div_eq_div_iff
    (Nat.cast_ne_zero.mpr (Fintype.card_ne_zero (α := A)))
    (Nat.cast_ne_zero.mpr (Fintype.card_ne_zero (α := B)))).mpr
  rw [hsum, hcard]
  ring

