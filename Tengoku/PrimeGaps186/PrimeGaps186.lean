        (show (⟨i, Nat.lt_succ_of_le hi⟩ : Fin (L + 1)) ≤
          ⟨j, Nat.lt_succ_of_le hj⟩ from hij)
    change (1 / 2 + 2 * physicalSourceOmegaPrefix ν i) / physicalSourceRho ≤
      (1 / 2 + 2 * physicalSourceOmegaPrefix ν j) / physicalSourceRho
    gcongr
