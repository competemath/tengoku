      (show Nat.ModEq q₁ (m * n₁) b₁ from hq₁).of_dvd (Nat.gcd_dvd_left q₁ q₂)
    have hq₂' : Nat.ModEq (Nat.gcd q₁ q₂) (m * n₂) b₂ :=
      (show Nat.ModEq q₂ (m * n₂) b₂ from hq₂).of_dvd (Nat.gcd_dvd_right q₁ q₂)
    have hq : Nat.ModEq (Nat.gcd q₁ q₂) (b₁ * n₂) (b₂ * n₁) := by
      calc
