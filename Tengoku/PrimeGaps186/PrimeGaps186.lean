      · intro v hv
        obtain ⟨hvS, hvP⟩ := Finset.mem_filter.mp hv
        obtain ⟨ha, hbc⟩ := Finset.mem_sigma.mp hvS
        obtain ⟨hb, hc⟩ := Finset.mem_sigma.mp hbc
        have hprod : (v.1.1 * v.2.1.1 * v.2.2.1) * v.2.2.2 = n := by
          simp only [Nat.mul_assoc, (Nat.mem_divisorsAntidiagonal.mp hc).1,
            (Nat.mem_divisorsAntidiagonal.mp hb).1,
            (Nat.mem_divisorsAntidiagonal.mp ha).1]
