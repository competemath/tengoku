theorem typeIII_weighted_physical_error (S : Finset ℕ+) (Q : ℝ) (hQ : 0 < Q)
    (hq : ∀ q ∈ S, (q : ℝ) ≤ 2 * Q) (I : Finset ℤ) (M Wα : ℝ)
    (hM : 0 ≤ M) (hWα : 0 ≤ Wα) (hcard : (I.card : ℝ) ≤ 2 * M)
    (α : ℤ → ℂ) (hα : ∀ m ∈ I, ‖α m‖ ≤ Wα)
    (D e A t B₁ B₂ B₃ : ℝ) (hD : 0 ≤ D) (he : 0 ≤ e)
    (hA : 1 ≤ A) (ht : 0 ≤ t)
    (hB₁ : 0 ≤ B₁) (hB₂ : 0 ≤ B₂) (hB₃ : 0 ≤ B₃)
