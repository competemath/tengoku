theorem min_log_error_le_distance_error
    {x y U : ℝ} (hx : 0 < x) (hy : 0 < y)
    (hyUpper : y < 2 * x) (hne : x ≠ y) (hU : 0 < U) :
    min 1 (1 / (U * |Real.log (x / y)|)) ≤
