    Complex.ofReal_neg]
  ring

/--
@isnad1 id=eq.0h3v.s5.c458682fd40d from=translated src=- shape=51695f5c vocab=25664ba6
-/
theorem montgomeryVaughanS4_eq_B_add_S5 (x : ι → ℝ) (u : ι → ℂ) :
    montgomeryVaughanS4 x u =
