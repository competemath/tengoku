    simpa [E, R] using exp_sub_sum_range_le_geometric_tail
      (v : ℝ) M (by exact_mod_cast hv) hvhalfReal
  have hsmall (M : ℕ) :
      (E M : ℝ) ≤ Real.exp (v : ℝ) ∧
        Real.exp (v : ℝ) ≤ (E M : ℝ) + (R M : ℝ) := by
    constructor <;> linarith [(hbase M).1, (hbase M).2]
