      refine (hFrep.mul_left v).trans (Int.modEq_of_dvd ⟨-t * Int.gcdA u v, ?_⟩)
      linear_combination t * hbez
    refine ⟨F, ⟨hF0, hFu, hFmod, ?_⟩, ?_⟩
    · intro G
      have hGdiv : u ∣ v * F + t := by
        simpa only [sub_neg_eq_add] using hFmod.symm.dvd
      have hG : u * G - v * F = t :=
        Int.sub_eq_iff_eq_add'.2 (Int.mul_ediv_cancel' hGdiv)
      refine ⟨hGdiv, hG, ?_⟩
      intro d n nt
