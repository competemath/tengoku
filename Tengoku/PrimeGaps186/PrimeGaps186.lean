      _ = ∑ r, star (matrixSum Finset.univ C w r) *
          matrixSum Finset.univ C w r := by
        simp only [Complex.ofReal_sum, Complex.star_def,
          ← Complex.normSq_eq_conj_mul_self, Complex.normSq_eq_norm_sq]
