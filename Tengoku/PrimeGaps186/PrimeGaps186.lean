    (z.property.1.mul_right n₁).trans hcᵣ
  have hz₁ : Nat.ModEq q₁ ((z : ℕ) * n₁) b₁ :=
    (((z.property.2.of_dvd (Nat.dvd_lcm_left q₁ q₂)).trans t.property.1).mul_right n₁).trans hc₁
  have hz₂ : Nat.ModEq q₂ ((z : ℕ) * n₂) b₂ :=
    (((z.property.2.of_dvd (Nat.dvd_lcm_right q₁ q₂)).trans t.property.2).mul_right n₂).trans hc₂
  have hzrn₂ : Nat.ModEq r ((z : ℕ) * n₂) a :=
    (hnr.symm.mul_left (z : ℕ)).trans hzr
