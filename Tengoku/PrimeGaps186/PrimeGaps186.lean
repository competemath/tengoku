/-- The subtype of Dirichlet characters modulo `d` equipped with a proof of primitivity.-/
abbrev primitiveCharacters (d : ℕ) :=
  {ψ : DirichletCharacter ℂ d // ψ.IsPrimitive}

noncomputable instance primitiveCharactersFintype (d : ℕ) :
    Fintype (primitiveCharacters d) := Fintype.ofFinite _

/--
The unnormalized character transform of a function on the units modulo `q`: the sum of `chi⁻¹ a
* b a`. No factor of `1 / q.totient` is included.-/
