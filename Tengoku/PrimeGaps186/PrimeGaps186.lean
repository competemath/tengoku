            (reciprocal_differencing_gcd_sums r₁ (4 * R) (hmem r₁ hr₁).1).1
          _ ≤ (4 * R : ℝ) * τR := by
            have hτ : (r₁.divisors.card : ℝ) ≤ τR := by
              exact_mod_cast (Finset.le_sup (f := fun r : ℕ => r.divisors.card) hr₁ :
                r₁.divisors.card ≤ τR)
