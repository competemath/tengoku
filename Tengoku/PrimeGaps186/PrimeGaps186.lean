    intro ht
    simpa using (hP _ ht).2.2.1
  have hnotTop (t : ℝ) : ((t : ℂ) + w.im * I) ∉ P := by
    intro ht
    simpa using (hP _ ht).2.2.2
  have hnotRight (t : ℝ) : ((w.re : ℂ) + t * I) ∉ P := by
    intro ht
    simpa using (hP _ ht).2.1
  have hnotLeft (t : ℝ) : ((z.re : ℂ) + t * I) ∉ P := by
    intro ht
    simpa using (hP _ ht).1
