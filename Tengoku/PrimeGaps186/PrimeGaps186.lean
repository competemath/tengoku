        Filter.atTop (nhds (Real.exp (v : ℝ))) := by
      simpa only [sub_sub_cancel, sub_zero] using herror.const_sub (Real.exp (v : ℝ))
    have hLoLim : Filter.Tendsto (fun M : ℕ => (S (E M) : ℝ))
