          (lamTilde * n + (s : ℤ) * k * (d : ℤ)) / lam = nt) ∧
    (∀ k : ℤ,
      lam ∣ lamTilde * n + (s : ℤ) * k * (d : ℤ) →
      (lamTilde * n + (s : ℤ) * k * (d : ℤ)) / lam = nt →
      lam * nt - lamTilde * n = (s : ℤ) * k * (d : ℤ) ∧
      Jn = (s : ℤ) * k + (lam - lamTilde) * B ∧
      reciprocalUnitPhase m ((A : ZMod m) * (Jn : ZMod m))
          (((n + B * (d : ℤ) : ℤ) : ZMod m) *
            ((nt + B * (d : ℤ) : ℤ) : ZMod m)) =
        reciprocalUnitPhase m
          ((A : ZMod m) * (((s : ℤ) * k + (lam - lamTilde) * B : ℤ) : ZMod m))
          (((n + B * (d : ℤ) : ℤ) : ZMod m) *
            (((lamTilde * n + (s : ℤ) * k * (d : ℤ)) / lam + B * (d : ℤ) : ℤ) : ZMod m))) := by
  intro Jn
  have hguard (k : ℤ) :
      (lam ∣ lamTilde * n + (s : ℤ) * k * (d : ℤ) ∧
        (lamTilde * n + (s : ℤ) * k * (d : ℤ)) / lam = nt) ↔
      lam * nt - lamTilde * n = (s : ℤ) * k * (d : ℤ) := by
