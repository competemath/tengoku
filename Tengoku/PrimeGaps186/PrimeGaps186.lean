    ‖∑ n ∈ s.filter (p (base i₁)), (χ n : ℂ) * f i₁ n * star (f i₂ n)‖
  have hd (i : ι) (hi : i ∈ A) : ‖d i‖ ≤ K := by
    simpa only [d, norm_mul, (hz i).1, one_mul] using ha i hi
  have hlinear : (L : ℂ) =
      ∑ j ∈ B, ∑ n ∈ s.filter (p j), b j n * F j n := by
