/--
The zero-frequency contribution from distinct support indices of `β`, summed over all pairs in
`S` with the same second component. Both the modulus coefficients and sequence coefficients
enter as conjugate products.-/
noncomputable def offDiagonalZeroMode (sm : Finset ℕ) (w : ℕ → ℝ)
    (S : Finset (ℕ × ℕ)) (β : ℕ →₀ ℂ) (c : ℕ × ℕ → ℂ)
    (a b₁ b₂ : ℕ) : ℂ :=
  ∑ r ∈ S.image Prod.snd,
    ∑ p₁ ∈ S.filter (fun p => p.2 = r),
      ∑ p₂ ∈ S.filter (fun p => p.2 = r),
        c p₁ * star (c p₂) *
          ∑ n₁ ∈ β.support, ∑ n₂ ∈ β.support.filter (fun n₂ => n₁ ≠ n₂),
            β n₁ * star (β n₂) *
              mixedFiberFourierCoefficient sm w p₁.1 p₂.1 r a b₁ b₂ n₁ n₂ 0

