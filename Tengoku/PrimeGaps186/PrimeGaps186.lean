theorem finite_subproduct_divisor_mass_bound
    (k U : ℕ) (hU : 1 ≤ U) (s : Finset (Fin k)) (S : Finset ℕ)
    (hS : ∀ m ∈ S, 0 < m) :
    let T := (Fintype.piFinset (fun _ : Fin k => Finset.Icc 1 U)).filter
      (fun v => (∏ i, v i) ≤ U ∧ (∏ i ∈ s, v i) ∈ S)
    (T.card : ℝ) ≤ (U : ℝ) * (1 + Real.log (U : ℝ)) ^ (2 ^ k - 1) *
      ∑ m ∈ S, (m.divisors.card : ℝ) ^ k / (m : ℝ) := by
