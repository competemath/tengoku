        _ ≤ M ^ 2 * (Nat.gcd r₁ r₂ : ℝ) + M * (Nat.gcd r₁ r₂ : ℝ) :=
          add_le_add (mul_le_mul_of_nonneg_left hsgle (sq_nonneg M)) le_rfl
        _ = _ := by ring
    have hnum₂ : M ^ 2 / Real.sqrt (Nat.gcd r₁ r₂ : ℝ) + M ≤ M ^ 2 + M :=
