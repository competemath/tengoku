theorem sparse_factor_fullDiscrepancy_bound
    (θ : ℝ) (hθ0 : 0 < θ) (hθ1 : θ < 1)
    (k : ℕ) (Cscale : ℝ) (hCscale : 1 ≤ Cscale) :
    ∃ P : ℕ, ∃ K : ℝ, 0 < K ∧
      ∀ M : ℝ, Real.exp 1 ≤ M →
      ∀ q a : ℕ, 0 < q → (q : ℝ) ≤ M ^ θ → Nat.Coprime a q →
      ∀ (D : Finset ℕ) (w : ℕ → ℕ → ℂ) (v : ℕ → ℝ),
        (∀ d ∈ D, 0 ≤ v d) →
        (∀ d ∈ D, ∀ m ∈ Finset.Icc 1 ⌈Cscale * M⌉₊,
          ‖w d m‖ ≤ v d * (m.divisors.card : ℝ) ^ k) →
        let f : ℕ →₀ ℂ :=
          ∑ d ∈ D, ∑ m ∈ Finset.Icc 1 ⌈Cscale * M⌉₊, Finsupp.single (d * m) (w d m)
