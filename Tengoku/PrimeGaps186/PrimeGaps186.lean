    have hnmem : p ^ k ∈
        (Finset.Icc 1 x).filter
          (fun n => IsPrimePow n ∧ ¬Nat.Coprime n q) :=
      Finset.mem_filter.mpr
        ⟨Finset.mem_Icc.mpr ⟨hone, hpow⟩, hpp, hncop⟩
    refine ⟨p ^ k, hnmem, ?_⟩
