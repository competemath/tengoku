    (fun p => ‖α p.2‖) (fun p => ‖phaseResponse S β c p.1 a b₁ b₂ p.2‖)
  simp only [Finset.sum_product, Finset.sum_const, nsmul_eq_mul] at hcs
  calc
    _ ≤ (∑ r ∈ R, ∑ m ∈ α.support,
        ‖α m‖ * ‖phaseResponse S β c r a b₁ b₂ m‖) ^ 2 := by
      apply pow_le_pow_left₀ hmass
