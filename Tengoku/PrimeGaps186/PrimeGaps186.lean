        (∑ z : ZMod (q : ℕ), ‖U₁ z - V₁ z‖) *
            (∑ z : ZMod (q : ℕ), ‖U₂ z‖) * (∑ z : ZMod (q : ℕ), ‖U₃ z‖) +
          (∑ z : ZMod (q : ℕ), ‖V₁ z‖) *
            (∑ z : ZMod (q : ℕ), ‖U₂ z - V₂ z‖) *
            (∑ z : ZMod (q : ℕ), ‖U₃ z‖) +
