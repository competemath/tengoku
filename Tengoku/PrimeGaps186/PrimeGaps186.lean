    {q1 q : ℕ} [NeZero q1] [NeZero q]
    (chi1 : DirichletCharacter ℂ q1)
    (chi : DirichletCharacter ℂ q)
    (beta x : ℝ) (s : ℂ) : ℂ :=
  dslope (goldfeldContourNumerator chi1 chi beta x)
    (goldfeldShiftedZetaPole beta) s

/--
The Goldfeld vertical-line integral on `re = alpha`, truncated to imaginary parameters from `-T`
to `T` and normalized by `1 / (2 * pi)`.-/
