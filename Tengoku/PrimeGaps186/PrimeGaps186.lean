    _ ≤ (A * ((2 * M : ℕ) : ℝ)) * Real.log (2 * (M : ℝ)) := by
      apply mul_le_mul_of_nonneg_right _ hlogNonneg
      exact hpsi _ (by positivity)
    _ = 2 * A * (M : ℝ) * Real.log (2 * (M : ℝ)) := by
      push_cast
      ring
