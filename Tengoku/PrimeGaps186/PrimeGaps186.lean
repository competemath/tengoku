    (B - physicalSourceInnerRadius ν +
        (if physicalSourceOrder t.val ≤ 2 then ξ else
          (ξ + physicalSourceOuterRadius + physicalSourceInnerRadius ν - B) / 2) =
      physicalSourceOuterRadius +
        (if physicalSourceOrder t.val ≤ 2 then physicalSourceAdvance else
          physicalSourceAdvance / 2)) ∧
    (B - physicalSourceOuterRadius +
        (if physicalSourceOrder t.val ≤ 2 then ξ else
          (ξ + physicalSourceOuterRadius + physicalSourceInnerRadius ν - B) / 2) =
      physicalSourceInnerRadius ν +
        (if physicalSourceOrder t.val ≤ 2 then physicalSourceAdvance else
          physicalSourceAdvance / 2))
  by_cases horder : physicalSourceOrder t.val ≤ 2 <;>
    simp only [horder, ↓reduceIte] <;> constructor <;> linarith only [hkey]

