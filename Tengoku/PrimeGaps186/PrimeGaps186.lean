theorem mixedFiber_badGuard_zero
    (sm : Finset ℕ) (w : ℕ → ℝ)
    (q₁ q₂ r a b₁ b₂ n₁ n₂ : ℕ)
    (hbad : ¬ (Nat.Coprime n₁ (q₁ * r) ∧
      Nat.Coprime n₂ (q₂ * r) ∧ Nat.ModEq r n₁ n₂ ∧
      Nat.ModEq (Nat.gcd q₁ q₂) (b₁ * n₂) (b₂ * n₁))) :
