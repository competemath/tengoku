    (by intro n ℓ; dsimp [C]; split_ifs <;> norm_num)
    (by intro n ℓ; exact le_rfl)
  calc
    (∑ n₁ ∈ β.support, ∑ n₂ ∈ β.support,
        if Nat.ModEq r n₁ n₂ ∧ Nat.ModEq g (b₁ * n₂) (b₂ * n₁)
        then ‖β n₁‖ * ‖β n₂‖ else 0) =
        ∑ p ∈ S, ‖γ p.1‖ * ‖γ p.2‖ := by
      simp only [S, Finset.sum_filter, Finset.sum_product, γ,
        Finsupp.support_embDomain, Finset.sum_map, Finsupp.embDomain_apply_self]
      simp only [Nat.castEmbedding_apply, ← Nat.cast_mul, Int.natCast_modEq_iff]
    _ ≤ ∑ p ∈ T,
        ‖γ p.2‖ * ‖γ (p.2 + p.1 * (r : ℤ))‖ * C p.2 p.1 := hsum
    _ = ∑ ℓ ∈ I,
        ∑ n ∈ γ.support.filter (fun n => n + ℓ * (r : ℤ) ∈ γ.support),
          ‖γ n‖ * ‖γ (n + ℓ * (r : ℤ))‖ * C n ℓ := by
      simp only [T, Finset.sum_filter, Finset.sum_product]
    _ ≤ 2 * (1 + ((N / R : ℕ) : ℝ) / (g : ℝ)) *
        ∑ n ∈ γ.support, ‖γ n‖ ^ 2 := hmoment
    _ = 2 * (1 + ((N / R : ℕ) : ℝ) / (g : ℝ)) *
        ∑ n ∈ β.support, ‖β n‖ ^ 2 := by
      simp only [γ, Finsupp.support_embDomain, Finset.sum_map,
        Finsupp.embDomain_apply_self]

