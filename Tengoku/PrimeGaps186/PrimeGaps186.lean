/--
The difference of two smooth transitions one unit apart in the logarithmic coordinate `log u /
log Θ`. It is defined as zero for `u ≤ 0` and supplies the multiplicative localization profile
for the Heath–Brown factors.-/
noncomputable def minorantHBProfile (Θ u : ℝ) : ℝ :=
  if 0 < u then
    Real.smoothTransition (Real.log u / Real.log Θ + 1) -
      Real.smoothTransition (Real.log u / Real.log Θ)
  else 0

/--
The arithmetic function assigned to one of the `2 * j` convolution slots: the first `j` are
Möbius functions cut off at `U`, the last is logarithm, and the remaining slots are zeta
functions.-/
noncomputable def minorantHBSlot (j : ℕ) (U : ℝ) (i : Fin (2 * j)) : ArithmeticFunction ℝ :=
  if i.val < j then
    arithmeticFunctionLowCutoff U
      (ArithmeticFunction.moebius : ArithmeticFunction ℝ)
  else if i.val + 1 = 2 * j then ArithmeticFunction.log
  else (ArithmeticFunction.zeta : ArithmeticFunction ℝ)

