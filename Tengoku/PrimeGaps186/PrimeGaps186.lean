theorem clearedAuxiliaryPolynomial_ne_zero_and_degree
    {K : Type u} [Field K] (p h : ℕ) (hp : 1 < p)
    (A D : K[X]) (hD : D ≠ 0)
    (hAD : A.natDegree = D.natDegree + 1)
    (e : Fin p → Fin (p ^ h + 1) → K[X])
    (he : ∀ i l, (e i l).natDegree < p ^ (2 * h + 4))
    (hne : ∃ i l, e i l ≠ 0) :
    let d := D.natDegree
    let L := p ^ (2 * h + 5)
    let B := D ^ (p ^ (h + 2))
    let N := clearedTraceNumerator p (h + 3) A D
    let BH := expand K (p ^ (h + 3)) B
    let NH := expand K (p ^ (h + 3)) N
    (∀ (i : Fin p) (l : Fin (p ^ h + 1)), e i l ≠ 0 →
      (e i l * NH ^ i.val * BH ^ (p - 1 - i.val) *
        X ^ (p ^ (2 * (h + 3)) * l.val)).natDegree =
        d * (p - 1) * L + (e i l).natDegree + L * (i.val + p * l.val)) ∧
    clearedAuxiliaryPolynomial p h A D e ≠ 0 ∧
    (clearedAuxiliaryPolynomial p h A D e).natDegree <
      p ^ (2 * h + 4) + (d + 1) * (p - 1) * L +
        p ^ (2 * (h + 3)) * p ^ h := by
