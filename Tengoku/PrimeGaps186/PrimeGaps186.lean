            min (3 * (physicalSourceGroup gr).cap / 2) L ≤ A := by
    rcases hrole with rfl | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · simpa [gr, ge, go, R, A, C, L] using houterCapq
    · simpa [gr, ge, go, R, A, C, L] using
