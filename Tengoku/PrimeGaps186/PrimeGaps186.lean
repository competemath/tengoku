  have hextra (z : K) (hz : z ∈ M \ S) (v : K) (hv : v ∈ S) : φ z - φ v ≠ 0 :=
    sub_ne_zero.mpr (fun he => (Finset.mem_sdiff.mp hz).2 (φ.injective he ▸ hv))
