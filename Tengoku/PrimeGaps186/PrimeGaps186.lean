      rw [hshift p hp]
      simp only [hm, ite_true, mul_one, le_refl]
    · intro p _ _
      dsimp [C]
      split_ifs <;> positivity
  have hprimZ : Int.gcd ((b₁ : ℤ) * (b₂ : ℤ) * (r : ℤ)) (g : ℤ) = 1 := by
    simpa only [← Nat.cast_mul, Int.gcd_natCast_natCast] using hprim.gcd_eq_one
  have hmoment := primitive_shifted_coefficient_moment_le γ g (N / R) hg
