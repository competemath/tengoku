    Finset.prod_mul_prod_compl s v
  have htotal (v : Fin k → ℕ) (hv : v ∈ T) : (∏ i, v i) ≤ U :=
    (Finset.mem_filter.mp hv).2.1
  have hmapP : ∀ v ∈ T, P v ∈ S := fun v hv => (Finset.mem_filter.mp hv).2.2
