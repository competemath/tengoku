    volume ((fun u : Fin 4 → ℝ => v 0 + M *ᵥ u) '' D) =
        volume ((fun y : Fin 4 → ℝ => v 0 + y) '' ((Matrix.toLin' M) '' D)) := by
      rw [← Set.image_comp]
