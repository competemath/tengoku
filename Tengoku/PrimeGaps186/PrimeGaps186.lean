theorem physicalSource_retained_thresholds :
    ∀ ν : Fin 2,
      (∀ t : Fin (physicalSourceLadderLength ν - 1),
        physicalSourceRho * (physicalSourceRow ν t.val).activation -
          (physicalSourceRho *
            (physicalSourceOuterRadius + physicalSourceInnerRadius ν) - 1 / 2) +
          2 * physicalSourceOmegaPrefix ν t.val = (1 : ℚ) / 10000000) ∧
      (∀ t : Fin (if ν = 0 then 28 else 39),
        (physicalSourceRow ν t.val).outerThreshold =
            physicalSourceOuterRadius +
