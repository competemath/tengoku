  refine ⟨hQlopos, hQhalf, hQlole, ?_, hHbpos, hYone, hcap, ?_⟩
  · intro q hlow hhigh
    exact ⟨hlow, hhigh.trans hband⟩
  · calc
      Hb ^ 2 = (z ^ 2 * Qcenter ^ 2 * b) *
          (Qcenter ^ 4 / (N ^ 2 * B ^ 2 * b)) := by
        change (z * (Qcenter ^ 3 / N) / B) ^ 2 = _
        field_simp [hN.ne', hBpos.ne', hbpos.ne']
      _ ≤ (Y * (M * N) ^ 2) * (Qcenter ^ 4 / (N ^ 2 * B ^ 2 * b)) :=
        mul_le_mul_of_nonneg_right hcore (by positivity)
      _ = Qcenter ^ 4 * Y * M ^ 2 / (B ^ 2 * b) := by
        field_simp [hN.ne', hBpos.ne', hbpos.ne']
