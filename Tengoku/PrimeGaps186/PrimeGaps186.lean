      rw [dirichletNontrivialZeroReciprocalMultiplicitySum]
    _ ≤ C * (8 * (A : ℝ) *
        Real.log ((q : ℝ) * (T + 2)) ^ 2) :=
      mul_le_mul_of_nonneg_left hreciprocalBound hC0
    _ = 96 * (A : ℝ) *
        x ^ (1 - 1 / ((M : ℝ) ^ 2 *
          Real.log ((q : ℝ) * (T + 2)))) *
            Real.log ((q : ℝ) * (T + 2)) ^ 2 := by
      dsimp [C, alpha]
      ring

