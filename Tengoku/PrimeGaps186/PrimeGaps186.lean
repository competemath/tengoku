  have he :
      Tendsto
        (fun x : ℝ => (∑ p ∈ S x, Real.log (1 + z x p)) - ∑ p ∈ S x, z x p)
        atTop (nhds 0) := by
    rw [tendsto_zero_iff_abs_tendsto_zero]
    apply squeeze_zero' (Eventually.of_forall (fun _ => abs_nonneg _)) hbound
    simpa only [T, mul_zero] using (presieved_prime_square_tail_tendsto H).const_mul C
  have hweighted :
