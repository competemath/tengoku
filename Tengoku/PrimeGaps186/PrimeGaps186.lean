  have huupper : u ≤ x ^ 6 := by
    calc
      u ≤ C * U := huhi
      _ ≤ x * x ^ 5 := mul_le_mul hCx hUupper hU.le hx0.le
      _ = _ := by ring
  have hvupper : v ≤ x ^ 15 := hvhi.trans hCV
  have hv'upper : v' ≤ x ^ 15 := hv'hi.trans hCV
  have hq'upper : q' ≤ x ^ 5 := by
    calc
      q' ≤ q' * q := le_mul_of_one_le_right hq' hq
      _ ≤ C * Q := hq'hi
