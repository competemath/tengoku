/--
The truncated Perron kernel for `y ^ s / s` on the line `re = alpha`, with imaginary parameter
from `-U` to `U` and normalization `1 / (2 * pi)`.-/
noncomputable def dirichletPerronKernel
    (y alpha U : ℝ) : ℂ :=
  (((2 * Real.pi : ℝ) : ℂ)⁻¹) *
    ∫ t in -U..U,
      (y : ℂ) ^ ((alpha : ℂ) + t * I) /
        ((alpha : ℂ) + t * I)

/--
The sharp Perron weight on natural indices: one for `0 < n < x`, one half for `n = x > 0`, and
zero otherwise. The index `n = 0` always has weight zero.-/
noncomputable def dirichletPerronNaturalWeight (x n : ℕ) : ℝ :=
  if n = 0 then 0
  else if n < x then 1
  else if n = x then 1 / 2
  else 0

