theorem sourceAssembly_ordered_gcd_sum
    (S : Finset (ℕ × ℕ)) (u : ℕ → ℕ → ℕ)
    (F : ℕ → (ℕ × ℕ) → (ℕ × ℕ) → ℂ)
    (hu : ∀ p₁ ∈ S, ∀ p₂ ∈ S, p₁.2 = p₂.2 →
      let g := Nat.gcd p₁.1 p₂.1
      u g (p₁.1 / g) ∣ p₁.1 / g) :
    let Ω := (S ×ˢ S).filter (fun p => p.1.2 = p.2.2)
    let G := Ω.image (fun p => Nat.gcd p.1.1 p.2.1)
    let 𝒜 : ℕ → Finset (ℕ × ℕ × ℕ × ℕ) := fun g =>
      (Ω.filter (fun p => Nat.gcd p.1.1 p.2.1 = g)).image (fun p =>
        (p.1.2, u g (p.1.1 / g), (p.1.1 / g) / u g (p.1.1 / g), p.2.1 / g))
    (∑ r ∈ S.image Prod.snd,
      ∑ p₁ ∈ S.filter (fun p => p.2 = r),
        ∑ p₂ ∈ S.filter (fun p => p.2 = r), F r p₁ p₂) =
      ∑ g ∈ G, ∑ t ∈ 𝒜 g,
