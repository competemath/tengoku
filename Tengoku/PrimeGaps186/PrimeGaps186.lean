        1 * ((p : ℝ) ^ s.re)⁻¹ :=
      mul_le_mul_of_nonneg_right (psi.norm_le_one p)
        (inv_nonneg.mpr (Real.rpow_nonneg (Nat.cast_nonneg p) _))
