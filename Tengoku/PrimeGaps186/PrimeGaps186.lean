      (ℕ × ℕ × ℕ × ℕ) × (ℕ × ℕ × ℕ × ℕ) := fun t =>
    ((t.1, t.2.1, t.2.2.1, t.2.2.2.2),
      (t.1, t.2.1, t.2.2.2.1, t.2.2.2.2))
