    have hfirst : ((M ^ 2 + M * Real.sqrt (Nat.gcd r₁ r₂ : ℝ)) *
        Real.sqrt (Nat.gcd r₁ r₂ : ℝ)) * H * Real.sqrt b /
          ((r₁ : ℝ) ^ 2 * Real.sqrt Q * Real.sqrt (r₂ : ℝ)) ≤
        U * (Nat.gcd r₁ r₂ : ℝ) := by
      calc
        _ ≤ ((M ^ 2 + M) * (Nat.gcd r₁ r₂ : ℝ)) * H * Real.sqrt b /
            ((r₁ : ℝ) ^ 2 * Real.sqrt Q * Real.sqrt (r₂ : ℝ)) :=
          div_le_div_of_nonneg_right
            (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hnum₁ hH) hsb.le)
            (by positivity)
        _ ≤ ((M ^ 2 + M) * (Nat.gcd r₁ r₂ : ℝ)) * H * Real.sqrt b /
            ((R : ℝ) ^ 2 * Real.sqrt Q * Real.sqrt (R : ℝ)) :=
          div_le_div_of_nonneg_left (by positivity) (by positivity) hden₁
        _ = _ := by dsimp only [U]; ring
    have hsecond : (M ^ 2 / Real.sqrt (Nat.gcd r₁ r₂ : ℝ) + M) *
        Real.sqrt Q * Real.sqrt (r₂ : ℝ) / ((r₁ : ℝ) ^ 2 * Real.sqrt b) ≤ V := by
      calc
        _ ≤ (M ^ 2 + M) * Real.sqrt Q * (2 * Real.sqrt (R : ℝ)) /
            ((r₁ : ℝ) ^ 2 * Real.sqrt b) :=
          div_le_div_of_nonneg_right
            (mul_le_mul (mul_le_mul_of_nonneg_right hnum₂ hsQ.le)
