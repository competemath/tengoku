    have hm (m : ℤ) :
        ‖(∑ z₁ : ZMod (q : ℕ), ∑ z₂ : ZMod (q : ℕ), ∑ z₃ : ZMod (q : ℕ),
            if (m : ZMod (q : ℕ)) * z₁ * z₂ * z₃ = a then
              U₁ z₁ * U₂ z₂ * U₃ z₃ else 0) -
          (∑ z₁ : ZMod (q : ℕ), ∑ z₂ : ZMod (q : ℕ), ∑ z₃ : ZMod (q : ℕ),
            if (m : ZMod (q : ℕ)) * z₁ * z₂ * z₃ = a then
