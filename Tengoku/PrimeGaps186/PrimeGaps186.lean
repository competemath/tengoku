theorem mixedProgressionMass_diag (f : ℕ →₀ ℂ)
    {q r : ℕ} (hqr : Nat.Coprime q r) (a : ℕ) :
    mixedProgressionMass f q r a a = progressionMass f (q * r) a := by
  unfold mixedProgressionMass progressionMass
  apply Finset.sum_congr rfl
  intro n _
  have hiff : (n % r = a % r ∧ n % q = a % q) ↔
      n % (q * r) = a % (q * r) := by
    change (Nat.ModEq r n a ∧ Nat.ModEq q n a) ↔ Nat.ModEq (q * r) n a
    rw [and_comm]
    exact Nat.modEq_and_modEq_iff_modEq_mul hqr
  simp only [hiff]

