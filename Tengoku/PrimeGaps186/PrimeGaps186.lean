    ∃ (b : ℤ) (y : ℚ),
      x = (2 : ℚ) ^ b * y ∧ 1 ≤ y ∧ y < 2 ∧
        ∀ M : ℕ,
          let v : ℚ := (y - 1) / (y + 1)
          let P : ℚ → ℚ := fun z =>
            2 * (∑ r ∈ Finset.range M,
              z ^ (2 * r + 1) / (2 * (r : ℚ) + 1))
          let R : ℚ → ℚ := fun z =>
            2 * z ^ (2 * M + 1) /
              ((2 * (M : ℚ) + 1) * (1 - z ^ 2))
          let c : ℚ := (b : ℚ) * P (1 / 3) + P v
          let lo : ℚ := c + min (b : ℚ) 0 * R (1 / 3)
          let hi : ℚ := c + max (b : ℚ) 0 * R (1 / 3) + R v
