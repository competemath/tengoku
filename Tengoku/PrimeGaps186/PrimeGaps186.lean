      rcases mem_filter.mp hfrag with ⟨hpB, hndvd⟩
      have hprime := Nat.prime_of_mem_primesLE hpB
      have hp0 : 0 < (p : ℝ) := by exact_mod_cast hprime.pos
      have hp1 : 1 < (p : ℝ) := by exact_mod_cast hprime.one_lt
      have hpupper : (p : ℝ) ≤ (x ^ ρ) ^ β :=
        (Nat.le_floor_iff' hprime.ne_zero).mp (Nat.mem_primesLE.mp hpB).1
      have hu0 : 0 ≤ Real.log p / Real.log (x ^ ρ) :=
        (div_pos (Real.log_pos hp1) hlogR).le
      have huβ : Real.log p / Real.log (x ^ ρ) ≤ β := by
        apply (div_le_iff₀ hlogR).mpr
        have hl := Real.log_le_log hp0 hpupper
        simpa only [Real.log_rpow (zero_lt_one.trans hx)] using hl
      have hnumerator :
          |Real.exp (-s * (Real.log p / Real.log (x ^ ρ))) - 1| ≤ K := by
        calc
          _ ≤ |Real.exp (-s * (Real.log p / Real.log (x ^ ρ)))| + |(1 : ℝ)| :=
            abs_sub _ _
          _ = Real.exp (-s * (Real.log p / Real.log (x ^ ρ))) + 1 := by
            rw [Real.abs_exp, abs_one]
          _ ≤ K := add_le_add
            (Real.exp_le_exp.mpr
              ((mul_le_mul_of_nonneg_right (neg_le_abs s) hu0).trans
                (mul_le_mul_of_nonneg_left huβ (abs_nonneg s)))) le_rfl
      have hz : |z x p| ≤ K / (p : ℝ) := by
        dsimp only [z]
        rw [abs_div, abs_of_pos hp0]
        exact div_le_div_of_nonneg_right hnumerator hp0.le
