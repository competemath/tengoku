      _ ≤ D := by dsimp [D]; linarith only [le_max_right ((2 : ℝ) ^ R) ((1 + Real.log b') ^ R)]
      _ ≤ D * x ^ e := by nlinarith only [hxp_e, hdp]
  · have hlarge : b ≤ x := (le_max_right _ _).trans (le_of_lt (lt_of_not_ge hc))
    have he1 : 1 ≤ Real.log x := by
