  have hD : (0 : ℝ) < d := by exact_mod_cast hd0
  have hY : 0 < y := lt_of_lt_of_le zero_lt_one hy
  intro Z hZ hZ'
  have hyq : (y * (d : ℝ)) * (q / d : ℕ) = y * (q : ℝ) := by
    rw [mul_assoc, ← Nat.cast_mul, Nat.mul_div_cancel' hd]
  obtain ⟨v, hv, hlo, hhi⟩ := h Z hZ (hyq ▸ hZ')
