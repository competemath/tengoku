          ‖∑ n ∈ s.filter (p j), (χ n : ℂ) * f i₁ n * star (f i₂ n)‖) = H := by
    calc
      _ = ∑ j ∈ B, ∑ i₁ ∈ A.filter (fun i => base i = j),
