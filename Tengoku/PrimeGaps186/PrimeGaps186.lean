      (hB₁ : 0 ≤ B₁) (hB₂ : 0 ≤ B₂) (hB₃ : 0 ≤ B₃)
      (hqt : (q : ℝ) * t ≤ 1)
      (U₁ U₂ U₃ V₁ V₂ V₃ : ZMod (q : ℕ) → ℂ)
      (hU₁ : (∑ z : ZMod (q : ℕ), ‖U₁ z‖) ≤ D * B₁ * A)
      (hU₂ : (∑ z : ZMod (q : ℕ), ‖U₂ z‖) ≤ D * B₂ * A)
      (hU₃ : (∑ z : ZMod (q : ℕ), ‖U₃ z‖) ≤ D * B₃ * A)
      (hE₁ : ∀ z, ‖U₁ z - V₁ z‖ ≤ e * B₁ * t)
      (hE₂ : ∀ z, ‖U₂ z - V₂ z‖ ≤ e * B₂ * t)
      (hE₃ : ∀ z, ‖U₃ z - V₃ z‖ ≤ e * B₃ * t) :
      (∑ z₁ : ZMod (q : ℕ), ∑ z₂ : ZMod (q : ℕ), ∑ z₃ : ZMod (q : ℕ),
