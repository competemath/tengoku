            ‖V₁ z₁‖ * ‖U₂ z₂ - V₂ z₂‖ * ‖U₃ z₃‖ +
            ‖V₁ z₁‖ * ‖V₂ z₂‖ * ‖U₃ z₃ - V₃ z₃‖ := by
      calc
        _ = ‖(U₁ z₁ - V₁ z₁) * U₂ z₂ * U₃ z₃ +
            V₁ z₁ * (U₂ z₂ - V₂ z₂) * U₃ z₃ +
            V₁ z₁ * V₂ z₂ * (U₃ z₃ - V₃ z₃)‖ := by
