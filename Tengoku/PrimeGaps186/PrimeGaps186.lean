/--
@isnad1 id=eq.0h3v.s5.e12ffd483c67 from=translated src=- shape=51695f5c vocab=26e154b3
-/
theorem montgomeryVaughanS3_eq_A_sub_S5 (x : ι → ℝ) (u : ι → ℂ) :
    montgomeryVaughanS3 x u =
      montgomeryVaughanA x u - montgomeryVaughanS5 x u := by
