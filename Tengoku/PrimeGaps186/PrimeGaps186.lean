    (hR : 0 < R) (hRr : R ≤ r) (hg : 0 < g)
    (hβ : β.support ⊆ Finset.Icc A (A + N))
    (hprim : Nat.Coprime (b₁ * b₂ * r) g) :
    (∑ n₁ ∈ β.support, ∑ n₂ ∈ β.support,
      if Nat.ModEq r n₁ n₂ ∧ Nat.ModEq g (b₁ * n₂) (b₂ * n₁)
      then ‖β n₁‖ * ‖β n₂‖ else 0) ≤
