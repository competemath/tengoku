    (K : ℝ) ^ 7 ≤ (20 * (Real.log x) ^ (D + E + 1)) ^ 7 :=
      pow_le_pow_left₀ (Nat.cast_nonneg K) hbound 7
    _ = (20 : ℝ) ^ 7 * (Real.log x) ^ (7 * (D + E + 1)) := by
      rw [mul_pow, ← pow_mul, Nat.mul_comm (D + E + 1) 7]

