          ∀ (r : ℕ) (t : ℝ),
            ‖iteratedDeriv r (fun u : ℝ => dStar ((u - dcenter) / D₂)) t‖ ≤
                Cstar r * (Real.log x) ^ Estar r / D₂ ^ r ∧
