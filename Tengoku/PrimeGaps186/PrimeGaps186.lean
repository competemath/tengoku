          c p * deltaZero (finiteConvolution α β) p.1 p.2 a b₁ b₂ :=
        (Finset.sum_fiberwise_of_maps_to (s := S) (t := R) (g := Prod.snd)
          (fun _ => Finset.mem_image_of_mem Prod.snd) _).symm
      _ = _ := by
        apply Finset.sum_congr rfl
        intro r _
