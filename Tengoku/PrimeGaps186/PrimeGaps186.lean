    star (u s) * u r *
      (((Real.sin (Real.pi * (x r - x s)))⁻¹ : ℝ) : ℂ) *
      (cotangentPiDiff x r s : ℂ))

/--
@isnad1 id=eq.0h3v.s7.6f938849e876 from=translated src=- shape=424d6ed5 vocab=0cbd210a
-/
theorem montgomeryVaughanS5_same_orientation (x : ι → ℝ) (u : ι → ℂ) :
    montgomeryVaughanS5 x u =
      ∑ r, ∑ t ∈ Finset.univ.erase r,
