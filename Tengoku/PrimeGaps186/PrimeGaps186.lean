theorem sourcePhase_character_reciprocal
    (q t n b k : ℕ) [NeZero q] (h : ℤ)
    (hn : Nat.Coprime n q) (hk : Nat.Coprime k q)
    (ht : Nat.ModEq q (t * n) b) :
    ZMod.stdAddChar ((k : ZMod q)⁻¹ * ((t : ZMod q) * (h : ZMod q))) =
      reciprocalUnitPhase q ((b : ZMod q) * (h : ZMod q))
        ((n : ZMod q) * (k : ZMod q)) := by
  classical
  have hun : IsUnit (n : ZMod q) := (ZMod.isUnit_iff_coprime n q).mpr hn
  have huk : IsUnit (k : ZMod q) := (ZMod.isUnit_iff_coprime k q).mpr hk
  have htn : (t : ZMod q) * (n : ZMod q) = (b : ZMod q) := by
    simpa only [Nat.cast_mul] using (ZMod.natCast_eq_natCast_iff _ _ q).mpr ht
  have ht' : (t : ZMod q) = (b : ZMod q) * (n : ZMod q)⁻¹ :=
    (Units.eq_mul_inv_iff_mul_eq (ZMod.unitOfCoprime n hn)).mpr htn
  rw [reciprocalUnitPhase, ite_eq_left (hun.mul huk),
    sourcePhase_inv_mul _ _ hun huk, ht']
  congr 1
  ac_rfl

