    (ZMod.isUnit_iff_coprime f q₀).mpr (hfm.of_dvd_right hq₀)
  have hw : IsUnit (w₃ : ZMod q₀) :=
    (ZMod.isUnit_iff_coprime w₃ q₀).mpr (hw₃m.of_dvd_right hq₀)
  have huq : IsUnit (u : ZMod q₀) := by
    simpa only [ZMod.castHom_apply, ZMod.cast_intCast hq₀] using
      hu.map (ZMod.castHom hq₀ (ZMod q₀))
