  refine ⟨hrad, ?_, ?_⟩
  · rw [← hcoe]
    exact trial_band_cap_zero_of_empty a c hcap _ hbandcap
  · intro ν t
    rcases hrows ν t with hcore | hband
    · exact Or.inl hcore
    · right
      let R := physicalSourceRow ν t.val
      let L : ℝ := (23 / 40) * (R.innerThreshold : ℝ)
