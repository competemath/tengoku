theorem sum_reduced_mixedProgressionMass (f : ℕ →₀ ℂ)
    {q : ℕ} (hq : 0 < q) (r a : ℕ) :
    (∑ b ∈ primitiveResidues q, mixedProgressionMass f q r a b) =
      coprimeProgressionMass f q r a := by
  classical
  unfold mixedProgressionMass coprimeProgressionMass
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro n _
  by_cases hr : n % r = a % r
  · simpa only [hr, true_and] using sum_reduced_indicator hq n (f n)
  · simp only [hr, false_and, ite_false, Finset.sum_const_zero]

