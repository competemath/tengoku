      Finset.univ_nonempty (fun ξ => ‖Ehat ξ‖)
    let G : ℤ × ℤ → ℂ := fun z =>
      ψD (((z.1 : ℝ) - d₀) / D) * ψN (((z.2 : ℝ) - n₀) / N) *
        E (z.2 : ZMod m) (z.1 : ZMod m)
