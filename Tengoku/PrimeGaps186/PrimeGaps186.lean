    rw [dite_eq_left hxOne]
    exact Finset.le_sup'
      (fun z ↦ ‖vaughanTwistedSumFour U V z q chi.1‖) hyComponent
  rw [twistedChebyshevSum_eq_vaughanFiveTerms hU hV]
