open Set
/--
The iterated integral construction for the Dickman function, starting from the constant `1` and
applying `f ↦ 1 - ∫₁^max(1,x) f(t - 1) / max(1,t) dt` at each stage.-/
noncomputable def dickmanApproximation : ℕ → ℝ → ℝ :=
  Nat.rec (motive := fun _ => ℝ → ℝ)
    (fun _ => 1)
    (fun _ previous x =>
      1 - ∫ t in (1 : ℝ)..max 1 x, previous (t - 1) / max 1 t)

/--
The Dickman function defined by taking `⌈x⌉₊` integral-iteration steps for `x ≥ 0`, and extended
by zero to negative inputs.-/
noncomputable def dickmanRho (x : ℝ) : ℝ :=
  if x < 0 then 0 else dickmanApproximation ⌈x⌉₊ x

