/-- The character-twisted Chebyshev sum `∑_{1 ≤ n ≤ x} χ(n) Λ(n)`.-/
noncomputable def twistedChebyshevSum
    (x q : ℕ) (χ : DirichletCharacter ℂ q) : ℂ :=
  ∑ n ∈ Finset.Icc 1 x,
    χ n * (ArithmeticFunction.vonMangoldt n : ℂ)

/--
The Chebyshev sum twisted by a character modulo `r` and restricted to integers coprime to `q`.-/
noncomputable def coprimeTwistedChebyshevSum
    (x q r : ℕ) (χ : DirichletCharacter ℂ r) : ℂ :=
  ∑ n ∈ Finset.Icc 1 x with Nat.Coprime n q,
    χ n * (ArithmeticFunction.vonMangoldt n : ℂ)

/--
@isnad1 id=eq.1h3v.s7.111ded593bf8 from=translated src=- shape=72528ae0 vocab=a49da7db
