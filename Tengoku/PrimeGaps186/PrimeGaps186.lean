      (∀ d n : ℤ, Int.gcd d (lam * lamTilde) = 1 →
        ¬ (g : ℤ) ∣ s * k → ¬ lam ∣ lamTilde * n + s * k * d) ∧
      ((g : ℤ) ∣ s * k →
        ∃! F : ℤ,
          0 ≤ F ∧ F < u ∧ Int.ModEq u (v * F) (-t) ∧
            let G : ℤ := (v * F + t) / u
