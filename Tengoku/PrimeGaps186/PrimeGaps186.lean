      _ ≤ _ := add_le_add hfirst hsecond
  calc
    _ ≤ ∑ r₁ ∈ I, ∑ r₂ ∈ I, (U * (Nat.gcd r₁ r₂ : ℝ) + V) :=
      Finset.sum_le_sum fun r₁ hr₁ => Finset.sum_le_sum fun r₂ hr₂ =>
