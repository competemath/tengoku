    {q : ℕ} [NeZero q] (b : (ZMod q)ˣ → ℂ)
    (χ : DirichletCharacter ℂ q) : ℂ :=
  ∑ a : (ZMod q)ˣ, χ⁻¹ (a : ZMod q) * b a

