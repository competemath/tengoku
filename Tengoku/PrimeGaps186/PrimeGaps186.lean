        Polynomial.C (∏ a : Fin k, ∑ i : Fin d, t (j i) ^ σ a)) =
      ∑ π : Finpartition (Finset.univ : Finset (Fin k)),
        Polynomial.C (d.descFactorial π.parts.card : R) *
          P 0 ^ (d - π.parts.card) *
            ∏ B ∈ π.parts, P (∑ a ∈ B, σ a) := by
