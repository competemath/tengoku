        ∑ m ∈ vaughanFourthDyadicMIndices U V x alpha,
          ArithmeticFunction.vonMangoldt m * Real.log (2 * (M : ℝ)) := by
      apply Finset.sum_le_sum
      intro m hm
      exact hpoint m hm
    _ = (∑ m ∈ vaughanFourthDyadicMIndices U V x alpha,
          ArithmeticFunction.vonMangoldt m) * Real.log (2 * (M : ℝ)) := by
      rw [Finset.sum_mul]
