    ((F).product n.divisorsAntidiagonal).filter
      (fun u => u.2.1 = u.1.prod)
  let T : Finset (Σ _ : ℕ × ℕ, Σ _ : ℕ × ℕ, ℕ × ℕ) :=
    (n.divisorsAntidiagonal.sigma (fun a =>
      a.2.divisorsAntidiagonal.sigma (fun b => b.2.divisorsAntidiagonal))).filter
      (fun v => [v.1.1, v.2.1.1, v.2.2.1] ∈ F)
  let f : (Σ _ : ℕ × ℕ, Σ _ : ℕ × ℕ, ℕ × ℕ) → List ℕ × (ℕ × ℕ) := fun v =>
    ([v.1.1, v.2.1.1, v.2.2.1], (v.1.1 * v.2.1.1 * v.2.2.1, v.2.2.2))
  calc
    _ = ∑ u ∈ S, w u.1 u.2.2 := by
      simpa only [S, Finset.sum_filter, Finset.product_eq_sprod] using
        (Finset.sum_product (F) n.divisorsAntidiagonal
          (fun u : List ℕ × (ℕ × ℕ) =>
            if u.2.1 = u.1.prod then w u.1 u.2.2 else 0)).symm
