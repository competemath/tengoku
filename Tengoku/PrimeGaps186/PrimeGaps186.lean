          simpa only [norm_mul] using
            norm_sum_le α.support (fun m => α m * phaseResponse S β c r a b₁ b₂ m)
    _ ≤ _ := by
      refine hcs.trans (mul_le_mul_of_nonneg_left ?_
        (mul_nonneg (Nat.cast_nonneg _) (Finset.sum_nonneg fun _ _ => sq_nonneg _)))
