    · simp only [ite_eq_right hχ, norm_zero, mul_zero, le_refl]
  have hrow (d : ℕ) (hd : d ∈ D) :
      ‖∑ m ∈ I, w d m * kernel a (d * m)‖ ≤
        (2 * F * (q.divisors.card : ℝ) / q) * v d := by
