      by_cases hhi : s ≤ b
      · simp only [hP, true_and, hlo, hla, hhi, not_lt.mpr hhi, false_and,
          true_and, ite_true, ite_false, zero_add, add_zero]
      · have hbs : b < s := lt_of_not_ge hhi
