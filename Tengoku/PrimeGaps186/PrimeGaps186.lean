theorem dispersionEnergy_eq_four_mixedCorrelations
    (sm : Finset ℕ) (w : ℕ → ℝ) (S : Finset (ℕ × ℕ))
    (β : ℕ →₀ ℂ) (c : ℕ × ℕ → ℂ) (a b₁ b₂ : ℕ) :
    dispersionEnergy sm w S β c a b₁ b₂ =
      (mixedCorrelation sm w S β c a b₁ b₁ -
        mixedCorrelation sm w S β c a b₁ b₂ -
        mixedCorrelation sm w S β c a b₂ b₁ +
        mixedCorrelation sm w S β c a b₂ b₂).re := by
