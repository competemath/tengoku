          rw [div_mul_div_cancel₀ hqPos.ne']
          ring
        _ ≤ (2 * (F * v d) / q) * (q.divisors.card : ℝ) :=
          mul_le_mul_of_nonneg_left
            (div_totient_le_card_divisors q) (by positivity)
        _ = (2 * F * (q.divisors.card : ℝ) / q) * v d := by ring
