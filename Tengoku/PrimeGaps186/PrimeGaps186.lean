      rw [norm_mul, Complex.norm_natCast]
      simpa using mul_le_mul_of_nonneg_left (hweight y) (Nat.cast_nonneg (A + E - N y))
    _ = (Fintype.card Y * E : ℕ) := by exact_mod_cast hdefsum

