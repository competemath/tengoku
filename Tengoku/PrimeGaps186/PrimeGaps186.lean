  by_cases hS : S.Nonempty
  · obtain ⟨ℓ₀, hℓ₀⟩ := hS
    have hsub : S ⊆ (Finset.Icc (-(L : ℤ)) (L : ℤ)).filter
        (fun ℓ => Int.ModEq (q : ℤ) ℓ ℓ₀) := by
      intro ℓ hℓ
