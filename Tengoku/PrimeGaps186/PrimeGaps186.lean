            simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin, mul_pow]
      exact_mod_cast (Finset.card_le_card hsubset).trans hpi
    calc
      ((T.filter (fun v => P v = m)).card : ℝ) =
          ∑ u ∈ Finset.Icc 1 (U / m), ((V.filter (fun v => Q v = u)).card : ℝ) := by
        exact_mod_cast Finset.card_eq_sum_card_fiberwise hmapQ
