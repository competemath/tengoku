noncomputable def vaughanPrimitiveMeanPolynomial
    (x : ℕ) (q : ℝ) : ℝ :=
  4 * (x : ℝ) + 2 * Real.sqrt (x : ℝ) * q ^ 2 +
    6 * vaughanCubeRoot x ^ 2 * (q * Real.sqrt q) +
    5 * (Real.sqrt (x : ℝ) * vaughanCubeRoot x) * q

