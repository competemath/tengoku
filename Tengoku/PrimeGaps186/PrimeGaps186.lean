            Real.sqrt (Nat.gcd r₁ r₂ : ℝ)) * H * Real.sqrt b /
              ((r₁ : ℝ) ^ 2 * Real.sqrt Q * Real.sqrt (r₂ : ℝ)) +
            (M ^ 2 / Real.sqrt (Nat.gcd r₁ r₂ : ℝ) + M) *
              Real.sqrt Q * Real.sqrt (r₂ : ℝ) /
                ((r₁ : ℝ) ^ 2 * Real.sqrt b) := by
        rw [mul_div_assoc H, hratio₁, hratio₂]
