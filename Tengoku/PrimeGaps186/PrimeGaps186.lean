      _ = _ := by ring
  have hR := tendsto_rpow_atTop hρ
  have hA := (tendsto_rpow_atTop hα).comp hR
  have hbound :
      ∀ᶠ x : ℝ in atTop,
        |(∑ p ∈ S x, Real.log (1 + z x p)) - ∑ p ∈ S x, z x p| ≤
          C * ∑' p : ℕ, T x p := by
    filter_upwards [hR.eventually_gt_atTop 1, hA.eventually_gt_atTop (2 * K)]
