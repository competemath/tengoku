      (trialAngularSignature s).card ≤ 3 ∧ (trialAngularSignature s).sum ≤ 6 := by
    decide
  refine ⟨?_, ?_, hsmall, ?_⟩
  · decide +kernel
  · decide +kernel
  · intro η hη
    obtain ⟨⟨s, t⟩, _, rfl⟩ := Finset.mem_image.mp hη
    have hs := hsmall s
    have ht := hsmall t
