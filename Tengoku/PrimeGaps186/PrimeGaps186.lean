    (hE₂ : ∀ q ∈ S, ∀ z, ‖U₂ q z - V₂ q z‖ ≤ e * B₂ * t)
    (hE₃ : ∀ q ∈ S, ∀ z, ‖U₃ q z - V₃ q z‖ ≤ e * B₃ * t)
    (η : ℕ → ℂ) (hη : ∀ q ∈ S, ‖η (q : ℕ)‖ ≤ 1)
    (a : (q : ℕ+) → ZMod (q : ℕ)) :
    ‖(∑ q ∈ S, η (q : ℕ) *
        (∑ m ∈ I, α m * ∑ z₁ : ZMod (q : ℕ), ∑ z₂ : ZMod (q : ℕ),
