            hnormMask d hd (fun m => m % q = (B d) % q)
          _ ≤ v d * (Kraw * M / q * (Real.log M) ^ P) := by
            apply mul_le_mul_of_nonneg_left _ hvd
            rw [← Finset.sum_filter]
            exact hprogression M hM q (B d) hq hqM (hBcoprime d hdq)
