    have hend : -(L : ℤ) + ((2 * L + 1 : ℕ) : ℤ) = (L : ℤ) + 1 := by omega
    rw [hend, Finset.Ico_add_one_right_eq_Icc] at hcount
    have hqR : (0 : ℝ) < q := by exact_mod_cast hq
    have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
    have hi : (1 : ℝ) / q ≤ 1 := (div_le_one hqR).mpr hq1
    calc
      (S.card : ℝ) ≤
          (((Finset.Icc (-(L : ℤ)) (L : ℤ)).filter
            (fun ℓ => Int.ModEq (q : ℤ) ℓ ℓ₀)).card : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
