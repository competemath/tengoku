      obtain ⟨k, hk⟩ := Fin.exists_succAbove_eq (Finset.ne_of_mem_erase hj)
      refine Finset.mem_image.mpr ⟨(true, some k), Finset.mem_univ _, ?_⟩
      rw [auxiliaryPrimeState_true_some, hk]

