theorem dispersionTerm_eq_global_average
    (f : ℕ →₀ ℂ) {G q r : ℕ}
    (hG : 0 < G) (hqr : Nat.Coprime q r) (hqG : q ∣ G) (a : ℕ) :
    dispersionTerm f q r a =
      (∑ b ∈ primitiveResidues G, deltaZero f q r a a b) /
        (G.totient : ℂ) := by
  have hq := Nat.pos_of_dvd_of_pos hqG hG
  have hphi : (G.totient : ℂ) ≠ 0 := by
    exact_mod_cast (Nat.totient_pos.mpr hG).ne'
  have havg : (∑ b ∈ primitiveResidues G, mixedProgressionMass f q r a b) /
      (G.totient : ℂ) = coprimeProgressionMass f q r a / (q.totient : ℂ) := by
    convert average_primitiveResidues_mod hG hqG (mixedProgressionMass f q r a) using 1
    · simp [mixedProgressionMass]
    · rw [sum_reduced_mixedProgressionMass f hq r a]
  calc
    dispersionTerm f q r a = mixedProgressionMass f q r a a -
        (∑ b ∈ primitiveResidues G, mixedProgressionMass f q r a b) /
          (G.totient : ℂ) := by
      rw [mixedProgressionMass_diag f hqr, havg]
      rfl
    _ = _ := by
      simp only [deltaZero, Finset.sum_sub_distrib, Finset.sum_const,
        nsmul_eq_mul, primitiveResidues_card, sub_div]
      field_simp [hphi]

