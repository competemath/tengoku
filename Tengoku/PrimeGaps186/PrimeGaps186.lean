    simp only [fullDiscrepancy, progressionMass, reducedMass, kernel,
      div_eq_mul_inv, mul_sub, mul_ite, ite_mul, one_mul, mul_one,
      zero_mul, mul_zero, Finset.sum_sub_distrib, Finset.sum_mul]
