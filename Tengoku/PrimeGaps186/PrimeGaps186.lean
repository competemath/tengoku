  have hΔlower : 1 ≤ x ^ 26 * Δ := by
    calc
      1 ≤ N := hN
      _ ≤ C * x ^ (δ + 50 * ε) * H ^ 2 * Δ := hΔlo
      _ ≤ x * x * (x ^ 12) ^ 2 * Δ := by gcongr
