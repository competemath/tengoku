  have hpr : x ^ (δ + 4 * ε) ≤ x := hpow _ (by linarith)
  have hpq : x ^ (1 / 2 + 2 * «ω» + ε) ≤ x := hpow _ (by linarith)
  have hpv : x ^ (δ + 5 * ε) ≤ x := hpow _ (by linarith)
  have hpd : x ^ (δ + 50 * ε) ≤ x := hpow _ (by linarith)
  have hCN : C * N ≤ x ^ 2 := by
    calc
      _ ≤ x * x := mul_le_mul hCx hNx hN0 hx0.le
      _ = _ := by ring
  have hMhi : M ≤ x ^ 2 := by
    calc
      M ≤ M * N := le_mul_of_one_le_right hM.le hN
      _ ≤ C * x := hMNhi
      _ ≤ x * x := mul_le_mul_of_nonneg_right hCx hx0.le
