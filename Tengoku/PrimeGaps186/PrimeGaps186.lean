        exact le_rfl
      · simp only [ite_eq_right h, sub_self, norm_zero, norm_nonneg]
    rw [← Finset.sum_sub_distrib]
    calc
      _ ≤ ∑ m ∈ I, ‖α m‖ * Δ := by
        refine norm_sum_le_of_le _ fun m _ => ?_
