    (h : ∀ X : ℝ, 1 ≤ X → X ≤ y * (q : ℝ) →
      ∃ v : ℕ, v ∣ q ∧ X / y ≤ (v : ℝ) ∧ (v : ℝ) ≤ X) :
    ∀ Z : ℝ, 1 ≤ Z → Z ≤ (y * (d : ℝ)) * (q / d : ℕ) →
      ∃ w : ℕ, w ∣ q / d ∧ Z / (y * (d : ℝ)) ≤ (w : ℝ) ∧ (w : ℝ) ≤ Z := by
