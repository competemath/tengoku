      (∑ m ∈ sm, (w m : ℂ) *
        ZMod.stdAddChar (-((m : ZMod Q) * (h : ZMod Q)))) *
      ∑ t ∈ mixedFiber (Finset.range Q) q₁ q₂ r a b₁ b₂ n₁ n₂,
