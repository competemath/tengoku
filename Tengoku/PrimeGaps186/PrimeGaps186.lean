    Real.log_ne_zero_of_pos_of_ne_one (div_pos hx hy) (by
      intro hratio
      apply hne
      exact (div_eq_one_iff_eq hy.ne').mp hratio)
  have hdiff : x - y ≠ 0 := sub_ne_zero.mpr hne
  calc
    1 / (U * |Real.log (x / y)|) =
        (1 / |Real.log (x / y)|) / U := by
      field_simp [hU.ne', hlog]
