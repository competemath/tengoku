        · simp only [hP, true_and, hlo, hla, hhi, hbs, ht, not_le.mpr ht,
            true_and, ite_true, ite_false, zero_add, add_zero]
        · simp only [hP, true_and, hlo, hla, hhi, hbs, ht, le_of_not_gt ht,
            true_and, ite_true, ite_false, zero_add, add_zero]
