noncomputable def dirichletExplicitFormulaNormalizedRightEdge
    {q : ℕ} [NeZero q] (chi : DirichletCharacter ℂ q)
    (x U : ℝ) : ℂ :=
  (((2 * Real.pi : ℝ) : ℂ)⁻¹) *
    ∫ t in -U..U,
      dirichletExplicitFormulaIntegrand chi x
        (((1 + 1 / Real.log x : ℝ) : ℂ) + t * I)

