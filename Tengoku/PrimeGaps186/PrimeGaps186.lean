    Nat.ModEq.cancel_right_of_coprime hn₁r.symm (hdr.trans hzr.symm)
  have hd₁z : Nat.ModEq q₁ d (z : ℕ) :=
    Nat.ModEq.cancel_right_of_coprime hn₁q.symm (hd₁.trans hz₁.symm)
