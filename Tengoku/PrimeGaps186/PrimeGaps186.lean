  · rw [max_eq_right h, inv_inv, min_eq_right]
    exact (le_inv_comm₀ hBpos (abs_pos.mpr ht)).2 h
  · rw [max_eq_left h, min_eq_left]
    exact (inv_le_comm₀ (abs_pos.mpr ht) hBpos).2 h

