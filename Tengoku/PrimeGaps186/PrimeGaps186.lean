          _ = ∑ p ∈ S.filter (fun p => p.2 = r), ∑ m ∈ α.support,
              α m * (c p * ∑ n ∈ β.support, β n * unitDeltaKernel p.1 r a b₁ b₂ m n) := by
            apply Finset.sum_congr rfl
