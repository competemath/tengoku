theorem dft_pairing_twist (p : ℕ) [Fact p.Prime]
    (f g : ZMod p → ℂ) (c : ZMod p) :
    (∑ x : ZMod p, f x * star (g x) * ZMod.stdAddChar (c * x)) =
      (p : ℂ)⁻¹ * ∑ ξ : ZMod p, ZMod.dft f ξ * star (ZMod.dft g (ξ + c)) := by
  classical
  have hp : (p : ℂ) ≠ 0 := by exact_mod_cast (Fact.out : p.Prime).ne_zero
  have hsum :
      (∑ ξ : ZMod p, ZMod.dft f ξ * star (ZMod.dft g (ξ + c))) =
        (p : ℂ) * ∑ x : ZMod p, f x * star (g x) * ZMod.stdAddChar (c * x) := by
    simp only [ZMod.dft_apply, smul_eq_mul, star_sum, star_mul, star_stdAddChar,
      neg_neg]
    simp_rw [Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro x _
    rw [Finset.sum_comm]
    have hterm (y ξ : ZMod p) :
        (ZMod.stdAddChar (-(x * ξ)) * f x) *
            (star (g y) * ZMod.stdAddChar (y * (ξ + c))) =
          (f x * star (g y) * ZMod.stdAddChar (c * y)) *
            ZMod.stdAddChar ((y - x) * ξ) := by
      rw [show y * (ξ + c) = c * y + y * ξ by ring, map_add_eq_mul]
      rw [show -(x * ξ) = (-x) * ξ by ring]
      rw [show (y - x) * ξ = (-x) * ξ + y * ξ by ring, map_add_eq_mul]
      ring
    simp_rw [hterm, ← Finset.mul_sum, stdAddChar_sum]
    simp only [sub_eq_zero, mul_ite, mul_zero]
    simp
    ring
  rw [hsum, ← mul_assoc, inv_mul_cancel₀ hp, one_mul]

