replaced by `1`, is strictly less than `z`.-/
noncomputable def smallPrimeMobius (z : ℝ) : ArithmeticFunction ℝ := by
  classical
  exact ⟨fun d =>
    if ((max 1 (d.primeFactors.sup id) : ℕ) : ℝ) < z then
      (ArithmeticFunction.moebius d : ℝ) else 0, by simp⟩

/--
The Dirichlet convolution of `u`, `v`, and the small-prime Möbius function, cut off at the real
upper bound `M0`.-/
