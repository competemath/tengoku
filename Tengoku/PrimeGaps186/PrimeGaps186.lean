        x ≤ ((f 0 * f 3 : ℕ) : ℝ) ∧ ((f 0 * f 3 : ℕ) : ℝ) ≤ 2 * x ∧
        match l.val with
        | 2 => f 6 < f 2 ∧ ((f 2 * f 6 : ℕ) : ℝ) < H
        | 3 => f 6 < f 2 ∧ Bthreshold < ((f 2 * f 6 : ℕ) : ℝ)
        | 4 => f 6 < f 2
        | 5 => f 2 < f 6
