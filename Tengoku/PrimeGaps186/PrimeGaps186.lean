      _ = P ^ (1 / 6 : ℝ) := by rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hppos.le]; norm_num
  · calc
      Real.sqrt (Real.sqrt (s : ℝ)) ≤ Real.sqrt (Real.sqrt (P ^ (2 / 3 : ℝ))) :=
