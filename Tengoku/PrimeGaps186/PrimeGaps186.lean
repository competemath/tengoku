          apply Finset.mem_filter.mpr
          refine ⟨Finset.mem_sigma.mpr ⟨?_, Finset.mem_sigma.mpr ⟨?_, ?_⟩⟩, ?_⟩
          · exact Nat.mem_divisorsAntidiagonal.mpr ⟨htotal', hn⟩
          · exact Nat.mem_divisorsAntidiagonal.mpr ⟨rfl, hqrh⟩
          · exact Nat.mem_divisorsAntidiagonal.mpr ⟨rfl, hrh⟩
          · simpa only [v, hpshape] using hps
        refine ⟨v, hv, ?_⟩
        exact Prod.ext hpshape.symm (Prod.ext hprod.symm rfl)
