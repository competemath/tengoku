  intro p
  by_cases hp : p.1 = 0
  · simp [positiveFactorPairs, hp]
  have hp0 : 0 < p.1 := Nat.pos_of_ne_zero hp
  have hmul := Nat.le_mul_of_pos_right p.2 hp0
  simp only [positiveFactorPairs, Finset.mem_filter, Finset.mem_product,
    Finset.mem_Ioc, Nat.le_div_iff_mul_le hp0, Nat.mul_comm p.1 p.2]
  by_cases hP : P p.1 <;> simp [hP]
  omega

/--
@isnad1 id=eq.0h3v.s6.d3d5e831da7e from=translated src=- shape=14eeb6c4 vocab=7a839b24
