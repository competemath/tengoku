combining the symmetric Perron integrand at `t` and `-t`.-/
noncomputable def pairedSincIntegrand (alpha beta t : ℝ) : ℝ :=
  (beta + alpha) * Real.sinc ((beta + alpha) * t) +
    (beta - alpha) * Real.sinc ((beta - alpha) * t)

