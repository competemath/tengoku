theorem average_primitiveResidues_mod
    {G q : ℕ} (hG : 0 < G) (hqG : q ∣ G) (F : ℕ → ℂ) :
    (∑ b ∈ primitiveResidues G, F (b % q)) / (G.totient : ℂ) =
      (∑ b ∈ primitiveResidues q, F b) / (q.totient : ℂ) := by
  let : NeZero G := ⟨hG.ne'⟩
  let : NeZero q := ⟨(Nat.pos_of_dvd_of_pos hqG hG).ne'⟩
  have h := average_surjective_monoidHom (ZMod.unitsMap hqG)
    (ZMod.unitsMap_surjective hqG) (fun u => F (u : ZMod q).val)
  simpa only [ZMod.unitsMap_val, ZMod.cast_eq_val, ZMod.val_natCast,
    sum_units_eq_primitiveResidues (q := G) (fun b => F (b % q)),
    sum_units_eq_primitiveResidues (q := q) F, ZMod.card_units_eq_totient] using h

