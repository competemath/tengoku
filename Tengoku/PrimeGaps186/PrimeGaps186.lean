        obtain ⟨_hva, hvtail⟩ := Finset.mem_sigma.mp (Finset.mem_filter.mp hv).1
        obtain ⟨hvb, hvc⟩ := Finset.mem_sigma.mp hvtail
        obtain ⟨_hwa, hwtail⟩ := Finset.mem_sigma.mp (Finset.mem_filter.mp hw).1
        obtain ⟨hwb, hwc⟩ := Finset.mem_sigma.mp hwtail
        have hbtail : v.2.1.2 = w.2.1.2 := by
          rw [← (Nat.mem_divisorsAntidiagonal.mp hvc).1,
            ← (Nat.mem_divisorsAntidiagonal.mp hwc).1, hlist.2.2, hlast]
        have hatail : v.1.2 = w.1.2 := by
          rw [← (Nat.mem_divisorsAntidiagonal.mp hvb).1,
            ← (Nat.mem_divisorsAntidiagonal.mp hwb).1, hlist.2.1, hbtail]
        exact Sigma.ext (Prod.ext hlist.1 hatail)
          (heq_of_eq (Sigma.ext (Prod.ext hlist.2.1 hbtail)
            (heq_of_eq (Prod.ext hlist.2.2 hlast))))
      · intro u hu
        obtain ⟨huS, hproduct⟩ := Finset.mem_filter.mp hu
        obtain ⟨hps, hd⟩ := Finset.mem_product.mp huS
        obtain ⟨p, q, r, hpshape⟩ := hshape u.1 hps
