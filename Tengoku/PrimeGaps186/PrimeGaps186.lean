    rw [intervalIntegral.integral_const_mul, integral_pow]
    norm_num
  have hgint : (∫ t in a..b, g t) =
      (C / 2) * ((b ^ 3 - a ^ 3) / 3) - (∫ t in a..b, f t) := by
    change (∫ t in a..b, q t - f t) = _
    rw [intervalIntegral.integral_sub (hqc.intervalIntegrable a b) hfi, hqint]
  rw [hgint] at hother
  dsimp [g, q] at hother
  exact ⟨sub_nonneg.mpr hupper, by nlinarith only [hother]⟩

