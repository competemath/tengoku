theorem convolution_vanishes_le_mul {R : Type*} [Semiring R]
    {U V : ℝ} {f g : ArithmeticFunction R} (hU : 0 ≤ U) (hV : 0 ≤ V)
    (hf : ∀ n : ℕ, (n : ℝ) ≤ U → f n = 0)
    (hg : ∀ n : ℕ, (n : ℝ) ≤ V → g n = 0) :
    ∀ n : ℕ, (n : ℝ) ≤ U * V → (f * g) n = 0 := by
