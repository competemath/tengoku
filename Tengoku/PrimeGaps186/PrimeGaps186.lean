theorem abs_cos_add_mul_sin_le_sqrt (X t : ℝ) :
    |Real.cos X + t * Real.sin X| ≤ Real.sqrt (1 + t ^ 2) := by
  apply Real.abs_le_sqrt
  nlinarith [sq_nonneg (t * Real.cos X - Real.sin X), Real.cos_sq_add_sin_sq X]

