      have hjG : j ∈ G := by
        apply Finset.mem_filter.mpr
        refine ⟨hjrange, ?_⟩
        rw [hjnat]
        exact not_or.mpr ⟨not_lt.mpr hjnonneg, not_not.mpr hn⟩
      refine ⟨j, hjG, ?_, hjnat⟩
      simpa only [hpoint j hjnonneg, hjnat] using hn₀
    · intro j hj _
      exact hpoint j (hgood j hj).1
