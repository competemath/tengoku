        Filter.Tendsto (fun M : ℕ => (L M : ℝ))
          Filter.atTop (nhds (Real.exp (x : ℝ))) ∧
        Filter.Tendsto (fun M : ℕ => (U M : ℝ))
          Filter.atTop (nhds (Real.exp (x : ℝ))) := by
      by_cases hx : 0 ≤ x
      · simpa only [L, U, hrestore, ite_eq_left hx] using And.intro hLoLim hHiLim
      · simpa only [L, U, hrestore, ite_eq_right hx, Rat.cast_inv] using
          And.intro (hHiLim.inv₀ hTpos.ne') (hLoLim.inv₀ hTpos.ne')
    have hwidth : Filter.Tendsto
        (fun M : ℕ => ((U M - L M : ℚ) : ℝ)) Filter.atTop (nhds 0) := by
      simpa only [Rat.cast_sub, sub_self] using hlimits.2.sub hlimits.1
    let K : ℝ := (2 : ℝ) ^ 164
    have hK : 0 < K := by dsimp [K]; positivity
    have hsmallWidth : ∀ᶠ M : ℕ in Filter.atTop,
        ((U M - L M : ℚ) : ℝ) < Real.exp (x : ℝ) / (K + 1) :=
      hwidth.eventually_lt_const (by positivity)
    obtain ⟨M₀, hM₀⟩ := Filter.eventually_atTop.1 hsmallWidth
    refine ⟨M₀, fun M hM => ?_⟩
    have hw : ((U M - L M : ℚ) : ℝ) * (K + 1) < Real.exp (x : ℝ) :=
      (lt_div_iff₀ (by positivity)).1 (hM₀ M hM)
