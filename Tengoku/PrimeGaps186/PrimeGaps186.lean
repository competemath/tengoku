        simpa only [sq_abs] using
          (sq_le_sq₀ (abs_nonneg (z x p)) (div_nonneg hK.le hp0.le)).mpr hz
      calc
        _ ≤ 2 * (z x p) ^ 2 := hrem _ hzhalf
        _ ≤ 2 * (K / (p : ℝ)) ^ 2 := mul_le_mul_of_nonneg_left hzsq (by norm_num)
        _ = C * T x p := by
          dsimp only [C, T]
          rw [ite_eq_left (And.intro hprime hndvd)]
          ring
    rw [← sum_sub_distrib]
    calc
      _ ≤ ∑ p ∈ S x, |Real.log (1 + z x p) - z x p| := abs_sum_le_sum_abs _ _
      _ ≤ ∑ p ∈ S x, C * T x p := sum_le_sum hpoint
      _ = C * ∑ p ∈ S x, T x p := by rw [mul_sum]
      _ ≤ C * ∑' p : ℕ, T x p :=
        mul_le_mul_of_nonneg_left
