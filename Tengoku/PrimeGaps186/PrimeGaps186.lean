variable {ι : Type*} {κ : Type*}
/--
The finite transpose action of the kernel `C` on `v`, summing over source indices in `s`. This
is an ordinary transpose sum, with no complex conjugation.-/
def transposeSum
    (s : Finset ι) (C : ι → κ → ℂ) (v : ι → ℂ) (n : κ) : ℂ :=
  ∑ r ∈ s, C r n * v r

/-- The finite matrix action of the kernel `C` on `w`, summing over column indices in `t`.-/
def matrixSum
    (t : Finset κ) (C : ι → κ → ℂ) (w : κ → ℂ) (r : ι) : ℂ :=
  ∑ n ∈ t, C r n * w n

