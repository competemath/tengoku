    have hsl : 0 < Real.sqrt (Nat.lcm r₁ r₂ : ℝ) := Real.sqrt_pos.2 hl
    have hg₁ : (1 : ℝ) ≤ Nat.gcd r₁ r₂ := by
      exact_mod_cast Nat.gcd_pos_of_pos_left r₂ hr₁pos
    have hsg₁ : 1 ≤ Real.sqrt (Nat.gcd r₁ r₂ : ℝ) := Real.one_le_sqrt.2 hg₁
    have hsgle : Real.sqrt (Nat.gcd r₁ r₂ : ℝ) ≤ Nat.gcd r₁ r₂ :=
