theorem sourceTerminalMobius_masked_phase
    (m w₂ f w₃ : ℕ) [NeZero m] (J h : ℤ)
    (hw₂J : (w₂ : ℤ) ∣ J) (hfm : Nat.Coprime f m) (hw₃m : Nat.Coprime w₃ m)
    (A₁ A₂ B : ZMod m) (hA₁ : IsUnit A₁) (hA₂ : IsUnit A₂) :
    let L : ZMod m := A₂ * ((J / (w₂ : ℤ) : ℤ) : ZMod m)
    let A₁' : ZMod m := A₁ * ((w₃ : ZMod m) * (f : ZMod m))⁻¹
    let A₂' : ZMod m := (f : ZMod m) * A₂ * (w₃ : ZMod m)⁻¹
    let B' : ZMod m := ((h : ZMod m) + B * (f : ZMod m)) * (w₃ : ZMod m)⁻¹
    let L' : ZMod m := A₂' * ((J / (w₂ : ℤ) : ℤ) : ZMod m)
    IsUnit A₁' ∧ IsUnit A₂' ∧
      Nat.gcd (((w₂ : ZMod m) * A₁' * L').val) m = Int.gcd J (m : ℤ) ∧
      ∀ D N : ℤ,
        let d : ZMod m := ((f : ℤ) * D : ℤ)
        let n : ZMod m := ((w₃ : ℤ) * N + h * D : ℤ)
