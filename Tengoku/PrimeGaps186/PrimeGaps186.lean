        Function.support nStar ⊆ Set.Icc (-TN) TN ∧
        (∀ (r : ℕ) (t : ℝ),
          ‖iteratedDeriv r dStar t‖ ≤ Cstar r * (Real.log x) ^ Estar r ∧
            ‖iteratedDeriv r nStar t‖ ≤ Cstar r * (Real.log x) ^ Estar r) ∧
