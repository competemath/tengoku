  have hQpos : (0 : ℝ) < Q := Nat.cast_pos.mpr (zero_lt_one.trans_le hQone)
  have hQpower : (Q : ℝ) ≤ x ^ θ := Nat.floor_le (Real.rpow_nonneg hxPos.le _)
  have hQx : (Q : ℝ) ≤ x := hQpower.trans (Real.rpow_le_self_of_one_le hxOne hθ1.le)
  have hQlog0 : 0 ≤ 1 + Real.log (Q : ℝ) :=
