theorem sourceTerminalHomogeneous_sign_normalization
    (m : ℕ) [NeZero m] (lam lamTilde s k A B : ℤ) (hlam : lam ≠ 0) :
    let ε : ℤ := if 0 < lam then 1 else -1
    let J : ℤ := s * k + (lam - lamTilde) * B
    let Jε : ℤ := s * (ε * k) + (ε * lam - ε * lamTilde) * B
