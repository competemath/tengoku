    conv_lhs => rw [← hconst r]
    simp only [u, Finsupp.finsetSum_apply, Finsupp.single_apply]
    have hc (s : ℕ) : ((fun _ : Fin 1 => s) = fun _ : Fin 1 => r 0) ↔ s = r 0 :=
