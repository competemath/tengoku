    have hz := (AddCircle.equivIco 1 (-(1 / 2 : ℝ)) z).property
    constructor
    · exact hz.1
    · dsimp [PrimeGap186.centeredRepresentative]
      linarith [hz.2]
  have habs : |PrimeGap186.centeredRepresentative z| ≤ (1 / 2 : ℝ) :=
    abs_le.mpr ⟨hmem.1, hmem.2.le⟩
  simpa only [PrimeGap186.centeredRepresentative, AddCircle.coe_equivIco] using
    (AddCircle.norm_coe_eq_abs_iff 1
      (x := PrimeGap186.centeredRepresentative z) one_ne_zero).2
      (by simpa using habs)

/--
@isnad1 id=le.0h3v.s6.ed11fa0516b8 from=translated src=- shape=1b750250 vocab=58494fef
-/
theorem PrimeGap186.dist_le_abs_centeredRepresentative_sub_sub
    (a b base : UnitAddCircle) :
