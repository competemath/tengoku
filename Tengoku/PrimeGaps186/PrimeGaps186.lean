/--
The complete sum of the standard additive character at `c / (u * v) + a * u + b * v` over pairs
of units modulo the prime `p`. No normalization factor is included.-/
noncomputable def reciprocalProductCompleteSum (p : ℕ) [Fact p.Prime]
    (a b c : ZMod p) : ℂ :=
  ∑ u : (ZMod p)ˣ, ∑ v : (ZMod p)ˣ,
    ZMod.stdAddChar
      (c / ((u : ZMod p) * (v : ZMod p)) + a * (u : ZMod p) + b * (v : ZMod p))

