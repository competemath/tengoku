    _ = Real.sqrt 2 * (Real.sqrt A *
        Real.sqrt ((M : ℝ) * Real.log (2 * (M : ℝ)))) := by
      rw [Real.sqrt_mul hA]
    _ = Real.sqrt 2 * Real.sqrt A * Real.sqrt (M : ℝ) *
        Real.sqrt (Real.log (2 * (M : ℝ))) := by
      rw [Real.sqrt_mul hMnonneg]
