  have hrupper : r ≤ x ^ 29 := by
    calc
      r ≤ r * (x ^ 26 * Δ) := le_mul_of_one_le_right hr hΔlower
      _ = x ^ 26 * (r * Δ) := by ring
      _ ≤ x ^ 26 * (C * R₀) := mul_le_mul_of_nonneg_left hrhi (by positivity)
      _ ≤ x ^ 26 * (x * x ^ 2) := by gcongr
