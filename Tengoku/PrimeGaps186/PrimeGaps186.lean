  have hphysicalMaskError (q : ℕ+) (I : Finset ℤ) (α : ℤ → ℂ)
      (a : ZMod (q : ℕ)) (U₁ U₂ U₃ V₁ V₂ V₃ : ZMod (q : ℕ) → ℂ) :
      ‖(∑ m ∈ I, α m * ∑ z₁ : ZMod (q : ℕ), ∑ z₂ : ZMod (q : ℕ),
          ∑ z₃ : ZMod (q : ℕ),
            if (m : ZMod (q : ℕ)) * z₁ * z₂ * z₃ = a then
