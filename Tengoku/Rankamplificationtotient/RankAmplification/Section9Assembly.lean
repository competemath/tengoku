/-! # Assembly of the all-shifts diagonal argument This file joins the exact finite statements behind Proposition 9.4, Proposition 9.6, Proposition 9.7, and the odd-shift specialization used for Corollary 1.5. -/

namespace RankAmplification

noncomputable section

/-! ## Proposition 9.4: exact diagonal parametrization -/

/-- Forward half of Proposition 9.4, retaining both the shifted factorization and the exact common totient `Γ_j r`.-/
theorem proposition9_3_forward {h Y n j r : ℕ}
    (hrep : IsDiagonalRepresentation h Y n j r) :
    n + h = (j + h) * (diagonalB h j * r + 1) ∧
      n.totient = (n + h).totient ∧
      n.totient = diagonalGamma h j * r := by
  exact ⟨hrep.2.2.2.1, hrep.totient_eq, hrep.totient_eq_gamma_mul⟩

/-- Converse half of Proposition 9.4: a diagonal provider skeleton is represented by the exact same-support affine prime pair.-/
theorem proposition9_3_converse {h n p Y : ℕ} (s : LargePrimeSkeleton h n p)
    (hp : p.Prime) (hdiag : s.IsDiagonal)
    (hcut : Y < largestPrimeFactor n.totient) :
    ∃ r, IsDiagonalRepresentation h Y n s.m1 r :=
  s.exists_diagonalRepresentation hp hdiag hcut

/-- Finite carrier formulation of the external finiteness statement for `J_h`.-/
def IsSameSupportCarrier (h : ℕ) (J : Finset ℕ) : Prop :=
  ∀ j, j ∈ J ↔ IsSameSupportIndex h j

/-- For odd shifts the empty finset is an exact carrier, unconditionally.-/
theorem isSameSupportCarrier_empty_of_odd {h : ℕ} (hodd : Odd h) :
    IsSameSupportCarrier h ∅ := by
  intro j
  simp only [Finset.notMem_empty, false_iff]
  exact not_isSameSupportIndex_of_odd hodd

/-! ## The fixed affine pairs attached to diagonal indices -/

/-- The pair `(A_j r+1,B_j r+1)`.-/
def diagonalAffinePair (h j : ℕ) : AffinePrimePair :=
  if hv : 0 < h ∧ 0 < j then
    { leftSlope := diagonalA h j
      rightSlope := diagonalB h j
      left_pos := diagonalA_pos hv.2
      right_pos := diagonalB_pos hv.2
      slopes_ne := by
        intro heq
        have hmul := congrArg (fun a ↦ a * diagonalGCD h j) heq
        rw [diagonalA_mul_diagonalGCD, diagonalB_mul_diagonalGCD] at hmul
        omega }
  else
    { leftSlope := 1
      rightSlope := 2
      left_pos := by norm_num
      right_pos := by norm_num
      slopes_ne := by norm_num }

@[simp]
theorem diagonalAffinePair_leftValue {h j : ℕ} (hh : 0 < h) (hj : 0 < j) (r : ℕ) :
    (diagonalAffinePair h j).leftValue r = diagonalA h j * r + 1 := by
  simp [diagonalAffinePair, hh, hj, AffinePrimePair.leftValue]

@[simp]
theorem diagonalAffinePair_rightValue {h j : ℕ} (hh : 0 < h) (hj : 0 < j) (r : ℕ) :
    (diagonalAffinePair h j).rightValue r = diagonalB h j * r + 1 := by
  simp [diagonalAffinePair, hh, hj, AffinePrimePair.rightValue]

/-- Prime-pair parameters for the diagonal index `j`.-/
def diagonalPrimePairSet (h j R : ℕ) : Finset ℕ :=
  (diagonalAffinePair h j).primePairSet R

@[simp]
theorem mem_diagonalPrimePairSet {h j R r : ℕ} (hh : 0 < h) (hj : 0 < j) :
    r ∈ diagonalPrimePairSet h j R ↔
      1 ≤ r ∧ r ≤ R ∧ Nat.Prime (diagonalA h j * r + 1) ∧
        Nat.Prime (diagonalB h j * r + 1) := by
  rw [diagonalPrimePairSet, AffinePrimePair.mem_primePairSet]
  simp only [diagonalAffinePair_leftValue hh hj, diagonalAffinePair_rightValue hh hj]

/-- Integers generated by the prime-pair parameters for one fixed diagonal index.-/
def diagonalPrimeValueSet (x h j : ℕ) : Finset ℕ :=
  (diagonalPrimePairSet h j x).image fun r ↦ j * (diagonalA h j * r + 1)

theorem card_diagonalPrimeValueSet_le (x h j : ℕ) :
    (diagonalPrimeValueSet x h j).card ≤ (diagonalPrimePairSet h j x).card := by
  exact Finset.card_image_le

/-- A represented diagonal integer below `x` occurs in the fixed-index prime-value set.-/
theorem IsDiagonalRepresentation.mem_diagonalPrimeValueSet
    {x h Y n j r : ℕ} (hh : 0 < h) (hnx : n ≤ x)
    (hrep : IsDiagonalRepresentation h Y n j r) :
    n ∈ diagonalPrimeValueSet x h j := by
  have hj : 0 < j := zero_lt_one.trans_le hrep.1.1
  have hA : 0 < diagonalA h j := diagonalA_pos hj
  have hrx : r ≤ x := by
    calc
      r ≤ diagonalA h j * r := Nat.le_mul_of_pos_left r hA
      _ ≤ diagonalA h j * r + 1 := Nat.le_add_right _ _
      _ ≤ j * (diagonalA h j * r + 1) :=
        Nat.le_mul_of_pos_left _ hj
      _ = n := hrep.2.2.1.symm
      _ ≤ x := hnx
  apply Finset.mem_image.mpr
  refine ⟨r, ?_, hrep.2.2.1.symm⟩
  exact mem_diagonalPrimePairSet hh hj |>.mpr
    ⟨hrep.2.1, hrx, hrep.2.2.2.2.1, hrep.2.2.2.2.2.1⟩

/-- Exact finite cover of the displayed diagonal by a supplied carrier for `J_h`.-/
theorem aboveCutoffDiagonalSet_subset_biUnion_diagonalPrimeValueSet
    {x h Y : ℕ} {J : Finset ℕ} (hh : 0 < h)
    (hJ : IsSameSupportCarrier h J) :
    aboveCutoffDiagonalSet x h Y ⊆ J.biUnion (diagonalPrimeValueSet x h) := by
  intro n hn
  have hnData := mem_aboveCutoffDiagonalSet.mp hn
  obtain ⟨j, r, hrep⟩ := hnData.2.2
  apply Finset.mem_biUnion.mpr
  exact ⟨j, (hJ j).mpr hrep.1,
    hrep.mem_diagonalPrimeValueSet hh hnData.2.1⟩

/-- Purely finite diagonal count bound by the sum of fixed affine prime-pair counts.-/
theorem aboveCutoffDiagonalCount_le_sum_diagonalPrimePairSet
    {x h Y : ℕ} {J : Finset ℕ} (hh : 0 < h)
    (hJ : IsSameSupportCarrier h J) :
    aboveCutoffDiagonalCount x h Y ≤
      ∑ j ∈ J, (diagonalPrimePairSet h j x).card := by
  rw [aboveCutoffDiagonalCount]
  calc
    (aboveCutoffDiagonalSet x h Y).card ≤
        (J.biUnion (diagonalPrimeValueSet x h)).card :=
      Finset.card_le_card
        (aboveCutoffDiagonalSet_subset_biUnion_diagonalPrimeValueSet hh hJ)
    _ ≤ ∑ j ∈ J, (diagonalPrimeValueSet x h j).card := Finset.card_biUnion_le
    _ ≤ ∑ j ∈ J, (diagonalPrimePairSet h j x).card := by
      exact Finset.sum_le_sum fun j _ ↦ card_diagonalPrimeValueSet_le x h j

/-! ## Proposition 9.6: the supplied affine-sieve endpoint -/

/-- Uniform fixed-form sieve input over a finite same-support carrier.-/
def DiagonalAffineSieveHypothesis (h : ℕ) (J : Finset ℕ) (C : ℝ) : Prop :=
  ∀ j ∈ J, ∀ R, 3 ≤ R →
    ((diagonalPrimePairSet h j R).card : ℝ) ≤ C * AffinePrimePair.logSquaredScale R

/-- A finite family of the pointwise conclusions produced by `AffineSelbergReduction` admits one uniform constant.-/
theorem exists_diagonalAffineSieveHypothesis_of_pointwise
    {h : ℕ} {J : Finset ℕ}
    (hpoint : ∀ j ∈ J, (diagonalAffinePair h j).HasLogSquaredPrimePairBound) :
    ∃ C, DiagonalAffineSieveHypothesis h J C := by
  classical
  let c : ℕ → ℝ := fun j ↦
    if hj : j ∈ J then Classical.choose (hpoint j hj) else 0
  have hc (j : ℕ) (hj : j ∈ J) (R : ℕ) (hR : 3 ≤ R) :
      ((diagonalPrimePairSet h j R).card : ℝ) ≤
        c j * AffinePrimePair.logSquaredScale R := by
    have hchosen := Classical.choose_spec (hpoint j hj)
    simpa [c, hj, diagonalPrimePairSet] using hchosen R hR
  let C : ℝ := ∑ j ∈ J, max 0 (c j)
  refine ⟨C, ?_⟩
  intro j hj R hR
  have hscale : 0 ≤ AffinePrimePair.logSquaredScale R := by
    unfold AffinePrimePair.logSquaredScale
    positivity
  have hjmax : max 0 (c j) ≤ C := by
    apply Finset.single_le_sum (fun i _ ↦ le_max_left 0 (c i)) hj
  calc
    ((diagonalPrimePairSet h j R).card : ℝ) ≤
        c j * AffinePrimePair.logSquaredScale R := hc j hj R hR
    _ ≤ max 0 (c j) * AffinePrimePair.logSquaredScale R :=
      mul_le_mul_of_nonneg_right (le_max_right 0 (c j)) hscale
    _ ≤ C * AffinePrimePair.logSquaredScale R :=
      mul_le_mul_of_nonneg_right hjmax hscale

/-- Proposition 9.6 from a finite `J_h` carrier and a uniform fixed-affine sieve input.-/
theorem proposition9_5_diagonal_bound
    {x h Y : ℕ} {J : Finset ℕ} {C : ℝ} (hh : 0 < h) (hx : 3 ≤ x)
    (hJ : IsSameSupportCarrier h J)
    (hsieve : DiagonalAffineSieveHypothesis h J C) :
    (aboveCutoffDiagonalCount x h Y : ℝ) ≤
      (J.card : ℝ) * C * AffinePrimePair.logSquaredScale x := by
  have hfinite := aboveCutoffDiagonalCount_le_sum_diagonalPrimePairSet
    (x := x) (Y := Y) hh hJ
  have hfiniteReal : (aboveCutoffDiagonalCount x h Y : ℝ) ≤
      ∑ j ∈ J, ((diagonalPrimePairSet h j x).card : ℝ) := by
    exact_mod_cast hfinite
  calc
    (aboveCutoffDiagonalCount x h Y : ℝ) ≤
        ∑ j ∈ J, ((diagonalPrimePairSet h j x).card : ℝ) := hfiniteReal
    _ ≤ ∑ _j ∈ J, C * AffinePrimePair.logSquaredScale x := by
      exact Finset.sum_le_sum fun j hj ↦ hsieve j hj x hx
    _ = (J.card : ℝ) * C * AffinePrimePair.logSquaredScale x := by
      simp
      ring

/-- Odd-shift simplification of Proposition 9.6: there is no diagonal to estimate.-/
theorem proposition9_5_diagonal_zero_of_odd {x h Y : ℕ} (hodd : Odd h) :
    aboveCutoffDiagonalCount x h Y = 0 :=
  aboveCutoffDiagonalCount_eq_zero_of_odd hodd

/-! ## Proposition 9.7: exact transfer and square-source extraction -/

/-- The part of the off-diagonal remainder carrying an above-`y` square-source witness.-/
def offDiagonalSquareSourceSet (x h y P : ℕ) : Finset ℕ :=
  offDiagonalNonsmoothSet x h y ∩ squareSourceSet x h y P

/-- The complementary off-diagonal branch, to which the small/large-cofactor estimates apply.-/
def offDiagonalNonSquareSet (x h y P : ℕ) : Finset ℕ :=
  offDiagonalNonsmoothSet x h y \ squareSourceSet x h y P

@[simp]
theorem mem_offDiagonalSquareSourceSet {x h y P n : ℕ} :
    n ∈ offDiagonalSquareSourceSet x h y P ↔
      n ∈ offDiagonalNonsmoothSet x h y ∧ n ∈ squareSourceSet x h y P := by
  simp [offDiagonalSquareSourceSet]

@[simp]
theorem mem_offDiagonalNonSquareSet {x h y P n : ℕ} :
    n ∈ offDiagonalNonSquareSet x h y P ↔
      n ∈ offDiagonalNonsmoothSet x h y ∧ n ∉ squareSourceSet x h y P := by
  simp [offDiagonalNonSquareSet]

theorem offDiagonalSquareSourceSet_disjoint_nonSquareSet (x h y P : ℕ) :
    Disjoint (offDiagonalSquareSourceSet x h y P)
      (offDiagonalNonSquareSet x h y P) := by
  rw [Finset.disjoint_left]
  intro n hsquare hnonsquare
  exact (mem_offDiagonalNonSquareSet.mp hnonsquare).2
    (mem_offDiagonalSquareSourceSet.mp hsquare).2

/-- Exact square/nonsquare partition inside the off-diagonal remainder.-/
theorem offDiagonalSquareSourceSet_union_nonSquareSet (x h y P : ℕ) :
    offDiagonalSquareSourceSet x h y P ∪ offDiagonalNonSquareSet x h y P =
      offDiagonalNonsmoothSet x h y := by
  ext n
  simp only [Finset.mem_union, mem_offDiagonalSquareSourceSet,
    mem_offDiagonalNonSquareSet]
  tauto

theorem offDiagonalNonsmoothCount_eq_square_add_nonSquare (x h y P : ℕ) :
    offDiagonalNonsmoothCount x h y =
      (offDiagonalSquareSourceSet x h y P).card +
        (offDiagonalNonSquareSet x h y P).card := by
  rw [offDiagonalNonsmoothCount,
    ← offDiagonalSquareSourceSet_union_nonSquareSet x h y P,
    Finset.card_union_of_disjoint
      (offDiagonalSquareSourceSet_disjoint_nonSquareSet x h y P)]

/-- The witnessed square part is controlled by the unconditional square-source census.-/
theorem offDiagonalSquareSourceSet_subset_squareSourceSet (x h y P : ℕ) :
    offDiagonalSquareSourceSet x h y P ⊆ squareSourceSet x h y P :=
  Finset.inter_subset_right

/-- Unconditional square-source contribution at the automatic square-root endpoint.-/
theorem offDiagonalSquareSourceSet_card_cast_le_sqrt_cutoff
    {x h y : ℕ} (hh : 0 < h) (hhy : h ≤ y) (hy : 0 < y) :
    ((offDiagonalSquareSourceSet x h y (2 * x).sqrt).card : ℝ) ≤
      2 * (x : ℝ) * (y : ℝ)⁻¹ + 2 * ((2 * x).sqrt : ℝ) := by
  have hsubset : (offDiagonalSquareSourceSet x h y (2 * x).sqrt).card ≤
      (squareSourceSet x h y (2 * x).sqrt).card :=
    Finset.card_le_card (offDiagonalSquareSourceSet_subset_squareSourceSet
      x h y (2 * x).sqrt)
  have hsubsetReal : ((offDiagonalSquareSourceSet x h y (2 * x).sqrt).card : ℝ) ≤
      ((squareSourceSet x h y (2 * x).sqrt).card : ℝ) := by
    exact_mod_cast hsubset
  exact hsubsetReal.trans (squareSourceSet_card_cast_le_sqrt_cutoff hh hhy hy)

/-- Named hypothesis for the genuinely unformalized nonsquare small- and large-cofactor estimates in Proposition 9.7.-/
def NonSquareTransferHypothesis (E : ℕ → ℕ → ℕ → ℝ) : Prop :=
  ∀ x h y, 0 < h → h ≤ y → 0 < y →
    ((offDiagonalNonSquareSet x h y (2 * x).sqrt).card : ℝ) ≤ E x h y

/-- The off-diagonal transfer bound obtained by combining the unconditional square-source branch with the supplied nonsquare estimate.-/
theorem proposition9_6_offDiagonal_bound
    {E : ℕ → ℕ → ℕ → ℝ} (hE : NonSquareTransferHypothesis E)
    {x h y : ℕ} (hh : 0 < h) (hhy : h ≤ y) (hy : 0 < y) :
    (offDiagonalNonsmoothCount x h y : ℝ) ≤
      2 * (x : ℝ) * (y : ℝ)⁻¹ + 2 * ((2 * x).sqrt : ℝ) + E x h y := by
  rw [offDiagonalNonsmoothCount_eq_square_add_nonSquare
    x h y (2 * x).sqrt, Nat.cast_add]
  exact add_le_add
    (offDiagonalSquareSourceSet_card_cast_le_sqrt_cutoff hh hhy hy)
    (hE x h y hh hhy hy)

/-- Full displayed-diagonal form of Proposition 9.7.-/
theorem proposition9_6_nonsmooth_bound
    {E : ℕ → ℕ → ℕ → ℝ} (hE : NonSquareTransferHypothesis E)
    {x h y : ℕ} (hh : 0 < h) (hhy : h ≤ y) (hy : 0 < y) :
    (nonsmoothShiftedCount x h y : ℝ) ≤
      (aboveCutoffDiagonalCount x h y : ℝ) +
        (2 * (x : ℝ) * (y : ℝ)⁻¹ + 2 * ((2 * x).sqrt : ℝ) + E x h y) := by
  rw [nonsmoothShiftedCount_eq_aboveCutoffDiagonalCount_add_offDiagonalNonsmoothCount,
    Nat.cast_add]
  exact add_le_add le_rfl (proposition9_6_offDiagonal_bound hE hh hhy hy)

/-- Odd shifts have no displayed diagonal, so the transfer bound controls the entire nonsmooth branch directly.-/
theorem proposition9_6_nonsmooth_bound_of_odd
    {E : ℕ → ℕ → ℕ → ℝ} (hE : NonSquareTransferHypothesis E)
    {x h y : ℕ} (hodd : Odd h) (hhy : h ≤ y) (hy : 0 < y) :
    (nonsmoothShiftedCount x h y : ℝ) ≤
      2 * (x : ℝ) * (y : ℝ)⁻¹ + 2 * ((2 * x).sqrt : ℝ) + E x h y := by
  have hh : 0 < h := hodd.pos
  have hbound := proposition9_6_nonsmooth_bound (x := x) hE hh hhy hy
  rw [aboveCutoffDiagonalCount_eq_zero_of_odd hodd, Nat.cast_zero, zero_add] at hbound
  exact hbound

/-- Assembly of Propositions 9.5 and 9.6: a fixed-shift nonsmooth count is bounded by its finite affine diagonal sieve contribution plus the transfer error.-/
theorem corollary9_6_assembled_bound
    {E : ℕ → ℕ → ℕ → ℝ} (hE : NonSquareTransferHypothesis E)
    {x h y : ℕ} {J : Finset ℕ} {C : ℝ}
    (hh : 0 < h) (hhy : h ≤ y) (hy : 0 < y) (hx : 3 ≤ x)
    (hJ : IsSameSupportCarrier h J)
    (hsieve : DiagonalAffineSieveHypothesis h J C) :
    (nonsmoothShiftedCount x h y : ℝ) ≤
      (J.card : ℝ) * C * AffinePrimePair.logSquaredScale x +
        (2 * (x : ℝ) * (y : ℝ)⁻¹ + 2 * ((2 * x).sqrt : ℝ) + E x h y) := by
  exact (proposition9_6_nonsmooth_bound hE hh hhy hy).trans
    (add_le_add (proposition9_5_diagonal_bound hh hx hJ hsieve) le_rfl)

/-! ## Odd shifts and Corollary 1.5 -/

/-- All finite diagonal-transfer objects collapse in the expected way for an odd shift.-/
theorem section9_odd_shift_collapse {x h Y : ℕ} (hodd : Odd h) :
    sameSupportIndices h = ∅ ∧
      aboveCutoffDiagonalSet x h Y = ∅ ∧
      aboveCutoffDiagonalCount x h Y = 0 ∧
      offDiagonalNonsmoothSet x h Y = nonsmoothShiftedSet x h Y ∧
      offDiagonalNonsmoothCount x h Y = nonsmoothShiftedCount x h Y := by
  exact ⟨sameSupportIndices_eq_empty_of_odd hodd,
    aboveCutoffDiagonalSet_eq_empty_of_odd hodd,
    aboveCutoffDiagonalCount_eq_zero_of_odd hodd,
    offDiagonalNonsmoothSet_eq_nonsmoothShiftedSet_of_odd hodd,
    offDiagonalNonsmoothCount_eq_nonsmoothShiftedCount_of_odd hodd⟩

/-- The moving-rank scale `√(log x log₂ x)` in Corollary 1.5.-/
def movingRankScale (x : ℕ) : ℝ :=
  Real.sqrt (Real.log x * Real.log (Real.log x))

/-- An explicit representative of `x exp(-(1/2-o(1))√(log x log₂ x))`.-/
def halfExponentMajorant (ε : ℕ → ℝ) (x : ℕ) : ℝ :=
  (x : ℝ) * Real.exp (-(((2 : ℝ)⁻¹ - ε x) * movingRankScale x))

/-- Named analytic input supplied by the moving-rank argument of Section 10.-/
def MovingRankDiagonalHypothesis (Y H : ℕ → ℕ) (ε : ℕ → ℝ) : Prop :=
  Filter.Tendsto ε Filter.atTop (nhds 0) ∧
    ∀ᶠ x in Filter.atTop, ∀ h, 1 ≤ h → h ≤ H x →
      (shiftedEqualTotientCount x h : ℝ) ≤
        (aboveCutoffDiagonalCount x h (Y x) : ℝ) + halfExponentMajorant ε x

/-- Odd-shift specialization of the moving-rank diagonal estimate.-/
theorem movingRank_bound_of_odd
    {Y H : ℕ → ℕ} {ε : ℕ → ℝ}
    (hmove : MovingRankDiagonalHypothesis Y H ε)
    {h : ℕ} (hodd : Odd h)
    (hcap : ∀ᶠ x in Filter.atTop, h ≤ H x) :
    ∀ᶠ x in Filter.atTop,
      (shiftedEqualTotientCount x h : ℝ) ≤ halfExponentMajorant ε x := by
  filter_upwards [hmove.2, hcap] with x hx hxCap
  have hhOne : 1 ≤ h := Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt hodd.pos)
  have hbound := hx h hhOne hxCap
  rw [aboveCutoffDiagonalCount_eq_zero_of_odd hodd, Nat.cast_zero, zero_add] at hbound
  exact hbound

/-- Formal conclusion corresponding to the `1/2-o(1)` statement in Corollary 1.5.-/
def HasConsecutiveHalfExponentBound : Prop :=
  ∃ ε : ℕ → ℝ,
    Filter.Tendsto ε Filter.atTop (nhds 0) ∧
      ∀ᶠ x in Filter.atTop,
        (shiftedEqualTotientCount x 1 : ℝ) ≤ halfExponentMajorant ε x

/-- Corollary 1.5: the moving-rank diagonal estimate implies the consecutive equal-totient bound, because `h=1` is odd and its diagonal is empty.-/
theorem theorem1_5_consecutive
    {Y H : ℕ → ℕ} {ε : ℕ → ℝ}
    (hmove : MovingRankDiagonalHypothesis Y H ε)
    (hcap : ∀ᶠ x in Filter.atTop, 1 ≤ H x) :
    HasConsecutiveHalfExponentBound := by
  refine ⟨ε, hmove.1, ?_⟩
  exact movingRank_bound_of_odd hmove (by norm_num : Odd 1) hcap

end

