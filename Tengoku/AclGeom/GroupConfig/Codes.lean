import Tengoku.AclGeom.GroupConfig.Rank
import Tengoku.Seed.Algebra.Polynomial.Roots
import Tengoku.Seed.Algebra.Polynomial.Lifts

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Codes of finite sets of tuples

Blueprint `sources/group_configuration/03-codes.tex`, `def:code` and `lem:code`(1)–(3).

A finite set `S` of tuples `s : ι → R` is encoded by the polynomial
`codePoly S = ∏_{s ∈ S} (T - ∑_j s_j U_j)`, a monic polynomial in `T` over `R[U]`, and by
its scalar coefficient carrier `code S`, the finite set of nonzero scalar coefficients.
The indexed coefficients are retained by `codePoly S`; equality of scalar carriers alone
is not asserted to determine the tuples.  The code polynomial
determines `S` (`codePoly_injective`, via its roots over the domain `R[U]`) and is natural
in `R` (`codePoly_map`), so an automorphism fixes `code S` pointwise iff it stabilises `S`
(`fixes_code_iff`).  The code lies in the ring generated by the coordinates of `S`
(`code_subset_adjoin`), and the coordinates are algebraic over the field generated by the
code (`mem_racl_code`, by specialising the variables `U` to unit vectors), so the code and
the coordinates have the same relative algebraic closure (`racl_code_eq`).

`lem:code`(4) and the codes of conjugate sets (`def:conjset`, `lem:conjcode`) need the
Galois description of definable closure. Their scalar-carrier forms are proved in
`GroupConfig.ConjugateSet`; the finite indexed vector presentation is in
`GroupConfig.CodeVector`, under the namespace `GroupConfig.FiniteSetCode`.

**Status:** the indexed coding polynomial is injective over domains, and
scalar coefficient carriers are finite and natural. The fixed-point/stabilizer
criterion, containment in the coordinate ring, and equality of relative
algebraic closures are proved. The finite degree-bounded coefficient-vector
presentation and its corresponding properties are proved in `GroupConfig.CodeVector`;
the scalar-carrier definable-closure/conjugate-set clauses are in `GroupConfig.ConjugateSet`.
No injectivity of the scalar coefficient carrier is claimed.
-/

namespace GroupConfig

open AclGeom MvPolynomial Set

noncomputable section

/-! ### Embeddings of tuples -/

section Emb

variable {ι R R' : Type*}

/-- Composition with an injective map, as an embedding of tuples.-/
def compEmb (f : R → R') (hf : Function.Injective f) : (ι → R) ↪ (ι → R') :=
  ⟨fun s ↦ f ∘ s, hf.comp_left⟩

@[simp]
theorem compEmb_apply (f : R → R') (hf : Function.Injective f) (s : ι → R) :
    compEmb f hf s = f ∘ s := rfl

end Emb

/-! ### Linear forms and the code polynomial -/

section Ring

variable {R : Type*} [CommRing R] {ι : Type*} [Fintype ι]

/-- The linear form `∑ j, s j * U j` attached to a tuple `s`.-/
def linForm (s : ι → R) : MvPolynomial ι R := ∑ j, C (s j) * X j

theorem coeff_linForm_single (s : ι → R) (j : ι) :
    (linForm s).coeff (Finsupp.single j 1) = s j := by
  classical
  simp only [linForm, coeff_sum, coeff_C_mul, coeff_X]
  rw [Finset.sum_eq_single j]
  · simp
  · intro j' _ hj'
    have : Finsupp.single j' (1 : ℕ) ≠ Finsupp.single j 1 := fun h ↦
      hj' ((Finsupp.single_left_inj one_ne_zero).1 h)
    simp [this]
  · intro h
    exact absurd (Finset.mem_univ j) h

theorem linForm_injective : Function.Injective (linForm (R := R) (ι := ι)) := by
  intro s s' h
  funext j
  rw [← coeff_linForm_single s j, ← coeff_linForm_single s' j, h]

/-- Naturality of linear forms.-/
theorem map_linForm {R' : Type*} [CommRing R'] (f : R →+* R') (s : ι → R) :
    MvPolynomial.map f (linForm s) = linForm (f ∘ s) := by
  simp [linForm, map_sum]

/-- `def:code`: the code polynomial `∏_{s ∈ S} (T - ∑_j s_j U_j)` of a finite set of tuples,
as a monic polynomial in `T` over `R[U]`.-/
def codePoly (S : Finset (ι → R)) : Polynomial (MvPolynomial ι R) :=
  ∏ s ∈ S, (Polynomial.X - Polynomial.C (linForm s))

theorem codePoly_monic (S : Finset (ι → R)) : (codePoly S).Monic :=
  Polynomial.monic_prod_of_monic _ _ fun s _ ↦ Polynomial.monic_X_sub_C (linForm s)

/-- Naturality of the code polynomial along injective ring homomorphisms.-/
theorem codePoly_map {R' : Type*} [CommRing R'] (f : R →+* R') (hf : Function.Injective f)
    (S : Finset (ι → R)) :
    codePoly (S.map (compEmb f hf)) = (codePoly S).map (MvPolynomial.map f) := by
  unfold codePoly
  rw [Finset.prod_map, Polynomial.map_prod]
  refine Finset.prod_congr rfl fun s _ ↦ ?_
  rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, map_linForm, compEmb_apply]

theorem roots_codePoly [IsDomain R] (S : Finset (ι → R)) :
    (codePoly S).roots = S.val.map linForm := by
  unfold codePoly
  rw [Finset.prod_eq_multiset_prod,
    ← Polynomial.roots_multiset_prod_X_sub_C (S.val.map linForm), Multiset.map_map]
  rfl

/-- `lem:code`(2): the code polynomial determines the set.-/
theorem codePoly_injective [IsDomain R] : Function.Injective (codePoly (R := R) (ι := ι)) := by
  intro S S' h
  have h' := congrArg Polynomial.roots h
  rw [roots_codePoly, roots_codePoly] at h'
  exact Finset.val_injective (Multiset.map_injective linForm_injective h')

/-! ### The code -/

/-- `def:code`: the code of `S`, the set of all coefficients of its code polynomial.-/
def code (S : Finset (ι → R)) : Set R :=
  {x | ∃ i, x ∈ ((codePoly S).coeff i).coeffs}

end Ring

/-! ### Codes over a field -/

section Field

variable {k K : Type*} [Field k] [Field K] [Algebra k K] {ι : Type*} [Fintype ι]

/-- The set of coordinates of the tuples of `S`.-/
def coords (S : Finset (ι → K)) : Set K := ⋃ s ∈ S, range s

section Single

variable [DecidableEq ι]

/-- Specialising the variables `U` to the `j`-th unit vector picks out the `j`-th
coordinate.-/
theorem aeval_single_linForm (s : ι → K) (j : ι) :
    aeval (Pi.single j (1 : K)) (linForm s) = s j := by
  simp [linForm, Pi.single_apply]

/-- The code polynomial specialised at the `j`-th unit vector is `∏_{s ∈ S} (T - s_j)`.-/
theorem map_aeval_single_codePoly (S : Finset (ι → K)) (j : ι) :
    (codePoly S).map (aeval (Pi.single j (1 : K))).toRingHom =
      ∏ s ∈ S, (Polynomial.X - Polynomial.C (s j)) := by
  unfold codePoly
  rw [Polynomial.map_prod]
  refine Finset.prod_congr rfl fun s _ ↦ ?_
  rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
  congr 2
  exact aeval_single_linForm s j

omit [Fintype ι] in
/-- Specialisations at unit vectors lie in the ring generated by the coefficients.-/
theorem aeval_single_mem_adjoin (p : MvPolynomial ι K) (j : ι) :
    aeval (Pi.single j (1 : K)) p ∈ Algebra.adjoin k (p.coeffs : Set K) := by
  change eval (Pi.single j (1 : K)) p ∈ _
  rw [eval_eq]
  refine Subalgebra.sum_mem _ fun m hm ↦ Subalgebra.mul_mem _ ?_
    (Subalgebra.prod_mem _ fun i _ ↦ Subalgebra.pow_mem _ ?_ _)
  · exact Algebra.subset_adjoin (mem_coeffs_iff.2 ⟨m, hm, rfl⟩)
  · rw [Pi.single_apply]
    split_ifs
    · exact Subalgebra.one_mem _
    · exact Subalgebra.zero_mem _

end Single

end Field

end

end GroupConfig
