/-!
# Reduced row echelon bases and fields of definition of subspaces

Blueprint `sources/group_configuration/02-fields-of-definition.tex`,
`def:subspace-defined`, `def:rref`, `lem:rref`, `def:fod-subspace`,
`lem:fod-subspace`.

For a subspace `W` of `𝓜 → R` (`𝓜` a finite linearly ordered index set), a
*pivot* is an index at which some vector of `W` has its leading (first nonzero)
coordinate.  Restricting vectors of `W` to the pivot coordinates is injective
(a nonzero vector is nonzero at its leading index, which is a pivot) and, by a
dimension count, bijective (`pivotEquiv`).  The *reduced row echelon basis*
`rref W` is the preimage of the standard basis of the pivot coordinates; this
gives existence and uniqueness (`rref_eq_of_pivot_coords`) at once, with no
Gaussian elimination.

The *field of definition* `fod W` is the subfield generated by the coordinates
of the reduced row echelon basis.  A subspace is *defined over* a subfield `F`
if it is spanned by its `F`-valued vectors; this holds iff `fod W ≤ F`
(`definedOver_iff`), so `fod W` is the smallest field of definition.  Field
automorphisms act compatibly (`fod_map`, `map_eq_self_iff`).

This module is part of the formalization of the group configuration theorem
blueprint `sources/group_configuration_blueprint.tex`.

**Status:** the canonical pivot-indexed reduced row echelon basis, its Mathlib
matrix certificate, uniqueness for any finite ordered basis in RREF, and the
smallest field of definition of a finite-coordinate subspace are proved over
arbitrary fields. Finite field generators and the pointwise automorphism
stabilizer criterion are explicit. Fields of definition
of polynomial ideals are developed in `GroupConfig.FieldOfDefinition`, and
canonical bases in `GroupConfig.CanonicalBase`.
-/

namespace GroupConfig

open Module Set

noncomputable section

variable {R : Type*} [Field R] {𝓜 : Type*} [Finite 𝓜] [LinearOrder 𝓜]

/-! ### Leading indices and pivots -/

/-- A nonzero vector has a leading index: the least index with nonzero coordinate.
@isnad1 id=ex.1h3v.s6.cac5a458851d from=translated src=- shape=781bbbfe vocab=1c5bc67b
-/
theorem exists_leading {v : 𝓜 → R} (hv : v ≠ 0) :
    ∃ μ, v μ ≠ 0 ∧ ∀ ν < μ, v ν = 0 := by
  simpa only [Matrix.IsLeadingEntry, and_comm] using
    (Matrix.row_ne_zero_iff_exists_isLeadingEntry (A := fun _ : Unit ↦ v) (i := ())).mp hv

/-- `μ` is a *pivot index* of `W`: some vector of `W` has leading index `μ`.-/
def IsPivot (W : Submodule R (𝓜 → R)) (μ : 𝓜) : Prop :=
  ∃ v ∈ W, v μ ≠ 0 ∧ ∀ ν < μ, v ν = 0

/-- The pivot indices of `W`, as a subtype.-/
abbrev Pivots (W : Submodule R (𝓜 → R)) : Type _ := {μ : 𝓜 // IsPivot W μ}

variable (W : Submodule R (𝓜 → R))

/-- Restriction of a vector of `W` to its pivot coordinates.-/
def pivotProj : W →ₗ[R] (Pivots W → R) :=
  LinearMap.pi fun μ : Pivots W ↦ (LinearMap.proj (μ : 𝓜)).comp W.subtype

omit [Finite 𝓜] in
/--
@isnad1 id=eq.0h5v.s10.05d90876823c from=translated src=- shape=c8390d21 vocab=9719a53e
-/
@[simp]
theorem pivotProj_apply (v : W) (μ : Pivots W) : pivotProj W v μ = (v : 𝓜 → R) μ := rfl

/--
@isnad1 id=injectiv.0h3v.s10.c232d8f44943 from=translated src=- shape=d4665b6f vocab=ed2da4d0
-/
theorem pivotProj_injective : Function.Injective (pivotProj W) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro v hv
  by_contra hne
  have hv0 : (v : 𝓜 → R) ≠ 0 := fun h ↦ hne (Subtype.ext h)
  obtain ⟨μ, hμ, hlt⟩ := exists_leading hv0
  have hpiv : IsPivot W μ := ⟨v, v.2, hμ, hlt⟩
  exact hμ (congrFun hv ⟨μ, hpiv⟩)

omit [Finite 𝓜] in
/-- Vectors of `W` with distinct leading indices are linearly independent.
@isnad1 id=linearin.3h6v.s10.977cc13c1eba from=translated src=- shape=ecb9a686 vocab=2a264224
-/
theorem linearIndependent_of_leading {ι : Type*} (w : ι → W) (lead : ι → 𝓜)
    (hinj : Function.Injective lead) (hne : ∀ i, (w i : 𝓜 → R) (lead i) ≠ 0)
    (hlt : ∀ i ν, ν < lead i → (w i : 𝓜 → R) ν = 0) : LinearIndependent R w := by
  classical
  rw [linearIndependent_iff']
  intro s g hsum
  by_contra hex
  push Not at hex
  obtain ⟨i₀, hi₀s, hg₀⟩ := hex
  -- The element of `s` with nonzero coefficient and least leading index.
  let t : Finset ι := s.filter fun i ↦ g i ≠ 0
  have ht : t.Nonempty := ⟨i₀, by simp [t, hi₀s, hg₀]⟩
  obtain ⟨i, hit, hmin⟩ := t.exists_min_image lead ht
  have his : i ∈ s := (Finset.mem_filter.1 hit).1
  have hgi : g i ≠ 0 := (Finset.mem_filter.1 hit).2
  -- Evaluate the vanishing combination at the coordinate `lead i`.
  have heval := congrArg (fun v : W ↦ (v : 𝓜 → R) (lead i)) hsum
  simp only [Submodule.coe_sum, Submodule.coe_smul, Finset.sum_apply, Pi.smul_apply,
    smul_eq_mul, Submodule.coe_zero, Pi.zero_apply] at heval
  rw [Finset.sum_eq_single i] at heval
  · exact hgi (mul_eq_zero.1 heval |>.resolve_right (hne i))
  · intro j hjs hji
    by_cases hgj : g j = 0
    · simp [hgj]
    · have hjt : j ∈ t := Finset.mem_filter.2 ⟨hjs, hgj⟩
      have hle : lead i ≤ lead j := hmin j hjt
      have hlt' : lead i < lead j := lt_of_le_of_ne hle fun h ↦ hji (hinj h).symm
      rw [hlt j _ hlt', mul_zero]
  · intro h
    exact absurd his h

/-- Choice of a vector of `W` with leading index each pivot.-/
def pivotWitness (μ : Pivots W) : W :=
  ⟨Classical.choose μ.2, (Classical.choose_spec μ.2).1⟩

omit [Finite 𝓜] in
/--
@isnad1 id=ne.0h4v.s8.6000e37264af from=translated src=- shape=1511b176 vocab=51e89eb7
-/
theorem pivotWitness_ne_zero (μ : Pivots W) : (pivotWitness W μ : 𝓜 → R) μ ≠ 0 :=
  (Classical.choose_spec μ.2).2.1

omit [Finite 𝓜] in
/--
@isnad1 id=eq.1h5v.s8.95ffeae793c7 from=translated src=- shape=521ecfce vocab=8ac1d46b
-/
theorem pivotWitness_eq_zero_of_lt (μ : Pivots W) {ν : 𝓜} (hν : ν < μ) :
    (pivotWitness W μ : 𝓜 → R) ν = 0 :=
  (Classical.choose_spec μ.2).2.2 ν hν

/--
@isnad1 id=le.0h3v.s8.817b0f5b7a12 from=translated src=- shape=4a9ecb50 vocab=32507b02
-/
theorem card_pivots_le_finrank : Nat.card (Pivots W) ≤ finrank R W := by
  have := Fintype.ofFinite (Pivots W)
  rw [Nat.card_eq_fintype_card]
  refine LinearIndependent.fintype_card_le_finrank
    (linearIndependent_of_leading W (pivotWitness W) (fun μ ↦ (μ : 𝓜)) Subtype.val_injective
      (pivotWitness_ne_zero W) fun μ ν hν ↦ pivotWitness_eq_zero_of_lt W μ hν)

/--
@isnad1 id=le.0h3v.s8.57914f5ca310 from=translated src=- shape=cafa5aae vocab=32507b02
-/
theorem finrank_le_card_pivots : finrank R W ≤ Nat.card (Pivots W) := by
  have := Fintype.ofFinite (Pivots W)
  have h := LinearMap.finrank_le_finrank_of_injective (pivotProj_injective W)
  rwa [Module.finrank_fintype_fun_eq_card, ← Nat.card_eq_fintype_card] at h

/--
@isnad1 id=eq.0h3v.s8.eed04f059416 from=translated src=- shape=cafa5aae vocab=fe1945b0
-/
theorem finrank_eq_card_pivots : finrank R W = Nat.card (Pivots W) :=
  le_antisymm (finrank_le_card_pivots W) (card_pivots_le_finrank W)

/--
@isnad1 id=bijectiv.0h3v.s10.4ef3ab930af1 from=translated src=- shape=d4665b6f vocab=b23ddfc8
-/
theorem pivotProj_bijective : Function.Bijective (pivotProj W) := by
  classical
  have := Fintype.ofFinite (Pivots W)
  refine ⟨pivotProj_injective W, ?_⟩
  refine (LinearMap.injective_iff_surjective_of_finrank_eq_finrank ?_).1 (pivotProj_injective W)
  rw [finrank_eq_card_pivots, Module.finrank_fintype_fun_eq_card, Nat.card_eq_fintype_card]

/-- `lem:rref`: restriction to the pivot coordinates is a linear equivalence.-/
def pivotEquiv : W ≃ₗ[R] (Pivots W → R) :=
  LinearEquiv.ofBijective (pivotProj W) (pivotProj_bijective W)

/--
@isnad1 id=eq.0h5v.s11.7871f263c73b from=translated src=- shape=f6012816 vocab=6b8e08fe
-/
@[simp]
theorem pivotEquiv_apply (v : W) (μ : Pivots W) : pivotEquiv W v μ = (v : 𝓜 → R) μ := rfl

/-! ### The reduced row echelon basis -/

/-- The reduced row echelon basis of `W`: the vector of `W` with coordinate `1` at the pivot
`μ` and `0` at all other pivots.-/
def rref (μ : Pivots W) : 𝓜 → R :=
  ((pivotEquiv W).symm (Pi.single μ 1) : W)

/--
@isnad1 id=mem.0h4v.s8.b72a6a59b1ae from=translated src=- shape=69b09ac1 vocab=277801f1
-/
theorem rref_mem (μ : Pivots W) : rref W μ ∈ W :=
  ((pivotEquiv W).symm (Pi.single μ 1)).2

/--
@isnad1 id=eq.0h5v.s7.5317564fdf29 from=translated src=- shape=6ce12c95 vocab=61e4db99
-/
theorem rref_apply_pivot (μ ν : Pivots W) :
    rref W μ (ν : 𝓜) = if ν = μ then 1 else 0 := by
  classical
  have h := (pivotEquiv W).apply_symm_apply (Pi.single μ (1 : R))
  have h' := congrFun h ν
  rw [pivotEquiv_apply] at h'
  rw [rref, h', Pi.single_apply]

/--
@isnad1 id=eq.0h4v.s6.8d48345a9b2a from=translated src=- shape=dd4dbbe5 vocab=fab9b610
-/
theorem rref_apply_self (μ : Pivots W) : rref W μ (μ : 𝓜) = 1 := by
  rw [rref_apply_pivot]
  simp

/--
@isnad1 id=eq.1h5v.s7.acb3304f4508 from=translated src=- shape=e9b62fec vocab=fab9b610
-/
theorem rref_apply_of_ne {μ ν : Pivots W} (h : ν ≠ μ) : rref W μ (ν : 𝓜) = 0 := by
  rw [rref_apply_pivot]
  simp [h]

/-- Uniqueness: a family of vectors of `W` with the pivot coordinates of the standard basis
is the reduced row echelon basis.
@isnad1 id=eq.2h4v.s8.136241a9555b from=translated src=- shape=a08a058f vocab=524a5a6d
-/
theorem rref_eq_of_pivot_coords {w : Pivots W → (𝓜 → R)} (hw : ∀ μ, w μ ∈ W)
    (hcoord : ∀ μ ν : Pivots W, w μ (ν : 𝓜) = if ν = μ then 1 else 0) :
    w = rref W := by
  classical
  funext μ
  have h : pivotProj W ⟨w μ, hw μ⟩ = pivotProj W ⟨rref W μ, rref_mem W μ⟩ := by
    funext ν
    change w μ ν = rref W μ ν
    rw [hcoord, rref_apply_pivot]
  exact congrArg Subtype.val (pivotProj_injective W h)

/-- The leading index of `rref W μ` is `μ`.
@isnad1 id=eq.1h5v.s7.a1be9040e492 from=translated src=- shape=c3c67db3 vocab=b9278344
-/
theorem rref_apply_of_lt (μ : Pivots W) {ν : 𝓜} (hν : ν < μ) : rref W μ ν = 0 := by
  by_contra hne
  obtain ⟨ℓ, hℓ, hlt⟩ := exists_leading (v := rref W μ) fun h ↦ hne (by rw [h]; rfl)
  have hpiv : IsPivot W ℓ := ⟨rref W μ, rref_mem W μ, hℓ, hlt⟩
  have hℓμ : (⟨ℓ, hpiv⟩ : Pivots W) = μ := by
    by_contra h
    exact hℓ (rref_apply_of_ne W h)
  have hℓ' : ℓ = μ := congrArg Subtype.val hℓμ
  have : ν < ℓ := hℓ' ▸ hν
  exact hne (hlt ν this)

/-- The reduced row echelon basis spans `W`.
@isnad1 id=eq.0h3v.s7.24fd278d6f46 from=translated src=- shape=418fae1d vocab=2ac569f0
-/
theorem span_range_rref : Submodule.span R (range (rref W)) = W := by
  classical
  refine le_antisymm (Submodule.span_le.2 (range_subset_iff.2 (rref_mem W))) ?_
  intro v hv
  have := Fintype.ofFinite (Pivots W)
  set c : Pivots W → R := pivotEquiv W ⟨v, hv⟩ with hc
  have hrepr : (⟨v, hv⟩ : W) = ∑ μ : Pivots W, c μ • (pivotEquiv W).symm (Pi.single μ 1) := by
    have h0 : (⟨v, hv⟩ : W) = (pivotEquiv W).symm (∑ μ, Pi.single μ (c μ)) := by
      rw [Finset.univ_sum_single, hc, LinearEquiv.symm_apply_apply]
    rw [h0, map_sum]
    refine Finset.sum_congr rfl fun μ _ ↦ ?_
    rw [← map_smul, ← Pi.single_smul, smul_eq_mul, mul_one]
  have hcoe : v = ∑ μ : Pivots W, c μ • rref W μ := by
    have := congrArg Subtype.val hrepr
    simpa [rref] using this
  rw [hcoe]
  exact Submodule.sum_mem _ fun μ _ ↦
    Submodule.smul_mem _ _ (Submodule.subset_span ⟨μ, rfl⟩)

/-- The canonical subspace basis satisfies Mathlib's reduced-row-echelon predicate.
@isnad1 id=isreduce.0h3v.s7.476b524d39db from=translated src=- shape=390640dd vocab=820070a0
-/
theorem rref_isReducedRowEchelon :
    Matrix.IsReducedRowEchelon (rref W : Matrix (Pivots W) 𝓜 R) := by
  refine ⟨?_, ?_, ?_⟩
  · intro μ ν hμν j hj
    by_cases hjν : j < (ν : 𝓜)
    · exact rref_apply_of_lt W ν hjν
    · have hμj : (μ : 𝓜) < j := lt_of_lt_of_le hμν (le_of_not_gt hjν)
      have h := hj μ hμj
      rw [rref_apply_self] at h
      exact (one_ne_zero h).elim
  · intro μ c hc
    have hμ : Matrix.IsLeadingEntry (rref W) μ (μ : 𝓜) :=
      ⟨fun j hj ↦ rref_apply_of_lt W μ hj, by rw [rref_apply_self]; exact one_ne_zero⟩
    rw [hc.unique hμ]
    exact rref_apply_self W μ
  · intro μ ν c hμν hc
    have hν : Matrix.IsLeadingEntry (rref W) ν (ν : 𝓜) :=
      ⟨fun j hj ↦ rref_apply_of_lt W ν hj, by rw [rref_apply_self]; exact one_ne_zero⟩
    rw [hc.unique hν]
    exact rref_apply_of_ne W hμν.ne'

/-- `lem:rref`: every ordered basis in reduced row echelon form is the
canonical basis, under the increasing bijection with the pivot indices.-/
theorem eq_rref_of_basis_isReducedRowEchelon {α : Type*} [Finite α] [LinearOrder α]
    (B : Basis α R W)
    (hB : Matrix.IsReducedRowEchelon (fun i ↦ (B i : 𝓜 → R))) :
    ∃ e : α ≃ Pivots W, StrictMono e ∧ ∀ i, (B i : 𝓜 → R) = rref W (e i) := by
  classical
  have := Fintype.ofFinite α
  have := Fintype.ofFinite (Pivots W)
  have hne (i : α) : (B i : 𝓜 → R) ≠ 0 := fun h ↦ B.ne_zero i (Subtype.ext h)
  choose lead hlead using fun i ↦ exists_leading (hne i)
  have hm : StrictMono lead := by
    intro i j hij
    by_contra h
    have hle : lead j ≤ lead i := le_of_not_gt h
    exact (hlead j).1 (hB.isRowEchelon hij fun q hq ↦
      (hlead i).2 q (lt_of_lt_of_le hq hle))
  let f : α → Pivots W := fun i ↦ ⟨lead i, B i, (B i).2, hlead i⟩
  have hfm : StrictMono f := fun _ _ hij ↦ hm hij
  have hcard : Fintype.card α = Fintype.card (Pivots W) := by
    calc
      _ = finrank R W := (Module.finrank_eq_card_basis B).symm
      _ = Nat.card (Pivots W) := finrank_eq_card_pivots W
      _ = _ := Nat.card_eq_fintype_card
  have hbij : Function.Bijective f :=
    (Fintype.bijective_iff_injective_and_card f).2 ⟨hfm.injective, hcard⟩
  let e : α ≃ Pivots W := Equiv.ofBijective f hbij
  have he (μ : Pivots W) : lead (e.symm μ) = (μ : 𝓜) :=
    congrArg Subtype.val (e.apply_symm_apply μ)
  have heq : (fun μ : Pivots W ↦ (B (e.symm μ) : 𝓜 → R)) = rref W := by
    refine rref_eq_of_pivot_coords W (fun μ ↦ (B (e.symm μ)).2) ?_
    intro μ ν
    have hlead' : Matrix.IsLeadingEntry (fun i ↦ (B i : 𝓜 → R)) (e.symm ν) (ν : 𝓜) := by
      rw [← he ν]
      exact ⟨(hlead (e.symm ν)).2, (hlead (e.symm ν)).1⟩
    split_ifs with h
    · subst ν
      exact hB.eq_one hlead'
    · exact hB.eq_zero_of_ne_of_isLeadingEntry
        (fun h' ↦ h (e.symm.injective h').symm) hlead'
  refine ⟨e, hfm, fun i ↦ ?_⟩
  simpa using congrFun heq (e i)

/-! ### Fields of definition -/

/-- The coordinates of the reduced row echelon basis.-/
def fodSet : Set R := range fun p : Pivots W × 𝓜 ↦ rref W p.1 p.2

/-- The *field of definition* of `W`: the subfield generated by the coordinates of its
reduced row echelon basis.-/
def fod : Subfield R := Subfield.closure (fodSet W)

/--
@isnad1 id=mem.0h5v.s6.0df107b8ff09 from=translated src=- shape=7556a97c vocab=d0a89d22
-/
theorem rref_apply_mem_fod (μ : Pivots W) (ν : 𝓜) : rref W μ ν ∈ fod W :=
  Subfield.subset_closure ⟨(μ, ν), rfl⟩

/-- The smallest field of definition has a finite set of field generators.
@isnad1 id=ex.0h3v.s6.3f1209b48065 from=translated src=- shape=dbf6e081 vocab=34197b39
-/
theorem exists_finset_closure_eq_fod :
    ∃ s : Finset R, Subfield.closure (s : Set R) = fod W := by
  classical
  have hs : (fodSet W).Finite := Set.finite_range _
  exact ⟨hs.toFinset, by rw [Set.Finite.coe_toFinset]; rfl⟩

/-- `W` is *defined over* the subfield `F` if it is spanned by its `F`-valued vectors.-/
def DefinedOver (F : Subfield R) : Prop :=
  W = Submodule.span R {v : 𝓜 → R | v ∈ W ∧ ∀ ν, v ν ∈ F}

variable {W}

/--
@isnad1 id=definedo.1h4v.s6.b3dc1941781e from=translated src=- shape=cddae68b vocab=7896db9c
-/
theorem DefinedOver.of_fod_le {F : Subfield R} (h : fod W ≤ F) : DefinedOver W F := by
  refine le_antisymm ?_ (Submodule.span_le.2 fun v hv ↦ hv.1)
  conv_lhs => rw [← span_range_rref W]
  refine Submodule.span_mono ?_
  rintro _ ⟨μ, rfl⟩
  exact ⟨rref_mem W μ, fun ν ↦ h (rref_apply_mem_fod W μ ν)⟩

section Restrict

variable (F : Subfield R)

/-- The `F`-linear inclusion of `F`-valued vectors.-/
def coeVec : (𝓜 → F) →ₗ[F] (𝓜 → R) :=
  LinearMap.pi fun ν ↦ (Algebra.linearMap F R).comp (LinearMap.proj ν)

omit [Finite 𝓜] [LinearOrder 𝓜] in
/--
@isnad1 id=eq.0h5v.s10.36fa51915675 from=translated src=- shape=de8995af vocab=6554280f
-/
@[simp]
theorem coeVec_apply (u : 𝓜 → F) (ν : 𝓜) : coeVec F u ν = (u ν : R) := rfl

omit [Finite 𝓜] [LinearOrder 𝓜] in
/--
@isnad1 id=injectiv.0h3v.s10.5b3b5f550ff3 from=translated src=- shape=d5d57462 vocab=befc620b
-/
theorem coeVec_injective : Function.Injective (coeVec (𝓜 := 𝓜) F) := by
  intro u u' h
  funext ν
  exact Subtype.ext (congrFun h ν)

end Restrict

/-- `lem:fod-subspace`: if `W` is spanned by its `F`-valued vectors then its reduced row
echelon basis is `F`-valued.
@isnad1 id=le.1h4v.s6.b2af28a0fd3f from=translated src=- shape=db2c0249 vocab=7896db9c
-/
theorem DefinedOver.fod_le {F : Subfield R} (h : DefinedOver W F) : fod W ≤ F := by
  classical
  -- The `F`-subspace of `F`-valued vectors of `W`.
  let U : Submodule F (𝓜 → F) := (W.restrictScalars F).comap (coeVec F)
  have hUW : ∀ u ∈ U, coeVec F u ∈ W := fun u hu ↦ hu
  -- `W` is spanned by the image of `U`.
  have hspan : W = Submodule.span R (coeVec F '' (U : Set (𝓜 → F))) := by
    have hset : {v : 𝓜 → R | v ∈ W ∧ ∀ ν, v ν ∈ F} = coeVec F '' (U : Set (𝓜 → F)) := by
      ext v
      constructor
      · rintro ⟨hvW, hvF⟩
        have hval : coeVec F (fun ν ↦ ⟨v ν, hvF ν⟩) = v := funext fun ν ↦ rfl
        refine ⟨fun ν ↦ ⟨v ν, hvF ν⟩, ?_, hval⟩
        change coeVec F _ ∈ W
        rw [hval]
        exact hvW
      · rintro ⟨u, hu, rfl⟩
        exact ⟨hUW u hu, fun ν ↦ (u ν).2⟩
    rw [← hset]
    exact h
  -- Pivots of `U` are pivots of `W`.
  have hpiv : ∀ μ, IsPivot U μ → IsPivot W μ := by
    rintro μ ⟨u, hu, huμ, hult⟩
    refine ⟨coeVec F u, hUW u hu, ?_, fun ν hν ↦ ?_⟩
    · rw [coeVec_apply]
      exact fun h ↦ huμ (Subtype.ext h)
    · rw [coeVec_apply, hult ν hν]
      rfl
  -- `W` is spanned by the images of the reduced basis of `U`, so the pivot counts agree.
  have hspan' : W ≤ Submodule.span R (range fun μ : Pivots U ↦ coeVec F (rref U μ)) := by
    rw [hspan]
    refine Submodule.span_le.2 ?_
    rintro _ ⟨u, hu, rfl⟩
    have hu' : u ∈ Submodule.span F (range (rref U)) := by
      rw [span_range_rref]; exact hu
    have hmap := Submodule.mem_map_of_mem (f := coeVec F) hu'
    rw [Submodule.map_span, ← range_comp] at hmap
    have hle : Submodule.span F (range (coeVec F ∘ rref U)) ≤
        (Submodule.span R (range fun μ : Pivots U ↦ coeVec F (rref U μ))).restrictScalars F :=
      Submodule.span_le.2 fun _ ⟨μ, hμ⟩ ↦ Submodule.subset_span ⟨μ, hμ⟩
    exact hle hmap
  have hfU := Fintype.ofFinite (Pivots U)
  have hfW := Fintype.ofFinite (Pivots W)
  have hcard : Fintype.card (Pivots W) ≤ Fintype.card (Pivots U) := by
    rw [← Nat.card_eq_fintype_card, ← finrank_eq_card_pivots W]
    refine (Submodule.finrank_mono hspan').trans ?_
    refine (finrank_span_le_card _).trans ?_
    simpa using
      Finset.card_image_le (s := Finset.univ) (f := fun μ : Pivots U ↦ coeVec F (rref U μ))
  -- Hence every pivot of `W` is a pivot of `U`.
  have hpiv' : ∀ μ, IsPivot W μ → IsPivot U μ := by
    by_contra hex
    push Not at hex
    obtain ⟨μ₀, hμ₀W, hμ₀U⟩ := hex
    have hinj : Function.Injective fun μ : Pivots U ↦ (⟨μ.1, hpiv μ.1 μ.2⟩ : Pivots W) :=
      fun μ μ' h ↦ Subtype.ext (by simpa using congrArg Subtype.val h)
    have hlt : Fintype.card (Pivots U) < Fintype.card (Pivots W) :=
      Fintype.card_lt_of_injective_of_notMem _ hinj (b := ⟨μ₀, hμ₀W⟩) fun ⟨μ, hμ⟩ ↦ by
        have h : (μ : 𝓜) = μ₀ := by simpa using congrArg Subtype.val hμ
        exact hμ₀U (h ▸ μ.2)
    exact absurd hcard (not_le.2 hlt)
  -- The reduced basis of `W` is the image of that of `U`.
  let w : Pivots W → (𝓜 → R) := fun μ ↦ coeVec F (rref U ⟨μ.1, hpiv' μ.1 μ.2⟩)
  have hw : w = rref W := by
    refine rref_eq_of_pivot_coords W (fun μ ↦ hUW _ (rref_mem U _)) fun μ ν ↦ ?_
    simp only [w, coeVec_apply]
    rw [rref_apply_pivot U ⟨μ.1, hpiv' μ.1 μ.2⟩ ⟨ν.1, hpiv' ν.1 ν.2⟩]
    by_cases hνμ : ν = μ
    · subst hνμ
      simp
    · have : (⟨ν.1, hpiv' ν.1 ν.2⟩ : Pivots U) ≠ ⟨μ.1, hpiv' μ.1 μ.2⟩ :=
        fun h ↦ hνμ (Subtype.ext (by simpa using congrArg Subtype.val h))
      simp [hνμ, this]
  refine Subfield.closure_le.2 ?_
  rintro _ ⟨⟨μ, ν⟩, rfl⟩
  rw [← hw]
  exact (rref U ⟨μ.1, hpiv' μ.1 μ.2⟩ ν).2

/-- `lem:fod-subspace`: `W` is defined over `F` iff its field of definition lies in `F`.
@isnad1 id=iff.0h4v.s6.b924ee484699 from=translated src=- shape=7ad05c18 vocab=7896db9c
-/
theorem definedOver_iff {F : Subfield R} : DefinedOver W F ↔ fod W ≤ F :=
  ⟨DefinedOver.fod_le, DefinedOver.of_fod_le⟩

/-! ### Equivariance -/

section Equivariance

variable (W) (σ : R ≃+* R)

/-- Coordinatewise action of a field automorphism on vectors, as a semilinear map.-/
def mapVec : (𝓜 → R) →ₛₗ[(σ : R →+* R)] (𝓜 → R) where
  toFun v := fun ν ↦ σ (v ν)
  map_add' v w := by
    funext ν
    simp
  map_smul' c v := by
    funext ν
    simp

omit [Finite 𝓜] [LinearOrder 𝓜] in
/--
@isnad1 id=eq.0h5v.s9.dac395181bc7 from=translated src=- shape=e275c765 vocab=38b8cd29
-/
@[simp]
theorem mapVec_apply (v : 𝓜 → R) (ν : 𝓜) : mapVec σ v ν = σ (v ν) := rfl

omit [Finite 𝓜] in
/--
@isnad1 id=iff.0h5v.s8.dbe78a17991d from=translated src=- shape=ff218dd6 vocab=2299a376
-/
theorem isPivot_map_iff (μ : 𝓜) : IsPivot (W.map (mapVec σ)) μ ↔ IsPivot W μ := by
  constructor
  · rintro ⟨_, ⟨v, hv, rfl⟩, hμ, hlt⟩
    refine ⟨v, hv, fun h ↦ hμ (by simp [h]), fun ν hν ↦ ?_⟩
    have := hlt ν hν
    rw [mapVec_apply] at this
    exact (map_eq_zero_iff σ σ.injective).1 this
  · rintro ⟨v, hv, hμ, hlt⟩
    exact ⟨mapVec σ v, Submodule.mem_map_of_mem hv, by simp [hμ], fun ν hν ↦ by simp [hlt ν hν]⟩

/-- The pivots of the image subspace, transported.-/
def pivotsMapEquiv : Pivots (W.map (mapVec σ)) ≃ Pivots W :=
  Equiv.subtypeEquivRight (isPivot_map_iff W σ)

/--
@isnad1 id=eq.0h5v.s11.63d26e0d1bf5 from=translated src=- shape=b6c186c6 vocab=5fe7e4ee
-/
theorem rref_map (μ : Pivots (W.map (mapVec σ))) :
    rref (W.map (mapVec σ)) μ = mapVec σ (rref W (pivotsMapEquiv W σ μ)) := by
  classical
  have key : (fun μ' : Pivots (W.map (mapVec σ)) ↦ mapVec σ (rref W (pivotsMapEquiv W σ μ'))) =
      rref (W.map (mapVec σ)) := by
    refine rref_eq_of_pivot_coords _ (fun μ' ↦ Submodule.mem_map_of_mem (rref_mem W _)) ?_
    intro μ' ν'
    rw [mapVec_apply]
    have : (ν' : 𝓜) = ((pivotsMapEquiv W σ ν' : Pivots W) : 𝓜) := rfl
    rw [this, rref_apply_pivot]
    by_cases h : ν' = μ'
    · subst h
      simp
    · have h' : pivotsMapEquiv W σ ν' ≠ pivotsMapEquiv W σ μ' :=
        fun h'' ↦ h ((pivotsMapEquiv W σ).injective h'')
      simp [h, h']
  exact (congrFun key μ).symm

/--
@isnad1 id=eq.0h4v.s9.b7f45d7b0f12 from=translated src=- shape=597f047a vocab=e1159ea0
-/
theorem fodSet_map : fodSet (W.map (mapVec σ)) = σ '' fodSet W := by
  ext x
  constructor
  · rintro ⟨⟨μ, ν⟩, rfl⟩
    refine ⟨rref W (pivotsMapEquiv W σ μ) ν, ⟨(pivotsMapEquiv W σ μ, ν), rfl⟩, ?_⟩
    dsimp only
    rw [rref_map]
    rfl
  · rintro ⟨_, ⟨⟨μ, ν⟩, rfl⟩, rfl⟩
    refine ⟨((pivotsMapEquiv W σ).symm μ, ν), ?_⟩
    simp only [rref_map, mapVec_apply, Equiv.apply_symm_apply]

/-- The field of definition of the image subspace is the image of the field of definition.
@isnad1 id=eq.0h4v.s8.7917a1a0777a from=translated src=- shape=9aadacb9 vocab=52ba0ec9
-/
theorem fod_map : fod (W.map (mapVec σ)) = (fod W).map σ.toRingHom := by
  unfold fod
  rw [fodSet_map]
  refine le_antisymm ?_ ?_
  · refine Subfield.closure_le.2 ?_
    rintro _ ⟨x, hx, rfl⟩
    exact ⟨x, Subfield.subset_closure hx, rfl⟩
  · rw [Subfield.map_le_iff_le_comap]
    refine Subfield.closure_le.2 fun x hx ↦ ?_
    change σ x ∈ Subfield.closure (σ '' fodSet W)
    exact Subfield.subset_closure ⟨x, hx, rfl⟩

/-- A field automorphism fixes `W` iff it fixes its field of definition pointwise.
@isnad1 id=iff.0h4v.s9.9adc5514c42e from=translated src=- shape=9c0cad13 vocab=d6021f61
-/
theorem map_eq_self_iff : W.map (mapVec σ) = W ↔ ∀ x ∈ fod W, σ x = x := by
  constructor
  · intro hW x hx
    have key : (fun μ' : Pivots W ↦ mapVec σ (rref W μ')) = rref W := by
      refine rref_eq_of_pivot_coords W (fun μ' ↦ ?_) fun μ' ν ↦ ?_
      · have hmem : mapVec σ (rref W μ') ∈ W.map (mapVec σ) :=
          Submodule.mem_map_of_mem (rref_mem W μ')
        rwa [hW] at hmem
      rw [mapVec_apply, rref_apply_pivot]
      split_ifs <;> simp
    have hsub : fodSet W ⊆ RingHom.eqLocusField σ.toRingHom (RingHom.id R) := by
      rintro _ ⟨⟨μ, ν⟩, rfl⟩
      change σ.toRingHom (rref W μ ν) = RingHom.id R (rref W μ ν)
      exact congrFun (congrFun key μ) ν
    exact (Subfield.closure_le.2 hsub) hx
  · intro hfix
    have hrref : ∀ μ, mapVec σ (rref W μ) = rref W μ := fun μ ↦
      funext fun ν ↦ hfix _ (rref_apply_mem_fod W μ ν)
    have h1 : W.map (mapVec σ) = Submodule.span R (mapVec σ '' range (rref W)) := by
      conv_lhs => rw [← span_range_rref W]
      exact Submodule.map_span _ _
    rw [h1, ← range_comp]
    have h2 : (mapVec σ ∘ rref W) = rref W := funext hrref
    rw [h2, span_range_rref]

end Equivariance

end

