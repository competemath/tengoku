import Tengoku.Seed.FieldTheory.KummerPolynomial
import Tengoku.Seed.FieldTheory.Relrank
import Tengoku.Seed.Algebra.CharP.Frobenius
import Tengoku.Seed.Algebra.Polynomial.Expand

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Frobenius twists of fields of one variable

Let `K` be a field of exponential characteristic `p` and let `C ⊆ K` be a set of coefficients.
For tuples `y` and `z` of `K`, write `C(y)` for the subfield generated by `C` and the
coordinates of `y`. We say that `z` has *Frobenius index* `δ ∈ ℤ` relative to `y`
(`IsFrobIndex`) if `C(z)^{p^m} = C(y)^{p^n}` for some `m n` with `n - m = δ`. When `C` is
perfect and `C(y)` is a function field of one variable over it, this index is unique, it is
additive along chains of tuples, and it exists as soon as each of `C(y)` and `C(z)` is
purely inseparable over a Frobenius twist of the other.

The main inputs are:

* `relfinrank_map_frobenius_eq`: if `x ∈ F` is transcendental over the perfect set `C` and
  `F` is finite over `C(x)`, then `[F : F^p] = p`;
* `exists_eq_map_iterateFrobenius`: if `[F : F^p] = p` with `p` prime, every subfield between
  `F^{p^n}` and `F` is one of the twists `F^{p^j}`.

They are used by `GroupConfig.Germ.HasFrobIndex`, whose consumer is the rationality of
Hrushovski–Weil germs on curves (`GroupConfig.Germ.IsHW.exists_rational_representative`).

This module is part of the formalization of the group configuration theorem
blueprint `sources/group_configuration_blueprint.tex`.

**Status:** complete for its consumer `GroupConfig.Germ.HasFrobIndex`.
-/

namespace GroupConfig

open Polynomial Set

noncomputable section

variable {K : Type*} [Field K] (p : ℕ) [ExpChar K p] {ι κ μ : Type*}

/-! ### Frobenius images of subfields -/

private theorem map_iterateFrobenius_map (S : Subfield K) (a b : ℕ) :
    (S.map (iterateFrobenius K p a)).map (iterateFrobenius K p b) =
      S.map (iterateFrobenius K p (b + a)) := by
  rw [Subfield.map_map, iterateFrobenius_add]

private theorem map_iterateFrobenius_zero (S : Subfield K) :
    S.map (iterateFrobenius K p 0) = S := by
  ext x
  simp [Subfield.mem_map]

private theorem map_iterateFrobenius_le (E : Subfield K) (n : ℕ) :
    E.map (iterateFrobenius K p n) ≤ E := by
  rintro _ ⟨x, hx, rfl⟩
  rw [iterateFrobenius_def]
  exact pow_mem hx _

private theorem map_iterateFrobenius_injective (n : ℕ) :
    Function.Injective fun S : Subfield K ↦ S.map (iterateFrobenius K p n) := by
  have key : ∀ {S T : Subfield K}, S.map (iterateFrobenius K p n) =
      T.map (iterateFrobenius K p n) → S ≤ T := by
    intro S T h x hx
    obtain ⟨w, hw, hwx⟩ : iterateFrobenius K p n x ∈ T.map (iterateFrobenius K p n) :=
      h ▸ ⟨x, hx, rfl⟩
    rwa [iterateFrobenius_inj K p n hwx] at hw
  exact fun S T h ↦ le_antisymm (key h) (key h.symm)

private theorem subset_closure_singleton {C : Set K} {x : K} :
    x ∈ Subfield.closure (C ∪ {x}) :=
  Subfield.subset_closure (mem_union_right _ (mem_singleton x))

/-- On a perfect set of coefficients, the Frobenius image of a generated subfield is generated
by the coefficients and the images of the generators.-/
private theorem map_closure_union {C : Set K} (hC : ∀ c ∈ C, ∃ w ∈ C, w ^ p = c) (n : ℕ)
    (S : Set K) :
    (Subfield.closure (C ∪ S)).map (iterateFrobenius K p n) =
      Subfield.closure (C ∪ iterateFrobenius K p n '' S) := by
  have hCn : ∀ c ∈ C, ∃ w ∈ C, iterateFrobenius K p n w = c := by
    induction n with
    | zero => exact fun c hc ↦ ⟨c, hc, iterateFrobenius_zero_apply K p c⟩
    | succ n ih =>
      intro c hc
      obtain ⟨w, hw, rfl⟩ := ih c hc
      obtain ⟨w', hw', rfl⟩ := hC w hw
      exact ⟨w', hw', by rw [iterateFrobenius_add_apply, iterateFrobenius_one_apply]⟩
  rw [RingHom.map_field_closure, image_union]
  refine le_antisymm (Subfield.closure_le.2 (union_subset ?_ ?_))
    (Subfield.closure_le.2 (union_subset ?_ ?_))
  · rintro _ ⟨c, hc, rfl⟩
    rw [iterateFrobenius_def]
    exact pow_mem (Subfield.subset_closure (mem_union_left _ hc)) _
  · exact fun x hx ↦ Subfield.subset_closure (mem_union_right _ hx)
  · intro c hc
    obtain ⟨w, hw, rfl⟩ := hCn c hc
    exact Subfield.subset_closure (Or.inl ⟨w, hw, rfl⟩)
  · exact fun x hx ↦ Subfield.subset_closure (mem_union_right _ hx)

/-- Ring endomorphisms commute with Frobenius twists of generated subfields.-/
private theorem map_closure_image (σ : K →+* K) (S : Set K) (j : ℕ) :
    (Subfield.closure (σ '' S)).map (iterateFrobenius K p j) =
      ((Subfield.closure S).map (iterateFrobenius K p j)).map σ := by
  have hcomm : (iterateFrobenius K p j).comp σ = σ.comp (iterateFrobenius K p j) :=
    RingHom.ext fun t ↦ by simp [iterateFrobenius_def]
  rw [← RingHom.map_field_closure, Subfield.map_map, Subfield.map_map, hcomm]

/-- A Frobenius twist of generators lying in a generated subfield bounds the twist of the
subfield they generate.-/
private theorem map_closure_le {C : Set K} {ν ν' : Type*} (w : ν → K) (w' : ν' → K) (j : ℕ)
    (hw : ∀ i, w i ^ p ^ j ∈ Subfield.closure (C ∪ range w')) :
    (Subfield.closure (C ∪ range w)).map (iterateFrobenius K p j) ≤
      Subfield.closure (C ∪ range w') := by
  rw [Subfield.map_le_iff_le_comap]
  refine Subfield.closure_le.2 (union_subset (fun c hc ↦ ?_) ?_)
  · rw [SetLike.mem_coe, Subfield.mem_comap, iterateFrobenius_def]
    exact pow_mem (Subfield.subset_closure (mem_union_left _ hc)) _
  · rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, Subfield.mem_comap, iterateFrobenius_def]
    exact hw i

/-! ### The degree of the Frobenius -/

omit [ExpChar K p] in
/-- A transcendental element is not a rational function of its `p`-th power.
@isnad1 id=not.2h5v.s7.4446e0bed40d from=translated src=- shape=3dda72a2 vocab=0f113b16
-/
theorem notMem_closure_pow_of_transcendental (hp : p.Prime) {k : Type*} [Field k] [Algebra k K]
    {N : IntermediateField k K} {x : K} (hx : Transcendental N x) :
    x ∉ Subfield.closure ((N : Set K) ∪ {x ^ p}) := by
  intro hmem
  have hmem' : x ∈ IntermediateField.adjoin N {x ^ p} := by
    rw [← IntermediateField.mem_toSubfield, IntermediateField.adjoin_toSubfield]
    refine Subfield.closure_mono (union_subset_union_left _ ?_) hmem
    intro c hc
    exact ⟨⟨c, hc⟩, rfl⟩
  obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff _ _).1 hmem'
  by_cases hs : aeval (x ^ p) s = 0
  · rw [hs, div_zero] at hrs
    exact hx (hrs ▸ isAlgebraic_zero)
  have h0 : aeval x (X * expand N p s - expand N p r) = 0 := by
    rw [map_sub, map_mul, aeval_X, expand_aeval, expand_aeval, (eq_div_iff hs).1 hrs, sub_self]
  have h1 := sub_eq_zero.1 (transcendental_iff.1 hx _ h0)
  have hs0 : s ≠ 0 := by
    rintro rfl
    simp at hs
  have hndvd : ¬p ∣ s.natDegree * p + 1 := fun hdvd ↦
    hp.one_lt.ne' (Nat.dvd_one.1 ((Nat.dvd_add_right (dvd_mul_left p _)).1 hdvd))
  have hcoeff : (X * expand N p s).coeff (s.natDegree * p + 1) =
      (expand N p r).coeff (s.natDegree * p + 1) := by rw [h1]
  rw [coeff_X_mul, coeff_expand_mul hp.pos, coeff_expand hp.pos] at hcoeff
  simp only [hndvd, ↓reduceIte] at hcoeff
  exact leadingCoeff_ne_zero.2 hs0 hcoeff

/-- Adjoining a `p`-th root to a field not containing it has degree `p`.-/
private theorem relfinrank_closure_pow_eq (hp : p.Prime) {C : Set K} {x : K}
    (hxp : x ∉ Subfield.closure (C ∪ {x ^ p})) :
    Subfield.relfinrank (Subfield.closure (C ∪ {x ^ p})) (Subfield.closure (C ∪ {x})) = p := by
  set A' := Subfield.closure (C ∪ {x ^ p})
  have hA'A : A' ≤ Subfield.closure (C ∪ {x}) :=
    Subfield.closure_le.2 (union_subset (fun c hc ↦ Subfield.subset_closure (mem_union_left _ hc))
      (singleton_subset_iff.2 (pow_mem subset_closure_singleton p)))
  have hxA' : x ^ p ∈ A' := subset_closure_singleton
  rw [Subfield.relfinrank_eq_finrank_of_le hA'A]
  have hE : Subfield.extendScalars hA'A = IntermediateField.adjoin A' {x} := by
    apply IntermediateField.toSubfield_injective
    rw [Subfield.extendScalars_toSubfield, IntermediateField.adjoin_toSubfield]
    refine le_antisymm (Subfield.closure_le.2 (union_subset ?_ ?_))
      (Subfield.closure_le.2 (union_subset ?_ ?_))
    · exact fun c hc ↦ Subfield.subset_closure
        (mem_union_left _ ⟨⟨c, Subfield.subset_closure (mem_union_left _ hc)⟩, rfl⟩)
    · exact fun _ hy ↦ Subfield.subset_closure (Or.inr hy)
    · rintro _ ⟨c, rfl⟩
      exact hA'A c.2
    · exact singleton_subset_iff.2 subset_closure_singleton
  have hirr : Irreducible (X ^ p - Polynomial.C (⟨x ^ p, hxA'⟩ : A')) := by
    refine X_pow_sub_C_irreducible_of_prime hp fun b hb ↦ hxp ?_
    have hb' : (b : K) ^ p = x ^ p := congrArg Subtype.val hb
    rw [← frobenius_def, ← frobenius_def] at hb'
    have hbx : (b : K) = x := frobenius_inj K p hb'
    exact hbx ▸ b.2
  have haeval : aeval x (X ^ p - Polynomial.C (⟨x ^ p, hxA'⟩ : A')) = 0 := by
    rw [map_sub, map_pow, aeval_X, aeval_C]
    exact sub_self (x ^ p)
  have hint : IsIntegral A' x :=
    ⟨X ^ p - Polynomial.C (⟨x ^ p, hxA'⟩ : A'), monic_X_pow_sub_C _ hp.ne_zero, by
      rw [← aeval_def, haeval]⟩
  rw [hE, IntermediateField.adjoin.finrank hint,
    ← minpoly.eq_of_irreducible_of_monic hirr haeval (monic_X_pow_sub_C _ hp.ne_zero),
    natDegree_X_pow_sub_C]

/-- `[F : F^p] = p` for a field `F` finite over `C(x)`, where `C` is perfect and `x` is not a
rational function of `x^p` over `C`.
@isnad1 id=eq.6h5v.s7.cde46485a76c from=translated src=- shape=2aa8738e vocab=091ac335
-/
theorem relfinrank_map_frobenius_eq (hp : p.Prime) {C : Set K}
    (hC : ∀ c ∈ C, ∃ w ∈ C, w ^ p = c) {F : Subfield K} {x : K} (hCF : C ⊆ F) (hxF : x ∈ F)
    (hxp : x ∉ Subfield.closure (C ∪ {x ^ p}))
    (hfin : Subfield.relfinrank (Subfield.closure (C ∪ {x})) F ≠ 0) :
    Subfield.relfinrank (F.map (frobenius K p)) F = p := by
  set A := Subfield.closure (C ∪ {x})
  set A' := Subfield.closure (C ∪ {x ^ p})
  have hAmap : A.map (frobenius K p) = A' := by
    have h := map_closure_union p hC 1 {x}
    rwa [iterateFrobenius_one, image_singleton, frobenius_def] at h
  have hA'A : A' ≤ A :=
    Subfield.closure_le.2 (union_subset (fun c hc ↦ Subfield.subset_closure (mem_union_left _ hc))
      (singleton_subset_iff.2 (pow_mem subset_closure_singleton p)))
  have hAF : A ≤ F := Subfield.closure_le.2 (union_subset hCF (singleton_subset_iff.2 hxF))
  have hFF : F.map (frobenius K p) ≤ F := by
    simpa using map_iterateFrobenius_le p F 1
  have hA'F : A' ≤ F.map (frobenius K p) := hAmap ▸ (Subfield.gc_map_comap _).monotone_l hAF
  have h1 := Subfield.relfinrank_mul_relfinrank hA'A hAF
  have h2 := Subfield.relfinrank_mul_relfinrank hA'F hFF
  have h3 : Subfield.relfinrank A' (F.map (frobenius K p)) = Subfield.relfinrank A F := by
    rw [← hAmap]
    exact Subfield.relfinrank_map_map A F _
  rw [relfinrank_closure_pow_eq p hp hxp, ← h2, h3] at h1
  exact (Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hfin) ((mul_comm _ _).trans h1)).symm

/-! ### Subfields between Frobenius twists -/

/-- If `[F : F^p] = p` with `p` prime, every subfield between `F^{p^n}` and `F` is a Frobenius
twist `F^{p^j}` with `j ≤ n`.
@isnad1 id=ex.4h5v.s7.db80b8260a17 from=translated src=- shape=c4b4ce99 vocab=7731c0af
-/
theorem exists_eq_map_iterateFrobenius (hp : p.Prime) {F : Subfield K}
    (hF : Subfield.relfinrank (F.map (frobenius K p)) F = p) {E : Subfield K} {n : ℕ}
    (h₁ : F.map (iterateFrobenius K p n) ≤ E) (h₂ : E ≤ F) :
    ∃ j ≤ n, E = F.map (iterateFrobenius K p j) := by
  induction n generalizing F with
  | zero =>
    refine ⟨0, le_rfl, ?_⟩
    rw [map_iterateFrobenius_zero] at h₁ ⊢
    exact le_antisymm h₂ h₁
  | succ n ih =>
    have hsucc : ∀ (S : Subfield K) (j : ℕ), (S.map (frobenius K p)).map
        (iterateFrobenius K p j) = S.map (iterateFrobenius K p (j + 1)) := fun S j ↦ by
      rw [← iterateFrobenius_one, map_iterateFrobenius_map]
    by_cases hE : E ≤ F.map (frobenius K p)
    · have hF' : Subfield.relfinrank ((F.map (frobenius K p)).map (frobenius K p))
          (F.map (frobenius K p)) = p := by
        rw [Subfield.relfinrank_map_map]
        exact hF
      obtain ⟨j, hj, rfl⟩ := ih hF' (by rwa [hsucc]) hE
      exact ⟨j + 1, by omega, hsucc F j⟩
    · have hFF : F.map (frobenius K p) ≤ F := by
        simpa using map_iterateFrobenius_le p F 1
      have hsup : F ≤ E ⊔ F.map (frobenius K p) := by
        have htower := Subfield.relfinrank_mul_relfinrank (le_sup_right (a := E))
          (sup_le h₂ hFF)
        rw [hF] at htower
        rcases (Nat.dvd_prime hp).1 (Dvd.intro _ htower) with h | h
        · exact absurd (le_sup_left.trans (Subfield.relfinrank_eq_one_iff.1 h)) hE
        · rw [h] at htower
          exact Subfield.relfinrank_eq_one_iff.1
            (Nat.eq_of_mul_eq_mul_left hp.pos (htower.trans (mul_one p).symm))
      have hall : ∀ m, F ≤ E ⊔ F.map (iterateFrobenius K p m) := by
        intro m
        induction m with
        | zero =>
          rw [map_iterateFrobenius_zero]
          exact le_sup_right
        | succ m ihm =>
          refine hsup.trans (sup_le le_sup_left ?_)
          calc F.map (frobenius K p)
              ≤ (E ⊔ F.map (iterateFrobenius K p m)).map (frobenius K p) :=
                (Subfield.gc_map_comap _).monotone_l ihm
            _ = E.map (frobenius K p) ⊔ (F.map (iterateFrobenius K p m)).map (frobenius K p) :=
                Subfield.map_sup _ _ _
            _ ≤ E ⊔ F.map (iterateFrobenius K p (m + 1)) := by
              refine sup_le_sup (by simpa using map_iterateFrobenius_le p E 1) (le_of_eq ?_)
              rw [← iterateFrobenius_one, map_iterateFrobenius_map, add_comm]
      refine ⟨0, Nat.zero_le _, ?_⟩
      rw [map_iterateFrobenius_zero]
      exact le_antisymm h₂ ((hall (n + 1)).trans (sup_le le_rfl h₁))

/-- If `[F : F^p] = p` with `p` prime, distinct Frobenius twists of `F` are distinct.-/
theorem eq_of_map_iterateFrobenius_eq (hp : p.Prime) {F : Subfield K}
    (hF : Subfield.relfinrank (F.map (frobenius K p)) F = p) {a b : ℕ}
    (h : F.map (iterateFrobenius K p a) = F.map (iterateFrobenius K p b)) : a = b := by
  wlog hab : a ≤ b generalizing a b
  · exact (this h.symm (le_of_not_ge hab)).symm
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hab
  rcases Nat.eq_zero_or_pos d with rfl | hd
  · rfl
  exfalso
  have hFd : F = F.map (iterateFrobenius K p d) := by
    apply map_iterateFrobenius_injective p a
    simp only
    rw [h, map_iterateFrobenius_map]
  obtain ⟨d', rfl⟩ := Nat.exists_eq_add_of_lt hd
  rw [zero_add] at hFd
  have hle : F ≤ F.map (frobenius K p) := by
    calc F = F.map (iterateFrobenius K p (d' + 1)) := hFd
      _ = (F.map (iterateFrobenius K p d')).map (frobenius K p) := by
        rw [← iterateFrobenius_one, map_iterateFrobenius_map, add_comm]
      _ ≤ F.map (frobenius K p) :=
        (Subfield.gc_map_comap _).monotone_l (map_iterateFrobenius_le p F _)
  have h1 := Subfield.relfinrank_eq_one_iff.2 hle
  rw [hF] at h1
  exact hp.one_lt.ne' h1

/-! ### The Frobenius index -/

/-- `IsFrobIndex p C y z δ`: over the coefficients `C`, the field generated by `z` is the
`p^δ`-th Frobenius twist of the field generated by `y`, that is
`C(z)^{p^m} = C(y)^{p^n}` for some `m n` with `n - m = δ`.-/
def IsFrobIndex (C : Set K) (y : ι → K) (z : κ → K) (δ : ℤ) : Prop :=
  ∃ m n : ℕ, (n : ℤ) - m = δ ∧
    (Subfield.closure (C ∪ range z)).map (iterateFrobenius K p m) =
      (Subfield.closure (C ∪ range y)).map (iterateFrobenius K p n)

variable {p} {C : Set K} {y : ι → K} {z : κ → K} {x : μ → K} {δ δ' : ℤ}

/-- The Frobenius index is unchanged by enlarging a perfect set of coefficients.
@isnad1 id=isfrobin.3h9v.s6.b7c7ac6369dc from=translated src=- shape=6d0ae37b vocab=7f6c3862
-/
theorem IsFrobIndex.mono {C' : Set K} (hCC' : C ⊆ C') (hC' : ∀ c ∈ C', ∃ w ∈ C', w ^ p = c)
    (h : IsFrobIndex p C y z δ) : IsFrobIndex p C' y z δ := by
  obtain ⟨m, n, hδ, h⟩ := h
  refine ⟨m, n, hδ, ?_⟩
  have key : ∀ (S : Set K) (j : ℕ), (Subfield.closure (C' ∪ S)).map (iterateFrobenius K p j) =
      Subfield.closure C' ⊔ (Subfield.closure (C ∪ S)).map (iterateFrobenius K p j) := by
    intro S j
    have hsplit : Subfield.closure (C' ∪ S) = Subfield.closure C' ⊔ Subfield.closure (C ∪ S) :=
      le_antisymm (Subfield.closure_le.2 (union_subset
          (fun c hc ↦ le_sup_left (a := Subfield.closure C') (Subfield.subset_closure hc))
          (fun s hs ↦ le_sup_right (b := Subfield.closure (C ∪ S))
            (Subfield.subset_closure (mem_union_right _ hs)))))
        (sup_le (Subfield.closure_mono subset_union_left)
          (Subfield.closure_mono (union_subset_union_left _ hCC')))
    have hC'j : (Subfield.closure C').map (iterateFrobenius K p j) = Subfield.closure C' := by
      simpa using map_closure_union p hC' j ∅
    rw [hsplit, Subfield.map_sup, hC'j]
  rw [key, key, h]

/-- The Frobenius index is additive along chains of tuples.
@isnad1 id=isfrobin.2h11v.s6.275945fffb55 from=translated src=- shape=49ab24bc vocab=283b6d00
-/
theorem IsFrobIndex.trans (h₁ : IsFrobIndex p C y z δ) (h₂ : IsFrobIndex p C z x δ') :
    IsFrobIndex p C y x (δ + δ') := by
  obtain ⟨m, n, rfl, h₁⟩ := h₁
  obtain ⟨m', n', rfl, h₂⟩ := h₂
  refine ⟨m + m', n' + n, by push_cast; ring, ?_⟩
  calc (Subfield.closure (C ∪ range x)).map (iterateFrobenius K p (m + m'))
      = ((Subfield.closure (C ∪ range x)).map (iterateFrobenius K p m')).map
          (iterateFrobenius K p m) := (map_iterateFrobenius_map p _ _ _).symm
    _ = ((Subfield.closure (C ∪ range z)).map (iterateFrobenius K p n')).map
          (iterateFrobenius K p m) := by rw [h₂]
    _ = ((Subfield.closure (C ∪ range z)).map (iterateFrobenius K p m)).map
          (iterateFrobenius K p n') := by rw [map_iterateFrobenius_map, map_iterateFrobenius_map,
            add_comm]
    _ = ((Subfield.closure (C ∪ range y)).map (iterateFrobenius K p n)).map
          (iterateFrobenius K p n') := by rw [h₁]
    _ = (Subfield.closure (C ∪ range y)).map (iterateFrobenius K p (n' + n)) :=
      map_iterateFrobenius_map p _ _ _

/-- The Frobenius index is transported by ring endomorphisms.
@isnad1 id=isfrobin.1h9v.s7.ebb28ed538d2 from=translated src=- shape=6210007a vocab=02a1714b
-/
theorem IsFrobIndex.map (σ : K →+* K) (h : IsFrobIndex p C y z δ) :
    IsFrobIndex p (σ '' C) (σ ∘ y) (σ ∘ z) δ := by
  obtain ⟨m, n, hδ, h⟩ := h
  refine ⟨m, n, hδ, ?_⟩
  have hz : σ '' C ∪ range (σ ∘ z) = σ '' (C ∪ range z) := by rw [range_comp, image_union]
  have hy : σ '' C ∪ range (σ ∘ y) = σ '' (C ∪ range y) := by rw [range_comp, image_union]
  rw [hz, hy, map_closure_image, map_closure_image, h]

/-- With `[C(y) : C(y)^p] = p`, the Frobenius index is unique.
@isnad1 id=eq.4h9v.s6.85eefe5b7115 from=translated src=- shape=5fb76136 vocab=06b7fbc6
-/
theorem IsFrobIndex.unique (hp : p.Prime)
    (hF : Subfield.relfinrank ((Subfield.closure (C ∪ range y)).map (frobenius K p))
      (Subfield.closure (C ∪ range y)) = p)
    (h : IsFrobIndex p C y z δ) (h' : IsFrobIndex p C y z δ') : δ = δ' := by
  obtain ⟨m, n, rfl, h⟩ := h
  obtain ⟨m', n', rfl, h'⟩ := h'
  have heq : (Subfield.closure (C ∪ range y)).map (iterateFrobenius K p (m' + n)) =
      (Subfield.closure (C ∪ range y)).map (iterateFrobenius K p (m + n')) :=
    calc (Subfield.closure (C ∪ range y)).map (iterateFrobenius K p (m' + n))
        = ((Subfield.closure (C ∪ range y)).map (iterateFrobenius K p n)).map
            (iterateFrobenius K p m') := (map_iterateFrobenius_map p _ _ _).symm
      _ = ((Subfield.closure (C ∪ range z)).map (iterateFrobenius K p m)).map
            (iterateFrobenius K p m') := by rw [h]
      _ = ((Subfield.closure (C ∪ range z)).map (iterateFrobenius K p m')).map
            (iterateFrobenius K p m) := by rw [map_iterateFrobenius_map,
              map_iterateFrobenius_map, add_comm]
      _ = ((Subfield.closure (C ∪ range y)).map (iterateFrobenius K p n')).map
            (iterateFrobenius K p m) := by rw [h']
      _ = (Subfield.closure (C ∪ range y)).map (iterateFrobenius K p (m + n')) :=
        map_iterateFrobenius_map p _ _ _
  have := eq_of_map_iterateFrobenius_eq p hp hF heq
  omega

/-- If `[C(y) : C(y)^p] = p` and each of `C(y)`, `C(z)` contains a Frobenius twist of the
generators of the other, then `z` has a Frobenius index relative to `y`.
@isnad1 id=ex.4h9v.s8.084dbf33d9eb from=translated src=- shape=1b45f64b vocab=bd4bc779
-/
theorem IsFrobIndex.exists (hp : p.Prime)
    (hF : Subfield.relfinrank ((Subfield.closure (C ∪ range y)).map (frobenius K p))
      (Subfield.closure (C ∪ range y)) = p) {m n : ℕ}
    (hz : ∀ j, z j ^ p ^ m ∈ Subfield.closure (C ∪ range y))
    (hy : ∀ i, y i ^ p ^ n ∈ Subfield.closure (C ∪ range z)) :
    ∃ δ, IsFrobIndex p C y z δ := by
  have hYE : (Subfield.closure (C ∪ range y)).map (iterateFrobenius K p (m + n)) ≤
      (Subfield.closure (C ∪ range z)).map (iterateFrobenius K p m) := by
    rw [← map_iterateFrobenius_map]
    exact (Subfield.gc_map_comap _).monotone_l (map_closure_le p y z n hy)
  obtain ⟨j, -, hj⟩ := exists_eq_map_iterateFrobenius p hp hF hYE (map_closure_le p z y m hz)
  exact ⟨(j : ℤ) - m, m, j, rfl, hj⟩

/-- Index zero means that `y` and `z` generate the same field over `C`.
@isnad1 id=eq.1h7v.s6.b4333ad7f4b7 from=translated src=- shape=585a481f vocab=38ff68cf
-/
theorem IsFrobIndex.closure_eq_of_zero (h : IsFrobIndex p C y z 0) :
    Subfield.closure (C ∪ range z) = Subfield.closure (C ∪ range y) := by
  obtain ⟨m, n, hmn, h⟩ := h
  obtain rfl : n = m := by omega
  exact map_iterateFrobenius_injective p n h

end

