import Tengoku.Seed.Algebra.MvPolynomial.Nilpotent
import Tengoku.Seed.RingTheory.Nullstellensatz
import Tengoku.AclGeom.AclGeom.Correspondence.Additive

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# One-dimensional subgroups of the additive plane

Blueprint Lemma `subgroup-classification` (a): over an algebraically closed field `k`, a
connected one-dimensional subgroup `H ≤ Gₐ²` whose two projections are nonconstant is
`{(u, v) : P(u) = Q(v)}` for nonzero additive polynomials `P, Q`.

This module proves the statement for a subgroup `H ⊆ k²` that is the zero locus of a prime ideal
`I` with one-dimensional coordinate ring `k[X₀, X₁] ⧸ I` (`addSubgroup_classification`): `I` is
generated by `P(X₀) - Q(X₁)` and `H = {P(u) = Q(v)}`.  A prime ideal is the irreducible form
of the hypothesis. `AdditiveSubgroupConnected` derives primality of the canonical vanishing
ideal from connectedness of its coordinate ring and proves the full connected source form.
The shape of additive polynomials in characteristic zero and `p` is
`IsAdditive.eq_C_mul_X` and `IsAdditive.coeff_eq_zero_of_ne_pow`.

The proof follows the source.  The ideal is principal, generated by a prime `F` with
`F(0) = 0`.  Translation by a point of `H` preserves `H`, hence the ideal; by the
Nullstellensatz `F` is translation invariant at every point of `H`.  The additivity defect
`F(X + Y) - F(X) - F(Y)` therefore lies in the ideals of both blocks
(`mem_span_rename_inl_of_forall_aevalFst_eq_zero`).  These are coprime primes, and a degree
comparison forces the defect to vanish (`addSubst_eq_of_mem_span_rename_inl`).  Splitting
`F = F(X₀, 0) + F(0, X₁)` gives the additive polynomials; they are nonzero because a
prime polynomial in one variable is linear and the projections are nonconstant.

This module is part of the formalization of the Evans–Hrushovski–Gismatullin
reconstruction theorem; the source of truth is `sources/blueprint.tex`.

**Status:** the prime-ideal form is proved here; the full connected source form is proved in
`AdditiveSubgroupConnected` (#5, C4).
-/

namespace AclGeom

open MvPolynomial

variable {k : Type*} [Field k]

/-- Translation is an algebra automorphism, so it preserves prime polynomials.-/
theorem prime_translate_iff {σ : Type*} (c : σ → k) {G : MvPolynomial σ k} :
    Prime (translate c G) ↔ Prime G := by
  let T : MvPolynomial σ k ≃ₐ[k] MvPolynomial σ k :=
    AlgEquiv.ofAlgHom (translate c) (translate (-c))
      (AlgHom.ext fun g ↦ by
        rw [AlgHom.comp_apply, AlgHom.id_apply]
        exact translate_translate_neg c g)
      (AlgHom.ext fun g ↦ by
        rw [AlgHom.comp_apply, AlgHom.id_apply]
        exact translate_neg_translate c g)
  exact MulEquiv.prime_iff T

end AclGeom
