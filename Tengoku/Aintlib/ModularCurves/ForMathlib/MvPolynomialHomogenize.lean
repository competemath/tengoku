import Tengoku.Seed.RingTheory.GradedAlgebra.Homogeneous.Ideal
import Tengoku.Seed.RingTheory.MvPolynomial.Homogeneous

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Homogenizing a multivariate polynomial

We adjoin one variable using `Option σ`, with `none` as the homogenizing variable and
`some i` as the image of the original variable `i`.
-/

namespace MvPolynomial

noncomputable section

open Finset

variable {R S σ : Type*} [CommSemiring R] [CommSemiring S]

attribute [local instance] MvPolynomial.gradedAlgebra

/-- Set the extra `none` variable to one and send every `some i` variable back to `i`.-/
def dehomogenizeOption (R : Type*) [CommSemiring R] :
    MvPolynomial (Option σ) R →+* MvPolynomial σ R :=
  eval₂Hom C fun
    | none => 1
    | some i => X i

/--
@isnad1 id=eq.0h3v.s8.c69c10afe84c from=translated src=- shape=526992e1 vocab=661349b0
-/
@[simp]
lemma dehomogenizeOption_C (r : R) :
    dehomogenizeOption (σ := σ) R (C r) = C r :=
  eval₂Hom_C _ _ _

/--
@isnad1 id=eq.0h2v.s7.fd50a027fa01 from=translated src=- shape=c458f2ba vocab=f5f931c4
-/
@[simp]
lemma dehomogenizeOption_X_none :
    dehomogenizeOption (σ := σ) R (X none) = 1 := by
  simp [dehomogenizeOption]

/--
@isnad1 id=eq.0h3v.s7.e851171fe557 from=translated src=- shape=6013145c vocab=38c15efb
-/
@[simp]
lemma dehomogenizeOption_X_some (i : σ) :
    dehomogenizeOption (σ := σ) R (X (some i)) = X i := by
  simp [dehomogenizeOption]

/--
@isnad1 id=eq.0h3v.s8.298a0accb5b5 from=translated src=- shape=8ea92d58 vocab=49fcc186
-/
@[simp]
lemma dehomogenizeOption_rename_some (p : MvPolynomial σ R) :
    dehomogenizeOption (σ := σ) R (rename some p) = p := by
  have h : (dehomogenizeOption (σ := σ) R).comp (rename some).toRingHom = RingHom.id _ := by
    refine ringHom_ext (fun r ↦ ?_) (fun i ↦ ?_)
    · simp
    · simp
  exact RingHom.congr_fun h p

/-- Homogenize `p` to degree `n` using the extra `none` variable.

If `n < p.totalDegree`, this keeps only the homogeneous components of degree at most `n`.-/
def homogenizeOption (p : MvPolynomial σ R) (n : ℕ) : MvPolynomial (Option σ) R :=
  ∑ i ∈ range (n + 1),
    rename some (homogeneousComponent i p) * X none ^ (n - i)

/--
@isnad1 id=ishomoge.0h4v.s4.abc1234d0c9c from=translated src=- shape=0349bba7 vocab=147a19a9
-/
lemma homogenizeOption_isHomogeneous (p : MvPolynomial σ R) (n : ℕ) :
    (homogenizeOption p n).IsHomogeneous n := by
  refine IsHomogeneous.sum (range (n + 1)) _ n ?_
  intro i hi
  have hi' : i ≤ n := Nat.lt_succ_iff.mp (mem_range.mp hi)
  have hleft : IsHomogeneous
      (rename some (homogeneousComponent i p) : MvPolynomial (Option σ) R) i :=
    (homogeneousComponent_isHomogeneous i p).rename_isHomogeneous
  have hright : (X none ^ (n - i) : MvPolynomial (Option σ) R).IsHomogeneous (n - i) :=
    isHomogeneous_X_pow none (n - i)
  simpa [Nat.add_sub_of_le hi'] using hleft.mul hright

/--
@isnad1 id=eq.1h4v.s7.0a6b200081fe from=translated src=- shape=396afcf6 vocab=a4eb8d97
-/
lemma dehomogenizeOption_homogenizeOption (p : MvPolynomial σ R) (n : ℕ)
    (h : p.totalDegree ≤ n) :
    dehomogenizeOption (σ := σ) R (homogenizeOption p n) = p := by
  rw [homogenizeOption, map_sum]
  simp only [map_mul, dehomogenizeOption_rename_some, map_pow,
    dehomogenizeOption_X_none, one_pow, mul_one]
  calc
    _ = ∑ i ∈ range (p.totalDegree + 1), homogeneousComponent i p := by
      apply (sum_subset (range_mono (Nat.succ_le_succ h)) ?_).symm
      intro i _ hi
      apply homogeneousComponent_eq_zero
      have hi' : ¬ i ≤ p.totalDegree := by
        simpa only [mem_range, Nat.lt_succ_iff] using hi
      exact Nat.lt_of_not_ge hi'
    _ = p := sum_homogeneousComponent p

private lemma map_homogeneousComponent (g : R →+* S) (p : MvPolynomial σ R) (n : ℕ) :
    map g (homogeneousComponent n p) = homogeneousComponent n (map g p) := by
  ext d
  rw [coeff_map, coeff_homogeneousComponent, coeff_homogeneousComponent, coeff_map]
  split_ifs <;> simp

/--
@isnad1 id=eq.0h6v.s8.310b2c94411d from=translated src=- shape=52980f38 vocab=06234a87
-/
lemma homogenizeOption_map (g : R →+* S) (p : MvPolynomial σ R) (n : ℕ) :
    homogenizeOption (map g p) n = map g (homogenizeOption p n) := by
  simp only [homogenizeOption, map_sum, map_mul, map_pow, map_rename, map_X,
    map_homogeneousComponent]

/-- The homogeneous ideal generated by a family of relations, homogenized at prescribed degrees.-/
def homogenizedIdeal {κ : Type*} (g : κ → MvPolynomial σ R) (d : κ → ℕ) :
    HomogeneousIdeal (homogeneousSubmodule (Option σ) R) :=
  ⟨Ideal.span (Set.range fun j ↦ homogenizeOption (g j) (d j)),
    Ideal.homogeneous_span _ _ fun _ hx ↦ by
      obtain ⟨j, rfl⟩ := hx
      exact ⟨d j, (mem_homogeneousSubmodule _ _).mpr
        (homogenizeOption_isHomogeneous (g j) (d j))⟩⟩

/--
@isnad1 id=eq.0h5v.s7.f6caaeffdc8d from=translated src=- shape=45279a9a vocab=2f1c7547
-/
lemma homogenizedIdeal_toIdeal {κ : Type*} (g : κ → MvPolynomial σ R) (d : κ → ℕ) :
    (homogenizedIdeal g d).toIdeal =
      Ideal.span (Set.range fun j ↦ homogenizeOption (g j) (d j)) :=
  rfl

/--
@isnad1 id=eq.0h7v.s9.911d3be1adc2 from=translated src=- shape=a96a1dbe vocab=020ba174
-/
lemma map_homogenizedIdeal {κ : Type*} (f : R →+* S) (g : κ → MvPolynomial σ R)
    (d : κ → ℕ) :
    Ideal.map (map (σ := Option σ) f) (homogenizedIdeal g d).toIdeal =
      (homogenizedIdeal (fun j ↦ map (σ := σ) f (g j)) d).toIdeal := by
  rw [homogenizedIdeal_toIdeal, homogenizedIdeal_toIdeal, Ideal.map_span]
  congr 1
  rw [← Set.range_comp']
  apply congrArg Set.range
  funext j
  exact (homogenizeOption_map f (g j) (d j)).symm

/--
@isnad1 id=eq.1h5v.s8.b6c152e59e84 from=translated src=- shape=14b722e5 vocab=0a559b74
-/
lemma map_dehomogenizeOption_homogenizedIdeal {κ : Type*}
    (g : κ → MvPolynomial σ R) (d : κ → ℕ)
    (h : ∀ j, (g j).totalDegree ≤ d j) :
    Ideal.map (dehomogenizeOption (σ := σ) R) (homogenizedIdeal g d).toIdeal =
      Ideal.span (Set.range g) := by
  rw [homogenizedIdeal_toIdeal, Ideal.map_span]
  congr 1
  rw [← Set.range_comp']
  apply congrArg Set.range
  funext j
  exact dehomogenizeOption_homogenizeOption (g j) (d j) (h j)

end

end MvPolynomial
