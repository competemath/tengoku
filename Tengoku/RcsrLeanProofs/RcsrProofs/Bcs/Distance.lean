/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# `D` is the graph distance of the bcs net

We package the eight class-wise metrics `D1 .. D8` into a single function `D`
on states of the bcs quotient graph, define the (symmetric) adjacency relation
`Adj` generated by the 24 voltage edges, and define `Walk n s` ("`s` is
reachable from the base state in exactly `n` steps"). The two main results are:

* `walk_dist` : the base state reaches every state `s` in exactly `(D s).toNat`
  steps (upper bound / achievability), proved by strong induction on
  `(D s).toNat` using the `descent_*` lemmas to peel off one step at a time.
* `dist_le_walk` : any walk of length `n` to `s` forces `(D s).toNat ≤ n`
  (lower bound), proved by induction on the walk using the `lip_*` lemmas.

Together these give `dist_is_least`: `(D s).toNat` is the least `n` with
`Walk n s`, i.e. `D s` *is* the graph distance. We also derive the box bound
`dist_box` used by the counting/assembly work.
-/

namespace Bcs

/-- A state of the bcs net: a vertex class `1..8` (as `Fin 8`, so class `v`
is represented by `v - 1 : Fin 8`) together with a cell `(x, y, z) : ℤ³`.-/
abbrev St := Fin 8 × Int × Int × Int

/-- The base state: class 1, cell `(0,0,0)`.-/
def base : St := (0, 0, 0, 0)

/-- Dispatch to the class-wise metric. `v : Fin 8` encodes class `v.val + 1`.-/
def D : St → Int
  | (0, x, y, z) => D1 x y z
  | (1, x, y, z) => D2 x y z
  | (2, x, y, z) => D3 x y z
  | (3, x, y, z) => D4 x y z
  | (4, x, y, z) => D5 x y z
  | (5, x, y, z) => D6 x y z
  | (6, x, y, z) => D7 x y z
  | (7, x, y, z) => D8 x y z

/-- Adjacency in the infinite cover, generated by the 24 voltage edges of the
bcs quotient graph (each edge contributes both traversal directions).-/
inductive Adj : St → St → Prop
  | e0_12  (x y z : Int) : Adj (0, x, y, z) (1, x, y, z)
  | e0_12' (x y z : Int) : Adj (1, x, y, z) (0, x, y, z)
  | e1_12  (x y z : Int) : Adj (0, x, y, z) (1, x, y, z+1)
  | e1_12' (x y z : Int) : Adj (1, x, y, z+1) (0, x, y, z)
  | e2_13  (x y z : Int) : Adj (0, x, y, z) (2, x, y, z)
  | e2_13' (x y z : Int) : Adj (2, x, y, z) (0, x, y, z)
  | e3_13  (x y z : Int) : Adj (0, x, y, z) (2, x, y+1, z)
  | e3_13' (x y z : Int) : Adj (2, x, y+1, z) (0, x, y, z)
  | e4_14  (x y z : Int) : Adj (0, x, y, z) (3, x, y, z)
  | e4_14' (x y z : Int) : Adj (3, x, y, z) (0, x, y, z)
  | e5_14  (x y z : Int) : Adj (0, x, y, z) (3, x+1, y, z)
  | e5_14' (x y z : Int) : Adj (3, x+1, y, z) (0, x, y, z)
  | e6_25  (x y z : Int) : Adj (1, x, y, z) (4, x-1, y-1, z+1)
  | e6_25' (x y z : Int) : Adj (4, x-1, y-1, z+1) (1, x, y, z)
  | e7_25  (x y z : Int) : Adj (1, x, y, z) (4, x, y, z)
  | e7_25' (x y z : Int) : Adj (4, x, y, z) (1, x, y, z)
  | e8_26  (x y z : Int) : Adj (1, x, y, z) (5, x, y, z)
  | e8_26' (x y z : Int) : Adj (5, x, y, z) (1, x, y, z)
  | e9_26  (x y z : Int) : Adj (1, x, y, z) (5, x, y+1, z)
  | e9_26' (x y z : Int) : Adj (5, x, y+1, z) (1, x, y, z)
  | e10_35 (x y z : Int) : Adj (2, x, y, z) (4, x-1, y-1, z+1)
  | e10_35'(x y z : Int) : Adj (4, x-1, y-1, z+1) (2, x, y, z)
  | e11_35 (x y z : Int) : Adj (2, x, y, z) (4, x, y-1, z+1)
  | e11_35'(x y z : Int) : Adj (4, x, y-1, z+1) (2, x, y, z)
  | e12_37 (x y z : Int) : Adj (2, x, y, z) (6, x-1, y-1, z+1)
  | e12_37'(x y z : Int) : Adj (6, x-1, y-1, z+1) (2, x, y, z)
  | e13_37 (x y z : Int) : Adj (2, x, y, z) (6, x, y, z)
  | e13_37'(x y z : Int) : Adj (6, x, y, z) (2, x, y, z)
  | e14_46 (x y z : Int) : Adj (3, x, y, z) (5, x-1, y, z+1)
  | e14_46'(x y z : Int) : Adj (5, x-1, y, z+1) (3, x, y, z)
  | e15_46 (x y z : Int) : Adj (3, x, y, z) (5, x, y+1, z)
  | e15_46'(x y z : Int) : Adj (5, x, y+1, z) (3, x, y, z)
  | e16_47 (x y z : Int) : Adj (3, x, y, z) (6, x-1, y, z)
  | e16_47'(x y z : Int) : Adj (6, x-1, y, z) (3, x, y, z)
  | e17_47 (x y z : Int) : Adj (3, x, y, z) (6, x-1, y, z+1)
  | e17_47'(x y z : Int) : Adj (6, x-1, y, z+1) (3, x, y, z)
  | e18_58 (x y z : Int) : Adj (4, x, y, z) (7, x, y, z)
  | e18_58'(x y z : Int) : Adj (7, x, y, z) (4, x, y, z)
  | e19_58 (x y z : Int) : Adj (4, x, y, z) (7, x, y, z+1)
  | e19_58'(x y z : Int) : Adj (7, x, y, z+1) (4, x, y, z)
  | e20_68 (x y z : Int) : Adj (5, x, y, z) (7, x-1, y-1, z+1)
  | e20_68'(x y z : Int) : Adj (7, x-1, y-1, z+1) (5, x, y, z)
  | e21_68 (x y z : Int) : Adj (5, x, y, z) (7, x, y-1, z+1)
  | e21_68'(x y z : Int) : Adj (7, x, y-1, z+1) (5, x, y, z)
  | e22_78 (x y z : Int) : Adj (6, x, y, z) (7, x, y-1, z+1)
  | e22_78'(x y z : Int) : Adj (7, x, y-1, z+1) (6, x, y, z)
  | e23_78 (x y z : Int) : Adj (6, x, y, z) (7, x, y, z+1)
  | e23_78'(x y z : Int) : Adj (7, x, y, z+1) (6, x, y, z)

/-- `Walk n s`: the state `s` is reachable from `base` in exactly `n` steps
along `Adj`.-/
inductive Walk : Nat → St → Prop
  | nil : Walk 0 base
  | cons {n : Nat} {s t : St} : Walk n s → Adj s t → Walk (n+1) t

/-- Flip a `±1`-difference statement to the opposite direction: if `a - b` is
`±1` then so is `b - a`. Used to discharge the reverse-orientation `Adj`
constructors from the forward `lip_*` lemmas.
@isnad1 id=or.1h2v.s6.8af5d82e433d from=translated src=- shape=ba39be12 vocab=0282f42d
-/
theorem flip1 {a b : Int} (h : a - b = 1 ∨ a - b = -1) :
    b - a = 1 ∨ b - a = -1 := by
  rcases h with h | h <;> omega

/-- Every `Adj` edge changes `D` by exactly `± 1`. This is precisely the
content of the 24 `lip_*` lemmas, repackaged for the abstract adjacency.
@isnad1 id=or.1h2v.s5.88665f25c740 from=translated src=- shape=88e61180 vocab=45d16a61
-/
theorem adj_dist_step {s t : St} (h : Adj s t) :
    D t - D s = 1 ∨ D t - D s = -1 := by
  cases h <;> simp only [D]
  · exact lip_e0_12 ..
  · exact flip1 (lip_e0_12 ..)
  · exact lip_e1_12 ..
  · exact flip1 (lip_e1_12 ..)
  · exact lip_e2_13 ..
  · exact flip1 (lip_e2_13 ..)
  · exact lip_e3_13 ..
  · exact flip1 (lip_e3_13 ..)
  · exact lip_e4_14 ..
  · exact flip1 (lip_e4_14 ..)
  · exact lip_e5_14 ..
  · exact flip1 (lip_e5_14 ..)
  · exact lip_e6_25 ..
  · exact flip1 (lip_e6_25 ..)
  · exact lip_e7_25 ..
  · exact flip1 (lip_e7_25 ..)
  · exact lip_e8_26 ..
  · exact flip1 (lip_e8_26 ..)
  · exact lip_e9_26 ..
  · exact flip1 (lip_e9_26 ..)
  · exact lip_e10_35 ..
  · exact flip1 (lip_e10_35 ..)
  · exact lip_e11_35 ..
  · exact flip1 (lip_e11_35 ..)
  · exact lip_e12_37 ..
  · exact flip1 (lip_e12_37 ..)
  · exact lip_e13_37 ..
  · exact flip1 (lip_e13_37 ..)
  · exact lip_e14_46 ..
  · exact flip1 (lip_e14_46 ..)
  · exact lip_e15_46 ..
  · exact flip1 (lip_e15_46 ..)
  · exact lip_e16_47 ..
  · exact flip1 (lip_e16_47 ..)
  · exact lip_e17_47 ..
  · exact flip1 (lip_e17_47 ..)
  · exact lip_e18_58 ..
  · exact flip1 (lip_e18_58 ..)
  · exact lip_e19_58 ..
  · exact flip1 (lip_e19_58 ..)
  · exact lip_e20_68 ..
  · exact flip1 (lip_e20_68 ..)
  · exact lip_e21_68 ..
  · exact flip1 (lip_e21_68 ..)
  · exact lip_e22_78 ..
  · exact flip1 (lip_e22_78 ..)
  · exact lip_e23_78 ..
  · exact flip1 (lip_e23_78 ..)

/-- `D` is nonnegative everywhere, and vanishes only at `base`.
@isnad1 id=le.0h1v.s3.bc61c0cfaf04 from=translated src=- shape=b9369acb vocab=e2dd505b
-/
theorem d_nonneg (s : St) : 0 ≤ D s := by
  obtain ⟨v, x, y, z⟩ := s
  fin_cases v <;> simp only [D]
  · exact d1_nonneg x y z
  · linarith [d2_pos x y z]
  · linarith [d3_pos x y z]
  · linarith [d4_pos x y z]
  · linarith [d5_pos x y z]
  · linarith [d6_pos x y z]
  · linarith [d7_pos x y z]
  · linarith [d8_pos x y z]

/--
@isnad1 id=iff.0h1v.s4.623db8dc9f03 from=translated src=- shape=c8a0a801 vocab=d856b2b5
-/
theorem d_zero_iff (s : St) : D s = 0 ↔ s = base := by
  obtain ⟨v, x, y, z⟩ := s
  fin_cases v <;> simp only [D, base, Prod.mk.injEq, Fin.ext_iff]
  · rw [d1_zero_iff]; tauto
  · exact iff_of_false (by linarith [d2_pos x y z]) (by simp)
  · exact iff_of_false (by linarith [d3_pos x y z]) (by simp)
  · exact iff_of_false (by linarith [d4_pos x y z]) (by simp)
  · exact iff_of_false (by linarith [d5_pos x y z]) (by simp)
  · exact iff_of_false (by linarith [d6_pos x y z]) (by simp)
  · exact iff_of_false (by linarith [d7_pos x y z]) (by simp)
  · exact iff_of_false (by linarith [d8_pos x y z]) (by simp)

/-- Every non-base state `s` has a neighbor `t` with `Adj t s` and
`D t = D s - 1`: the abstract repackaging of the `descent_*` lemmas.
@isnad1 id=ex.1h1v.s5.7b5a25c6549d from=translated src=- shape=c57710f9 vocab=cbcf8cb8
-/
theorem descent_step (s : St) (h : s ≠ base) :
    ∃ t : St, Adj t s ∧ D t = D s - 1 := by
  obtain ⟨v, x, y, z⟩ := s
  fin_cases v <;> simp only [D, base, ne_eq, Prod.mk.injEq, Fin.ext_iff] at h ⊢
  · have h' : ¬(x = 0 ∧ y = 0 ∧ z = 0) := by tauto
    rcases descent_1 x y z h' with h1 | h1 | h1 | h1 | h1 | h1
    · exact ⟨(1, x, y, z), Adj.e0_12' x y z, by simpa using h1⟩
    · exact ⟨(1, x, y, z+1), Adj.e1_12' x y z, by simpa using h1⟩
    · exact ⟨(2, x, y, z), Adj.e2_13' x y z, by simpa using h1⟩
    · exact ⟨(2, x, y+1, z), Adj.e3_13' x y z, by simpa using h1⟩
    · exact ⟨(3, x, y, z), Adj.e4_14' x y z, by simpa using h1⟩
    · exact ⟨(3, x+1, y, z), Adj.e5_14' x y z, by simpa using h1⟩
  · rcases descent_2 x y z with h1 | h1 | h1 | h1 | h1 | h1
    · exact ⟨(0, x, y, z), Adj.e0_12 x y z, by simpa using h1⟩
    · exact ⟨(0, x, y, z-1), by simpa using Adj.e1_12 x y (z-1), by simpa using h1⟩
    · exact ⟨(4, x-1, y-1, z+1), Adj.e6_25' x y z, by simpa using h1⟩
    · exact ⟨(4, x, y, z), Adj.e7_25' x y z, by simpa using h1⟩
    · exact ⟨(5, x, y, z), Adj.e8_26' x y z, by simpa using h1⟩
    · exact ⟨(5, x, y+1, z), Adj.e9_26' x y z, by simpa using h1⟩
  · rcases descent_3 x y z with h1 | h1 | h1 | h1 | h1 | h1
    · exact ⟨(0, x, y, z), Adj.e2_13 x y z, by simpa using h1⟩
    · exact ⟨(0, x, y-1, z), by simpa using Adj.e3_13 x (y-1) z, by simpa using h1⟩
    · exact ⟨(4, x-1, y-1, z+1), Adj.e10_35' x y z, by simpa using h1⟩
    · exact ⟨(4, x, y-1, z+1), Adj.e11_35' x y z, by simpa using h1⟩
    · exact ⟨(6, x-1, y-1, z+1), Adj.e12_37' x y z, by simpa using h1⟩
    · exact ⟨(6, x, y, z), Adj.e13_37' x y z, by simpa using h1⟩
  · rcases descent_4 x y z with h1 | h1 | h1 | h1 | h1 | h1
    · exact ⟨(0, x, y, z), Adj.e4_14 x y z, by simpa using h1⟩
    · exact ⟨(0, x-1, y, z), by simpa using Adj.e5_14 (x-1) y z, by simpa using h1⟩
    · exact ⟨(5, x-1, y, z+1), Adj.e14_46' x y z, by simpa using h1⟩
    · exact ⟨(5, x, y+1, z), Adj.e15_46' x y z, by simpa using h1⟩
    · exact ⟨(6, x-1, y, z), Adj.e16_47' x y z, by simpa using h1⟩
    · exact ⟨(6, x-1, y, z+1), Adj.e17_47' x y z, by simpa using h1⟩
  · rcases descent_5 x y z with h1 | h1 | h1 | h1 | h1 | h1
    · exact ⟨(1, x+1, y+1, z-1), by simpa using Adj.e6_25 (x+1) (y+1) (z-1), by simpa using h1⟩
    · exact ⟨(1, x, y, z), Adj.e7_25 x y z, by simpa using h1⟩
    · exact ⟨(2, x+1, y+1, z-1), by simpa using Adj.e10_35 (x+1) (y+1) (z-1), by simpa using h1⟩
    · exact ⟨(2, x, y+1, z-1), by simpa using Adj.e11_35 x (y+1) (z-1), by simpa using h1⟩
    · exact ⟨(7, x, y, z), Adj.e18_58' x y z, by simpa using h1⟩
    · exact ⟨(7, x, y, z+1), Adj.e19_58' x y z, by simpa using h1⟩
  · rcases descent_6 x y z with h1 | h1 | h1 | h1 | h1 | h1
    · exact ⟨(1, x, y, z), Adj.e8_26 x y z, by simpa using h1⟩
    · exact ⟨(1, x, y-1, z), by simpa using Adj.e9_26 x (y-1) z, by simpa using h1⟩
    · exact ⟨(3, x+1, y, z-1), by simpa using Adj.e14_46 (x+1) y (z-1), by simpa using h1⟩
    · exact ⟨(3, x, y-1, z), by simpa using Adj.e15_46 x (y-1) z, by simpa using h1⟩
    · exact ⟨(7, x-1, y-1, z+1), Adj.e20_68' x y z, by simpa using h1⟩
    · exact ⟨(7, x, y-1, z+1), Adj.e21_68' x y z, by simpa using h1⟩
  · rcases descent_7 x y z with h1 | h1 | h1 | h1 | h1 | h1
    · exact ⟨(2, x+1, y+1, z-1), by simpa using Adj.e12_37 (x+1) (y+1) (z-1), by simpa using h1⟩
    · exact ⟨(2, x, y, z), Adj.e13_37 x y z, by simpa using h1⟩
    · exact ⟨(3, x+1, y, z), by simpa using Adj.e16_47 (x+1) y z, by simpa using h1⟩
    · exact ⟨(3, x+1, y, z-1), by simpa using Adj.e17_47 (x+1) y (z-1), by simpa using h1⟩
    · exact ⟨(7, x, y-1, z+1), Adj.e22_78' x y z, by simpa using h1⟩
    · exact ⟨(7, x, y, z+1), Adj.e23_78' x y z, by simpa using h1⟩
  · rcases descent_8 x y z with h1 | h1 | h1 | h1 | h1 | h1
    · exact ⟨(4, x, y, z), Adj.e18_58 x y z, by simpa using h1⟩
    · exact ⟨(4, x, y, z-1), by simpa using Adj.e19_58 x y (z-1), by simpa using h1⟩
    · exact ⟨(5, x+1, y+1, z-1), by simpa using Adj.e20_68 (x+1) (y+1) (z-1), by simpa using h1⟩
    · exact ⟨(5, x, y+1, z-1), by simpa using Adj.e21_68 x (y+1) (z-1), by simpa using h1⟩
    · exact ⟨(6, x, y+1, z-1), by simpa using Adj.e22_78 x (y+1) (z-1), by simpa using h1⟩
    · exact ⟨(6, x, y, z-1), by simpa using Adj.e23_78 x y (z-1), by simpa using h1⟩

/-- **Upper bound / achievability.** The base state reaches every state `s` in
exactly `(D s).toNat` steps. Strong induction on `(D s).toNat`: if `D s = 0`
then `s = base` (by `d_zero_iff`); otherwise `descent_step` produces a neighbor
`t` one step closer to `base`, reached in `(D t).toNat = (D s).toNat - 1`
steps by the induction hypothesis, and `Walk.cons` extends that walk to `s`.
@isnad1 id=walk.0h1v.s2.2ef7e05b6163 from=translated src=- shape=7fb93114 vocab=9ccf3780
-/
theorem walk_dist (s : St) : Walk (D s).toNat s := by
  generalize hn : (D s).toNat = n
  induction n using Nat.strong_induction_on generalizing s with
  | _ n ih =>
    by_cases hb : s = base
    · subst hb
      have : (D base).toNat = 0 := by
        have := (d_zero_iff base).mpr rfl
        omega
      simpa [← hn, this] using Walk.nil
    · obtain ⟨t, hadj, hdt⟩ := descent_step s hb
      have hspos : 0 < D s := lt_of_le_of_ne (d_nonneg s) (Ne.symm (mt (d_zero_iff s).mp hb))
      have htnat : (D t).toNat = n - 1 := by omega
      have hwt : Walk (n - 1) t := by
        have := ih (n - 1) (by omega) t htnat
        exact this
      have : Walk (n - 1 + 1) s := Walk.cons hwt hadj
      have hn1 : n - 1 + 1 = n := by omega
      rwa [hn1] at this

/-- **Lower bound.** Any walk of length `n` reaching `s` forces
`(D s).toNat ≤ n`: induction on the walk, using `adj_dist_step` to see that
each step changes `D` by at most 1 (so `D` can drop by at most 1 per step,
and it starts at `D base = 0`).
@isnad1 id=le.1h2v.s3.7face6d1b200 from=translated src=- shape=2ed1417d vocab=da90d3db
-/
theorem dist_le_walk {n : Nat} {s : St} (h : Walk n s) : (D s).toNat ≤ n := by
  induction h with
  | nil =>
    have : D base = 0 := (d_zero_iff base).mpr rfl
    simp [this]
  | cons hw hadj ih =>
    rename_i n s t
    rcases adj_dist_step hadj with hd | hd
    · omega
    · omega

/-- **Headline theorem.** `(D s).toNat` is the least `n` such that `s` is
reachable from `base` in `n` steps: `D` *is* the graph distance.
@isnad1 id=isleast.0h1v.s3.ced73103a578 from=translated src=- shape=0bd17606 vocab=581c08d5
-/
theorem dist_is_least (s : St) : IsLeast {n : Nat | Walk n s} (D s).toNat := by
  constructor
  · exact walk_dist s
  · intro n hn
    exact dist_le_walk hn

-- Box lemma. If a state at cell `(x, y, z)` (any class) has distance
-- `n` from `base`, then `x`, `y`, `z` all lie within `n` of the origin. Needed
-- by the counting/assembly work to bound the search box at radius `n`. Each
-- class is one `omega` after unfolding the metric (the class-1/8 cases first
-- `split` on the exceptional-line bump).
set_option maxHeartbeats 8000000 in
/--
@isnad1 id=and.1h5v.s6.28c24b1eaa33 from=translated src=- shape=a1dbe05d vocab=b583c805
-/
theorem dist_box (v : Fin 8) (x y z n : Int) (h : D (v, x, y, z) = n) :
    x.natAbs ≤ n.natAbs ∧ y.natAbs ≤ n.natAbs ∧ z.natAbs ≤ n.natAbs := by
  fin_cases v <;> simp only [D] at h
  · unfold D1 at h; split at h <;> omega
  · unfold D2 at h; omega
  · unfold D3 at h; omega
  · unfold D4 at h; omega
  · unfold D5 at h; omega
  · unfold D6 at h; omega
  · unfold D7 at h; omega
  · unfold D8 at h; split at h <;> omega

end Bcs
