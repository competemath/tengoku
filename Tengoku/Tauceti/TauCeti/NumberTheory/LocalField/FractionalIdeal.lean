module

public import Tengoku
public import Tengoku.Tauceti.TauCeti.NumberTheory.LocalField.NormalizedValuation

/-!
# Principal fractional ideals of a nonarchimedean local field

The fractional ideals of the ring of integers `𝒪[K]` of a valued field `K` that are generated by
one element are ordered by the valuation: `x 𝒪[K] ≤ y 𝒪[K]` exactly when `v(x) ≤ v(y)`. For a
nonarchimedean local field, whose ring of integers is a discrete valuation ring, the principal
fractional ideal generated by `x ≠ 0` is the power `𝓂[K] ^ v_K(x)` of the maximal ideal, for the
normalized valuation `v_K`.

## Main results

* `TauCeti.spanSingleton_le_spanSingleton_iff_valuation_le`: inclusion of principal fractional
  ideals is the order of the valuation.
* `Units.spanSingleton_eq_maximalIdeal_zpow`: `x 𝒪[K] = 𝓂[K] ^ v_K(x)`.
-/

public section

open ValuativeRel

namespace TauCeti

section Valuation

variable {K : Type*} [Field K] [ValuativeRel K]

/-- Inclusion of principal fractional ideals of the ring of integers of a valued field is the
reverse of divisibility, that is, the order of the valuation. -/
theorem spanSingleton_le_spanSingleton_iff_valuation_le {x y : K} :
    FractionalIdeal.spanSingleton (nonZeroDivisors 𝒪[K]) x ≤
        FractionalIdeal.spanSingleton (nonZeroDivisors 𝒪[K]) y ↔
      valuation K x ≤ valuation K y := by
  rw [FractionalIdeal.spanSingleton_le_iff_mem, FractionalIdeal.mem_spanSingleton]
  constructor
  · rintro ⟨z, rfl⟩
    rw [Subring.smul_def, smul_eq_mul, map_mul]
    exact mul_le_of_le_one_left' z.2
  · intro h
    rcases eq_or_ne y 0 with rfl | hy
    · exact ⟨0, by simp_all⟩
    refine ⟨⟨x / y, ?_⟩, ?_⟩
    · rw [Valuation.mem_integer_iff, map_div₀]
      exact div_le_one_of_le₀ h zero_le
    · rw [Subring.smul_def, smul_eq_mul, div_mul_cancel₀ x hy]

end Valuation

end TauCeti

namespace Units

open TauCeti

variable {K : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]

end Units
