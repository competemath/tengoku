import Tengoku.Seed.Analysis.InnerProductSpace.Basic
import Tengoku.Seed.MeasureTheory.Integral.Bochner.Basic
import Tengoku.RiemannhypothesisFormalization.RiemannHypothesis.ComplexAnalysis.HermiteBiehler

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# de Branges spaces: exact membership and Hilbert-realization interfaces

For a Hermite--Biehler function `E`, a standard definition of the de Branges
space `B(E)` consists of entire functions `F` for which both `F/E` and
`F#/E` belong to Hardy `H²` of the upper half-plane.  We formalize that
definition directly, including the uniform horizontal-line integral bound.

Mathlib v4.31 does not provide upper-half-plane Hardy spaces, boundary-value
theorems, or de Branges' Hilbert-space theorem.  Accordingly:

* `UpperHalfPlaneHardyTwo` and `DeBrangesSpaceMember` are unconditional
  definitions;
* `DeBrangesHilbertRealization` is an explicit interface for the missing
  Hilbert completion, norm identity, continuous evaluations, and reproducing
  kernel theorem.

No inhabitant of the latter interface is postulated in this repository.
-/

namespace OverflowResidueRH

open Complex MeasureTheory Set

/-- Restriction of a complex function to the horizontal line at height
`y > 0`.-/
def upperHalfPlaneHorizontalLine
    (f : ℂ → ℂ) (y x : ℝ) : ℂ :=
  f ((x : ℂ) + Complex.I * (y : ℂ))

/-- Hardy `H²` on the upper half-plane, expressed by analyticity and a
uniform bound for the squared `L²` norms on horizontal lines.-/
def UpperHalfPlaneHardyTwo (f : ℂ → ℂ) : Prop :=
  DifferentiableOn ℂ f {z : ℂ | 0 < z.im} ∧
    ∃ C : ℝ, 0 ≤ C ∧
      ∀ y : ℝ, 0 < y →
        Integrable (fun x : ℝ => ‖upperHalfPlaneHorizontalLine f y x‖ ^ 2) ∧
        (∫ x : ℝ, ‖upperHalfPlaneHorizontalLine f y x‖ ^ 2) ≤ C

/-- Pointwise quotient used in the de Branges definition.  Division is
totalized by Lean; `HermiteBiehlerUHP.ne_zero` below proves the denominator
is nonzero in the domain where Hardy analyticity matters.-/
noncomputable def deBrangesQuotient (F E : ℂ → ℂ) (z : ℂ) : ℂ :=
  F z / E z

/-- Membership in the de Branges space generated by `E`, in the equivalent
Hardy-space formulation.-/
def DeBrangesSpaceMember (E F : ℂ → ℂ) : Prop :=
  Differentiable ℂ F ∧
    UpperHalfPlaneHardyTwo (deBrangesQuotient F E) ∧
    UpperHalfPlaneHardyTwo
      (deBrangesQuotient (hermiteBiehlerSharp F) E)

/-- A bundled element of the function-level de Branges space `B(E)`.-/
structure DeBrangesSpaceElement (E : ℂ → ℂ) where
  toFun : ℂ → ℂ
  property : DeBrangesSpaceMember E toFun

/-- The boundary integral defining the squared de Branges norm.-/
noncomputable def deBrangesNormSq
    (E F : ℂ → ℂ) : ℝ :=
  ∫ x : ℝ, ‖F (x : ℂ) / E (x : ℂ)‖ ^ 2

/-- The boundary sesquilinear form associated with `E`.  Establishing that
this is a complete positive-definite inner product on the function-level
carrier is part of the classical de Branges theorem, hence is a field of the
realization interface below rather than asserted here.-/
noncomputable def deBrangesBoundaryPairing
    (E F G : ℂ → ℂ) : ℂ :=
  ∫ x : ℝ,
    star (F (x : ℂ) / E (x : ℂ)) *
      (G (x : ℂ) / E (x : ℂ))

/-- The raw classical de Branges reproducing-kernel quotient.  It is the
correct formula away from `z = conj w`.  Lean's division is totalized at that
point, but the resulting value `0` is **not** asserted to be the analytic
removable value; a Hilbert realization therefore uses this formula only off
the exceptional locus.-/
noncomputable def deBrangesKernel
    (E : ℂ → ℂ) (w z : ℂ) : ℂ :=
  (star (E w) * E z -
      star (hermiteBiehlerSharp E w) * hermiteBiehlerSharp E z) /
    (2 * (Real.pi : ℂ) * Complex.I * (star w - z))

/-- A strict Hermite--Biehler function has no zero in the open upper
half-plane.
@isnad1 id=ne.2h2v.s5.fcff471248f7 from=translated src=- shape=481276ad vocab=1bfedb41
-/
theorem HermiteBiehlerUHP.ne_zero
    {E : ℂ → ℂ} (hE : HermiteBiehlerUHP E)
    {z : ℂ} (hz : 0 < z.im) : E z ≠ 0 := by
  intro hzero
  have h := hE z hz
  rw [hzero, norm_zero] at h
  exact (not_lt_of_ge (norm_nonneg _)) h

/-- Explicit interface for the Hilbert-space and reproducing-kernel content
of de Branges' theorem.  It is parameterized by an already existing Hilbert
space `H`; constructing this data entails the missing Hardy boundary theory
and completeness proof.-/
structure DeBrangesHilbertRealization
    (E : ℂ → ℂ)
    (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] where
  generator_differentiable : Differentiable ℂ E
  generator_hermiteBiehler : HermiteBiehlerNoRealZeros E
  toFunction : H →ₗ[ℂ] (ℂ → ℂ)
  member : ∀ f : H, DeBrangesSpaceMember E (toFunction f)
  surjective_onto_members :
    ∀ F : ℂ → ℂ, DeBrangesSpaceMember E F →
      ∃ f : H, toFunction f = F
  norm_identity :
    ∀ f : H, ‖f‖ ^ 2 = deBrangesNormSq E (toFunction f)
  evaluation : ℂ → H →L[ℂ] ℂ
  evaluation_apply :
    ∀ (w : ℂ) (f : H), evaluation w f = toFunction f w
  kernelVector : ℂ → H
  kernel_formula :
    ∀ w z : ℂ, star w ≠ z →
      toFunction (kernelVector w) z = deBrangesKernel E w z
  reproducing :
    ∀ (w : ℂ) (f : H), inner ℂ (kernelVector w) f = toFunction f w

end OverflowResidueRH
