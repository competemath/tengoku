import Tengoku.RiemannhypothesisFormalization.RiemannHypothesis.RealZeros.Polynomial

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Explicit sign probes for an off-real symmetric zero quartet

This file packages the local pole argument as a concrete diagnostic.  A
nonzero polynomial with an upper-half-plane root has a point immediately
below that root, still in the upper half-plane and away from every zero, where
the imaginary part of its logarithmic derivative is strictly positive.

We then instantiate this theorem on the orbit polynomial with zeros
`ρ`, `star ρ`, `-ρ`, and `-star ρ`.  The polynomial is proved even and Schwarz
symmetric, so the result isolates exactly what an off-real quartet does: it
forces a witnessed failure of the anti-Herglotz sign condition.  In particular
the witness is not an artefact of Lean's totalized division, since the
polynomial is explicitly nonzero at the probe point.
-/

namespace OverflowResidueRH

open Complex

/-- A nonzero polynomial with an upper-half-plane root has an explicit
lower-probe sign violation.  The witness lies below the root on the same
vertical line, remains in the upper half-plane, and is not itself a root.-/
theorem polynomial_upper_root_has_lowerProbe_signViolation
    (p : Polynomial ℂ) (hp : p ≠ 0) {ρ : ℂ}
    (hroot : p.eval ρ = 0) (hupper : 0 < ρ.im) :
    ∃ ε : ℝ, 0 < ε ∧ ε < ρ.im ∧
      0 < (ρ - (ε : ℂ) * Complex.I).im ∧
      p.eval (ρ - (ε : ℂ) * Complex.I) ≠ 0 ∧
      0 < (polynomialLogDerivResponse p
        (ρ - (ε : ℂ) * Complex.I)).im := by
  obtain ⟨D⟩ :=
    (polynomialPoleWitnessHypothesis_of_nonzero_polynomial p hp)
      |>.decomp_at_each_upper_root ρ hroot hupper
  obtain ⟨ε, hε, hεD, hprobeUpper, hprobePos⟩ :=
    exists_lowerProbe_escape_of_localLogDerivPole D
  have hεUpper : ε < ρ.im := lt_trans hεD D.hε0_lt
  have hprobeNonzero : p.eval (ρ - (ε : ℂ) * Complex.I) ≠ 0 := by
    intro hzero
    unfold polynomialLogDerivResponse at hprobePos
    rw [hzero, div_zero, Complex.zero_im] at hprobePos
    exact (lt_irrefl 0 hprobePos)
  exact ⟨ε, hε, hεUpper, hprobeUpper, hprobeNonzero, hprobePos⟩

/-- The degree-four orbit polynomial carrying the zero multiset generated by
negation and complex conjugation from `ρ`.  Some orbit points can coincide
(for example on the imaginary axis); the factors retain the corresponding
multiplicity.-/
noncomputable def symmetricZeroQuartetPolynomial (ρ : ℂ) : Polynomial ℂ :=
  (Polynomial.X - Polynomial.C ρ) *
    (Polynomial.X - Polynomial.C (star ρ)) *
    (Polynomial.X - Polynomial.C (-ρ)) *
    (Polynomial.X - Polynomial.C (-star ρ))

/-- Evaluation exposes the four orbit factors.-/
@[simp] theorem symmetricZeroQuartetPolynomial_eval (ρ z : ℂ) :
    (symmetricZeroQuartetPolynomial ρ).eval z =
      (z - ρ) * (z - star ρ) * (z + ρ) * (z + star ρ) := by
  simp [symmetricZeroQuartetPolynomial, Polynomial.eval_mul,
    Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]

/-- The orbit polynomial is nonzero, independently of any possible
coincidences among the four orbit points.-/
theorem symmetricZeroQuartetPolynomial_ne_zero (ρ : ℂ) :
    symmetricZeroQuartetPolynomial ρ ≠ 0 := by
  unfold symmetricZeroQuartetPolynomial
  exact mul_ne_zero
    (mul_ne_zero
      (mul_ne_zero (Polynomial.X_sub_C_ne_zero ρ)
        (Polynomial.X_sub_C_ne_zero (star ρ)))
      (Polynomial.X_sub_C_ne_zero (-ρ)))
    (Polynomial.X_sub_C_ne_zero (-star ρ))

/-- The generating point is a root of its orbit polynomial.-/
@[simp] theorem symmetricZeroQuartetPolynomial_root (ρ : ℂ) :
    (symmetricZeroQuartetPolynomial ρ).eval ρ = 0 := by
  simp

/-- Every point in the negation/conjugation orbit is a root.-/
theorem symmetricZeroQuartetPolynomial_orbit_roots (ρ : ℂ) :
    (symmetricZeroQuartetPolynomial ρ).eval ρ = 0 ∧
    (symmetricZeroQuartetPolynomial ρ).eval (star ρ) = 0 ∧
    (symmetricZeroQuartetPolynomial ρ).eval (-ρ) = 0 ∧
    (symmetricZeroQuartetPolynomial ρ).eval (-star ρ) = 0 := by
  simp

/-- The orbit polynomial is even.-/
theorem symmetricZeroQuartetPolynomial_neg (ρ z : ℂ) :
    (symmetricZeroQuartetPolynomial ρ).eval (-z) =
      (symmetricZeroQuartetPolynomial ρ).eval z := by
  simp only [symmetricZeroQuartetPolynomial_eval]
  ring

/-- The orbit polynomial is Schwarz symmetric.-/
theorem symmetricZeroQuartetPolynomial_conj (ρ z : ℂ) :
    (symmetricZeroQuartetPolynomial ρ).eval (star z) =
      star ((symmetricZeroQuartetPolynomial ρ).eval z) := by
  simp only [symmetricZeroQuartetPolynomial_eval]
  simp only [star_mul, star_add, star_sub, star_star]
  ring

/-- **Concrete quartet obstruction.** If the generating zero lies in the
upper half-plane, the even Schwarz-symmetric quartet polynomial has an
explicit non-root probe in the upper half-plane at which its logarithmic
derivative has positive imaginary part.-/
theorem symmetricZeroQuartet_forces_lowerProbe_signViolation
    {ρ : ℂ} (hupper : 0 < ρ.im) :
    ∃ ε : ℝ, 0 < ε ∧ ε < ρ.im ∧
      0 < (ρ - (ε : ℂ) * Complex.I).im ∧
      (symmetricZeroQuartetPolynomial ρ).eval
        (ρ - (ε : ℂ) * Complex.I) ≠ 0 ∧
      0 < (polynomialLogDerivResponse
        (symmetricZeroQuartetPolynomial ρ)
        (ρ - (ε : ℂ) * Complex.I)).im :=
  polynomial_upper_root_has_lowerProbe_signViolation
    (symmetricZeroQuartetPolynomial ρ)
    (symmetricZeroQuartetPolynomial_ne_zero ρ)
    (symmetricZeroQuartetPolynomial_root ρ) hupper

/-- Consequently the quartet polynomial cannot satisfy the anti-Herglotz
upper-half-plane sign condition.-/
theorem symmetricZeroQuartet_not_antiHerglotz
    {ρ : ℂ} (hupper : 0 < ρ.im) :
    ¬ AntiHerglotzUHP
      (polynomialLogDerivResponse (symmetricZeroQuartetPolynomial ρ)) := by
  intro hanti
  obtain ⟨ε, _hε, _hεUpper, hprobeUpper, _hprobeNonzero, hprobePos⟩ :=
    symmetricZeroQuartet_forces_lowerProbe_signViolation hupper
  exact (not_lt_of_ge (hanti _ hprobeUpper)) hprobePos

end OverflowResidueRH
