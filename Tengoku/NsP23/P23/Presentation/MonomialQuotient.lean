import Tengoku.NsP23.P23.Presentation.NormalMonoidAlgebra
import Tengoku.Seed.Data.Finset.Max

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# The monomial quotient of the normalized one-tie monoid algebra

The killed ideal is defined independently as a monomial span.  It is then
identified with the truncation kernel and, in the live parameter domain, with
the ideal generated by the exact frozen minimal border.
-/

namespace P23.Presentation

noncomputable section

open P23.OneTie P23.Artin

variable {k : Type*} [Field k]
variable {a b c : ℕ} [NeZero a]

/-- Canonical monomials whose normalized exponents do not survive.-/
def killedMonomialSet (S : Finset (Normal a b c)) :
    Set (NormalMonoidAlgebra k a b c) :=
  {f | ∃ p, p ∉ standardSet S ∧ f = monomial (k := k) p}

/-- The independently defined ideal spanned by all killed monomials.-/
def killedMonomialIdeal (S : Finset (Normal a b c)) :
    Ideal (NormalMonoidAlgebra k a b c) :=
  Ideal.span (killedMonomialSet (k := k) S)

/--
@isnad1 id=mem.1h6v.s7.b74b72ba0f24 from=translated src=- shape=db85d06c vocab=4829e901
-/
theorem monomial_mem_killedMonomialIdeal (S : Finset (Normal a b c))
    (p : Normal a b c) (hp : p ∉ standardSet S) :
    monomial (k := k) p ∈ killedMonomialIdeal (k := k) S := by
  apply Ideal.subset_span
  exact ⟨p, hp, rfl⟩

/--
@isnad1 id=le.0h5v.s9.073aeff27627 from=translated src=- shape=4461727c vocab=81a6c569
-/
theorem killedMonomialIdeal_le_ker (S : Finset (Normal a b c)) :
    killedMonomialIdeal (k := k) S ≤
      RingHom.ker (truncateAlgHom (k := k) S).toRingHom := by
  apply Ideal.span_le.2
  rintro f ⟨p, hp, rfl⟩
  apply RingHom.mem_ker.2
  apply truncateAlgHom_monomial_of_not_mem
  exact fun hfin => hp ((mem_standardFinset_iff_standardSet S p).1 hfin)

/--
@isnad1 id=le.0h5v.s9.bcfe7f359e1d from=translated src=- shape=6fb2097a vocab=81a6c569
-/
theorem ker_le_killedMonomialIdeal (S : Finset (Normal a b c)) :
    RingHom.ker (truncateAlgHom (k := k) S).toRingHom ≤
      killedMonomialIdeal (k := k) S := by
  intro f hf
  have hf0 : truncateAlgHom (k := k) S f = 0 := RingHom.mem_ker.1 hf
  rw [← MonoidAlgebra.sum_coeff_single f]
  apply Submodule.sum_mem
  intro p hpSupport
  by_cases hp : p ∈ standardSet S
  · have hpFin : p ∈ standardFinset S :=
      (mem_standardFinset_iff_standardSet S p).2 hp
    have hc := congrArg
      (fun v : MonomialArtin k S => v.coeff ⟨p, hpFin⟩) hf0
    have hcoeff : f.coeff p = 0 := by
      simpa [coeff_truncateAlgHom] using hc
    simp [hcoeff]
  · have hm := monomial_mem_killedMonomialIdeal (k := k) S p hp
    have hsmul := (killedMonomialIdeal (k := k) S).mul_mem_left
      (algebraMap k (NormalMonoidAlgebra k a b c) (f.coeff p)) hm
    simpa [monomial, Algebra.smul_def] using hsmul

/-- Exact identification of the independently defined killed span with the
truncation kernel.
@isnad1 id=eq.0h5v.s8.4a003bfc1ff4 from=translated src=- shape=6fb2097a vocab=6e75310e
-/
theorem truncateAlgHom_ker (S : Finset (Normal a b c)) :
    RingHom.ker (truncateAlgHom (k := k) S).toRingHom =
      killedMonomialIdeal (k := k) S := by
  apply le_antisymm
  · exact ker_le_killedMonomialIdeal (k := k) S
  · exact killedMonomialIdeal_le_ker (k := k) S

/-- Canonical monomials indexed by the exact frozen border.-/
def borderMonomialSet (S : Finset (Normal a b c)) :
    Set (NormalMonoidAlgebra k a b c) :=
  {f | ∃ g ∈ borderFinset S, f = monomial (k := k) g}

/-- The ideal generated by exact minimal-border monomials.-/
def borderMonomialIdeal (S : Finset (Normal a b c)) :
    Ideal (NormalMonoidAlgebra k a b c) :=
  Ideal.span (borderMonomialSet (k := k) S)

/-- A positive additive weight respected by normalized one-tie
multiplication.-/
def normalWeight (p : Normal a b c) : ℕ :=
  (b + c) * p.x + a * p.y + a * p.z

/--
@isnad1 id=eq.0h5v.s6.907eb2dc3e70 from=translated src=- shape=840f865f vocab=bf279203
-/
theorem normalWeight_mul (p q : Normal a b c) :
    normalWeight (p * q) = normalWeight p + normalWeight q := by
  have hdiv := Nat.mod_add_div (p.x + q.x) a
  simp only [normalWeight, Normal.mul_x, Normal.mul_y, Normal.mul_z]
  calc
    (b + c) * ((p.x + q.x) % a) +
          a * (p.y + q.y + (p.x + q.x) / a * b) +
          a * (p.z + q.z + (p.x + q.x) / a * c) =
        a * p.y + a * q.y + a * p.z + a * q.z +
          (b + c) * ((p.x + q.x) % a + a * ((p.x + q.x) / a)) := by ring
    _ = a * p.y + a * q.y + a * p.z + a * q.z +
          (b + c) * (p.x + q.x) := by rw [hdiv]
    _ = ((b + c) * p.x + a * p.y + a * p.z) +
          ((b + c) * q.x + a * q.y + a * q.z) := by ring

/--
@isnad1 id=lt.2h4v.s6.5e45f2fbca93 from=translated src=- shape=18e72703 vocab=5f6ea539
-/
theorem normalWeight_pos_of_ne_one (hdom : IsLiveParameterDomain a b c)
    (p : Normal a b c) (hp : p ≠ 1) : 0 < normalWeight p := by
  have ha : 0 < a := Nat.pos_of_ne_zero (NeZero.ne a)
  have hbc : 0 < b + c := by
    rcases hdom.2 with hmix | hpure
    · omega
    · omega
  by_cases hx : 0 < p.x
  · have hpos : 0 < (b + c) * p.x := Nat.mul_pos hbc hx
    unfold normalWeight
    omega
  by_cases hy : 0 < p.y
  · have hpos : 0 < a * p.y := Nat.mul_pos ha hy
    unfold normalWeight
    omega
  by_cases hz : 0 < p.z
  · have hpos : 0 < a * p.z := Nat.mul_pos ha hz
    unfold normalWeight
    omega
  exfalso
  apply hp
  apply Normal.ext <;> simp <;> omega

/--
@isnad1 id=lt.3h5v.s5.1301048b8768 from=translated src=- shape=bfc886b2 vocab=09338896
-/
theorem normalWeight_lt_of_proper_dvd (hdom : IsLiveParameterDomain a b c)
    {d p : Normal a b c} (hdp : d ∣ p) (hne : d ≠ p) :
    normalWeight d < normalWeight p := by
  rcases hdp with ⟨t, rfl⟩
  have ht : t ≠ 1 := by
    intro ht
    subst t
    exact hne (by simp)
  rw [normalWeight_mul]
  have hpos := normalWeight_pos_of_ne_one hdom t ht
  omega

/-- Every killed monomial has a divisibility-minimal killed divisor, hence an
exact border divisor, in the live one-tie parameter domain.
@isnad1 id=ex.3h5v.s6.c8151b8b5c43 from=translated src=- shape=415e3ff2 vocab=de8e0002
-/
theorem killed_has_border_divisor (S : Finset (Normal a b c))
    (hS : S.Nonempty) (hdom : IsLiveParameterDomain a b c)
    (p : Normal a b c) (hp : p ∉ standardSet S) :
    ∃ g ∈ borderFinset S, g ∣ p := by
  classical
  let K := (Normal.divisorFinset p).filter fun q => q ∉ standardSet S
  have hpK : p ∈ K := by
    simp [K, Normal.mem_divisorFinset_iff, hp]
  obtain ⟨g, hgK, hmin⟩ := K.exists_min_image normalWeight ⟨p, hpK⟩
  have hgp : g ∣ p := (Normal.mem_divisorFinset_iff g p).1 (Finset.mem_filter.1 hgK).1
  have hgkill : g ∉ standardSet S := (Finset.mem_filter.1 hgK).2
  have hgminimal : IsDivisibilityMinimalKilled (standardSet S) g := by
    refine ⟨hgkill, ?_⟩
    intro d hdg hdne
    by_contra hdkill
    have hdK : d ∈ K := by
      apply Finset.mem_filter.2
      exact ⟨(Normal.mem_divisorFinset_iff d p).2 (dvd_trans hdg hgp), hdkill⟩
    have hle := hmin d hdK
    have hlt := normalWeight_lt_of_proper_dvd hdom hdg hdne
    omega
  have hborder : IsMinimalBorder (standardSet S) g :=
    (isMinimalBorder_iff_isDivisibilityMinimalKilled S g
      (variableGenerators_ne_one_of_two_le hdom.1)).2 hgminimal
  exact ⟨g, (mem_borderFinset_iff hS g).2 hborder, hgp⟩

/--
@isnad1 id=mem.1h6v.s8.ec471f56ba68 from=translated src=- shape=fa7834d9 vocab=a3147721
-/
theorem monomial_mem_borderMonomialIdeal_of_border
    (S : Finset (Normal a b c)) (g : Normal a b c)
    (hg : g ∈ borderFinset S) :
    monomial (k := k) g ∈ borderMonomialIdeal (k := k) S := by
  apply Ideal.subset_span
  exact ⟨g, hg, rfl⟩

/--
@isnad1 id=mem.2h7v.s8.3002f8c76b25 from=translated src=- shape=23e3145f vocab=0d2e5319
-/
theorem monomial_mem_borderMonomialIdeal_of_dvd
    (S : Finset (Normal a b c)) {g p : Normal a b c}
    (hg : g ∈ borderFinset S) (hgp : g ∣ p) :
    monomial (k := k) p ∈ borderMonomialIdeal (k := k) S := by
  rcases hgp with ⟨q, rfl⟩
  have hgen := monomial_mem_borderMonomialIdeal_of_border (k := k) S g hg
  have hmul := (borderMonomialIdeal (k := k) S).mul_mem_left
    (monomial (k := k) q) hgen
  simpa [mul_comm] using hmul

/--
@isnad1 id=le.1h5v.s7.a22f8f40c565 from=translated src=- shape=83b7a1ca vocab=6f8236b7
-/
theorem borderMonomialIdeal_le_killedMonomialIdeal
    (S : Finset (Normal a b c)) (hS : S.Nonempty) :
    borderMonomialIdeal (k := k) S ≤ killedMonomialIdeal (k := k) S := by
  apply Ideal.span_le.2
  rintro f ⟨g, hg, rfl⟩
  apply monomial_mem_killedMonomialIdeal
  exact ((mem_borderFinset_iff hS g).1 hg).1

/--
@isnad1 id=le.2h5v.s7.3abb331cc3ff from=translated src=- shape=789db0a5 vocab=43b2802e
-/
theorem killedMonomialIdeal_le_borderMonomialIdeal
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) :
    killedMonomialIdeal (k := k) S ≤ borderMonomialIdeal (k := k) S := by
  apply Ideal.span_le.2
  rintro f ⟨p, hp, rfl⟩
  rcases killed_has_border_divisor S hS hdom p hp with ⟨g, hg, hgp⟩
  exact monomial_mem_borderMonomialIdeal_of_dvd (k := k) S hg hgp

/-- In the live one-tie domain, the exact frozen border generates precisely
the killed monomial ideal.
@isnad1 id=eq.2h5v.s6.2d99744df391 from=translated src=- shape=789db0a5 vocab=1d60abd4
-/
theorem borderMonomialIdeal_eq_killedMonomialIdeal
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) :
    borderMonomialIdeal (k := k) S = killedMonomialIdeal (k := k) S := by
  apply le_antisymm
  · exact borderMonomialIdeal_le_killedMonomialIdeal (k := k) S hS
  · exact killedMonomialIdeal_le_borderMonomialIdeal (k := k) S hS hdom

/-- The normalized monomial quotient by the independently defined killed
ideal.-/
abbrev NormalMonomialQuotient (k : Type*) [Field k]
    (S : Finset (Normal a b c)) :=
  NormalMonoidAlgebra k a b c ⧸ killedMonomialIdeal (k := k) S

/-- The genuine quotient algebra equivalence with the frozen direct model.-/
noncomputable def normalMonomialQuotientEquiv
    (S : Finset (Normal a b c)) :
    NormalMonomialQuotient k S ≃ₐ[k] MonomialArtin k S :=
  (Ideal.quotientEquivAlgOfEq k (truncateAlgHom_ker (k := k) S).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective
      (truncateAlgHom_surjective (k := k) S))

/--
@isnad1 id=eq.0h6v.s10.8894664fd93a from=translated src=- shape=6e0873df vocab=217e5de9
-/
@[simp]
theorem normalMonomialQuotientEquiv_mk
    (S : Finset (Normal a b c)) (f : NormalMonoidAlgebra k a b c) :
    normalMonomialQuotientEquiv (k := k) S
        (Ideal.Quotient.mk (killedMonomialIdeal (k := k) S) f) =
      truncateAlgHom (k := k) S f := by
  rfl

/--
@isnad1 id=eq.1h6v.s10.70646b39060d from=translated src=- shape=9aaac7e4 vocab=95de856e
-/
theorem normalMonomialQuotientEquiv_monomial_of_mem
    (S : Finset (Normal a b c)) (p : Normal a b c)
    (hp : p ∈ standardFinset S) :
    normalMonomialQuotientEquiv (k := k) S
        (Ideal.Quotient.mk (killedMonomialIdeal (k := k) S)
          (monomial (k := k) p)) = X (k := k) S p hp := by
  simp [hp]

/--
@isnad1 id=eq.1h6v.s10.df5cf9e338f5 from=translated src=- shape=130bf709 vocab=19a51ce4
-/
theorem normalMonomialQuotientEquiv_monomial_of_not_mem
    (S : Finset (Normal a b c)) (p : Normal a b c)
    (hp : p ∉ standardFinset S) :
    normalMonomialQuotientEquiv (k := k) S
        (Ideal.Quotient.mk (killedMonomialIdeal (k := k) S)
          (monomial (k := k) p)) = 0 := by
  simp [hp]

/-- The quotient by the exact minimal-border ideal, transported through its
equality with the independently defined killed ideal.-/
noncomputable def borderMonomialQuotientEquiv
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) :
    (NormalMonoidAlgebra k a b c ⧸ borderMonomialIdeal (k := k) S) ≃ₐ[k]
      MonomialArtin k S :=
  (Ideal.quotientEquivAlgOfEq k
      (borderMonomialIdeal_eq_killedMonomialIdeal
        (k := k) S hS hdom)).trans
    (normalMonomialQuotientEquiv (k := k) S)

/--
@isnad1 id=eq.2h6v.s10.60c36df1feee from=translated src=- shape=681eddd5 vocab=d3835e42
-/
@[simp]
theorem borderMonomialQuotientEquiv_monomial
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (p : Normal a b c) :
    borderMonomialQuotientEquiv (k := k) S hS hdom
        (Ideal.Quotient.mk (borderMonomialIdeal (k := k) S)
          (monomial (k := k) p)) =
      truncatedMonomial (k := k) S p := by
  simp [borderMonomialQuotientEquiv]

/-- Scope-explicit statement that the direct finite model is the normalized
monoid algebra modulo the ideal generated by its exact minimal border.-/
structure DirectModelAsNormalMonoidQuotient : Prop where
  presentation : ∀ (a b c : ℕ) [NeZero a]
    (S : Finset (Normal a b c)), S.Nonempty →
    IsLiveParameterDomain a b c →
    ∃ e : (NormalMonoidAlgebra k a b c ⧸ borderMonomialIdeal (k := k) S) ≃ₐ[k]
        MonomialArtin k S,
      ∀ p : Normal a b c,
        e (Ideal.Quotient.mk (borderMonomialIdeal (k := k) S)
          (monomial (k := k) p)) = truncatedMonomial (k := k) S p

/--
@isnad1 id=directmo.0h1v.s3.bb90f19d5181 from=translated src=- shape=c6850a32 vocab=9816a1b8
-/
theorem directModel_as_normalMonoidQuotient :
    DirectModelAsNormalMonoidQuotient (k := k) := by
  constructor
  intro a b c _ S hS hdom
  refine ⟨borderMonomialQuotientEquiv (k := k) S hS hdom, ?_⟩
  intro p
  exact borderMonomialQuotientEquiv_monomial (k := k) S hS hdom p

end

end P23.Presentation
