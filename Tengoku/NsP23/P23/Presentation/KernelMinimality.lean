import Tengoku.NsP23.P23.Presentation.FinitePolynomialQuotient
import Tengoku.Seed.RingTheory.MvPolynomial.Ideal
import Tengoku.Seed.LinearAlgebra.Dimension.Free
import Tengoku.Seed.LinearAlgebra.StdBasis

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Exact minimal generator count for the finite polynomial presentation

This file proves the live one-tie equation

`mu (ker (polyToDirectAlg S)) = 1 + (borderFinset S).card`.

The lower bound is universal: it applies to every finite ideal generating
family, not only to subfamilies of the displayed tie-plus-border family.
-/

namespace P23.Presentation

noncomputable section

open P23.OneTie P23.Artin

variable {k : Type*} [Field k]
variable {a b c : ℕ} [NeZero a]

/-- Evaluation of a three-variable polynomial at `x=y=z=0`.-/
def polyAugmentation : ThreePoly k →ₐ[k] k where
  __ := (MvPolynomial.constantCoeff : ThreePoly k →+* k)
  commutes' r := by simp

@[simp]
theorem polyAugmentation_apply (f : ThreePoly k) :
    polyAugmentation f = MvPolynomial.constantCoeff f := rfl

/-- The polynomial variable maximal ideal, defined as the augmentation
kernel.-/
def polyVariableIdeal : Ideal (ThreePoly k) :=
  RingHom.ker (polyAugmentation (k := k)).toRingHom

theorem mem_polyVariableIdeal_iff (f : ThreePoly k) :
    f ∈ polyVariableIdeal (k := k) ↔ MvPolynomial.constantCoeff f = 0 := by
  rfl

@[simp] theorem polyX_mem_polyVariableIdeal :
    (polyX : ThreePoly k) ∈ polyVariableIdeal (k := k) := by
  simp [mem_polyVariableIdeal_iff, polyX]

@[simp] theorem polyY_mem_polyVariableIdeal :
    (polyY : ThreePoly k) ∈ polyVariableIdeal (k := k) := by
  simp [mem_polyVariableIdeal_iff, polyY]

@[simp] theorem polyZ_mem_polyVariableIdeal :
    (polyZ : ThreePoly k) ∈ polyVariableIdeal (k := k) := by
  simp [mem_polyVariableIdeal_iff, polyZ]

/-- The augmentation kernel is exactly the ideal generated by the three
polynomial variables.-/
theorem polyVariableIdeal_eq_span_variables :
    polyVariableIdeal (k := k) =
      Ideal.span ({polyX, polyY, polyZ} : Set (ThreePoly k)) := by
  ext f
  rw [mem_polyVariableIdeal_iff]
  have hvars : ({polyX, polyY, polyZ} : Set (ThreePoly k)) =
      MvPolynomial.X '' (Set.univ : Set (Fin 3)) := by
    ext p
    constructor
    · simp only [Set.mem_insert_iff, Set.mem_singleton_iff,
        Set.mem_image, Set.mem_univ, true_and]
      rintro (rfl | rfl | rfl)
      · exact ⟨0, rfl⟩
      · exact ⟨1, rfl⟩
      · exact ⟨2, rfl⟩
    · rintro ⟨i, -, rfl⟩
      fin_cases i <;> simp [polyX, polyY, polyZ]
  rw [hvars, MvPolynomial.mem_ideal_span_X_image]
  constructor
  · intro hzero m hm
    have hm0 : m ≠ 0 := by
      intro h
      subst m
      exact (MvPolynomial.mem_support_iff.mp hm) hzero
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
    refine ⟨i, Set.mem_univ i, hi⟩
  · intro hsupport
    by_contra hzero
    have hmem : (0 : Fin 3 →₀ ℕ) ∈ f.support :=
      MvPolynomial.mem_support_iff.mpr hzero
    obtain ⟨i, -, hi⟩ := hsupport 0 hmem
    exact hi rfl

private theorem monomial_ne_zero (p : Normal a b c) :
    monomial (k := k) p ≠ 0 := by
  intro h
  have := congrArg (fun f : NormalMonoidAlgebra k a b c => f.coeff p) h
  simpa using this

/-- The live tie cannot coincide with any displayed border lift.-/
theorem tiePolynomial_ne_polynomialLift_of_border
    (S : Finset (Normal a b c)) {g : Normal a b c}
    (hg : g ∈ borderFinset S) :
    tiePolynomial (k := k) a b c ≠ polynomialLift (k := k) g := by
  intro h
  have hmap := congrArg
    (polyToNormalAlg (k := k) (a := a) (b := b) (c := c)) h
  exact (monomial_ne_zero (k := k) g) (by simpa using hmap.symm)

/-- The displayed Run 15 family has one tie generator plus one distinct lift
for every exact border point.-/
theorem presentationGeneratorFinset_card
    (S : Finset (Normal a b c)) :
    (presentationGeneratorFinset (k := k) S).card =
      1 + (borderFinset S).card := by
  classical
  rw [presentationGeneratorFinset, Finset.card_insert_of_notMem]
  · rw [Finset.card_image_of_injective _
      (polynomialLift_injective (k := k) (a := a) (b := b) (c := c))]
    omega
  · simp only [Finset.mem_image, not_exists, not_and]
    intro g hg
    exact (tiePolynomial_ne_polynomialLift_of_border (k := k) S hg).symm

/-- The part of `mI` lying in the ideal subtype `I`.-/
def presentationRelationSubmodule (S : Finset (Normal a b c)) :
    Submodule k (finitePresentationIdeal (k := k) S) :=
  (Submodule.comap (finitePresentationIdeal (k := k) S).subtype
      ((polyVariableIdeal (k := k) * finitePresentationIdeal (k := k) S :
        Ideal (ThreePoly k)) : Submodule (ThreePoly k) (ThreePoly k))).restrictScalars k

/-- The exact relation space `I / (mI)` over the coefficient field.-/
abbrev PresentationRelationSpace (S : Finset (Normal a b c)) :=
  (finitePresentationIdeal (k := k) S) ⧸ presentationRelationSubmodule (k := k) S

/-- The class of an element of the presentation ideal in `I/(mI)`.-/
def relationClass (S : Finset (Normal a b c))
    (f : ThreePoly k) (hf : f ∈ finitePresentationIdeal (k := k) S) :
    PresentationRelationSpace (k := k) S :=
  (presentationRelationSubmodule (k := k) S).mkQ ⟨f, hf⟩

/-- The raw polynomial exponent of the `x^a` term of the tie.-/
def tieXExponent (a : ℕ) : Fin 3 →₀ ℕ := Finsupp.single 0 a

/-- One detector coordinate for the tie and one for each exact border point.-/
abbrev RelationDetectorIndex (S : Finset (Normal a b c)) :=
  Option ↥(borderFinset S)

private def normalCoeffAt (p : Normal a b c) :
    NormalMonoidAlgebra k a b c →ₗ[k] k where
  toFun f := f.coeff p
  map_add' _ _ := by simp
  map_smul' _ _ := by simp

/-- Raw coefficient detectors.  `none` reads the `x^a` coefficient; `some g`
reads the coefficient of the reduced lift of the border exponent `g`.-/
def relationDetector (S : Finset (Normal a b c)) :
    ThreePoly k →ₗ[k] (RelationDetectorIndex S → k) :=
  LinearMap.pi fun i =>
    match i with
    | none => MvPolynomial.lcoeff k (tieXExponent a)
    | some g => (normalCoeffAt (k := k) g.1).comp
        (polyToNormalAlg (k := k) (a := a) (b := b) (c := c)).toLinearMap

@[simp]
theorem relationDetector_none (S : Finset (Normal a b c)) (f : ThreePoly k) :
    relationDetector (k := k) S f none = f.coeff (tieXExponent a) := rfl

@[simp]
theorem relationDetector_some (S : Finset (Normal a b c))
    (f : ThreePoly k) (g : ↥(borderFinset S)) :
    relationDetector (k := k) S f (some g) =
      (polyToNormalAlg (k := k) f).coeff g.1 := rfl

private theorem liveDomain_b_pos (hdom : IsLiveParameterDomain a b c) : 0 < b := by
  rcases hdom with ⟨-, hmix | hpure⟩ <;> omega

private theorem normalExponent_ne_tieXExponent (p : Normal a b c) :
    normalExponent p ≠ tieXExponent a := by
  intro h
  have hx := congrArg (fun d : Fin 3 →₀ ℕ => d 0) h
  simp [tieXExponent] at hx
  have hp := p.x_lt
  omega

private theorem border_not_standard
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    {g : Normal a b c} (hg : g ∈ borderFinset S) :
    g ∉ standardSet S :=
  ((mem_borderFinset_iff hS g).1 hg).1

private theorem border_dvd_border_eq
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c)
    {g h : Normal a b c} (hg : g ∈ borderFinset S)
    (hh : h ∈ borderFinset S) (hdvd : h ∣ g) : h = g := by
  by_contra hne
  have hgmin : IsDivisibilityMinimalKilled (standardSet S) g :=
    (isMinimalBorder_iff_isDivisibilityMinimalKilled S g
      (variableGenerators_ne_one_of_two_le hdom.1)).1
      ((mem_borderFinset_iff hS g).1 hg)
  exact border_not_standard S hS hh (hgmin.2 h hdvd hne)

private theorem border_normalExponent_not_le_tieX
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hlive : IsLiveTie S) {g : Normal a b c}
    (hg : g ∈ borderFinset S) :
    ¬normalExponent g ≤ tieXExponent a := by
  intro hle
  have hgy : g.y = 0 := by
    have hgyLe : g.y ≤ 0 := by
      simpa [normalExponent, tieXExponent] using hle 1
    exact Nat.eq_zero_of_le_zero hgyLe
  have hgz : g.z = 0 := by
    have hgzLe : g.z ≤ 0 := by
      simpa [normalExponent, tieXExponent] using hle 2
    exact Nat.eq_zero_of_le_zero hgzLe
  have hdvd : g ∣ (liveTiePoint : Normal a b c) := by
    apply (Normal.exact_divides_iff g liveTiePoint).2
    simp [Normal.DividesCriterion, liveTiePoint, hgy, hgz]
  exact border_not_standard S hS hg (standardSet_dvd_closed S hlive.2.2.2 hdvd)

@[simp]
theorem relationDetector_tie_none
    (S : Finset (Normal a b c))
    (hdom : IsLiveParameterDomain a b c) :
    relationDetector (k := k) S (tiePolynomial (k := k) a b c) none = 1 := by
  classical
  have hne :
      (Finsupp.single 1 b + Finsupp.single 2 c : Fin 3 →₀ ℕ) ≠
        tieXExponent a := by
    intro h
    have hy := congrArg (fun d : Fin 3 →₀ ℕ => d 1) h
    simp [tieXExponent] at hy
    exact (Nat.ne_of_gt (liveDomain_b_pos hdom)) hy
  rw [tiePolynomial]
  rw [show (polyX : ThreePoly k) ^ a =
      MvPolynomial.monomial (tieXExponent a) (1 : k) by
    unfold polyX tieXExponent
    rw [MvPolynomial.X_pow_eq_monomial]]
  rw [show (polyY : ThreePoly k) ^ b * polyZ ^ c =
      MvPolynomial.monomial
        (Finsupp.single 1 b + Finsupp.single 2 c) (1 : k) by
    unfold polyY polyZ
    rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.X_pow_eq_monomial,
      MvPolynomial.monomial_mul_monomial]
    simp]
  simp [relationDetector, MvPolynomial.coeff_monomial, hne]

@[simp]
theorem relationDetector_lift_none
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hlive : IsLiveTie S) (g : ↥(borderFinset S)) :
    relationDetector (k := k) S (polynomialLift (k := k) g.1) none = 0 := by
  classical
  simp [relationDetector, polynomialLift, MvPolynomial.coeff_monomial,
    normalExponent_ne_tieXExponent (p := g.1)]

@[simp]
theorem relationDetector_tie_some
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S)
    (g : ↥(borderFinset S)) :
    relationDetector (k := k) S (tiePolynomial (k := k) a b c) (some g) = 0 := by
  simp [relationDetector]

@[simp]
theorem relationDetector_lift_some
    (S : Finset (Normal a b c)) (g h : ↥(borderFinset S)) :
    relationDetector (k := k) S (polynomialLift (k := k) h.1) (some g) =
      if g = h then 1 else 0 := by
  classical
  rw [relationDetector_some, polyToNormalAlg_polynomialLift]
  change (monomial (k := k) h.1).coeff g.1 = _
  by_cases e : g = h
  · subst h
    simp
  · have hval : g.1 ≠ h.1 := by
      intro hv
      exact e (Subtype.ext hv)
    simp [monomial_coeff, hval, Ne.symm hval, e]

private theorem normalizeExponent_eq_one_iff
    (hdom : IsLiveParameterDomain a b c) (d : Fin 3 →₀ ℕ) :
    normalizeExponent a b c d = (1 : Normal a b c) ↔ d = 0 := by
  constructor
  · intro h
    have hx := congrArg Normal.x h
    have hy := congrArg Normal.y h
    have hz := congrArg Normal.z h
    simp [normalizeExponent, exponentRaw, Normal.normalize, Normal.one] at hx hy hz
    have hb : 0 < b := liveDomain_b_pos hdom
    have hlt : d 0 < a := by
      rcases hy.2 with (ha0 | hlt) | hb0
      · exact (NeZero.ne a ha0).elim
      · exact hlt
      · exact (Nat.ne_of_gt hb hb0).elim
    have hd0 : d 0 = 0 := by
      simpa [Nat.mod_eq_of_lt hlt] using hx
    apply Finsupp.ext
    intro i
    fin_cases i
    · simpa using hd0
    · simpa using hy.1
    · simpa using hz.1
  · rintro rfl
    apply Normal.ext <;>
      simp [normalizeExponent, exponentRaw, Normal.normalize, Normal.one]

private theorem coeff_one_polyToNormalAlg
    (hdom : IsLiveParameterDomain a b c) (f : ThreePoly k) :
    (polyToNormalAlg (k := k) (a := a) (b := b) (c := c) f).coeff 1 =
      MvPolynomial.constantCoeff f := by
  classical
  rw [coeff_polyToNormalAlg]
  simp [normalizeExponent_eq_one_iff hdom,
    MvPolynomial.constantCoeff_eq, eq_comm]

private theorem relationDetector_mul_tie_none
    (S : Finset (Normal a b c))
    (hdom : IsLiveParameterDomain a b c) (q : ThreePoly k) :
    relationDetector (k := k) S
        (q * tiePolynomial (k := k) a b c) none =
      MvPolynomial.constantCoeff q := by
  classical
  let yz : Fin 3 →₀ ℕ := Finsupp.single 1 b + Finsupp.single 2 c
  have hnle : ¬yz ≤ tieXExponent a := by
    intro h
    have hy := h 1
    simp [yz, tieXExponent] at hy
    exact (Nat.ne_of_gt (liveDomain_b_pos hdom)) hy
  rw [tiePolynomial, mul_sub]
  rw [show (polyX : ThreePoly k) ^ a =
      MvPolynomial.monomial (tieXExponent a) (1 : k) by
    unfold polyX tieXExponent
    rw [MvPolynomial.X_pow_eq_monomial]]
  rw [show (polyY : ThreePoly k) ^ b * polyZ ^ c =
      MvPolynomial.monomial yz (1 : k) by
    unfold polyY polyZ yz
    rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.X_pow_eq_monomial,
      MvPolynomial.monomial_mul_monomial]
    simp]
  simp [relationDetector, MvPolynomial.coeff_mul_monomial', hnle,
    MvPolynomial.constantCoeff_eq]

private theorem relationDetector_mul_lift_none
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hlive : IsLiveTie S) (q : ThreePoly k)
    (g : ↥(borderFinset S)) :
    relationDetector (k := k) S
        (q * polynomialLift (k := k) g.1) none = 0 := by
  classical
  simp [relationDetector, polynomialLift, MvPolynomial.coeff_mul_monomial',
    border_normalExponent_not_le_tieX S hS hlive g.2]

private theorem relationDetector_mul_tie_some
    (S : Finset (Normal a b c)) (q : ThreePoly k)
    (g : ↥(borderFinset S)) :
    relationDetector (k := k) S
        (q * tiePolynomial (k := k) a b c) (some g) = 0 := by
  simp [relationDetector]

private theorem relationDetector_mul_lift_some
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (q : ThreePoly k)
    (g h : ↥(borderFinset S)) :
    relationDetector (k := k) S
        (q * polynomialLift (k := k) h.1) (some g) =
      if g = h then MvPolynomial.constantCoeff q else 0 := by
  classical
  rw [relationDetector_some, map_mul, polyToNormalAlg_polynomialLift]
  change ((polyToNormalAlg (k := k) q) * MonoidAlgebra.single h.1 1).coeff g.1 = _
  by_cases e : g = h
  · subst h
    rw [MonoidAlgebra.coeff_mul_single_eq_coeff_mul (m₂ := 1)]
    · simp [coeff_one_polyToNormalAlg (k := k) hdom]
    · intro d hd
      constructor
      · intro heq
        exact Normal.mul_right_cancel (p := g.1) (by simpa using heq)
      · rintro rfl
        simp
  · have hne : ∀ d : Normal a b c, d * h.1 ≠ g.1 := by
      intro d hd
      apply e
      apply Subtype.ext
      exact (border_dvd_border_eq S hS hdom g.2 h.2
        ⟨d, by simpa [mul_comm] using hd.symm⟩).symm
    simp [MonoidAlgebra.coeff_mul_single_of_forall_mul_ne, hne, e]

private theorem relationDetector_mul_displayed_eq_zero
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S)
    {q f : ThreePoly k} (hq : q ∈ polyVariableIdeal (k := k))
    (hf : f ∈ presentationGeneratorFinset (k := k) S) :
    relationDetector (k := k) S (q * f) = 0 := by
  classical
  have hq0 : MvPolynomial.constantCoeff q = 0 :=
    (mem_polyVariableIdeal_iff q).1 hq
  rw [presentationGeneratorFinset] at hf
  rcases Finset.mem_insert.mp hf with rfl | hf
  · ext i
    cases i with
    | none => simp [relationDetector_mul_tie_none (k := k) S hdom q, hq0]
    | some g => simp [relationDetector_mul_tie_some (k := k) S q g]
  · rcases Finset.mem_image.mp hf with ⟨g, hg, rfl⟩
    ext i
    cases i with
    | none =>
        exact relationDetector_mul_lift_none (k := k) S hS hlive q ⟨g, hg⟩
    | some r =>
        simp [relationDetector_mul_lift_some (k := k) S hS hdom q r ⟨g, hg⟩,
          hq0]

/-- Public symbolic regression interface: every variable-ideal coefficient
times every displayed presentation generator is killed by all relation
detectors.-/
theorem relationDetector_mul_presentationGenerator_eq_zero
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S)
    (q : ThreePoly k) (hq : q ∈ polyVariableIdeal (k := k))
    (f : ThreePoly k) (hf : f ∈ presentationGeneratorFinset (k := k) S) :
    relationDetector (k := k) S (q * f) = 0 :=
  relationDetector_mul_displayed_eq_zero S hS hdom hlive hq hf

private theorem relationDetector_eq_zero_of_mem_mul
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S)
    {f : ThreePoly k}
    (hf : f ∈ polyVariableIdeal (k := k) *
      finitePresentationIdeal (k := k) S) :
    relationDetector (k := k) S f = 0 := by
  classical
  have hf' : f ∈ polyVariableIdeal (k := k) •
      Submodule.span (ThreePoly k)
        ((id : ThreePoly k → ThreePoly k) ''
          (↑(presentationGeneratorFinset (k := k) S) : Set (ThreePoly k))) := by
    change f ∈ polyVariableIdeal (k := k) •
      (finitePresentationIdeal (k := k) S : Submodule (ThreePoly k) (ThreePoly k)) at hf
    rw [← span_presentationGeneratorFinset (k := k) S] at hf
    simpa using hf
  obtain ⟨coeff, hcoeff, hsum⟩ :=
    (Submodule.mem_ideal_smul_span_iff_exists_sum'
      (polyVariableIdeal (k := k))
      (↑(presentationGeneratorFinset (k := k) S) : Set (ThreePoly k))
      (id : ThreePoly k → ThreePoly k) f).1 hf'
  rw [← hsum]
  simp only [Finsupp.sum, id_eq, smul_eq_mul, map_sum]
  apply Finset.sum_eq_zero
  intro i hi
  exact relationDetector_mul_displayed_eq_zero S hS hdom hlive
    (hcoeff i) i.2

private theorem mem_presentationRelationSubmodule_iff
    (S : Finset (Normal a b c))
    (f : finitePresentationIdeal (k := k) S) :
    f ∈ presentationRelationSubmodule (k := k) S ↔
      (f : ThreePoly k) ∈ polyVariableIdeal (k := k) *
        finitePresentationIdeal (k := k) S := by
  rfl

/-- The detector descends to the actual relation space `I/(mI)`.-/
def relationSpaceDetector
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S) :
    PresentationRelationSpace (k := k) S →ₗ[k]
      (RelationDetectorIndex S → k) :=
  (presentationRelationSubmodule (k := k) S).liftQ
    ((relationDetector (k := k) S).comp
      ((finitePresentationIdeal (k := k) S).subtype.restrictScalars k)) <| by
        intro f hf
        apply LinearMap.mem_ker.mpr
        exact relationDetector_eq_zero_of_mem_mul S hS hdom hlive
          ((mem_presentationRelationSubmodule_iff S f).1 hf)

@[simp]
theorem relationSpaceDetector_relationClass
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S)
    (f : ThreePoly k) (hf : f ∈ finitePresentationIdeal (k := k) S) :
    relationSpaceDetector (k := k) S hS hdom hlive (relationClass S f hf) =
      relationDetector (k := k) S f := by
  rfl

private theorem relationClass_mul_eq_smul
    (S : Finset (Normal a b c)) (q f : ThreePoly k)
    (hf : f ∈ finitePresentationIdeal (k := k) S) :
    relationClass S (q * f) ((finitePresentationIdeal (k := k) S).mul_mem_left q hf) =
      MvPolynomial.constantCoeff q • relationClass S f hf := by
  change Submodule.Quotient.mk
      (⟨q * f, (finitePresentationIdeal (k := k) S).mul_mem_left q hf⟩ :
        finitePresentationIdeal (k := k) S) =
    MvPolynomial.constantCoeff q • Submodule.Quotient.mk
      (⟨f, hf⟩ : finitePresentationIdeal (k := k) S)
  rw [← Submodule.Quotient.mk_smul]
  apply (Submodule.Quotient.eq (presentationRelationSubmodule (k := k) S)).2
  apply (mem_presentationRelationSubmodule_iff S _).2
  have hmem : q * f - MvPolynomial.C (MvPolynomial.constantCoeff q) * f ∈
      polyVariableIdeal (k := k) * finitePresentationIdeal (k := k) S := by
    rw [← sub_mul]
    apply Ideal.mul_mem_mul
    · apply (mem_polyVariableIdeal_iff _).2
      simp
    · exact hf
  simpa [Algebra.smul_def] using hmem

private theorem relationClass_add
    (S : Finset (Normal a b c)) (f g : ThreePoly k)
    (hf : f ∈ finitePresentationIdeal (k := k) S)
    (hg : g ∈ finitePresentationIdeal (k := k) S) :
    relationClass S (f + g) ((finitePresentationIdeal (k := k) S).add_mem hf hg) =
      relationClass S f hf + relationClass S g hg := by
  change Submodule.Quotient.mk
      (⟨f + g, (finitePresentationIdeal (k := k) S).add_mem hf hg⟩ :
        finitePresentationIdeal (k := k) S) =
    Submodule.Quotient.mk (⟨f, hf⟩ : finitePresentationIdeal (k := k) S) +
      Submodule.Quotient.mk (⟨g, hg⟩ : finitePresentationIdeal (k := k) S)
  convert Submodule.Quotient.mk_add
    (presentationRelationSubmodule (k := k) S) using 1
  apply congrArg Submodule.Quotient.mk
  ext
  rfl

/-- The distinguished relation class: the tie first, followed by the exact border lifts.-/
def displayedRelation
    (S : Finset (Normal a b c)) :
    RelationDetectorIndex S → PresentationRelationSpace (k := k) S
  | none => relationClass S (tiePolynomial (k := k) a b c)
      (tiePolynomial_mem_finitePresentationIdeal (k := k) S)
  | some g => relationClass S (polynomialLift (k := k) g.1)
      (polynomialLift_mem_finitePresentationIdeal_of_border (k := k) S g.2)

@[simp]
theorem relationSpaceDetector_displayedRelation
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S)
    (i : RelationDetectorIndex S) :
    relationSpaceDetector (k := k) S hS hdom hlive
        (displayedRelation (k := k) S i) =
      Pi.single i 1 := by
  funext j
  cases i with
  | none =>
      cases j with
      | none => simp [displayedRelation, relationDetector_tie_none (k := k) S hdom]
      | some g =>
          simp [displayedRelation,
            relationDetector_tie_some (k := k) S hS hdom hlive]
  | some g =>
      cases j with
      | none =>
          simp [displayedRelation,
            relationDetector_lift_none (k := k) S hS hlive]
      | some r =>
          change relationSpaceDetector (k := k) S hS hdom hlive
              (relationClass S (polynomialLift (k := k) g.1)
                (polynomialLift_mem_finitePresentationIdeal_of_border
                  (k := k) S g.2)) (some r) = _
          rw [relationSpaceDetector_relationClass,
            relationDetector_lift_some (k := k) S]
          by_cases h : r = g
          · subst r
            simp
          · simp [h]

/-- Relation classes attached to an arbitrary finite ideal-generating family.-/
def generatorRelationClass
    (S : Finset (Normal a b c)) (G : Finset (ThreePoly k))
    (hG : Ideal.span (↑G : Set (ThreePoly k)) =
      finitePresentationIdeal (k := k) S) :
    ↥G → PresentationRelationSpace (k := k) S := fun g =>
  relationClass S g.1 <| by
    rw [← hG]
    exact Ideal.subset_span g.2

/-- Any finite ideal-generating family spans the relation space after passage to `I / mI`.-/
theorem generatorRelationClasses_span_eq_top
    (S : Finset (Normal a b c)) (G : Finset (ThreePoly k))
    (hG : Ideal.span (↑G : Set (ThreePoly k)) =
      finitePresentationIdeal (k := k) S) :
    Submodule.span k (Set.range (generatorRelationClass (k := k) S G hG)) = ⊤ := by
  apply top_unique
  intro z hz
  obtain ⟨f, rfl⟩ :=
    (presentationRelationSubmodule (k := k) S).mkQ_surjective z
  change relationClass S f.1 f.2 ∈
    Submodule.span k (Set.range (generatorRelationClass (k := k) S G hG))
  have hf : (f : ThreePoly k) ∈ Ideal.span (↑G : Set (ThreePoly k)) := by
    rw [hG]
    exact f.2
  let W := Submodule.span k
    (Set.range (generatorRelationClass (k := k) S G hG))
  have hclaim : ∀ (x : ThreePoly k)
      (hx : x ∈ Ideal.span (↑G : Set (ThreePoly k))),
      relationClass S x (by rw [← hG]; exact hx) ∈ W := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
        apply Submodule.subset_span
        refine ⟨⟨x, hx⟩, ?_⟩
        rfl
    | zero =>
        exact Submodule.zero_mem W
    | add x y hx hy ihx ihy =>
        have hxI : x ∈ finitePresentationIdeal (k := k) S := by
          rw [← hG]
          exact hx
        have hyI : y ∈ finitePresentationIdeal (k := k) S := by
          rw [← hG]
          exact hy
        rw [relationClass_add S x y hxI hyI]
        exact W.add_mem ihx ihy
    | smul q x hx ih =>
        have hxI : x ∈ finitePresentationIdeal (k := k) S := by
          rw [← hG]
          exact hx
        change relationClass S (q * x) _ ∈ W
        rw [relationClass_mul_eq_smul S q x hxI]
        exact W.smul_mem _ ih
  exact hclaim f.1 hf

@[simp]
theorem relationDetectorIndex_card (S : Finset (Normal a b c)) :
    Fintype.card (RelationDetectorIndex S) = 1 + (borderFinset S).card := by
  simp [RelationDetectorIndex, Nat.add_comm]

/-- The coefficient detector is onto: every coordinate vector is represented
by the matching displayed relation.-/
theorem relationSpaceDetector_surjective
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S) :
    Function.Surjective (relationSpaceDetector (k := k) S hS hdom hlive) := by
  intro v
  refine ⟨∑ i, v i • displayedRelation (k := k) S i, ?_⟩
  rw [map_sum]
  simp_rw [map_smul,
    relationSpaceDetector_displayedRelation (k := k) S hS hdom hlive]
  ext j
  simp only [Finset.sum_apply, Pi.single_apply, smul_eq_mul]
  rw [Finset.sum_eq_single j]
  · simp
  · intro i hi hij
    simp [Pi.single_apply, hij, Ne.symm hij]
  · simp

/-- Exact dimension of the actual relation space `I / mI`.-/
theorem presentationRelationSpace_finrank
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S) :
    Module.finrank k (PresentationRelationSpace (k := k) S) =
      1 + (borderFinset S).card := by
  let G := presentationGeneratorFinset (k := k) S
  have hG : Ideal.span (↑G : Set (ThreePoly k)) =
      finitePresentationIdeal (k := k) S :=
    span_presentationGeneratorFinset (k := k) S
  have hspan := generatorRelationClasses_span_eq_top (k := k) S G hG
  letI : Module.Finite k (PresentationRelationSpace (k := k) S) :=
    Module.Finite.of_fg_top <| by
      rw [← hspan]
      exact Submodule.fg_span (Set.finite_range _)
  apply Nat.le_antisymm
  · have hu := finrank_le_of_span_eq_top hspan
    simpa [G, presentationGeneratorFinset_card (k := k) S, Nat.add_comm] using hu
  · have hl := LinearMap.finrank_le_finrank_of_surjective
        (relationSpaceDetector_surjective (k := k) S hS hdom hlive)
    simp [RelationDetectorIndex] at hl
    omega

/-- The detector is a bijection; hence no nontrivial linear relation among the
tie and exact-border classes exists in `I / mI`.-/
theorem relationSpaceDetector_bijective
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S) :
    Function.Bijective (relationSpaceDetector (k := k) S hS hdom hlive) := by
  let G := presentationGeneratorFinset (k := k) S
  have hG : Ideal.span (↑G : Set (ThreePoly k)) =
      finitePresentationIdeal (k := k) S :=
    span_presentationGeneratorFinset (k := k) S
  have hspan := generatorRelationClasses_span_eq_top (k := k) S G hG
  letI : Module.Finite k (PresentationRelationSpace (k := k) S) :=
    Module.Finite.of_fg_top <| by
      rw [← hspan]
      exact Submodule.fg_span (Set.finite_range _)
  apply OrzechProperty.bijective_of_surjective_of_finrank_le
  · exact relationSpaceDetector_surjective (k := k) S hS hdom hlive
  · rw [presentationRelationSpace_finrank (k := k) S hS hdom hlive]
    simp [RelationDetectorIndex]
    omega

/-- Linear equivalence identifying `I / mI` with its tie/border coefficient
coordinates.-/
noncomputable def relationSpaceDetectorEquiv
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S) :
    PresentationRelationSpace (k := k) S ≃ₗ[k]
      (RelationDetectorIndex S → k) :=
  LinearEquiv.ofBijective (relationSpaceDetector (k := k) S hS hdom hlive)
    (relationSpaceDetector_bijective (k := k) S hS hdom hlive)

/-- The tie class and exact border-lift classes form a basis of `I / mI`.-/
noncomputable def displayedRelationBasis
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S) :
    Module.Basis (RelationDetectorIndex S) k
      (PresentationRelationSpace (k := k) S) :=
  (Pi.basisFun k (RelationDetectorIndex S)).map
    (relationSpaceDetectorEquiv (k := k) S hS hdom hlive).symm

/-- A scope-neutral assertion that an ideal has minimal finite generator
cardinality `n`.  The second conjunct is the universal lower bound, not merely
inclusion-minimality of one displayed family.-/
def HasMinimalGeneratorCard (I : Ideal (ThreePoly k)) (n : ℕ) : Prop :=
  (∃ G : Finset (ThreePoly k),
      Ideal.span (↑G : Set (ThreePoly k)) = I ∧ G.card = n) ∧
    ∀ G : Finset (ThreePoly k),
      Ideal.span (↑G : Set (ThreePoly k)) = I → n ≤ G.card

/-- Every finite generating family of the presentation ideal has at least the
tie-plus-border cardinality.-/
theorem finitePresentationIdeal_generator_card_lower_bound
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S)
    (G : Finset (ThreePoly k))
    (hG : Ideal.span (↑G : Set (ThreePoly k)) =
      finitePresentationIdeal (k := k) S) :
    1 + (borderFinset S).card ≤ G.card := by
  have hspan := generatorRelationClasses_span_eq_top (k := k) S G hG
  have hle := finrank_le_of_span_eq_top hspan
  rw [presentationRelationSpace_finrank (k := k) S hS hdom hlive] at hle
  simpa using hle

/-- The displayed tie-plus-border family attains the universal lower bound.-/
theorem finitePresentationIdeal_minimalGeneratorCard
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S) :
    HasMinimalGeneratorCard (k := k) (finitePresentationIdeal (k := k) S)
      (1 + (borderFinset S).card) := by
  constructor
  · refine ⟨presentationGeneratorFinset (k := k) S,
      span_presentationGeneratorFinset (k := k) S, ?_⟩
    exact presentationGeneratorFinset_card (k := k) S
  · intro G hG
    exact finitePresentationIdeal_generator_card_lower_bound
      (k := k) S hS hdom hlive G hG

/-- Kernel form of exact minimality, obtained through the frozen Run 15
kernel equality rather than by redefining the kernel.-/
theorem polyToDirectAlg_kernel_minimalGeneratorCard
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S) :
    HasMinimalGeneratorCard (k := k)
      (RingHom.ker (polyToDirectAlg (k := k) S).toRingHom)
      (1 + (borderFinset S).card) := by
  rw [polyToDirectAlg_ker (k := k) S hS hdom]
  exact finitePresentationIdeal_minimalGeneratorCard
    (k := k) S hS hdom hlive

/-- Least cardinality of a finite generating finset, with value `0` only for
ideals for which no finite generating finset exists.-/
noncomputable def idealGeneratorMu (I : Ideal (ThreePoly k)) : ℕ :=
  by
    classical
    exact if h : ∃ n : ℕ, ∃ G : Finset (ThreePoly k),
        Ideal.span (↑G : Set (ThreePoly k)) = I ∧ G.card = n then
      Nat.find h
    else 0

private theorem idealGeneratorMu_eq_of_minimal
    (I : Ideal (ThreePoly k)) (n : ℕ)
    (hmin : HasMinimalGeneratorCard (k := k) I n) :
    idealGeneratorMu (k := k) I = n := by
  classical
  rcases hmin.1 with ⟨G₀, hG₀, hcard₀⟩
  have hex : ∃ m : ℕ, ∃ G : Finset (ThreePoly k),
      Ideal.span (↑G : Set (ThreePoly k)) = I ∧ G.card = m :=
    ⟨n, G₀, hG₀, hcard₀⟩
  rw [idealGeneratorMu, dite_eq_left hex]
  apply Nat.le_antisymm
  · exact Nat.find_min' hex ⟨G₀, hG₀, hcard₀⟩
  · rcases Nat.find_spec hex with ⟨G, hG, hcard⟩
    rw [← hcard]
    exact hmin.2 G hG

/-- The L2 equation for the final polynomial kernel.-/
theorem polyToDirectAlg_kernel_mu_eq_one_add_borderCard
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S) :
    idealGeneratorMu (k := k)
        (RingHom.ker (polyToDirectAlg (k := k) S).toRingHom) =
      1 + (borderFinset S).card :=
  idealGeneratorMu_eq_of_minimal (k := k) _ _
    (polyToDirectAlg_kernel_minimalGeneratorCard
      (k := k) S hS hdom hlive)

/-- The exact numeric form used by H-L5: five kernel generators are equivalent
to a four-point exact border.-/
theorem kernel_mu_eq_five_iff_border_card_eq_four
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S) :
    idealGeneratorMu (k := k)
        (RingHom.ker (polyToDirectAlg (k := k) S).toRingHom) = 5 ↔
      (borderFinset S).card = 4 := by
  rw [polyToDirectAlg_kernel_mu_eq_one_add_borderCard
    (k := k) S hS hdom hlive]
  omega

/-- Scope-explicit Run 16 summary.  It contains the exact Run 15 kernel,
actual `I / mI` dimension, universal generator lower bound, and resulting
minimal generator count.-/
structure PolynomialKernelBorderCount
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S) : Prop where
  kernel_eq : RingHom.ker (polyToDirectAlg (k := k) S).toRingHom =
    finitePresentationIdeal (k := k) S
  displayed_span : Ideal.span
      (↑(presentationGeneratorFinset (k := k) S) : Set (ThreePoly k)) =
    finitePresentationIdeal (k := k) S
  displayed_card : (presentationGeneratorFinset (k := k) S).card =
    1 + (borderFinset S).card
  relation_finrank : Module.finrank k (PresentationRelationSpace (k := k) S) =
    1 + (borderFinset S).card
  universal_lower_bound : ∀ G : Finset (ThreePoly k),
    Ideal.span (↑G : Set (ThreePoly k)) = finitePresentationIdeal (k := k) S →
      1 + (borderFinset S).card ≤ G.card
  minimal_card : HasMinimalGeneratorCard (k := k)
    (RingHom.ker (polyToDirectAlg (k := k) S).toRingHom)
    (1 + (borderFinset S).card)
  mu_eq : idealGeneratorMu (k := k)
    (RingHom.ker (polyToDirectAlg (k := k) S).toRingHom) =
    1 + (borderFinset S).card

/-- Run 16 public summary theorem.-/
theorem polynomialKernelBorderCount
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S) :
    PolynomialKernelBorderCount (k := k) S hS hdom hlive where
  kernel_eq := polyToDirectAlg_ker (k := k) S hS hdom
  displayed_span := span_presentationGeneratorFinset (k := k) S
  displayed_card := presentationGeneratorFinset_card (k := k) S
  relation_finrank := presentationRelationSpace_finrank
    (k := k) S hS hdom hlive
  universal_lower_bound := finitePresentationIdeal_generator_card_lower_bound
    (k := k) S hS hdom hlive
  minimal_card := polyToDirectAlg_kernel_minimalGeneratorCard
    (k := k) S hS hdom hlive
  mu_eq := polyToDirectAlg_kernel_mu_eq_one_add_borderCard
    (k := k) S hS hdom hlive

end

end P23.Presentation
