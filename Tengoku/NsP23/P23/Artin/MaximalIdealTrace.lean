import Tengoku.NsP23.P23.Artin.HL5Direct
import Tengoku.Seed.RingTheory.Ideal.Maps

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Maximal ideal and trace in the direct finite model

This module identifies the augmentation kernel of the frozen finite
standard-monomial algebra with the ideal generated by its three live variable
basis elements.  It then packages the direct nearly-Gorenstein condition and
applies the frozen Run-11 H-L5 API.  No polynomial quotient is used.
-/

namespace P23.Artin

noncomputable section

open P23.OneTie

variable {k : Type*} [Field k]
variable {a b c : ℕ} [NeZero a]

/-- The frozen unit-coordinate map, packaged as a `k`-algebra homomorphism.-/
def constantCoeffAlgHom (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) : MonomialArtin k S →ₐ[k] k where
  toFun := constantCoeff (k := k) S hS
  map_one' := constantCoeff_one (k := k) S hS
  map_mul' := constantCoeff_mul (k := k) S hS hdom
  map_zero' := by simp
  map_add' := by simp
  commutes' r := by
    change constantCoeff (k := k) S hS (r • (1 : MonomialArtin k S)) = r
    simp only [map_smul, constantCoeff_one, smul_eq_mul, mul_one]

/--
@isnad1 id=eq.2h6v.s8.e611c6bb4f83 from=translated src=- shape=bee73246 vocab=206b1282
-/
@[simp]
theorem constantCoeffAlgHom_apply (S : Finset (Normal a b c))
    (hS : S.Nonempty) (hdom : IsLiveParameterDomain a b c)
    (v : MonomialArtin k S) :
    constantCoeffAlgHom (k := k) S hS hdom v =
      constantCoeff (k := k) S hS v := rfl

/-- The augmentation ideal of the direct finite model.-/
def augmentationIdeal (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) : Ideal (MonomialArtin k S) :=
  RingHom.ker (constantCoeffAlgHom (k := k) S hS hdom).toRingHom

/--
@isnad1 id=iff.2h6v.s8.c9c9a3b13fdb from=translated src=- shape=1ac497fb vocab=868b19b5
-/
theorem mem_augmentationIdeal_iff (S : Finset (Normal a b c))
    (hS : S.Nonempty) (hdom : IsLiveParameterDomain a b c)
    (v : MonomialArtin k S) :
    v ∈ augmentationIdeal (k := k) S hS hdom ↔
      constantCoeff (k := k) S hS v = 0 := by
  rfl

/--
@isnad1 id=surjecti.2h5v.s7.c95bb6d09e92 from=translated src=- shape=e444ecbb vocab=57e4a411
-/
theorem constantCoeffAlgHom_surjective (S : Finset (Normal a b c))
    (hS : S.Nonempty) (hdom : IsLiveParameterDomain a b c) :
    Function.Surjective (constantCoeffAlgHom (k := k) S hS hdom) := by
  intro r
  refine ⟨algebraMap k (MonomialArtin k S) r, ?_⟩
  exact (constantCoeffAlgHom (k := k) S hS hdom).commutes r

/--
@isnad1 id=ismaxima.2h5v.s6.5bfa407ae551 from=translated src=- shape=ca0d0127 vocab=f560ddeb
-/
theorem augmentationIdeal_isMaximal (S : Finset (Normal a b c))
    (hS : S.Nonempty) (hdom : IsLiveParameterDomain a b c) :
    (augmentationIdeal (k := k) S hS hdom).IsMaximal := by
  exact RingHom.ker_isMaximal_of_surjective
    (constantCoeffAlgHom (k := k) S hS hdom).toRingHom
    (constantCoeffAlgHom_surjective (k := k) S hS hdom)

/-- The set of the three live variable basis elements.-/
def variableBasisSet (S : Finset (Normal a b c)) (hlive : IsLiveTie S) :
    Set (MonomialArtin k S) :=
  {X (k := k) S Normal.xGenerator
      ((mem_standardFinset_iff_standardSet S _).2 hlive.1),
   X (k := k) S Normal.yGenerator
      ((mem_standardFinset_iff_standardSet S _).2 hlive.2.1),
   X (k := k) S Normal.zGenerator
      ((mem_standardFinset_iff_standardSet S _).2 hlive.2.2.1)}

/-- The ideal generated by the three live variables.-/
def variableIdeal (S : Finset (Normal a b c)) (hlive : IsLiveTie S) :
    Ideal (MonomialArtin k S) :=
  Ideal.span (variableBasisSet (k := k) S hlive)

/--
@isnad1 id=mem.1h6v.s7.36f5c409ac9c from=translated src=- shape=67e1b1cc vocab=2f8e2f8a
-/
theorem X_variable_mem_variableIdeal (S : Finset (Normal a b c))
    (hlive : IsLiveTie S) (e : Direction) :
    X (k := k) S e.generator
        ((mem_standardFinset_iff_standardSet S _).2 (by
          cases e with
          | x => exact hlive.1
          | y => exact hlive.2.1
          | z => exact hlive.2.2.1)) ∈
      variableIdeal (k := k) S hlive := by
  apply Ideal.subset_span
  cases e <;> simp [variableBasisSet, Direction.generator]

/--
@isnad1 id=mem.3h6v.s7.1d62ce757b49 from=translated src=- shape=2b365138 vocab=cbb6a462
-/
theorem X_variable_mem_augmentationIdeal (S : Finset (Normal a b c))
    (hS : S.Nonempty) (hdom : IsLiveParameterDomain a b c)
    (hlive : IsLiveTie S) (e : Direction) :
    X (k := k) S e.generator
        ((mem_standardFinset_iff_standardSet S _).2 (by
          cases e with
          | x => exact hlive.1
          | y => exact hlive.2.1
          | z => exact hlive.2.2.1)) ∈
      augmentationIdeal (k := k) S hS hdom := by
  rw [mem_augmentationIdeal_iff]
  have hne : e.generator ≠ (1 : Normal a b c) :=
    variableGenerators_ne_one_of_two_le hdom.1 e
  have hval : (unitIndex S hS).1 ≠ e.generator := by
    simpa [unitIndex] using (Ne.symm hne)
  simp [constantCoeff, hval]

/-- Every surviving nonunit basis monomial is generated by a live variable.
The predecessor may be ordinary or wrapped; only the generic predecessor API
is used.
@isnad1 id=mem.3h6v.s8.1d675c31268c from=translated src=- shape=e6ce1573 vocab=ee38830d
-/
theorem X_mem_variableIdeal_of_ne_one (S : Finset (Normal a b c))
    (hlive : IsLiveTie S) (p : Normal a b c)
    (hp : p ∈ standardFinset S) (hp1 : p ≠ 1) :
    X (k := k) S p hp ∈ variableIdeal (k := k) S hlive := by
  obtain ⟨e, q, hpred⟩ := exists_predecessor_of_ne_one p hp1
  have hqp : q * e.generator = p :=
    (Normal.predecessor_eq_some_iff_mul e p q).1 hpred
  have hqSet : q ∈ standardSet S := by
    apply standardSet_dvd_closed S ((mem_standardFinset_iff_standardSet S p).1 hp)
    exact ⟨e.generator, hqp.symm⟩
  have hq : q ∈ standardFinset S :=
    (mem_standardFinset_iff_standardSet S q).2 hqSet
  have heSet : e.generator ∈ standardSet S := by
    cases e with
    | x => exact hlive.1
    | y => exact hlive.2.1
    | z => exact hlive.2.2.1
  have he : e.generator ∈ standardFinset S :=
    (mem_standardFinset_iff_standardSet S e.generator).2 heSet
  have hxe : X (k := k) S e.generator he ∈ variableIdeal (k := k) S hlive :=
    X_variable_mem_variableIdeal (k := k) S hlive e
  have hprod := (variableIdeal (k := k) S hlive).mul_mem_left
    (X (k := k) S q hq) hxe
  simpa [MonomialArtin.X_mul_X, hqp, hp] using hprod

/--
@isnad1 id=le.3h5v.s8.d361e75b0f56 from=translated src=- shape=69940f12 vocab=3299daed
-/
theorem variableIdeal_le_augmentationIdeal (S : Finset (Normal a b c))
    (hS : S.Nonempty) (hdom : IsLiveParameterDomain a b c)
    (hlive : IsLiveTie S) :
    variableIdeal (k := k) S hlive ≤ augmentationIdeal (k := k) S hS hdom := by
  apply Ideal.span_le.2
  intro v hv
  simp only [variableBasisSet, Set.mem_insert_iff, Set.mem_singleton_iff] at hv
  rcases hv with rfl | rfl | rfl
  · exact X_variable_mem_augmentationIdeal (k := k) S hS hdom hlive .x
  · exact X_variable_mem_augmentationIdeal (k := k) S hS hdom hlive .y
  · exact X_variable_mem_augmentationIdeal (k := k) S hS hdom hlive .z

/--
@isnad1 id=le.3h5v.s8.4f210290a2b2 from=translated src=- shape=60aaac30 vocab=3299daed
-/
theorem augmentationIdeal_le_variableIdeal (S : Finset (Normal a b c))
    (hS : S.Nonempty) (hdom : IsLiveParameterDomain a b c)
    (hlive : IsLiveTie S) :
    augmentationIdeal (k := k) S hS hdom ≤ variableIdeal (k := k) S hlive := by
  intro v hv
  have hv0 : constantCoeff (k := k) S hS v = 0 :=
    (mem_augmentationIdeal_iff (k := k) S hS hdom v).1 hv
  rw [MonomialArtin.basis_expansion v]
  apply Submodule.sum_mem
  intro p hpSupport
  by_cases hp1 : p.1 = 1
  · have hpUnit : p = unitIndex S hS := by
      apply Subtype.ext
      exact hp1
    have hcoeff : v.coeff p = 0 := by
      subst p
      exact hv0
    simp [hcoeff]
  · have hx := X_mem_variableIdeal_of_ne_one (k := k) S hlive p.1 p.2 hp1
    simpa [Algebra.smul_def] using
      (variableIdeal (k := k) S hlive).mul_mem_left
        (algebraMap k (MonomialArtin k S) (v.coeff p)) hx

/--
@isnad1 id=eq.3h5v.s6.bd36bba9d96f from=translated src=- shape=69940f12 vocab=46707b2a
-/
theorem variableIdeal_eq_augmentationIdeal (S : Finset (Normal a b c))
    (hS : S.Nonempty) (hdom : IsLiveParameterDomain a b c)
    (hlive : IsLiveTie S) :
    variableIdeal (k := k) S hlive = augmentationIdeal (k := k) S hS hdom :=
  le_antisymm
    (variableIdeal_le_augmentationIdeal (k := k) S hS hdom hlive)
    (augmentationIdeal_le_variableIdeal (k := k) S hS hdom hlive)

/-- Direct finite-model nearly-Gorenstein condition.-/
def DirectNearlyGorenstein (k : Type*) [Field k]
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) : Prop :=
  augmentationIdeal (k := k) S hS hdom ≤ TraceSubmodule k S

/--
@isnad1 id=iff.3h5v.s5.a351a78e5b7f from=translated src=- shape=d7550922 vocab=64681c1e
-/
theorem directNearlyGorenstein_iff_variablesInTrace
    (S : Finset (Normal a b c)) (hS : S.Nonempty)
    (hdom : IsLiveParameterDomain a b c) (hlive : IsLiveTie S) :
    DirectNearlyGorenstein k S hS hdom ↔ VariablesInTrace k S hlive := by
  constructor
  · intro hng
    exact ⟨hng (X_variable_mem_augmentationIdeal (k := k) S hS hdom hlive .x),
      hng (X_variable_mem_augmentationIdeal (k := k) S hS hdom hlive .y),
      hng (X_variable_mem_augmentationIdeal (k := k) S hS hdom hlive .z)⟩
  · intro htrace
    unfold DirectNearlyGorenstein
    rw [← variableIdeal_eq_augmentationIdeal (k := k) S hS hdom hlive]
    apply Ideal.span_le.2
    intro v hv
    simp only [variableBasisSet, Set.mem_insert_iff, Set.mem_singleton_iff] at hv
    rcases hv with rfl | rfl | rfl
    · exact htrace.1
    · exact htrace.2.1
    · exact htrace.2.2

/--
@isnad1 id=nonempty.1h4v.s5.23200a7546b9 from=translated src=- shape=5c73dc39 vocab=01df66dc
-/
theorem nonempty_of_isLiveTie (S : Finset (Normal a b c))
    (hlive : IsLiveTie S) : S.Nonempty := by
  by_contra hS
  rw [Finset.not_nonempty_iff_eq_empty] at hS
  subst S
  simpa [IsLiveTie, standardSet] using hlive.1

/--
@isnad1 id=ne.7h5v.s7.71ffe6a039cc from=translated src=- shape=de48440a vocab=d90dd703
-/
theorem mixed_directModel_HL5_of_nearlyGorenstein
    (S : Finset (Normal a b c)) (ha : 2 ≤ a) (hb : 1 ≤ b) (hc : 1 ≤ c)
    (hcard : S.card = 3) (hlive : IsLiveTie S)
    (hanti : IsRootAntichain S)
    (hng : DirectNearlyGorenstein k S (nonempty_of_isLiveTie S hlive)
      ⟨ha, Or.inl ⟨hb, hc⟩⟩) :
    (borderFinset S).card ≠ 4 := by
  apply mixed_directModel_HL5 (k := k) S ha hb hc hcard hlive hanti
  exact (directNearlyGorenstein_iff_variablesInTrace
    (k := k) S (nonempty_of_isLiveTie S hlive)
      ⟨ha, Or.inl ⟨hb, hc⟩⟩ hlive).1 hng

/--
@isnad1 id=ne.6h4v.s7.4b5255cd900a from=translated src=- shape=81ede88a vocab=a36953db
-/
theorem pure_directModel_HL5_of_nearlyGorenstein
    (S : Finset (Normal a b 0)) (ha : 2 ≤ a) (hb : 2 ≤ b)
    (hcard : S.card = 3) (hlive : IsLiveTie S)
    (hanti : IsRootAntichain S)
    (hng : DirectNearlyGorenstein k S (nonempty_of_isLiveTie S hlive)
      ⟨ha, Or.inr ⟨hb, rfl⟩⟩) :
    (borderFinset S).card ≠ 4 := by
  apply pure_directModel_HL5 (k := k) S ha hb hcard hlive hanti
  exact (directNearlyGorenstein_iff_variablesInTrace
    (k := k) S (nonempty_of_isLiveTie S hlive)
      ⟨ha, Or.inr ⟨hb, rfl⟩⟩ hlive).1 hng

/-- Scope-explicit Run-12 H-L5 summary.-/
structure DirectNearlyGorensteinHL5 : Prop where
  mixed : ∀ (a b c : ℕ) [NeZero a] (S : Finset (Normal a b c)),
    ∀ (ha : 2 ≤ a) (hb : 1 ≤ b) (hc : 1 ≤ c), S.card = 3 →
    ∀ (hlive : IsLiveTie S), IsRootAntichain S →
      DirectNearlyGorenstein k S (nonempty_of_isLiveTie S hlive)
        ⟨ha, Or.inl ⟨hb, hc⟩⟩ →
      (borderFinset S).card ≠ 4
  pure : ∀ (a b : ℕ) [NeZero a] (S : Finset (Normal a b 0)),
    ∀ (ha : 2 ≤ a) (hb : 2 ≤ b), S.card = 3 →
    ∀ (hlive : IsLiveTie S), IsRootAntichain S →
      DirectNearlyGorenstein k S (nonempty_of_isLiveTie S hlive)
        ⟨ha, Or.inr ⟨hb, rfl⟩⟩ →
      (borderFinset S).card ≠ 4

/--
@isnad1 id=directne.0h1v.s3.c7105c084e07 from=translated src=- shape=c6850a32 vocab=8e418d32
-/
theorem directNearlyGorenstein_HL5 : DirectNearlyGorensteinHL5 (k := k) where
  mixed := by
    intro a b c _ S ha hb hc hcard hlive hanti hng
    exact mixed_directModel_HL5_of_nearlyGorenstein
      (k := k) S ha hb hc hcard hlive hanti hng
  pure := by
    intro a b _ S ha hb hcard hlive hanti hng
    exact pure_directModel_HL5_of_nearlyGorenstein
      (k := k) S ha hb hcard hlive hanti hng

end

end P23.Artin
