set_option linter.style.header false

/-!
# The `x`-coordinates of torsion points over `ℂ` are `O(N²)`

For an elliptic curve `W` over `ℂ` and an `N`-torsion point `P = (x, y) ∈ W(ℂ)`, the
`x`-coordinate satisfies

`‖x + b₂/12‖⁶ ≤ e^{C_Δ} · ‖Δ_W‖ · max(‖j_W‖, 1) · (2N² + B_j)⁶`

with `B_j = 80·S·(e^{C_y} log max(‖j_W‖, e) + 1)²` (`Heights.exists_torsion_x_bound`), where
`S = ∑_{x ∈ ℤ² ∖ 0} ‖x‖_∞^{−3}` and `C_Δ`, `C_y` are the absolute constants of the comparisons
`−log‖Δ(τ)‖ ≈ log max(‖j‖, 1)` and `log Im τ ≈ log log max(‖j‖, e)` on the fundamental domain
(`Heights.modularDeltaJ_fd_comparison`, `Heights.modularIm_logLogJ_fd_comparison`).

The proof uses the uniformization of the lattice curve `E_τ : y² = x³ − g₂x/4 − g₃/4`
(`Heights.latticeQuotientPointMapAddEquiv`) and the variable change `C` with `C • W = E_τ`
from same-`j` classification: `P` corresponds to `z ∈ ℂ` with `Nz ∈ L_τ`, and
`x = u²℘(z) + r` with `r = −b₂/12`, `u¹² = Δ_W/Δ(E_τ)`. Reducing `z = aτ + b` to
`|a|, |b| ≤ 1/2` gives `‖z‖² ≥ (a² + b²)/2 ≥ 1/(2N²)` on the fundamental domain, and the lattice
sum defining `℘` gives `‖℘(z)‖ ≤ 1/‖z‖² + 80‖τ‖²S` (`Heights.norm_weierstrassP_le`).
-/

open scoped UpperHalfPlane
open WeierstrassCurve

namespace Heights

/-! ### Lattice estimates on the fundamental domain -/

section Lattice

variable {τ : ℍ}

/-- On the fundamental domain, `‖aτ + b‖² ≥ (a² + b²)/2` for real `a, b`. -/
theorem normSq_mul_add_ge (hτ : τ ∈ ModularGroup.fd) (a b : ℝ) :
    (a ^ 2 + b ^ 2) / 2 ≤ Complex.normSq ((a : ℂ) * τ + b) := by
  obtain ⟨h1, h2⟩ := hτ
  have hre : |(τ : ℂ).re| ≤ 1 / 2 := h2
  have hns : 1 ≤ (τ : ℂ).re ^ 2 + (τ : ℂ).im ^ 2 := by
    simpa [Complex.normSq_apply, sq] using h1
  have hab : |2 * a * b * (τ : ℂ).re| ≤ |a * b| := by
    rw [show 2 * a * b * (τ : ℂ).re = (a * b) * (2 * (τ : ℂ).re) by ring, abs_mul]
    have : |2 * (τ : ℂ).re| ≤ 1 := by rw [abs_mul]; norm_num; linarith
    calc |a * b| * |2 * (τ : ℂ).re| ≤ |a * b| * 1 := by gcongr
      _ = |a * b| := mul_one _
  have hsq : 2 * |a * b| ≤ a ^ 2 + b ^ 2 := by
    rw [abs_mul]
    nlinarith [sq_nonneg (|a| - |b|), sq_abs a, sq_abs b]
  have heq : Complex.normSq ((a : ℂ) * τ + b) =
      a ^ 2 * ((τ : ℂ).re ^ 2 + (τ : ℂ).im ^ 2) + 2 * a * b * (τ : ℂ).re + b ^ 2 := by
    simp only [Complex.normSq_apply, Complex.add_re, Complex.mul_re, Complex.ofReal_re,
      Complex.ofReal_im, Complex.add_im, Complex.mul_im]
    ring
  rw [heq]
  have := neg_abs_le (2 * a * b * (τ : ℂ).re)
  nlinarith [sq_nonneg a]

/-- On the fundamental domain, `‖aτ + b‖ ≥ √((a² + b²)/2)`, in squared form. -/
theorem norm_mul_add_sq_ge (hτ : τ ∈ ModularGroup.fd) (a b : ℝ) :
    (a ^ 2 + b ^ 2) / 2 ≤ ‖(a : ℂ) * τ + b‖ ^ 2 := by
  rw [← Complex.normSq_eq_norm_sq]
  exact normSq_mul_add_ge hτ a b

/-- `1 ≤ ‖τ‖` on the fundamental domain. -/
theorem one_le_norm_of_mem_fd (hτ : τ ∈ ModularGroup.fd) : 1 ≤ ‖(τ : ℂ)‖ := by
  have h : 1 ≤ Complex.normSq (τ : ℂ) := hτ.1
  rw [Complex.normSq_eq_norm_sq] at h
  nlinarith [norm_nonneg (τ : ℂ)]

/-- `‖τ‖ ≤ Im τ + 1/2` on the fundamental domain. -/
theorem norm_le_im_add_half (hτ : τ ∈ ModularGroup.fd) : ‖(τ : ℂ)‖ ≤ τ.im + 1 / 2 := by
  have hre : |(τ : ℂ).re| ≤ 1 / 2 := hτ.2
  calc ‖(τ : ℂ)‖ ≤ |(τ : ℂ).re| + |(τ : ℂ).im| := Complex.norm_le_abs_re_add_abs_im _
    _ ≤ 1 / 2 + τ.im := by
      gcongr
      rw [UpperHalfPlane.coe_im, abs_of_pos τ.im_pos]
    _ = τ.im + 1 / 2 := add_comm _ _

/-- The absolute number `S = ∑_{x ∈ ℤ²} ‖x‖_∞^{−3}` (the term `x = 0` vanishes). -/
noncomputable def latticeSumThree : ℝ := ∑' x : Fin 2 → ℤ, ‖x‖ ^ (-3 : ℝ)

/-- The coordinates of the lattice generated by `(τ, 1)`, as a map to `ℤ²`. -/
noncomputable def latticeCoords (τ : ℍ) : (periodPairOfUpperHalfPlane τ).lattice ≃ (Fin 2 → ℤ) :=
  (periodPairOfUpperHalfPlane τ).latticeEquivProd.toEquiv.trans (finTwoArrowEquiv ℤ).symm

end Lattice

/-! ### Torsion points of the lattice curve -/

end Heights
