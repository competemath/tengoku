/-!
# The absolute logarithmic Weil height on `ℚ̄`

For a finite family `x : ι → ℚ̄` (homogeneous coordinates of a point of projective space) we
define the absolute logarithmic Weil height `Heights.Absolute.logHeight x` as Mathlib's
relative height `Height.logHeight` of `x`, viewed in the number field `ℚ(x) ⊆ ℚ̄` generated by
its coordinates, divided by `[ℚ(x) : ℚ]`.

The main result is the independence of the choice of field of definition
(`Heights.Absolute.logHeight_comp_ringHom`): for any number field `L`, ring hom
`φ : L →+* ℚ̄` and `y : ι → L`, `logHeight (φ ∘ y) = h_L(y) / [L : ℚ]`.  It follows from the
extension formula `h_K(y) = [K : k] · h_k(y)` of `Heights.Absolute.Extension`.

We then derive the basic properties: nonnegativity, invariance under scaling, under ring
endomorphisms of `ℚ̄` (Galois invariance), under reindexing and adding zero coordinates, the
Segre (multiplicativity) identity, the formula `logHeight ![1, a] = h_{ℚ(a)}(a) / [ℚ(a) : ℚ]`,
invariance under `a ↦ a⁻¹`, the estimate for translations, and the local formula.
-/

namespace Heights.Absolute

open NumberField Module IntermediateField
open scoped IntermediateField

/-- The algebraic closure `ℚ̄` of `ℚ`. -/
abbrev Qbar := AlgebraicClosure ℚ

/-- Every element of `ℚ̄` is integral over `ℚ`. -/
theorem isIntegral (a : Qbar) : IsIntegral ℚ a :=
  (AlgebraicClosure.isAlgebraic ℚ |>.isAlgebraic a).isIntegral

/-- A finite-dimensional intermediate field of `ℚ̄` is a number field. -/
instance (F : IntermediateField ℚ Qbar) [FiniteDimensional ℚ F] : NumberField F where

/-- The field generated by finitely many elements of `ℚ̄` is finite-dimensional. -/
instance finiteDimensional_adjoin (S : Set Qbar) [Finite S] :
    FiniteDimensional ℚ (IntermediateField.adjoin ℚ S) :=
  IntermediateField.finiteDimensional_adjoin fun a _ => isIntegral a

variable {ι κ : Type*}

/-- The field of definition `ℚ(x)` generated by the coordinates of `x`. -/
noncomputable abbrev fieldOf (x : ι → Qbar) : IntermediateField ℚ Qbar :=
  IntermediateField.adjoin ℚ (Set.range x)

/-- The coordinates of `x`, viewed in `ℚ(x)`. -/
noncomputable def coords (x : ι → Qbar) : ι → fieldOf x :=
  fun i => ⟨x i, IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩⟩

@[simp]
lemma coe_coords (x : ι → Qbar) (i : ι) : (coords x i : Qbar) = x i := rfl

variable [Finite ι] [Finite κ]

/-- **The absolute logarithmic Weil height** of the point of projective space with homogeneous
coordinates `x` (it is `0` for `x = 0`): the relative height of `x` in `ℚ(x)` divided by the
degree `[ℚ(x) : ℚ]`. -/
noncomputable def logHeight (x : ι → Qbar) : ℝ :=
  Height.logHeight (coords x) / finrank ℚ (fieldOf x)

/-! ### Basic properties -/

lemma finrank_pos_real (F : IntermediateField ℚ Qbar) [FiniteDimensional ℚ F] :
    (0 : ℝ) < finrank ℚ F :=
  Nat.cast_pos.mpr finrank_pos

theorem logHeight_nonneg (x : ι → Qbar) : 0 ≤ logHeight x :=
  div_nonneg (Height.logHeight_nonneg _) (Nat.cast_nonneg _)

@[simp]
theorem logHeight_zero : logHeight (0 : ι → Qbar) = 0 := by
  have : coords (0 : ι → Qbar) = 0 := by
    ext i
    rfl
  rw [logHeight, this, Height.logHeight_zero, zero_div]

