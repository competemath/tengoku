theorem solution (R : Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (K : Type*) [Field K] [Algebra R K] [IsFractionRing R K] (g : GL (Fin 2) K) :
    ∃ b k : GL (Fin 2) K, k ∈ LocalGL2.integralSubgroup R K ∧
