    apply h𝔪.ne_top
    rw [hx, eq_top_iff]
    intro a _
    rw [Submodule.mem_colon_singleton, smul_zero]
    exact Submodule.zero_mem _
  · have : a ∈ (⊥ : Submodule A V).colon {x} := hx ▸ ha
    rw [Submodule.mem_colon_singleton] at this
    simpa using this

