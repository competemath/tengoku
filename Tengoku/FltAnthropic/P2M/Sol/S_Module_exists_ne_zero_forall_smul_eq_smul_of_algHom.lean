    [Module A V] [IsScalarTower K A V] [Module.Finite K V] [FaithfulSMul A V]
    (𝔪 : Ideal A) (h𝔪 : 𝔪.IsMaximal) : ∃ v : V, v ≠ 0 ∧ ∀ a ∈ 𝔪, a • v = 0 := by
