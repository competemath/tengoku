import Tengoku.Azurite.Azurite.BasuPollackRoy.Chapter4.Section4_4.IdealOfPolynomials
import Tengoku.Azurite.Azurite.BasuPollackRoy.Chapter4.Section4_4.FiniteMapping
import Tengoku.Seed.RingTheory.Ideal.Quotient.Operations
import Tengoku.Seed.RingTheory.MvPolynomial.Tower
