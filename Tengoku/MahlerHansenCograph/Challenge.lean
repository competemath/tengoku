import Tengoku.Seed.Combinatorics.SimpleGraph.Clique
import Tengoku.Seed.Combinatorics.SimpleGraph.Sum
import Tengoku.Seed.Data.SetLike.Fintype
import Tengoku.Seed.Order.Preorder.Chain
import Tengoku.Seed.Analysis.Convex.Hull
import Tengoku.Seed.MeasureTheory.Measure.Lebesgue.EqHaar

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Challenge: three sharp bounds for Hansen polytopes of cographs

For a finite graph `G`, its Hansen polytope is the centrally symmetric twisted
prism over its stable-set polytope. This file states three sharp results for
cographs. In dimension `d = |V(G)| + 1`:

* the normalized Mahler volume is at least one;
* the number of nonempty faces is at least `3^d`;
* the number of full flags is at least `2^d d!`.

Equality in each result holds exactly for threshold graphs. The face and flag
counts use the finite face lattice recovered from the signed stable-set/clique
incidence relation of a Hansen polytope.

This human-auditable statement file imports only Mathlib and contains only the
definitions needed to state the six compared declarations.
-/

open MeasureTheory Set

universe u

namespace HansenCograph

variable {V : Type u} [Fintype V] [DecidableEq V]

/-! ## Hansen polytopes -/

/-- The `0`/`1` indicator vector of a finite vertex set.-/
def indicator (s : Finset V) : V → ℝ :=
  fun v => if v ∈ s then 1 else 0

/-- Stable `0`/`1` vectors of `G`.-/
def stableIndicators (G : SimpleGraph V) : Set (V → ℝ) :=
  {x | ∃ s : Finset V,
      G.IsIndepSet (↑s : Set V) ∧
      x = indicator s}

/-- The stable-set polytope `STAB(G)`.-/
def stab (G : SimpleGraph V) : Set (V → ℝ) :=
  convexHull ℝ (stableIndicators G)

/-- The Hansen polytope `conv((1, STAB(G)) ∪ (-1, -STAB(G)))`.-/
def hansen (G : SimpleGraph V) : Set (ℝ × (V → ℝ)) :=
  convexHull ℝ
    (((fun p : V → ℝ => ((1 : ℝ), p)) '' stab G) ∪
     ((fun p : V → ℝ => ((-1 : ℝ), -p)) '' stab G))

/-! ## Cographs and threshold graphs -/

inductive Cotree : Type
  | leaf : Cotree
  | sum : Cotree → Cotree → Cotree
  | compl : Cotree → Cotree
deriving Repr

namespace Cotree

/-- Vertex type generated by a cotree.-/
def Vert : Cotree → Type
  | .leaf => PUnit
  | .sum A B => Sum (Vert A) (Vert B)
  | .compl A => Vert A

/-- Evaluation of a cotree as a simple graph.-/
def eval : (T : Cotree) → SimpleGraph (Vert T)
  | .leaf => ⊥
  | .sum A B => eval A ⊕g eval B
  | .compl A => (eval A)ᶜ

/-- At each union node, both children are threshold and one is edgeless.-/
def IsThreshold : Cotree → Prop
  | .leaf => True
  | .compl A => IsThreshold A
  | .sum A B =>
      IsThreshold A ∧ IsThreshold B ∧
        (eval A = ⊥ ∨ eval B = ⊥)

end Cotree

/-- A graph is a cograph when it is isomorphic to a cotree evaluation.-/
def IsCograph (G : SimpleGraph V) : Prop :=
  ∃ T : Cotree, Nonempty (G ≃g Cotree.eval T)

/-- Threshold graphs in cotree language.-/
def IsThresholdGraph (G : SimpleGraph V) : Prop :=
  ∃ T : Cotree, Cotree.IsThreshold T ∧ Nonempty (G ≃g Cotree.eval T)

/-- The normalized Mahler ratio in dimension `|V| + 1`.-/
noncomputable def mahlerRho (K : Set (ℝ × (V → ℝ))) : ℝ :=
  let n := Fintype.card V + 1
  let polarK : Set (ℝ × (V → ℝ)) :=
    {y | ∀ x ∈ K,
      x.1 * y.1 + ∑ v : V, x.2 v * y.2 v ≤ 1}
  (n.factorial : ℝ) * (volume K).toReal * (volume polarK).toReal /
    (4 : ℝ) ^ n

/-! ## The finite Hansen face lattice -/

/-- The two signs on Hansen vertices and facets.-/
inductive HansenSign : Type
  | neg
  | pos
deriving DecidableEq

instance : Fintype HansenSign where
  elems := {HansenSign.neg, HansenSign.pos}
  complete sign := by cases sign <;> simp

/-- Stable-set labels of a graph.-/
abbrev StableSetLabel (G : SimpleGraph V) :=
  {s : Finset V // G.IsIndepSet (↑s : Set V)}

/-- Clique labels of a graph.-/
abbrev CliqueLabel (G : SimpleGraph V) :=
  {c : Finset V // G.IsClique (↑c : Set V)}

/-- Signed Hansen vertex labels.-/
abbrev HansenVertexLabel (G : SimpleGraph V) :=
  HansenSign × StableSetLabel G

/-- Signed Hansen facet labels.-/
abbrev HansenFacetLabel (G : SimpleGraph V) :=
  HansenSign × CliqueLabel G

/-- Incidence between a signed stable-set vertex and a signed clique facet.-/
def hansenLabelIncidence (G : SimpleGraph V) :
    HansenVertexLabel G → HansenFacetLabel G → Prop :=
  fun vertex facet ↦
    (facet.1 = vertex.1) ↔ (facet.2.1 ∩ vertex.2.1).Nonempty

/-- Vertices incident to every facet in `T`.-/
def incidenceModels {A B : Type*} (inc : A → B → Prop)
    (T : Set B) : Set A :=
  {a | ∀ b ∈ T, inc a b}

/-- Facets incident to every common incident vertex of `T`.-/
def incidenceClosure {A B : Type*} (inc : A → B → Prop)
    (T : Set B) : Set B :=
  {b | ∀ a ∈ incidenceModels inc T, inc a b}

/-- A closed set of facet labels.-/
structure IncidenceClosedSet {A B : Type*} (inc : A → B → Prop) where
  carrier : Set B
  isClosed : incidenceClosure inc carrier = carrier

instance {A B : Type*} (inc : A → B → Prop) :
    SetLike (IncidenceClosedSet inc) B where
  coe := IncidenceClosedSet.carrier
  coe_injective A B h := by
    cases A
    cases B
    cases h
    rfl

/--
@isnad1 id=eq.1h5v.s5.c39efb0f02e0 from=translated src=- shape=51a2010b vocab=481a5e70
-/
@[ext]
theorem IncidenceClosedSet.ext {A B : Type*} {inc : A → B → Prop}
    {X Y : IncidenceClosedSet inc} (h : (X : Set B) = Y) : X = Y :=
  SetLike.coe_injective h

/-- Face order is reverse inclusion of containing-facet sets.-/
instance {A B : Type*} (inc : A → B → Prop) :
    PartialOrder (IncidenceClosedSet inc) where
  le X Y := (Y : Set B) ⊆ X
  le_refl _ := Set.Subset.rfl
  le_trans _ _ _ hXY hYZ := Set.Subset.trans hYZ hXY
  le_antisymm X Y hXY hYX :=
    IncidenceClosedSet.ext (Set.Subset.antisymm hYX hXY)

noncomputable instance {A B : Type*} [Finite B] (inc : A → B → Prop) :
    Fintype (IncidenceClosedSet inc) := Fintype.ofFinite _

/-- The finite face lattice of the Hansen polytope, including the empty face.-/
abbrev HansenCombinatorialFace (G : SimpleGraph V) :=
  IncidenceClosedSet (hansenLabelIncidence G)

/-- Number of nonempty faces of the Hansen polytope.-/
noncomputable def hansenNonemptyFaceCount (G : SimpleGraph V) : Nat :=
  Fintype.card (HansenCombinatorialFace G) - 1

noncomputable instance instFintypeHansenFlag (G : SimpleGraph V) :
    Fintype (Flag (HansenCombinatorialFace G)) := Fintype.ofFinite _

/-- Number of full flags (maximal face chains) of the Hansen polytope.-/
noncomputable def hansenFullFlagCount (G : SimpleGraph V) : Nat :=
  Fintype.card (Flag (HansenCombinatorialFace G))

end HansenCograph

open HansenCograph

variable {V : Type u} [Fintype V] [DecidableEq V]

namespace HansenCograph

end HansenCograph
