import Tengoku.AbelFormalization.AbelFormalization.LaurentIdealTools
import Tengoku.Seed.Algebra.MonoidAlgebra.Grading
import Tengoku.Seed.RingTheory.GradedAlgebra.Homogeneous.Ideal

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Homogeneous ideals in a Laurent polynomial ring

The coefficient ring has weight zero and the Laurent variable has weight one.
Every homogeneous ideal is extended from its coefficient contraction. No
domain or Noetherian assumption is needed for this extension statement.
Noetherianity is used only for equality of ideal heights.
-/

noncomputable section

namespace AbelFormalization

variable {R : Type*} [CommRing R]

/-- Multiplication by an inverse Laurent monomial normalizes a homogeneous
monomial to its coefficient. This identity is valid over rings with zero
divisors as well.
@isnad1 id=eq.0h3v.s7.148c0b5ec87e from=translated src=- shape=508f09ff vocab=21d4f64b
-/
theorem laurent_inverse_monomial_mul_single (n : ℤ) (a : R) :
    LaurentPolynomial.T (-n) * AddMonoidAlgebra.single n a =
      LaurentPolynomial.C a := by
  change AddMonoidAlgebra.single (-n) (1 : R) * AddMonoidAlgebra.single n a =
    AddMonoidAlgebra.single 0 a
  simp

/-- A homogeneous Laurent polynomial is exactly a single Laurent monomial.
@isnad1 id=iff.0h2v.s7.04cc41b34d77 from=translated src=- shape=9f835f2e vocab=38c23395
-/
theorem laurent_homogeneous_iff_single (f : LaurentPolynomial R) :
    SetLike.IsHomogeneousElem (AddMonoidAlgebra.grade R) f ↔
      ∃ n : ℤ, ∃ a : R, AddMonoidAlgebra.single n a = f := by
  constructor
  · rintro ⟨n, hn⟩
    obtain ⟨a, ha⟩ := (AddMonoidAlgebra.mem_grade_iff' R n f).mp hn
    exact ⟨n, a, ha⟩
  · rintro ⟨n, a, rfl⟩
    exact ⟨n, AddMonoidAlgebra.single_mem_grade n a⟩

/-- Normalizing a homogeneous element of an ideal gives an element of its
coefficient contraction, and hence of the extension of that contraction.
@isnad1 id=mem.2h3v.s9.63de66593819 from=translated src=- shape=e00f0e3c vocab=f2b6f31c
-/
theorem laurent_homogeneous_mem_map_comap (K : Ideal (LaurentPolynomial R))
    {f : LaurentPolynomial R}
    (hhom : SetLike.IsHomogeneousElem (AddMonoidAlgebra.grade R) f)
    (hf : f ∈ K) :
    f ∈ (K.comap LaurentPolynomial.C).map LaurentPolynomial.C := by
  obtain ⟨n, a, rfl⟩ := (laurent_homogeneous_iff_single f).mp hhom
  have ha : LaurentPolynomial.C a ∈ K := by
    simpa only [laurent_inverse_monomial_mul_single] using
      K.mul_mem_left (LaurentPolynomial.T (-n)) hf
  rw [LaurentPolynomial.single_eq_C_mul_T]
  exact ((K.comap LaurentPolynomial.C).map LaurentPolynomial.C).mul_mem_right
    (LaurentPolynomial.T n) (Ideal.mem_map_of_mem LaurentPolynomial.C ha)

/-- A homogeneous Laurent ideal is generated by its actual coefficient
contraction. The generators come from every homogeneous element of the ideal.
There is no finite-generation or domain hypothesis.
@isnad1 id=eq.1h2v.s8.f16870213c60 from=translated src=- shape=22d5331d vocab=14e19251
-/
theorem laurent_homogeneousIdeal_eq_map_comap (K : Ideal (LaurentPolynomial R))
    (hK : K.IsHomogeneous (AddMonoidAlgebra.grade R)) :
    K = (K.comap LaurentPolynomial.C).map LaurentPolynomial.C := by
  obtain ⟨s, hs⟩ := (Ideal.IsHomogeneous.iff_exists (AddMonoidAlgebra.grade R) K).mp hK
  apply le_antisymm
  · calc
      K = Ideal.span ((↑) '' s) := hs
      _ ≤ (K.comap LaurentPolynomial.C).map LaurentPolynomial.C := by
        apply Ideal.span_le.mpr
        rintro f ⟨g, hg, rfl⟩
        apply laurent_homogeneous_mem_map_comap K g.property
        rw [hs]
        exact Ideal.subset_span ⟨g, hg, rfl⟩
  · exact Ideal.map_comap_le

/-- Every coefficient of a homogeneous Laurent ideal belongs to its
coefficient contraction.
@isnad1 id=mem.2h4v.s8.79d6a9bb29ea from=translated src=- shape=e6bc7a5b vocab=a850fb66
-/
theorem laurent_homogeneousIdeal_coeff_mem (K : Ideal (LaurentPolynomial R))
    (hK : K.IsHomogeneous (AddMonoidAlgebra.grade R))
    {f : LaurentPolynomial R} (hf : f ∈ K) (n : ℤ) :
    f.coeff n ∈ K.comap LaurentPolynomial.C := by
  rw [laurent_homogeneousIdeal_eq_map_comap K hK] at hf
  exact (laurentPolynomial_mem_map_C_iff _ f).mp hf n

/-- The homogeneous monomial projection of an element stays in the ideal.
@isnad1 id=mem.2h4v.s8.5be45915de9c from=translated src=- shape=cdd373b8 vocab=0eb9269b
-/
theorem laurent_homogeneousIdeal_single_coeff_mem (K : Ideal (LaurentPolynomial R))
    (hK : K.IsHomogeneous (AddMonoidAlgebra.grade R))
    {f : LaurentPolynomial R} (hf : f ∈ K) (n : ℤ) :
    AddMonoidAlgebra.single n (f.coeff n) ∈ K := by
  have hc : LaurentPolynomial.C (f.coeff n) ∈ K :=
    laurent_homogeneousIdeal_coeff_mem K hK hf n
  rw [LaurentPolynomial.single_eq_C_mul_T]
  exact K.mul_mem_right (LaurentPolynomial.T n) hc

end AbelFormalization
