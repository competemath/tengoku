/-!
# Presented linear 2-categories

Given a signature `S` and a commutative ring `R`, a `Presentation S R` is a family of
relations, each an `R`-linear combination of diagrams `rel i : a ⟶ b` in the free
`R`-linear 2-category (`LinDiagram R a b`, Mathlib's `Free R (Obj S)`), read as `rel i = 0`.

The presented category `P.Presented` is the quotient of the free `R`-linear 2-category by
the two-sided *tensor ideal* generated by

* the relations `P.rel i`, and
* the (super) interchange law: for generators `g`, `h` and a word `w`, the diagram with
  `g` below `h` on the object `dom g ⊗ w ⊗ dom h` equals `(-1)^{|g||h|}` times the diagram
  with `h` below `g` (`InterchangeData`),

where "tensor ideal" means closure under whiskering by arbitrary (compatible) objects on
the left and right and under composition on either side. It is an `R`-linear category;
its morphisms are the diagrams of the presentation modulo the relations.

## Main definitions and results

* `StringDiagrams.Presentation`, `Presentation.Presented`, `Presentation.obj`.
* `Presentation.lin`: the quotient functor from linear combinations of diagrams, and
  `Presentation.layer`: the class of a single layer.
* `Presentation.lin_rel`: every whiskered relation holds in the presented category;
  `Presentation.lin_interchange`: likewise for the interchange law.
* `Presentation.lift` / `Presentation.lift_diag` (soundness): a functor from the free
  2-category to any `R`-linear category that kills every whiskered relation and every
  whiskered interchange relation factors through the presented category.
* `Interpretation`: the functor determined by images of layers
  (`Interpretation.functor`), with `Interpretation.map_mk_cons` computing it on diagrams.
-/

noncomputable section

namespace StringDiagrams

open CategoryTheory

universe w v u₀ u₁ u₂

variable {S : Signature.{u₀, u₁, u₂}}

section LinDiagram

variable (R : Type w) [CommRing R]

/-- `R`-linear combinations of diagrams from `a` to `b`: morphisms of the free `R`-linear
2-category on `S`.-/
abbrev LinDiagram (a b : Obj S) : Type _ := Free.of R a ⟶ Free.of R b

variable {R}

namespace LinDiagram

variable {a b c : Obj S}

/-- A single diagram with coefficient `1`.-/
abbrev of (f : a ⟶ b) : LinDiagram R a b := Finsupp.single f 1

/--
@isnad1 id=eq.0h7v.s6.debe99f2cc51 from=translated src=- shape=83228551 vocab=624e6a6e
-/
theorem of_comp (f : a ⟶ b) (g : b ⟶ c) : (of (f ≫ g) : LinDiagram R a c) = of f ≫ of g := by
  have := Free.single_comp_single R (Obj S) f g (1 : R) 1
  rw [one_mul] at this
  exact this.symm

/-- Whiskering of linear combinations of diagrams.-/
def whisker (f : LinDiagram R a b) (u : Obj S) (v : List S.Colour)
    (hw : a.WhiskerOK u v) : LinDiagram R (a.whisker u v) (b.whisker u v) :=
  Finsupp.mapDomain (fun d => Diagram.whisker d u v hw) f

/--
@isnad1 id=eq.1h8v.s7.4fe0cc53c91d from=translated src=- shape=dd53f6c2 vocab=9b429a5d
-/
@[simp] theorem whisker_single (f : a ⟶ b) (r : R) (u : Obj S) (v : List S.Colour)
    (hw : a.WhiskerOK u v) :
    whisker (Finsupp.single f r : LinDiagram R a b) u v hw =
      Finsupp.single (Diagram.whisker f u v hw) r :=
  Finsupp.mapDomain_single

/--
@isnad1 id=eq.1h7v.s6.09ac4b66de04 from=translated src=- shape=24b0b653 vocab=650941d3
-/
@[simp] theorem whisker_of (f : a ⟶ b) (u : Obj S) (v : List S.Colour) (hw : a.WhiskerOK u v) :
    whisker (of f : LinDiagram R a b) u v hw = of (Diagram.whisker f u v hw) :=
  Finsupp.mapDomain_single

/--
@isnad1 id=eq.1h6v.s7.79b572803b6c from=translated src=- shape=f48baa90 vocab=042ddb10
-/
@[simp] theorem whisker_zero (u : Obj S) (v : List S.Colour) (hw : a.WhiskerOK u v) :
    whisker (0 : LinDiagram R a b) u v hw = 0 :=
  Finsupp.mapDomain_zero

/--
@isnad1 id=eq.1h8v.s8.cc3182bc9400 from=translated src=- shape=d6f37d89 vocab=06c91885
-/
theorem whisker_sub (f g : LinDiagram R a b) (u : Obj S) (v : List S.Colour)
    (hw : a.WhiskerOK u v) : whisker (f - g) u v hw = whisker f u v hw - whisker g u v hw :=
  (Finsupp.lmapDomain R R _).map_sub f g

/--
@isnad1 id=eq.1h7v.s8.660e0f18f243 from=translated src=- shape=a3079ccf vocab=66b4f53c
-/
theorem whisker_neg (f : LinDiagram R a b) (u : Obj S) (v : List S.Colour)
    (hw : a.WhiskerOK u v) : whisker (-f) u v hw = -whisker f u v hw :=
  (Finsupp.lmapDomain R R _).map_neg f

/--
@isnad1 id=eq.1h8v.s8.6c9fcb06a982 from=translated src=- shape=d6f37d89 vocab=6d8593ca
-/
theorem whisker_add (f g : LinDiagram R a b) (u : Obj S) (v : List S.Colour)
    (hw : a.WhiskerOK u v) : whisker (f + g) u v hw = whisker f u v hw + whisker g u v hw :=
  Finsupp.mapDomain_add

/--
@isnad1 id=eq.1h8v.s9.e62b20f84f22 from=translated src=- shape=03d2fc49 vocab=e04fc8ef
-/
theorem whisker_smul (r : R) (f : LinDiagram R a b) (u : Obj S) (v : List S.Colour)
    (hw : a.WhiskerOK u v) : whisker (r • f) u v hw = r • whisker f u v hw :=
  Finsupp.mapDomain_smul _ _

/-- Retype a linear combination of diagrams along equalities of its boundary objects.-/
def cast {a' b' : Obj S} (f : LinDiagram R a b) (ha : a = a') (hb : b = b') :
    LinDiagram R a' b' :=
  Finsupp.mapDomain (fun d => Diagram.cast d ha hb) f

/--
@isnad1 id=eq.2h8v.s7.4db48a30e338 from=translated src=- shape=f9a3c717 vocab=3a41f0a2
-/
@[simp] theorem cast_single {a' b' : Obj S} (f : a ⟶ b) (r : R) (ha : a = a') (hb : b = b') :
    cast (Finsupp.single f r : LinDiagram R a b) ha hb = Finsupp.single (Diagram.cast f ha hb) r :=
  Finsupp.mapDomain_single

/--
@isnad1 id=eq.2h7v.s6.20b6b8f425d9 from=translated src=- shape=dfa4270b vocab=4a9e5d7a
-/
@[simp] theorem cast_of {a' b' : Obj S} (f : a ⟶ b) (ha : a = a') (hb : b = b') :
    cast (of f : LinDiagram R a b) ha hb = of (Diagram.cast f ha hb) :=
  Finsupp.mapDomain_single

/--
@isnad1 id=eq.2h8v.s7.0c8efc860132 from=translated src=- shape=25f72d1a vocab=1ac42764
-/
@[simp] theorem cast_add {a' b' : Obj S} (f g : LinDiagram R a b) (ha : a = a') (hb : b = b') :
    cast (f + g) ha hb = cast f ha hb + cast g ha hb :=
  Finsupp.mapDomain_add

/--
@isnad1 id=eq.2h8v.s7.39aa69a8f53a from=translated src=- shape=25f72d1a vocab=bc3544a3
-/
@[simp] theorem cast_sub {a' b' : Obj S} (f g : LinDiagram R a b) (ha : a = a') (hb : b = b') :
    cast (f - g) ha hb = cast f ha hb - cast g ha hb :=
  (Finsupp.lmapDomain R R _).map_sub f g

/--
@isnad1 id=eq.2h7v.s7.f5d440d91199 from=translated src=- shape=7a321ab4 vocab=e69cc66b
-/
@[simp] theorem cast_neg {a' b' : Obj S} (f : LinDiagram R a b) (ha : a = a') (hb : b = b') :
    cast (-f) ha hb = -cast f ha hb :=
  (Finsupp.lmapDomain R R _).map_neg f

/--
@isnad1 id=eq.2h8v.s9.317b084acddd from=translated src=- shape=75aa0a80 vocab=9aab5524
-/
@[simp] theorem cast_smul {a' b' : Obj S} (r : R) (f : LinDiagram R a b) (ha : a = a')
    (hb : b = b') : cast (r • f) ha hb = r • cast f ha hb :=
  Finsupp.mapDomain_smul _ _

/--
@isnad1 id=eq.0h5v.s5.b5726c39abc0 from=translated src=- shape=e8eee6a1 vocab=30f54a2b
-/
@[simp] theorem cast_rfl (f : LinDiagram R a b) : cast f rfl rfl = f := by
  simp only [cast]; exact Finsupp.mapDomain_id

end LinDiagram

end LinDiagram

/-! ## The interchange law -/

/-- Data for one instance of the interchange law: generators `g` (left) and `h` (right)
separated by the identity on the word `mid`, starting in region `start`.-/
structure InterchangeData (S : Signature.{u₀, u₁, u₂}) where
  /-- The leftmost region.-/
  start : S.Region
  /-- The left generator.-/
  g : S.Gen
  /-- The strands between the two generators.-/
  mid : List S.Colour
  /-- The right generator.-/
  h : S.Gen

namespace InterchangeData

variable (x : InterchangeData S)

/-- Bottom boundary `dom g ⊗ mid ⊗ dom h`.-/
def dom : Obj S := ⟨x.start, S.dom x.g ++ x.mid ++ S.dom x.h⟩

/-- Top boundary `cod g ⊗ mid ⊗ cod h`.-/
def cod : Obj S := ⟨x.start, S.cod x.g ++ x.mid ++ S.cod x.h⟩

/-- `g` first: bottom layer.-/
def gh₁ : Layer S := ⟨x.start, [], x.g, x.mid ++ S.dom x.h⟩
/-- `g` first: top layer.-/
def gh₂ : Layer S := ⟨x.start, S.cod x.g ++ x.mid, x.h, []⟩
/-- `h` first: bottom layer.-/
def hg₁ : Layer S := ⟨x.start, S.dom x.g ++ x.mid, x.h, []⟩
/-- `h` first: top layer.-/
def hg₂ : Layer S := ⟨x.start, [], x.g, x.mid ++ S.cod x.h⟩

/-- The four layers involved are well formed.-/
structure Valid : Prop where
  gh₁ : x.gh₁.Valid
  gh₂ : x.gh₂.Valid
  hg₁ : x.hg₁.Valid
  hg₂ : x.hg₂.Valid

/--
@isnad1 id=valid.0h2v.s3.8bc4132e70df from=translated src=- shape=b8d9a049 vocab=0e4f1542
-/
theorem valid_of_subsingleton [Subsingleton S.Region] : x.Valid :=
  ⟨Layer.valid_of_subsingleton _, Layer.valid_of_subsingleton _,
    Layer.valid_of_subsingleton _, Layer.valid_of_subsingleton _⟩

/-- The Koszul sign `(-1)^{|g||h|}`.-/
def sign : ℤ := if S.odd x.g && S.odd x.h then -1 else 1

variable {x}

/-- The diagram with `g` below `h`.-/
def ghDiagram (hx : x.Valid) : x.dom ⟶ x.cod :=
  Diagram.mk [x.gh₁, x.gh₂]
    ⟨hx.gh₁, by simp [gh₁, dom, Layer.dom],
      hx.gh₂, by simp [gh₁, gh₂, Layer.dom, Layer.cod], by simp [gh₂, cod, Layer.cod]⟩

/-- The diagram with `h` below `g`.-/
def hgDiagram (hx : x.Valid) : x.dom ⟶ x.cod :=
  Diagram.mk [x.hg₁, x.hg₂]
    ⟨hx.hg₁, by simp [hg₁, dom, Layer.dom],
      hx.hg₂, by simp [hg₁, hg₂, Layer.dom, Layer.cod], by simp [hg₂, cod, Layer.cod]⟩

/-- The interchange relation `(g below h) - (-1)^{|g||h|} (h below g)`.-/
def rel (R : Type w) [CommRing R] (hx : x.Valid) : LinDiagram R x.dom x.cod :=
  LinDiagram.of (ghDiagram hx) - ((x.sign : ℤ) : R) • LinDiagram.of (hgDiagram hx)

end InterchangeData

/-! ## Presentations -/

/-- A presentation of an `R`-linear 2-category on the signature `S`: a family of relations
`rel i = 0` between linear combinations of diagrams. The interchange law is always imposed
in addition (see `Presentation.Presented`).-/
structure Presentation (S : Signature.{u₀, u₁, u₂}) (R : Type w) [CommRing R] where
  /-- Index type of the relations.-/
  Rel : Type v
  /-- Bottom boundary of a relation.-/
  dom : Rel → Obj S
  /-- Top boundary of a relation.-/
  cod : Rel → Obj S
  /-- The relation `rel i = 0`.-/
  rel : (i : Rel) → LinDiagram R (dom i) (cod i)

namespace Presentation

variable {R : Type w} [CommRing R] (P : Presentation.{w, v} S R)

/-- All relations imposed in `P.Presented`: those of `P` and the interchange law.-/
inductive AllRel (P : Presentation.{w, v} S R) : Type (max v u₀ u₁ u₂)
  | user (i : P.Rel)
  | interchange (x : InterchangeData S) (hx : x.Valid)

/-- Bottom boundary of an imposed relation.-/
def AllRel.dom {P : Presentation.{w, v} S R} : P.AllRel → Obj S
  | .user i => P.dom i
  | .interchange x _ => x.dom

/-- Top boundary of an imposed relation.-/
def AllRel.cod {P : Presentation.{w, v} S R} : P.AllRel → Obj S
  | .user i => P.cod i
  | .interchange x _ => x.cod

/-- The imposed relation itself.-/
def AllRel.rel {P : Presentation.{w, v} S R} :
    (k : P.AllRel) → LinDiagram R k.dom k.cod
  | .user i => P.rel i
  | .interchange _ hx => InterchangeData.rel R hx

/-- Generators of the tensor ideal: whiskered relations composed on both sides.-/
inductive IdealGen : ∀ {a b : Obj S}, LinDiagram R a b → Prop
  | intro (k : P.AllRel) (u : Obj S) (v : List S.Colour) (hw : k.dom.WhiskerOK u v)
      {a b : Obj S} (pre : LinDiagram R a (k.dom.whisker u v))
      (post : LinDiagram R (k.cod.whisker u v) b) :
      IdealGen (pre ≫ LinDiagram.whisker k.rel u v hw ≫ post)

/-- The tensor ideal generated by the relations and the interchange law.-/
def ideal (a b : Obj S) : Submodule R (LinDiagram R a b) :=
  Submodule.span R {f | P.IdealGen f}

/--
@isnad1 id=mem.1h8v.s9.05f292e9d66c from=translated src=- shape=437a1fed vocab=c08496fd
-/
theorem comp_mem_ideal {a b c : Obj S} (g : LinDiagram R a b) {f : LinDiagram R b c}
    (hf : f ∈ P.ideal b c) : g ≫ f ∈ P.ideal a c := by
  induction hf using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨k, u, v, hw, pre, post⟩ := hx
    apply Submodule.subset_span
    rw [← Category.assoc]
    exact IdealGen.intro k u v hw _ post
  | zero => simp
  | add x y _ _ hx hy => rw [Preadditive.comp_add]; exact Submodule.add_mem _ hx hy
  | smul r x _ hx => rw [Linear.comp_smul]; exact Submodule.smul_mem _ r hx

/--
@isnad1 id=mem.1h8v.s9.dc379ebec1b5 from=translated src=- shape=8587f10d vocab=c08496fd
-/
theorem mem_ideal_comp {a b c : Obj S} {f : LinDiagram R a b} (hf : f ∈ P.ideal a b)
    (g : LinDiagram R b c) : f ≫ g ∈ P.ideal a c := by
  induction hf using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨k, u, v, hw, pre, post⟩ := hx
    apply Submodule.subset_span
    simp only [Category.assoc]
    exact IdealGen.intro k u v hw pre _
  | zero => simp
  | add x y _ _ hx hy => rw [Preadditive.add_comp]; exact Submodule.add_mem _ hx hy
  | smul r x _ hx => rw [Linear.smul_comp]; exact Submodule.smul_mem _ r hx

/--
@isnad1 id=mem.1h6v.s9.a9f161a7133d from=translated src=- shape=97ab2423 vocab=9ab1ce1e
-/
theorem whisker_rel_mem_ideal (k : P.AllRel) (u : Obj S) (v : List S.Colour)
    (hw : k.dom.WhiskerOK u v) : LinDiagram.whisker k.rel u v hw ∈ P.ideal _ _ := by
  apply Submodule.subset_span
  have := IdealGen.intro (P := P) k u v hw (𝟙 _) (𝟙 _)
  simpa using this

/-- The congruence on the free linear 2-category: `f ~ g` iff `f - g` lies in the ideal.-/
def homRel : HomRel (Free R (Obj S)) := fun a b f g => f - g ∈ P.ideal a b

instance : Congruence P.homRel where
  equivalence :=
    { refl := fun f => by rw [homRel, sub_self]; exact Submodule.zero_mem _
      symm := fun {f g} h => by
        rw [homRel, ← neg_sub]; exact Submodule.neg_mem _ h
      trans := fun {f g h} h₁ h₂ => by
        rw [homRel, ← sub_add_sub_cancel f g h]; exact Submodule.add_mem _ h₁ h₂ }
  comp_left := fun f g g' h => by
    rw [homRel, ← Preadditive.comp_sub]; exact P.comp_mem_ideal f h
  comp_right := fun g h => by
    rw [homRel, ← Preadditive.sub_comp]; exact P.mem_ideal_comp h g

/--
@isnad1 id=homrel.0h11v.s9.f62af1d691fc from=translated src=- shape=50e5972b vocab=f9f34441
-/
theorem homRel_add : ∀ ⦃X Y : Free R (Obj S)⦄ (f₁ f₂ g₁ g₂ : X ⟶ Y) (_ : P.homRel f₁ f₂)
    (_ : P.homRel g₁ g₂), P.homRel (f₁ + g₁) (f₂ + g₂) := by
  intro X Y f₁ f₂ g₁ g₂ h₁ h₂
  unfold homRel at *
  rw [add_sub_add_comm]; exact Submodule.add_mem _ h₁ h₂

/--
@isnad1 id=homrel.0h9v.s10.842e1c3c6b5e from=translated src=- shape=b2f4ae66 vocab=ac17075f
-/
theorem homRel_smul : ∀ (a : R) ⦃X Y : Free R (Obj S)⦄ (f₁ f₂ : X ⟶ Y) (_ : P.homRel f₁ f₂),
    P.homRel (a • f₁) (a • f₂) := by
  intro a X Y f₁ f₂ h
  unfold homRel at *
  rw [← smul_sub]; exact Submodule.smul_mem _ a h

/-- The presented `R`-linear 2-category.-/
abbrev Presented : Type _ := CategoryTheory.Quotient P.homRel

instance : Preadditive (CategoryTheory.Quotient P.homRel) := CategoryTheory.Quotient.preadditive P.homRel P.homRel_add

instance : (CategoryTheory.Quotient.functor P.homRel).Additive := CategoryTheory.Quotient.functor_additive P.homRel P.homRel_add

instance instLinear : Linear R (CategoryTheory.Quotient P.homRel) := CategoryTheory.Quotient.linear R P.homRel P.homRel_smul

/-- The object of the presented category given by an object of the free 2-category.-/
def obj (a : Obj S) : P.Presented := ⟨Free.of R a⟩

