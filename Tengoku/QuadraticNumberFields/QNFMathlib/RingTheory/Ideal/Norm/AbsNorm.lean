section NormalizedFactors

variable {R : Type*} [CommRing R] [Algebra ℤ R] [IsDedekindDomain R]
variable [Module.Free ℤ R] [Module.Finite ℤ R]

/-- If a rational prime divides the absolute norm of a nonzero ideal in a
finite free `ℤ`-Dedekind algebra, then some normalized prime factor of the ideal
lies over `(p)`.
@isnad1 id=ex.3h3v.s8.7f145e2d4f37 from=translated src=- shape=96f1e39e vocab=1be37142
-/
theorem exists_normalizedFactor_mem_primesOver_of_nat_prime_dvd_absNorm
    {I : Ideal R} (hI0 : I ≠ ⊥) {p : ℕ} (hp : p.Prime)
    (hpdiv : p ∣ Ideal.absNorm I) :
    ∃ P : Ideal R,
      P ∈ UniqueFactorizationMonoid.normalizedFactors I ∧
        P ∈ Ideal.primesOver (Ideal.span ({(p : ℤ)} : Set ℤ)) R := by
  letI : Fact p.Prime := ⟨hp⟩
  have hnot_sup : I ⊔ Ideal.span ({(p : R)} : Set R) ≠ ⊤ := by
    intro htop
    have hcop : (Ideal.absNorm I).Coprime p :=
      Ideal.absNorm_coprime_prime_of_sup_span_natCast_eq_top I p hI0 htop
    have hcop' : p.Coprime (Ideal.absNorm I) := Nat.coprime_comm.mp hcop
    exact ((Nat.Prime.coprime_iff_not_dvd hp).mp hcop') hpdiv
  obtain ⟨M, hMmax, hsupM⟩ :=
    Ideal.exists_le_maximal (I ⊔ Ideal.span ({(p : R)} : Set R)) hnot_sup
  have hIle : I ≤ M := le_sup_left.trans hsupM
  have hpSpan_le : Ideal.span ({(p : R)} : Set R) ≤ M := le_sup_right.trans hsupM
  have hmap :
      Ideal.map (algebraMap ℤ R) (Ideal.span ({(p : ℤ)} : Set ℤ)) =
        Ideal.span ({(p : R)} : Set R) := by
    rw [Ideal.map_span, Set.image_singleton]
    simp
  have hlecomap :
      (Ideal.span ({(p : ℤ)} : Set ℤ)) ≤ M.comap (algebraMap ℤ R) := by
    rw [← Ideal.map_le_iff_le_comap, hmap]
    exact hpSpan_le
  have hcomap_ne_top : M.comap (algebraMap ℤ R) ≠ ⊤ := by
    intro htop
    apply hMmax.ne_top
    rw [Ideal.eq_top_iff_one]
    have hone : (1 : ℤ) ∈ M.comap (algebraMap ℤ R) := by
      rw [htop]
      trivial
    simpa using hone
  haveI : (Ideal.span ({(p : ℤ)} : Set ℤ)).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible
      ((Nat.prime_iff_prime_int.mp hp).irreducible)
  have hcomap : M.comap (algebraMap ℤ R) =
      Ideal.span ({(p : ℤ)} : Set ℤ) := by
    exact (show (Ideal.span ({(p : ℤ)} : Set ℤ)).IsMaximal from inferInstance).eq_of_le
      hcomap_ne_top hlecomap |>.symm
  refine ⟨M, ?_, ?_⟩
  · exact (Ideal.mem_normalizedFactors_iff hI0).mpr ⟨hMmax.isPrime, hIle⟩
  · exact ⟨hMmax.isPrime, ⟨hcomap.symm⟩⟩

end NormalizedFactors

end Ideal
