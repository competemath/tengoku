import Tengoku.Seed.Algebra.Algebra.Basic
import Tengoku.Seed.Algebra.BigOperators.Fin
import Tengoku.Seed.Data.List.OfFn

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Ordered products indexed by finite initial segments

This file collects distributivity identities for ordered, generally noncommutative products
whose factors are indexed by `Fin`.

## Main results

* `List.prod_ofFn_sum`: distributes an ordered product over finite sums.
* `List.prod_ofFn_smul`: extracts the product of scalar coefficients.
* `Subsemigroup.exists_nonempty_list_prod_of_mem_closure`: represents an element of a
  generated subsemigroup as a nonempty product of generators.
-/

open scoped BigOperators

namespace List

/-- An ordered product of finite sums is the sum over all choices of the corresponding
ordered products.
@isnad1 id=eq.0h4v.s6.0a3b26bd59be from=translated src=- shape=951071c1 vocab=8a363f69
-/
theorem prod_ofFn_sum {R J : Type*} [Semiring R] [Fintype J]
    {N : ℕ} (f : Fin N → J → R) :
    (List.ofFn fun n : Fin N ↦ ∑ j : J, f n j).prod =
      ∑ choice : Fin N → J, (List.ofFn fun n ↦ f n (choice n)).prod := by
  classical
  induction N with
  | zero => simp
  | succ N ih =>
      rw [List.ofFn_succ, List.prod_cons, ih (fun n ↦ f n.succ), Finset.sum_mul_sum]
      rw [← Equiv.sum_comp (Fin.consEquiv fun _ : Fin (N + 1) ↦ J),
        Fintype.sum_prod_type]
      refine Finset.sum_congr rfl (fun j _ ↦ Finset.sum_congr rfl (fun choice _ ↦ ?_))
      rw [List.ofFn_succ, List.prod_cons]
      simp [Fin.consEquiv]

/-- Scalars extract from an ordered product as their commutative product.
@isnad1 id=eq.0h5v.s6.544391d085d3 from=translated src=- shape=7a1916db vocab=cab3dc4a
-/
theorem prod_ofFn_smul {𝕜 R : Type*} [CommSemiring 𝕜] [Semiring R] [Algebra 𝕜 R]
    {N : ℕ} (c : Fin N → 𝕜) (A : Fin N → R) :
    (List.ofFn fun n : Fin N ↦ c n • A n).prod =
      (∏ n : Fin N, c n) • (List.ofFn A).prod := by
  induction N with
  | zero => simp
  | succ N ih =>
      rw [List.ofFn_succ, List.prod_cons, ih (fun n ↦ c n.succ) (fun n ↦ A n.succ),
        smul_mul_smul_comm, Fin.prod_univ_succ, List.ofFn_succ, List.prod_cons]

end List

namespace Subsemigroup

/-- Every element of the subsemigroup generated by `s` is a nonempty product of elements
of `s`.
@isnad1 id=ex.1h3v.s6.f63596675365 from=translated src=- shape=34af0dd5 vocab=b3f55e3b
-/
theorem exists_nonempty_list_prod_of_mem_closure
    {M : Type*} [Monoid M] {s : Set M} {x : M}
    (hx : x ∈ Subsemigroup.closure s) :
    ∃ l : List M, l ≠ [] ∧ (∀ a ∈ l, a ∈ s) ∧ l.prod = x := by
  induction hx using Subsemigroup.closure_induction with
  | mem x hx => exact ⟨[x], by simp, by simpa, by simp⟩
  | mul x y _ _ hx hy =>
      obtain ⟨lx, hlx, hlxs, hxl⟩ := hx
      obtain ⟨ly, hly, hlys, hyl⟩ := hy
      refine ⟨lx ++ ly, ?_, ?_, ?_⟩
      · simp [hlx]
      · intro a ha
        exact List.mem_append.mp ha |>.elim (hlxs a) (hlys a)
      · rw [List.prod_append, hxl, hyl]

end Subsemigroup
