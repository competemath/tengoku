import Tengoku.Seed.GroupTheory.GroupAction.Blocks
import Tengoku.SharpIntermediateSubgroupBounds.SharpIntermediateSubgroupBounds.GroupMain

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Block systems and subgroup intervals

This file certifies the correspondence used in the concluding paragraph of
`sharp_intermediate_subgroup_bounds.tex`.  For a transitive action, blocks
containing a chosen point are order-equivalent to the subgroups containing its
stabilizer.  In particular, the two finite types have the same cardinality.
-/

namespace SharpIntermediateSubgroupBounds

open MulAction
open scoped Pointwise

variable (G X : Type*) [Group G] [Fintype G] [Fintype X]
variable [MulAction G X] [MulAction.IsPretransitive G X]

/-- A system of imprimitivity is a partition into blocks which is invariant
under translation by the acting group.  The invariance clause is stated
explicitly because Mathlib's bare `MulAction.IsBlockSystem` records only the
partition and block conditions.-/
def IsSystemOfImprimitivity (P : Set (Set X)) : Prop :=
  MulAction.IsBlockSystem G P ∧
    ∀ (g : G) (B : Set X), B ∈ P → g • B ∈ P

/-- The type of systems of imprimitivity for the action of `G` on `X`.-/
abbrev SystemOfImprimitivity :=
  {P : Set (Set X) // IsSystemOfImprimitivity G X P}

/-- The system of translates generated by a block containing the chosen
basepoint.-/
def pointedBlockToSystemOfImprimitivity (a : X) (B : MulAction.BlockMem G a) :
    SystemOfImprimitivity G X := by
  refine ⟨Set.range fun g : G ↦ g • (B : Set X), ?_, ?_⟩
  · exact B.2.2.isBlockSystem ⟨a, B.2.1⟩
  · rintro g C ⟨h, rfl⟩
    exact ⟨g * h, by simp only [smul_smul]⟩

/-- The unique member of a system of imprimitivity containing the chosen
basepoint.-/
noncomputable def systemOfImprimitivityToPointedBlock (a : X)
    (P : SystemOfImprimitivity G X) : MulAction.BlockMem G a := by
  let B : Set X := (P.2.1.1.2 a).choose
  have hB : B ∈ P.1 ∧ a ∈ B := (P.2.1.1.2 a).choose_spec.1
  exact ⟨B, hB.2, P.2.1.2 hB.1⟩

/--
@isnad1 id=mem.0h4v.s6.5772d9765dbc from=translated src=- shape=a0ffa5d2 vocab=d7f5d6dc
-/
lemma systemOfImprimitivityToPointedBlock_mem (a : X)
    (P : SystemOfImprimitivity G X) :
    (systemOfImprimitivityToPointedBlock G X a P : Set X) ∈ P.1 := by
  exact (P.2.1.1.2 a).choose_spec.1.1

/-- In a transitive action, blocks through a basepoint are equivalent to
systems of imprimitivity.-/
noncomputable def pointedBlock_systemOfImprimitivityEquiv (a : X) :
    MulAction.BlockMem G a ≃ SystemOfImprimitivity G X where
  toFun := pointedBlockToSystemOfImprimitivity G X a
  invFun := systemOfImprimitivityToPointedBlock G X a
  left_inv := by
    intro B
    apply Subtype.ext
    let P := pointedBlockToSystemOfImprimitivity G X a B
    exact (P.2.1.1.2 a).unique
      ⟨systemOfImprimitivityToPointedBlock_mem G X a P,
        (systemOfImprimitivityToPointedBlock G X a P).2.1⟩
      ⟨⟨1, by simp⟩, B.2.1⟩
  right_inv := by
    intro P
    apply Subtype.ext
    ext C
    constructor
    · rintro ⟨g, rfl⟩
      exact P.2.2 g _ (systemOfImprimitivityToPointedBlock_mem G X a P)
    · intro hC
      obtain ⟨x, hx⟩ := Setoid.nonempty_of_mem_partition P.2.1.1 hC
      obtain ⟨g, hga⟩ := MulAction.exists_smul_eq G a x
      have hbase :
          (systemOfImprimitivityToPointedBlock G X a P : Set X) ∈ P.1 :=
        systemOfImprimitivityToPointedBlock_mem G X a P
      have hgmem : g • (systemOfImprimitivityToPointedBlock G X a P : Set X) ∈
          P.1 := P.2.2 g _ hbase
      have hxg : x ∈ g • (systemOfImprimitivityToPointedBlock G X a P : Set X) := by
        rw [← hga, Set.smul_mem_smul_set_iff]
        exact (systemOfImprimitivityToPointedBlock G X a P).2.1
      exact ⟨g, Setoid.eq_of_mem_eqv_class P.2.1.1.2 hgmem hxg hC hx⟩

noncomputable local instance blockMemFintype (a : X) :
    Fintype (MulAction.BlockMem G a) :=
  Fintype.ofFinite _

/--
@isnad1 id=finite.0h1v.s3.55a88c868bab from=translated src=- shape=9499e9bc vocab=8ca526be
-/
local instance blocksSubgroupFinite : Finite (Subgroup G) :=
  Finite.of_injective (fun H : Subgroup G => (H : Set G)) SetLike.coe_injective

noncomputable local instance blocksIntervalFintype (H : Subgroup G) :
    Fintype (Set.Ici H) :=
  Fintype.ofFinite _

noncomputable local instance systemOfImprimitivityFintype :
    Fintype (SystemOfImprimitivity G X) :=
  Fintype.ofFinite _

/-- In a finite transitive action, the blocks containing `a` are equinumerous
with the subgroups containing the stabilizer of `a`.

This is the exact cardinal form of the block--subgroup correspondence used to
transfer subgroup-interval estimates to transitive permutation actions.
@isnad1 id=eq.0h3v.s6.3e491beb2e01 from=translated src=- shape=0a6910e5 vocab=82ec6f2c
-/
theorem blockMem_card_eq_interval_card (a : X) :
    Fintype.card (MulAction.BlockMem G a) =
      Fintype.card (Set.Ici (MulAction.stabilizer G a)) := by
  classical
  exact Fintype.card_congr (MulAction.block_stabilizerOrderIso G a).toEquiv

/-- Systems of imprimitivity, rather than merely individual pointed blocks,
are counted exactly by the intermediate subgroups above a point stabilizer.
@isnad1 id=eq.0h3v.s6.625a79f10dbd from=translated src=- shape=1baf055c vocab=dceae782
-/
theorem systemOfImprimitivity_card_eq_interval_card (a : X) :
    Fintype.card (SystemOfImprimitivity G X) =
      Fintype.card (Set.Ici (MulAction.stabilizer G a)) := by
  classical
  exact Fintype.card_congr
    ((pointedBlock_systemOfImprimitivityEquiv G X a).symm.trans
      (MulAction.block_stabilizerOrderIso G a).toEquiv)

/-- The sharp universal interval estimate transferred to block systems of a
finite transitive action.
@isnad1 id=lt.1h3v.s7.6399ad2bc3bb from=translated src=- shape=0a62c4ba vocab=45ec22d3
-/
theorem blockMem_card_lt_universal (a : X) (hX : 1 < Nat.card X) :
    (Fintype.card (MulAction.BlockMem G a) : ℝ) <
      sharpConstant 2 *
        (Nat.card X : ℝ) ^ (indexLog 2 (Nat.card X) / 4) := by
  have hindex : (MulAction.stabilizer G a).index = Nat.card X :=
    MulAction.index_stabilizer_of_transitive G a
  have hn : 1 < (MulAction.stabilizer G a).index := hindex.symm ▸ hX
  have hmain := interval_card_lt_universal_rpow
    (H := MulAction.stabilizer G a) hn
  rw [Nat.card_eq_fintype_card] at hmain
  change
    (Fintype.card (Set.Ici (MulAction.stabilizer G a)) : ℝ) <
      sharpConstant 2 *
        ((MulAction.stabilizer G a).index : ℝ) ^
          (indexLog 2 (MulAction.stabilizer G a).index / 4) at hmain
  rw [← blockMem_card_eq_interval_card G X a] at hmain
  simpa [hindex] using hmain

/-- The sharp universal bound for the number of genuine invariant systems
of imprimitivity of a finite transitive action.
@isnad1 id=lt.1h3v.s7.d1705ab77494 from=translated src=- shape=130b343f vocab=41e32398
-/
theorem systemOfImprimitivity_card_lt_universal (a : X)
    (hX : 1 < Nat.card X) :
    (Fintype.card (SystemOfImprimitivity G X) : ℝ) <
      sharpConstant 2 *
        (Nat.card X : ℝ) ^ (indexLog 2 (Nat.card X) / 4) := by
  have hpointed := blockMem_card_lt_universal G X a hX
  rw [Fintype.card_congr (pointedBlock_systemOfImprimitivityEquiv G X a)] at hpointed
  exact hpointed

/-- All-degree form of the system-of-imprimitivity estimate.  In degree one
there is exactly one invariant system and the same strict analytic bound is
still valid.
@isnad1 id=lt.0h3v.s6.ff233ed6d690 from=translated src=- shape=dabe1974 vocab=41e32398
-/
theorem systemOfImprimitivity_card_lt_universal_all_degrees (a : X) :
    (Fintype.card (SystemOfImprimitivity G X) : ℝ) <
      sharpConstant 2 *
        (Nat.card X : ℝ) ^ (indexLog 2 (Nat.card X) / 4) := by
  by_cases hX : 1 < Nat.card X
  · exact systemOfImprimitivity_card_lt_universal G X a hX
  · letI : Nonempty X := ⟨a⟩
    have hXone : Nat.card X = 1 := by
      have hXpos : 0 < Nat.card X := Nat.card_pos
      omega
    have hindex : (MulAction.stabilizer G a).index = 1 := by
      rw [MulAction.index_stabilizer_of_transitive G a, hXone]
    have hstab : MulAction.stabilizer G a = ⊤ :=
      Subgroup.index_eq_one.mp hindex
    have hcard : Fintype.card (SystemOfImprimitivity G X) = 1 := by
      rw [systemOfImprimitivity_card_eq_interval_card G X a, hstab]
      simp
    have hc : (1 : ℝ) < sharpConstant 2 := by
      have hc' := sharpConstant_two_decimal_enclosure.1
      norm_num at hc' ⊢
      linarith
    rw [hcard, hXone]
    norm_num [indexLog]
    exact hc

end SharpIntermediateSubgroupBounds
