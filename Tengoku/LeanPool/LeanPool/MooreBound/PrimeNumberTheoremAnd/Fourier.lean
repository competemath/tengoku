theorem nnnorm_eq_of_mem_circle (z : Circle) : ‖z.val‖₊ = 1 := NNReal.coe_eq_one.mp z.norm_coe

/--
@isnad1 id=eq.0h2v.s5.f627ff5e8b58 from=translated src=- shape=0ef0c345 vocab=c7657de0
