import Tengoku.Seed.GroupTheory.FreeGroup.Basic
import Tengoku.YamaguchiPapers.Nyll.ProCGroups.Generation.QuotientGeneratorConvergingPairs

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Basic results on topological finite generation

This module defines topological finite generation and topologically characteristic subgroups,
then relates finite generating sets to free-group maps and generator-converging families.
-/

open Set
open scoped Topology Pointwise

namespace ProCGroups.FiniteGeneration

universe u v w

open ProCGroups.Generation

section Basic

variable {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- Finitely generated as a topological group.-/
def TopologicallyFinitelyGenerated
    (G : Type u) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] : Prop :=
  ∃ s : Finset G, TopologicallyGenerates (G := G) (↑s : Set G)

/-- A subgroup is topologically characteristic if every continuous automorphism preserves it.-/
def IsTopologicallyCharacteristic
    (G : Type u) [Group G] [TopologicalSpace G] (H : Subgroup G) : Prop :=
  ∀ φ : G ≃ₜ* G, ∀ g : G, φ g ∈ H ↔ g ∈ H

section Characteristic

omit [IsTopologicalGroup G]

/--
Membership in a topologically characteristic subgroup is invariant under applying a continuous
automorphism.
@isnad1 id=iff.1h4v.s7.a4e0555cccea from=translated src=- shape=d7d8ad5b vocab=9f31d9fb
-/
theorem IsTopologicallyCharacteristic.apply_mem_iff {H : Subgroup G}
    (hH : IsTopologicallyCharacteristic (G := G) H) (φ : G ≃ₜ* G) {g : G} :
    φ g ∈ H ↔ g ∈ H :=
  hH φ g

/-- Intersections of topologically characteristic subgroups are topologically characteristic.
@isnad1 id=istopolo.2h3v.s5.e2435f9b6477 from=translated src=- shape=536dba1b vocab=25a5033f
-/
theorem IsTopologicallyCharacteristic.inf {H K : Subgroup G}
    (hH : IsTopologicallyCharacteristic (G := G) H) (hK : IsTopologicallyCharacteristic (G := G)
        K) :
    IsTopologicallyCharacteristic (G := G) (H ⊓ K) := by
  intro φ g
  simp only [Subgroup.mem_inf, hH φ g, hK φ g]

/-- Arbitrary infima of topologically characteristic subgroups are topologically characteristic.
@isnad1 id=istopolo.1h2v.s5.a6afbce0ef43 from=translated src=- shape=24b0215a vocab=42900993
-/
theorem IsTopologicallyCharacteristic.sInf {S : Set (Subgroup G)}
    (hS : ∀ H ∈ S, IsTopologicallyCharacteristic (G := G) H) :
    IsTopologicallyCharacteristic (G := G) (sInf S) := by
  intro φ g
  simp only [Subgroup.mem_sInf]
  constructor
  · intro hg H hH
    exact (hS H hH φ g).1 (hg H hH)
  · intro hg H hH
    exact (hS H hH φ g).2 (hg H hH)

/-- Indexed infima of topologically characteristic subgroups are topologically characteristic.
@isnad1 id=istopolo.1h3v.s5.ec66f52c8b72 from=translated src=- shape=20c29c7a vocab=cd5ee410
-/
theorem IsTopologicallyCharacteristic.iInf {ι : Sort*} {S : ι → Subgroup G}
    (hS : ∀ i, IsTopologicallyCharacteristic (G := G) (S i)) :
    IsTopologicallyCharacteristic (G := G) (iInf S) := by
  intro φ g
  simp only [Subgroup.mem_iInf]
  constructor
  · intro hg i
    exact (hS i φ g).1 (hg i)
  · intro hg i
    exact (hS i φ g).2 (hg i)

/--
The top subgroup is topologically characteristic, since every continuous automorphism preserves
it.
@isnad1 id=istopolo.0h1v.s4.d4354d20f4f4 from=translated src=- shape=6860a48c vocab=7ad84e1d
-/
@[simp] theorem IsTopologicallyCharacteristic.top :
    IsTopologicallyCharacteristic (G := G) (⊤ : Subgroup G) := by
  intro φ g
  simp only [Subgroup.mem_top]

end Characteristic

/-- \(G\) can be topologically generated by at most \(n\) elements.-/
def TopologicallyGeneratedByAtMost
    (n : ℕ) (G : Type u) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] :
    Prop :=
  ∃ s : Finset G, s.card ≤ n ∧ TopologicallyGenerates (G := G) (↑s : Set G)

/-- Increasing the allowed number of generators preserves bounded topological generation.
@isnad1 id=topologi.2h3v.s5.1e0a70fb6133 from=translated src=- shape=b4f4b692 vocab=38afe6af
-/
theorem TopologicallyGeneratedByAtMost.mono {m n : ℕ}
    (hmn : m ≤ n)
    (hG : TopologicallyGeneratedByAtMost (G := G) m) :
    TopologicallyGeneratedByAtMost (G := G) n := by
  rcases hG with ⟨s, hs, hgen⟩
  exact ⟨s, hs.trans hmn, hgen⟩

/--
A group is topologically finitely generated if and only if it is generated by at most \(n\)
elements for some natural number \(n\).
@isnad1 id=iff.0h1v.s4.2f7107e62a93 from=translated src=- shape=19719908 vocab=18d1d5ed
-/
theorem topologicallyFinitelyGenerated_iff_exists_topologicallyGeneratedByAtMost :
    TopologicallyFinitelyGenerated G ↔
      ∃ n, TopologicallyGeneratedByAtMost (G := G) n := by
  constructor
  · rintro ⟨s, hs⟩
    exact ⟨s.card, s, le_rfl, hs⟩
  · rintro ⟨_n, s, _hs, hgen⟩
    exact ⟨s, hgen⟩

omit [IsTopologicalGroup G] in
/-- A finite set of elements converges to \(1\) in the profinite generating-family sense.
@isnad1 id=converge.0h2v.s4.8622a11218a2 from=translated src=- shape=3e028cc7 vocab=502179e6
-/
theorem finiteSet_convergesToOneAlongOpenSubgroups (s : Finset G) :
    ConvergesToOneAlongOpenSubgroups (G := G) (↑s : Set G) :=
  ConvergesToOneAlongOpenSubgroups.of_finite s.finite_toSet

/--
If \(G\) is topologically generated by at most \(n\) elements, its topological rank is at most
\(n\).
@isnad1 id=le.1h2v.s5.27a35aaec999 from=translated src=- shape=e5a46af7 vocab=7e4bcd4c
-/
theorem topologicalRank_le_of_topologicallyGeneratedByAtMost {n : ℕ}
    (h : TopologicallyGeneratedByAtMost (G := G) n) :
    topologicalRank G ≤ n := by
  rcases h with ⟨s, hs, hgen⟩
  have hconv : ConvergesToOneAlongOpenSubgroups (G := G) (↑s : Set G) :=
    finiteSet_convergesToOneAlongOpenSubgroups (G := G) s
  calc
    topologicalRank G ≤ Cardinal.mk (↑s : Set G) :=
      topologicalRank_le_mk_of_generatesAndConvergesToOneAlongOpenSubgroups (G := G) ⟨hgen, hconv⟩
    _ = (s.card : Cardinal) := by
      exact Cardinal.mk_coe_finset (s := s)
    _ ≤ n := by
      exact_mod_cast hs

/--
The image of a topological generating family under a continuous surjective homomorphism
topologically generates the codomain.
@isnad1 id=topologi.2h5v.s7.68a633297c37 from=translated src=- shape=1d66e90d vocab=65aa2b03
-/
theorem topologicallyGenerates_range_comp_of_surjective
    {H : Type v} [Group H] [TopologicalSpace H] [IsTopologicalGroup H]
    (φ : G →ₜ* H) (hφ : Function.Surjective φ)
    {ι : Sort w} (g : ι → G)
    (hg : TopologicallyGenerates (G := G) (Set.range g)) :
    TopologicallyGenerates (G := H) (Set.range (φ ∘ g)) := by
  simpa [Set.range_comp, Function.comp] using
    topologicallyGenerates_image_of_continuousMonoidHom_surjective
      (G := G) (H := H) φ hφ hg

/-- Bounded topological generation descends along continuous surjective homomorphisms.
@isnad1 id=topologi.2h4v.s6.58eca1d2a5dd from=translated src=- shape=a13d0cd2 vocab=1e81e0ed
-/
theorem TopologicallyGeneratedByAtMost.of_surjective
    {H : Type v} [Group H] [TopologicalSpace H] [IsTopologicalGroup H]
    (φ : G →ₜ* H) (hφ : Function.Surjective φ) {n : ℕ}
    (hG : TopologicallyGeneratedByAtMost (G := G) n) :
    TopologicallyGeneratedByAtMost (G := H) n := by
  classical
  rcases hG with ⟨s, hs, hgen⟩
  refine ⟨s.image φ, (Finset.card_image_le).trans hs, ?_⟩
  simpa [Finset.coe_image] using
    topologicallyGenerates_image_of_continuousMonoidHom_surjective
      (G := G) (H := H) φ hφ hgen

/-- Topological finite generation descends along continuous surjective homomorphisms.
@isnad1 id=topologi.2h3v.s6.a759428b93ed from=translated src=- shape=6a789d64 vocab=6d4e5cb5
-/
theorem topologicallyFinitelyGenerated_of_continuousSurjective
    {H : Type v} [Group H] [TopologicalSpace H] [IsTopologicalGroup H]
    (φ : G →ₜ* H) (hφ : Function.Surjective φ)
    (hG : TopologicallyFinitelyGenerated G) :
    TopologicallyFinitelyGenerated H := by
  rw [topologicallyFinitelyGenerated_iff_exists_topologicallyGeneratedByAtMost] at hG ⊢
  rcases hG with ⟨n, hn⟩
  exact ⟨n, TopologicallyGeneratedByAtMost.of_surjective (G := G) (H := H) φ hφ hn⟩

/-- In the discrete case, topological generation is abstract subgroup generation.
@isnad1 id=iff.0h2v.s5.5e1f1627b95e from=translated src=- shape=5502da23 vocab=70828bb8
-/
theorem topologicallyGenerates_iff_subgroupClosure_eq_top_of_discrete
    [DiscreteTopology G] {X : Set G} :
    TopologicallyGenerates (G := G) X ↔ Subgroup.closure X = ⊤ := by
  have htc : (Subgroup.closure X).topologicalClosure = Subgroup.closure X := by
    apply SetLike.ext'
    rw [Subgroup.topologicalClosure_coe]
    exact closure_discrete ((Subgroup.closure X : Subgroup G) : Set G)
  rw [TopologicallyGenerates, htc]

/--
A map from a free group to a discrete group is surjective when the images of the chosen
generators topologically generate the target; in the discrete topology this is exactly abstract
generation.
@isnad1 id=surjecti.1h3v.s8.ac22e1199f1b from=translated src=- shape=ae4536c0 vocab=908088c1
-/
theorem freeGroup_lift_surjective_of_topologicallyGenerates_discrete
    {X : Type v} [DiscreteTopology G] (g : X → G)
    (hg : TopologicallyGenerates (G := G) (Set.range g)) :
    Function.Surjective (FreeGroup.lift g) := by
  rw [topologicallyGenerates_iff_subgroupClosure_eq_top_of_discrete] at hg
  have hclosure_le_range :
      Subgroup.closure (Set.range g) ≤ (FreeGroup.lift g).range := by
    refine (Subgroup.closure_le (K := (FreeGroup.lift g).range)).2 ?_
    rintro y ⟨x, rfl⟩
    exact ⟨FreeGroup.of x, by simp only [FreeGroup.lift_apply_of]⟩
  intro y
  have hy : y ∈ Subgroup.closure (Set.range g) := by
    rw [hg]
    trivial
  exact hclosure_le_range hy

/-- A finite discrete group is topologically finitely generated.
@isnad1 id=topologi.0h1v.s4.5861281ed658 from=translated src=- shape=fb04960b vocab=100ec0d6
-/
theorem topologicallyFinitelyGenerated_of_finite [Finite G] [DiscreteTopology G] :
    TopologicallyFinitelyGenerated G := by
  classical
  let : Fintype G := Fintype.ofFinite G
  refine ⟨Finset.univ, ?_⟩
  rw [topologicallyGenerates_iff_subgroupClosure_eq_top_of_discrete]
  simp only [Finset.coe_univ, Subgroup.closure_univ]

/--
If the topological rank of a profinite group is the natural number \(n\), then the group is
topologically generated by at most \(n\) elements.
@isnad1 id=topologi.1h2v.s5.4d7da6d0a468 from=translated src=- shape=29f17dcb vocab=8439b357
-/
theorem topologicallyGeneratedByAtMost_of_topologicalRank_eq_nat
    [CompactSpace G] [T2Space G] [TotallyDisconnectedSpace G] {n : ℕ}
    (hd : topologicalRank G = n) :
    TopologicallyGeneratedByAtMost (G := G) n := by
  classical
  rcases exists_topologicallyGenerates_card_eq_topologicalRank (G := G) with
    ⟨X, hX, hXcard⟩
  have hXlt : Cardinal.mk X < Cardinal.aleph0 := by
    calc
      Cardinal.mk X = topologicalRank G := hXcard
      _ = n := hd
      _ < Cardinal.aleph0 := Cardinal.natCast_lt_aleph0 (n := n)
  have : Finite X := (Cardinal.lt_aleph0_iff_finite (α := X)).mp hXlt
  have hXfin : X.Finite := Set.toFinite X
  let s : Finset G := hXfin.toFinset
  have hs_card : s.card = n := by
    have hs_mk : (s.card : Cardinal) = Cardinal.mk X := by
      simpa [s] using (Cardinal.mk_coe_finset (s := hXfin.toFinset)).symm
    exact_mod_cast (hs_mk.trans (hXcard.trans hd))
  refine ⟨s, hs_card.le, ?_⟩
  simpa [s] using hX

/--
A finite upper bound on the topological rank gives an explicit generating tuple of that length.
@isnad1 id=ex.2h2v.s5.2a83c593321e from=translated src=- shape=4b7cbbe0 vocab=9d26ca59
-/
theorem exists_generatingTuple_of_topologicalRank_le_of_finite
    (hG : TopologicallyFinitelyGenerated G) {n : ℕ} (hd : topologicalRank G ≤ n) :
    ∃ g : Fin n → G, TopologicallyGenerates (G := G) (Set.range g) := by
  classical
  have hdfin : topologicalRank G < Cardinal.aleph0 := by
    rcases hG with ⟨s, hs⟩
    have hconv : ConvergesToOneAlongOpenSubgroups (G := G) (↑s : Set G) :=
      finiteSet_convergesToOneAlongOpenSubgroups (G := G) s
    have hdle : topologicalRank G ≤ Cardinal.mk (↑s : Set G) :=
      topologicalRank_le_mk_of_generatesAndConvergesToOneAlongOpenSubgroups (G := G) ⟨hs, hconv⟩
    exact hdle.trans_lt <| by
      have hsMk : Cardinal.mk (↑s : Set G) = (s.card : Cardinal) :=
        Cardinal.mk_coe_finset (s := s)
      rw [hsMk]
      exact Cardinal.natCast_lt_aleph0 (n := s.card)
  let m := Cardinal.toNat (topologicalRank G)
  have hm : topologicalRank G = m := by
    symm
    exact Cardinal.cast_toNat_of_lt_aleph0 hdfin
  rcases exists_topologicallyGenerates_card_eq_topologicalRank (G := G) with
    ⟨X, hX, hXcard⟩
  have hXfin : X.Finite := by
    have hXlt : Cardinal.mk X < Cardinal.aleph0 := by
      calc
        Cardinal.mk X = topologicalRank G := hXcard
        _ = m := hm
        _ < Cardinal.aleph0 := Cardinal.natCast_lt_aleph0 (n := m)
    have : Finite X := (Cardinal.lt_aleph0_iff_finite (α := X)).mp hXlt
    exact Set.toFinite X
  let s : Finset G := hXfin.toFinset
  have hs_gen : TopologicallyGenerates (G := G) (↑s : Set G) := by
    simpa [s] using hX
  have hs_card : s.card = m := by
    have hs_mk : (s.card : Cardinal) = Cardinal.mk X := by
      simpa [s] using (Cardinal.mk_coe_finset (s := hXfin.toFinset)).symm
    exact_mod_cast (hs_mk.trans (hXcard.trans hm))
  have hmle : m ≤ n := by
    simpa [m] using
      (Cardinal.toNat_le_toNat hd (Cardinal.natCast_lt_aleph0 (n := n)))
  have hs_le : s.card ≤ n := by
    simpa [hs_card] using hmle
  let e : Fin s.card ≃ s := by
     simpa using (Fintype.equivFin s).symm
  let g0 : Fin s.card → G := fun i => (e i : G)
  have hs_subset_range : (↑s : Set G) ⊆ Set.range g0 := by
    intro x hx
    refine ⟨e.symm ⟨x, hx⟩, ?_⟩
    simp only [Equiv.apply_symm_apply, g0]
  have hg0 : TopologicallyGenerates (G := G) (Set.range g0) :=
    topologicallyGenerates_mono hs_gen hs_subset_range
  let g : Fin n → G := fun i =>
    if hi : i.1 < s.card then g0 ⟨i.1, hi⟩ else 1
  have hg0_subset : Set.range g0 ⊆ Set.range g := by
    intro x hx
    rcases hx with ⟨i, rfl⟩
    refine ⟨Fin.castLE hs_le i, ?_⟩
    have hi : (Fin.castLE hs_le i).1 < s.card := i.2
    simp only [Fin.val_castLE, Fin.is_lt, ↓reduceDIte, Fin.eta, g]
  exact ⟨g, topologicallyGenerates_mono hg0 hg0_subset⟩

end Basic

end ProCGroups.FiniteGeneration
