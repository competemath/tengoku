import Tengoku.YamaguchiPapers.Nyll.EtaleFundamentalGroups.Kummer.RootCovers.Local.Basic
import Tengoku.Seed.RingTheory.KrullDimension.Regular
import Tengoku.Seed.RingTheory.RegularLocalRing.Defs

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Regularity of a local Kummer root cover

This file proves the regular-local part of the one-step Kummer root
construction.  The key dimension input is produced here from going-up:
a faithfully integral extension cannot decrease Krull dimension.

For `B = R[X] / (X ^ n - a)`, if `a :: rs` is a regular sequence generating
the maximal ideal of `R`, then the maximal ideal of `B` is generated by the
adjoined root followed by the images of `rs`.  This generating family has the
same length as the dimension of `R`; going-up supplies the required lower
bound on the dimension of `B`, so `B` is regular local.
-/

namespace EtaleFundamentalGroups.Kummer

open Polynomial
open IsLocalRing

universe u v

noncomputable section

namespace IntegralDimension

private theorem exists_lift_ltSeries
    {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    [Nontrivial R] [Algebra R S] [Algebra.IsIntegral R S] [FaithfulSMul R S]
    (p : LTSeries (PrimeSpectrum R)) :
    ∃ q : LTSeries (PrimeSpectrum S),
      q.length = p.length ∧
        q.last.asIdeal.comap (algebraMap R S) = p.last.asIdeal := by
  refine RelSeries.inductionOn'
    (motive := fun p : LTSeries (PrimeSpectrum R) ↦
      ∃ q : LTSeries (PrimeSpectrum S),
        q.length = p.length ∧
          q.last.asIdeal.comap (algebraMap R S) = p.last.asIdeal)
    ?_ ?_ p
  · intro P
    let Q : P.asIdeal.primesOver S := Classical.choice inferInstance
    let q : LTSeries (PrimeSpectrum S) :=
      RelSeries.singleton (r := {xy : PrimeSpectrum S × PrimeSpectrum S | xy.1 < xy.2})
        ⟨Q.1, Q.2.1⟩
    refine ⟨q, rfl, ?_⟩
    exact Q.2.2.over.symm
  · intro p P hp ⟨q, hlen, hlast⟩
    change p.last < P at hp
    have hcomap_le :
        q.last.asIdeal.comap (algebraMap R S) ≤ P.asIdeal := by
      rw [hlast]
      exact hp.le
    obtain ⟨Q, hqQ, hQprime, hQcomap⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime
        P.asIdeal q.last.asIdeal hcomap_le
    let Q' : PrimeSpectrum S := ⟨Q, hQprime⟩
    have hne : q.last ≠ Q' := by
      intro heq
      apply hp.ne
      apply PrimeSpectrum.ext
      rw [← hlast, ← hQcomap]
      exact congrArg (fun I : Ideal S ↦ I.comap (algebraMap R S))
        (congrArg PrimeSpectrum.asIdeal heq)
    have hlt : q.last < Q' := lt_of_le_of_ne hqQ hne
    refine ⟨q.snoc Q' hlt, ?_, ?_⟩
    · simpa using hlen
    · simpa [Q'] using hQcomap

/-- A faithfully integral extension cannot decrease Krull dimension.-/
theorem ringKrullDim_le_of_faithfully_integral
    {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    [Nontrivial R] [Algebra R S] [Algebra.IsIntegral R S] [FaithfulSMul R S] :
    ringKrullDim R ≤ ringKrullDim S := by
  let : Nontrivial S := (FaithfulSMul.algebraMap_injective R S).nontrivial
  rw [ringKrullDim, ringKrullDim, Order.krullDim_eq_iSup_length,
    Order.krullDim_eq_iSup_length]
  apply WithBot.coe_le_coe.mpr
  refine iSup_le fun p ↦ ?_
  obtain ⟨q, hlen, -⟩ := exists_lift_ltSeries (R := R) (S := S) p
  rw [← hlen]
  exact le_iSup (fun q : LTSeries (PrimeSpectrum S) ↦
    (q.length : ℕ∞)) q

end IntegralDimension

/-- The parameter list on the root cover: the new root replaces `a`.-/
def localRootCoverParameterList
    (R : Type u) [CommRing R] (n : ℕ) (a : R) (rs : List R) :
    List (AdjoinRoot (X ^ n - C a)) :=
  AdjoinRoot.root (X ^ n - C a) ::
    rs.map (AdjoinRoot.of (X ^ n - C a))

@[simp]
theorem localRootCoverParameterList_length
    (R : Type u) [CommRing R] (n : ℕ) (a : R) (rs : List R) :
    (localRootCoverParameterList R n a rs).length = (a :: rs).length := by
  simp [localRootCoverParameterList]

end

end EtaleFundamentalGroups.Kummer
