import Tengoku.QuotientSubmoduleEquidistribution.QuotientSubmoduleEquidistribution.RepresentationTheory.TrivSqZeroExtSeparatedModuleFunctor

/-! Tengoku: the imports are the original's, in the tree's names (the umbrella `Tengoku` made names ambiguous). -/

/-!
# Top-trace comparison for separated square-zero data

The top trace generated by maps from one module, or from any family of
modules, is unchanged when Hom spaces are replaced by the corresponding
action-compatible Hom spaces of separated data.  Fullness of the
module-to-data functor supplies the reverse inclusion.
-/

set_option autoImplicit false
noncomputable section
open CategoryTheory

namespace QuotientSubmoduleEquidistribution.TrivSqZeroExtSeparatedTrace

open QuotientSubmoduleEquidistribution
open QuotientSubmoduleEquidistribution.ModuleRadicalLayerComparison
open QuotientSubmoduleEquidistribution.TrivSqZeroExtSeparatedData
open QuotientSubmoduleEquidistribution.TrivSqZeroExtSeparatedCorrespondence
open QuotientSubmoduleEquidistribution.TrivSqZeroExtSeparatedModuleFunctor

universe u v w x
variable {S : Type u} {J : Type v}
variable [CommRing S] [AddCommGroup J]
variable [Module S J] [Module Sᵐᵒᵖ J]
variable [SMulCommClass S Sᵐᵒᵖ J]

def moduleTopTrace
    (X Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    Submodule S (moduleTopS (S := S) (J := J) Y) :=
  ⨆ f : X ⟶ Y, LinearMap.range (moduleTopMapS f)

def separatedDataTopTrace
    (D E : SeparatedData.{u, v, w} (S := S) (J := J)) :
    Submodule S E.top :=
  ⨆ p : D ⟶ E, LinearMap.range p.val.1

/--
@isnad1 id=eq.0h4v.s8.a38ea6b50bb1 from=translated src=- shape=ddcaa40c vocab=94c5659d
-/
theorem moduleTopTrace_eq_separatedDataTopTrace
    [IsSemisimpleRing S]
    (X Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    moduleTopTrace X Y =
      separatedDataTopTrace
        (moduleSeparatedData (S := S) (J := J) X)
        (moduleSeparatedData (S := S) (J := J) Y) := by
  apply le_antisymm
  · apply iSup_le
    intro f
    exact le_iSup
      (fun p : moduleSeparatedData (S := S) (J := J) X ⟶
          moduleSeparatedData (S := S) (J := J) Y ↦
        LinearMap.range p.val.1)
      (moduleSeparatedDataMap f)
  · apply iSup_le
    intro p
    obtain ⟨f, hf⟩ :=
      (moduleSeparatedDataFunctor (S := S) (J := J)).map_surjective p
    have htop := congrArg (fun q ↦ q.val.1) hf
    rw [← htop]
    exact le_iSup
      (fun f : X ⟶ Y ↦ LinearMap.range (moduleTopMapS f)) f

def moduleFamilyTopTrace
    {A : Type x} (X : A → ModuleCat.{w} (TrivSqZeroExt S J))
    (Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    Submodule S (moduleTopS (S := S) (J := J) Y) :=
  ⨆ a, moduleTopTrace (X a) Y

/-- Reindexing a source family by an equivalence does not change its top
trace.
@isnad1 id=eq.0h7v.s8.86921b7471b0 from=translated src=- shape=8d734dc7 vocab=1c5ad3e9
-/
theorem moduleFamilyTopTrace_reindex
    {A : Type x} {B : Type*} (e : A ≃ B)
    (X : B → ModuleCat.{w} (TrivSqZeroExt S J))
    (Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    moduleFamilyTopTrace (fun a ↦ X (e a)) Y =
      moduleFamilyTopTrace X Y := by
  apply le_antisymm
  · apply iSup_le
    intro a
    exact le_iSup
      (fun b ↦ moduleTopTrace (X b) Y) (e a)
  · apply iSup_le
    intro b
    simpa [moduleFamilyTopTrace] using le_iSup
      (fun a ↦ moduleTopTrace (X (e a)) Y) (e.symm b)

/-- The top trace of a family indexed by a disjoint union is the join of the
two family traces.
@isnad1 id=eq.0h7v.s9.4984e78eafaf from=translated src=- shape=f0bb371f vocab=8f0200a0
-/
theorem moduleFamilyTopTrace_sum
    {A : Type x} {B : Type*}
    (X : A → ModuleCat.{w} (TrivSqZeroExt S J))
    (Z : B → ModuleCat.{w} (TrivSqZeroExt S J))
    (Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    moduleFamilyTopTrace (Sum.elim X Z) Y =
      moduleFamilyTopTrace X Y ⊔ moduleFamilyTopTrace Z Y := by
  apply le_antisymm
  · apply iSup_le
    intro a
    cases a with
    | inl a =>
        exact (le_iSup (fun a ↦ moduleTopTrace (X a) Y) a).trans
          le_sup_left
    | inr b =>
        exact (le_iSup (fun b ↦ moduleTopTrace (Z b) Y) b).trans
          le_sup_right
  · apply sup_le
    · apply iSup_le
      intro a
      exact le_iSup
        (fun z ↦ moduleTopTrace (Sum.elim X Z z) Y) (Sum.inl a)
    · apply iSup_le
      intro b
      exact le_iSup
        (fun z ↦ moduleTopTrace (Sum.elim X Z z) Y) (Sum.inr b)

def separatedDataFamilyTopTrace
    {A : Type x} (D : A → SeparatedData.{u, v, w} (S := S) (J := J))
    (E : SeparatedData.{u, v, w} (S := S) (J := J)) :
    Submodule S E.top :=
  ⨆ a, separatedDataTopTrace (D a) E

/--
@isnad1 id=eq.0h5v.s8.d0c8d74de479 from=translated src=- shape=626c8c87 vocab=710fea26
-/
theorem moduleFamilyTopTrace_eq_separatedDataFamilyTopTrace
    [IsSemisimpleRing S]
    {A : Type x} (X : A → ModuleCat.{w} (TrivSqZeroExt S J))
    (Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    moduleFamilyTopTrace X Y =
      separatedDataFamilyTopTrace
        (fun a ↦ moduleSeparatedData (S := S) (J := J) (X a))
        (moduleSeparatedData (S := S) (J := J) Y) := by
  apply iSup_congr
  intro a
  exact moduleTopTrace_eq_separatedDataTopTrace (X a) Y

/-- The trace in a target generated by all maps from one source module.-/
def moduleTrace
    (X Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    Submodule (TrivSqZeroExt S J) Y :=
  ⨆ f : X ⟶ Y, LinearMap.range f.hom

/-- The image in the target top of all maps from one source module.-/
def moduleTopTraceR
    (X Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    Submodule (TrivSqZeroExt S J)
      (Y ⧸ Module.jacobson (TrivSqZeroExt S J) Y) :=
  ⨆ f : X ⟶ Y, LinearMap.range (topMap f.hom)

/-- Passing a one-source trace to the quotient by the target radical gives
exactly the trace of the induced maps on tops.
@isnad1 id=eq.0h4v.s10.52047ba89f99 from=translated src=- shape=616eaf7d vocab=65b0196b
-/
theorem moduleTopTraceR_eq_map_moduleTrace
    (X Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    moduleTopTraceR X Y =
      (moduleTrace X Y).map
        (Module.jacobson (TrivSqZeroExt S J) Y).mkQ := by
  rw [moduleTrace, Submodule.map_iSup]
  apply iSup_congr
  intro f
  simpa [topMap] using (Submodule.range_mapQ
    (Module.jacobson (TrivSqZeroExt S J) X)
    (Module.jacobson (TrivSqZeroExt S J) Y) f.hom
    (Module.le_comap_jacobson f.hom))

/-- The `R`-linear trace on the top fills it exactly when its scalar
restriction, expressed as the `S`-linear top trace, fills it.
@isnad1 id=iff.0h4v.s10.d02c9fa6f65c from=translated src=- shape=0d2d244f vocab=2efbd5f7
-/
theorem moduleTopTraceR_eq_top_iff_moduleTopTrace_eq_top
    (X Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    moduleTopTraceR X Y = ⊤ ↔ moduleTopTrace X Y = ⊤ := by
  let i := TrivSqZeroExt.inlHom S J
  letI : Module S (Y ⧸ Module.jacobson (TrivSqZeroExt S J) Y) :=
    Module.compHom (Y ⧸ Module.jacobson (TrivSqZeroExt S J) Y) i
  letI : IsScalarTower S (TrivSqZeroExt S J)
      (Y ⧸ Module.jacobson (TrivSqZeroExt S J) Y) :=
    { smul_assoc := by
        intro s r q
        change (s • r) • q =
          (TrivSqZeroExt.inl s : TrivSqZeroExt S J) • (r • q)
        rw [← TrivSqZeroExt.inl_mul_eq_smul s r]
        exact mul_smul
          (TrivSqZeroExt.inl s : TrivSqZeroExt S J) r q }
  have hrestrict :
      (moduleTopTraceR X Y).restrictScalars S = moduleTopTrace X Y := by
    simp only [moduleTopTraceR, moduleTopTrace,
      Submodule.restrictScalars_iSup]
    apply iSup_congr
    intro f
    rfl
  rw [← hrestrict]
  exact (Submodule.restrictScalars_eq_top_iff
    (S := S) (R := TrivSqZeroExt S J)
    (M := Y ⧸ Module.jacobson (TrivSqZeroExt S J) Y)
    (p := moduleTopTraceR X Y)).symm

/-- The manuscript's top-coverage criterion for all maps from one source:
the trace plus the target radical fills the target exactly when the induced
top trace fills the semisimple top.
@isnad1 id=iff.0h4v.s11.dc4ca6cb164e from=translated src=- shape=8cf6426e vocab=41eb87da
-/
theorem moduleTrace_sup_jacobson_eq_top_iff
    (X Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    moduleTrace X Y ⊔ Module.jacobson (TrivSqZeroExt S J) Y = ⊤ ↔
      moduleTopTraceR X Y = ⊤ := by
  rw [moduleTopTraceR_eq_map_moduleTrace]
  rw [sup_comm]
  exact (Submodule.map_mkQ_eq_top
    (Module.jacobson (TrivSqZeroExt S J) Y) (moduleTrace X Y)).symm

/-- One-source top coverage can be checked entirely in the corresponding
separated data.
@isnad1 id=iff.0h4v.s10.11de06af6f57 from=translated src=- shape=17e9b53b vocab=a5b72d2e
-/
theorem moduleTrace_sup_jacobson_eq_top_iff_separatedDataTopTrace_eq_top
    [IsSemisimpleRing S]
    (X Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    moduleTrace X Y ⊔ Module.jacobson (TrivSqZeroExt S J) Y = ⊤ ↔
      separatedDataTopTrace
        (moduleSeparatedData (S := S) (J := J) X)
        (moduleSeparatedData (S := S) (J := J) Y) = ⊤ := by
  calc
    _ ↔ moduleTopTraceR X Y = ⊤ :=
      moduleTrace_sup_jacobson_eq_top_iff X Y
    _ ↔ moduleTopTrace X Y = ⊤ :=
      moduleTopTraceR_eq_top_iff_moduleTopTrace_eq_top X Y
    _ ↔ _ := by
      rw [moduleTopTrace_eq_separatedDataTopTrace]

/-- For a square-zero extension, ordinary quotient generation by one source
can therefore be read directly on the top component of the associated
separated data.
@isnad1 id=iff.0h4v.s9.dd4f099c30b6 from=translated src=- shape=fa51a513 vocab=5415e0a7
-/
theorem moduleTrace_eq_top_iff_separatedDataTopTrace_eq_top
    [IsSemisimpleRing S]
    (X Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    moduleTrace X Y = ⊤ ↔
      separatedDataTopTrace
        (moduleSeparatedData (S := S) (J := J) X)
        (moduleSeparatedData (S := S) (J := J) Y) = ⊤ := by
  rw [TrivSqZeroExtRadical.eq_top_iff_sup_module_jacobson_eq_top]
  exact
    moduleTrace_sup_jacobson_eq_top_iff_separatedDataTopTrace_eq_top X Y

/-- The trace generated by all maps from a family of source modules.-/
def moduleFamilyTrace
    {A : Type x} (X : A → ModuleCat.{w} (TrivSqZeroExt S J))
    (Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    Submodule (TrivSqZeroExt S J) Y :=
  ⨆ a, moduleTrace (X a) Y

/-- Reindexing a source family by an equivalence does not change its full
module trace.
@isnad1 id=eq.0h7v.s8.b8ea6d6464c6 from=translated src=- shape=b4e959e5 vocab=d130a107
-/
theorem moduleFamilyTrace_reindex
    {A : Type x} {B : Type*} (e : A ≃ B)
    (X : B → ModuleCat.{w} (TrivSqZeroExt S J))
    (Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    moduleFamilyTrace (fun a ↦ X (e a)) Y =
      moduleFamilyTrace X Y := by
  apply le_antisymm
  · apply iSup_le
    intro a
    exact le_iSup (fun b ↦ moduleTrace (X b) Y) (e a)
  · apply iSup_le
    intro b
    simpa [moduleFamilyTrace] using le_iSup
      (fun a ↦ moduleTrace (X (e a)) Y) (e.symm b)

/-- Full family generation is invariant under pointwise source isomorphisms
and a target isomorphism.
@isnad1 id=iff.0h9v.s9.fd8203365b1f from=translated src=- shape=53b0dc8e vocab=8b1b067e
-/
theorem moduleFamilyTrace_eq_top_iff_of_iso
    {A : Type x}
    (X X' : A → ModuleCat.{w} (TrivSqZeroExt S J))
    (Y Y' : ModuleCat.{w} (TrivSqZeroExt S J))
    (eX : ∀ a, X a ≅ X' a) (eY : Y ≅ Y') :
    moduleFamilyTrace X Y = ⊤ ↔
      moduleFamilyTrace X' Y' = ⊤ := by
  have forward
      (U U' : A → ModuleCat.{w} (TrivSqZeroExt S J))
      (V V' : ModuleCat.{w} (TrivSqZeroExt S J))
      (eU : ∀ a, U a ≅ U' a) (eV : V ≅ V')
      (h : moduleFamilyTrace U V = ⊤) :
      moduleFamilyTrace U' V' = ⊤ := by
    have hmap :
        (moduleFamilyTrace U V).map eV.hom.hom ≤
          moduleFamilyTrace U' V' := by
      rw [moduleFamilyTrace, Submodule.map_iSup]
      apply iSup_le
      intro a
      rw [moduleTrace, Submodule.map_iSup]
      apply iSup_le
      intro f y hy
      rcases hy with ⟨z, hz, rfl⟩
      rcases hz with ⟨x, rfl⟩
      let g : U' a ⟶ V' := (eU a).inv ≫ f ≫ eV.hom
      have hrange : g ((eU a).hom x) ∈ LinearMap.range g.hom :=
        ⟨(eU a).hom x, rfl⟩
      have hle : LinearMap.range g.hom ≤ moduleTrace (U' a) V' :=
        le_iSup (fun g : U' a ⟶ V' ↦ LinearMap.range g.hom) g
      have hfamily : moduleTrace (U' a) V' ≤
          moduleFamilyTrace U' V' :=
        le_iSup (fun a ↦ moduleTrace (U' a) V') a
      exact hfamily (hle (by simpa [g, Category.assoc] using hrange))
    apply top_unique
    have htopmap :
        (⊤ : Submodule (TrivSqZeroExt S J) V).map eV.hom.hom = ⊤ := by
      rw [Submodule.map_top]
      exact LinearMap.range_eq_top.mpr
        (ConcreteCategory.bijective_of_isIso eV.hom).surjective
    rw [← htopmap, ← h]
    exact hmap
  constructor
  · exact forward X X' Y Y' eX eY
  · exact forward X' X Y' Y (fun a ↦ (eX a).symm) eY.symm

/-- The corresponding top trace generated by a family of sources.-/
def moduleFamilyTopTraceR
    {A : Type x} (X : A → ModuleCat.{w} (TrivSqZeroExt S J))
    (Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    Submodule (TrivSqZeroExt S J)
      (Y ⧸ Module.jacobson (TrivSqZeroExt S J) Y) :=
  ⨆ a, moduleTopTraceR (X a) Y

/-- Passing a family trace to the target top commutes with taking the sum of
all sourcewise traces.
@isnad1 id=eq.0h5v.s10.a002fb099988 from=translated src=- shape=c25ed0d8 vocab=dba608ae
-/
theorem moduleFamilyTopTraceR_eq_map_moduleFamilyTrace
    {A : Type x} (X : A → ModuleCat.{w} (TrivSqZeroExt S J))
    (Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    moduleFamilyTopTraceR X Y =
      (moduleFamilyTrace X Y).map
        (Module.jacobson (TrivSqZeroExt S J) Y).mkQ := by
  rw [moduleFamilyTrace, Submodule.map_iSup]
  apply iSup_congr
  intro a
  exact moduleTopTraceR_eq_map_moduleTrace (X a) Y

/-- Family top coverage is unchanged by restricting scalars from the trivial
extension to its base ring.
@isnad1 id=iff.0h5v.s10.375f80253b8c from=translated src=- shape=c226ce2f vocab=9c811823
-/
theorem moduleFamilyTopTraceR_eq_top_iff_moduleFamilyTopTrace_eq_top
    {A : Type x} (X : A → ModuleCat.{w} (TrivSqZeroExt S J))
    (Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    moduleFamilyTopTraceR X Y = ⊤ ↔ moduleFamilyTopTrace X Y = ⊤ := by
  let i := TrivSqZeroExt.inlHom S J
  letI : Module S (Y ⧸ Module.jacobson (TrivSqZeroExt S J) Y) :=
    Module.compHom (Y ⧸ Module.jacobson (TrivSqZeroExt S J) Y) i
  letI : IsScalarTower S (TrivSqZeroExt S J)
      (Y ⧸ Module.jacobson (TrivSqZeroExt S J) Y) :=
    { smul_assoc := by
        intro s r q
        change (s • r) • q =
          (TrivSqZeroExt.inl s : TrivSqZeroExt S J) • (r • q)
        rw [← TrivSqZeroExt.inl_mul_eq_smul s r]
        exact mul_smul
          (TrivSqZeroExt.inl s : TrivSqZeroExt S J) r q }
  have hrestrict :
      (moduleFamilyTopTraceR X Y).restrictScalars S =
        moduleFamilyTopTrace X Y := by
    simp only [moduleFamilyTopTraceR, moduleFamilyTopTrace,
      Submodule.restrictScalars_iSup]
    apply iSup_congr
    intro a
    simp only [moduleTopTraceR, moduleTopTrace,
      Submodule.restrictScalars_iSup]
    apply iSup_congr
    intro f
    rfl
  rw [← hrestrict]
  exact (Submodule.restrictScalars_eq_top_iff
    (S := S) (R := TrivSqZeroExt S J)
    (M := Y ⧸ Module.jacobson (TrivSqZeroExt S J) Y)
    (p := moduleFamilyTopTraceR X Y)).symm

/-- Family form of the top-coverage criterion used for quotient closure.
@isnad1 id=iff.0h5v.s11.a3a4b32b9410 from=translated src=- shape=b939dcf8 vocab=996020a6
-/
theorem moduleFamilyTrace_sup_jacobson_eq_top_iff
    {A : Type x} (X : A → ModuleCat.{w} (TrivSqZeroExt S J))
    (Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    moduleFamilyTrace X Y ⊔ Module.jacobson (TrivSqZeroExt S J) Y = ⊤ ↔
      moduleFamilyTopTraceR X Y = ⊤ := by
  rw [moduleFamilyTopTraceR_eq_map_moduleFamilyTrace]
  rw [sup_comm]
  exact (Submodule.map_mkQ_eq_top
    (Module.jacobson (TrivSqZeroExt S J) Y)
    (moduleFamilyTrace X Y)).symm

/-- Exact family form of the manuscript's top-coverage comparison: the
ordinary module trace covers the target modulo its radical exactly when the
top components of all compatible separated-data maps span the target top.
@isnad1 id=iff.0h5v.s10.81d8668a67be from=translated src=- shape=bf28ab57 vocab=14aec5fe
-/
theorem
    moduleFamilyTrace_sup_jacobson_eq_top_iff_separatedDataFamilyTopTrace_eq_top
    [IsSemisimpleRing S]
    {A : Type x} (X : A → ModuleCat.{w} (TrivSqZeroExt S J))
    (Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    moduleFamilyTrace X Y ⊔
        Module.jacobson (TrivSqZeroExt S J) Y = ⊤ ↔
      separatedDataFamilyTopTrace
        (fun a ↦ moduleSeparatedData (S := S) (J := J) (X a))
        (moduleSeparatedData (S := S) (J := J) Y) = ⊤ := by
  calc
    _ ↔ moduleFamilyTopTraceR X Y = ⊤ :=
      moduleFamilyTrace_sup_jacobson_eq_top_iff X Y
    _ ↔ moduleFamilyTopTrace X Y = ⊤ :=
      moduleFamilyTopTraceR_eq_top_iff_moduleFamilyTopTrace_eq_top X Y
    _ ↔ _ := by
      rw [moduleFamilyTopTrace_eq_separatedDataFamilyTopTrace]

/-- Family form of square-zero Nakayama combined with separated-data
fullness: quotient generation by a family is exactly top coverage in the
separated data.
@isnad1 id=iff.0h5v.s9.39c438066dd2 from=translated src=- shape=de846795 vocab=348ea1e0
-/
theorem
    moduleFamilyTrace_eq_top_iff_separatedDataFamilyTopTrace_eq_top
    [IsSemisimpleRing S]
    {A : Type x} (X : A → ModuleCat.{w} (TrivSqZeroExt S J))
    (Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    moduleFamilyTrace X Y = ⊤ ↔
      separatedDataFamilyTopTrace
        (fun a ↦ moduleSeparatedData (S := S) (J := J) (X a))
        (moduleSeparatedData (S := S) (J := J) Y) = ⊤ := by
  rw [TrivSqZeroExtRadical.eq_top_iff_sup_module_jacobson_eq_top]
  exact
    moduleFamilyTrace_sup_jacobson_eq_top_iff_separatedDataFamilyTopTrace_eq_top
      X Y

/-- The same family criterion before passing to separated data: literal
quotient generation is equivalent to filling the semisimple module top.
@isnad1 id=iff.0h5v.s9.f28c4df0d556 from=translated src=- shape=ace8b1bb vocab=756171b5
-/
theorem moduleFamilyTrace_eq_top_iff_moduleFamilyTopTrace_eq_top
    [IsSemisimpleRing S]
    {A : Type x} (X : A → ModuleCat.{w} (TrivSqZeroExt S J))
    (Y : ModuleCat.{w} (TrivSqZeroExt S J)) :
    moduleFamilyTrace X Y = ⊤ ↔ moduleFamilyTopTrace X Y = ⊤ := by
  calc
    moduleFamilyTrace X Y = ⊤ ↔
        moduleFamilyTrace X Y ⊔
          Module.jacobson (TrivSqZeroExt S J) Y = ⊤ :=
      TrivSqZeroExtRadical.eq_top_iff_sup_module_jacobson_eq_top _
    _ ↔ moduleFamilyTopTraceR X Y = ⊤ :=
      moduleFamilyTrace_sup_jacobson_eq_top_iff X Y
    _ ↔ moduleFamilyTopTrace X Y = ⊤ :=
      moduleFamilyTopTraceR_eq_top_iff_moduleFamilyTopTrace_eq_top X Y

end QuotientSubmoduleEquidistribution.TrivSqZeroExtSeparatedTrace
